":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"action","name":"Radical Surgery","system":{"actionType":{"value":"action"},"description":{"value":"<p><strong>Requirements</strong> The synthecite vivisectionist is adjacent to an @UUID[Compendium.sf2e.conditions.Item.eIcWbB5o3pP6OIMe]{Immobilized} or @UUID[Compendium.sf2e.conditions.Item.j91X7x0XSomq8d60]{Prone} creature</p><hr /><p><strong>Effect</strong> The synthecite vivisectionist makes two scythe arm Strikes at a –2 penalty against a prone or immobilized target. These attacks count toward the vivisectionist's multiple attack penalty, but the multiple attack penalty doesn't increase until after they make both attacks. If both attacks hit and the creature has been poisoned with synthecite substrate, the poison advances by 1 stage.</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[{"key":"RollOption","option":"radical-surgery","toggleable":true},{"key":"FlatModifier","selector":"scythe-arm-attack","value":-2,"predicate":["radical-surgery"]}],"slug":null,"traits":{"otherTags":[],"value":[]},"_migration":{"version":0.942,"previous":{"schema":null,"foundry":"13.347","system":"7.3.1"}},"actions":{"value":2},"category":"offensive","deathNote":false},"effects":[],"_id":"y99kmTLb6LVqYJzQ","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"melee","name":"Hypodermic Spike","effects":[],"system":{"_migration":{"version":0.942,"previous":null},"description":{"value":"","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":["agile"]},"damageRolls":{"IIMcVd840evnDVlF":{"dam