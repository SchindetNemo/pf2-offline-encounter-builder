 its turn in the area takes 1d8 vitality damage.</p>\n<hr />\n<p><strong>Heightened (8th)</strong> The healing and damage increase to 1d10.</p>\n<p><strong>Heightened (9th)</strong> The healing and damage increase to 1d12.</p>"},"rules":[],"slug":"field-of-life","_migration":{"version":0.942,"lastMigration":null,"previous":{"schema":0.941,"foundry":"13.347","system":"7.3.1"}},"traits":{"otherTags":[],"value":["concentrate","healing","manipulate","vitality"],"rarity":"common","traditions":["divine","primal"]},"publication":{"title":"Pathfinder Player Core","authors":"","license":"ORC","remaster":true},"level":{"value":6},"requirements":"","target":{"value":""},"range":{"value":"30 feet"},"area":{"type":"burst","value":20},"time":{"value":"2"},"duration":{"value":"1 minute","sustained":true},"damage":{"0":{"applyMod":false,"category":null,"formula":"1d8","kinds":["damage","healing"],"materials":[],"type":"vitality"}},"defense":null,"cost":{"value":""},"location":{"value":"KVTLsAT3QjxW1tet","heightenedLevel":8},"counteraction":false,"heightening":{"levels":{"8":{"damage":{"0":{"applyMod":false,"category":null,"formula":"1d10","materials":[],"type":"vitality"}}},"9":{"damage":{"0":{"applyMod":false,"category":null,"formula":"1d12","materials":[],"type":"vitality"}}}},"type":"fixed"}},"type":"spell","_stats":{"compendiumSource":"Compendium.sf2e.spells.Item.x5rGOmhDRDVQPrnW","duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"},"effects":[],"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_id":"cA2QFJDDWmfmacDO"},{"folder":"T8AzYUgNIAgTJ9Iz","img":"icons/magic/life/cross-worn-green.webp","name":"Heal","system":{"description":{"gm":"","value":"<p>You channel vital energy to heal the living or damage the undead. If the target is a willing living creature, you restore 1d8 Hit Points. If the target is undead, you deal that amount of vitality damage to it, and it gets a basic Fortitude save. The number of actions you spend when Casting this Spell determines its targets, range, area, and other parameters.</p>\n<p><span class=\"action-glyph\">1</span> The spell has a range of touch.</p>\n<p><span class=\"action-glyph\">2</span> <strong>(concentrate)</strong> The spell has a range of 30 feet. If you're healing a living creature, increase the Hit Points restored by 8.</p>\n<p><span class=\"action-glyph\">3</span> <strong>(concentrate)</strong> You disperse vital energy in a @Template[emanation|distance:30]. This targets all living and undead creatures in the burst.</p>\n<hr />\n<p><strong>Heightened (+1)</strong> The amount of healing or damage increases by 1d8, and the extra healing for the 2-action version increases by 8.</p>"},"rules":[],"slug":"heal","_migration":{"version":0.942,"lastMigration":null,"previous":{"schema":0.941,"foundry":"13.347","system":"7.3.1"}},"traits":{"otherTags":[],"value":["healing","manipulate","vitality"],"rarity":"common","traditions":["divine","primal"]},"publication":{"title":"Pathfinder Player Core","authors":"","license":"ORC","remaster":true},"level":{"value":1},"requirements":"","target":{"value":"1 willing living creature or 1 undead"},"range":{"value":"varies"},"area":null,"time":{"value":"1 to 3"},"duration":{"value":"","sustained":false},"damage":{"0":{"applyMod":false,"category":null,"formula":"1d8","kinds":["damage","healing"],"materials":[],"type":"vitality"}},"defense":{"save":{"basic":true,"statistic":"fortitude"}},"cost":{"value":""},"location":{"value":"KVTLsAT3QjxW1tet","heightenedLevel":8,"uses":{"max":2,"value":2}},"counteraction":false,"heightening":{"damage":{"0":"1d8"},"interval":1,"type":"interval"},"overlays":{"37gy7l19tik74o4s":{"_id":"37gy7l19tik74o4s","name":"Heal (vs. Living)","overlayType":"override","sort":2,"system":{"damage":{"0":{"formula":"1d8+8","kinds":["healing"]}},"defense":null,"heightening":{"damage":{"0":"1d8+8"}},"range":{"value":"30 feet"},"time":{"value":"2"},"traits":{"value":["concentrate","healing","manipulate","vitality"]}}},"7qdtetowq348s9oc":{"_id":"7qdtetowq348s9oc","overlayType":"override","sort":1,"system":{"range":{"value":"touch"},"time":{"value":"1"}}},"7vbvdrv2cl87sqta":{"_id":"7vbvdrv2cl87sqta","overlayType":"override","sort":4,"system":{"area":{"type":"emanation","value":30},"range":{"value":""},"target":{"value":"all living and undead creatures"},"time":{"value":"3"},"traits":{"value":["concentrate","healing","manipulate","vitality"]}}},"lfxcoz2d3f8j2zq1":{"_id":"lfxcoz2d3f8j2zq1","name":"Heal (vs. Undead)","overlayType":"override","sort":3,"system":{"damage":{"0":{"kinds":["damage"]}},"range":{"value":"30 feet"},"target":{"value":"1 undead"},"time":{"value":"2"},"traits":{"value":["concentrate","healing","manipulate","vitality"]}}}}},"type":"spell","_stats":{"compendiumSource":"Compendium.sf2e.spells.Item.rfZpqmj0AIIdkVIs","duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"},"effects":[],"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_id":"XN6E4BcWIhSqRJiJ"},{"type":"spell","name":"Boulder Crush","folder":"MYtFH2KK4Kkb9Z7H","system":{"description":{"gm":"","value":"<p>You conjure a large boulder in the air and send it crashing down to the ground. The boulder appears at the top of the cylinder before falling. Creatures underneath the boulder take 4d12 bludgeoning damage and must attempt a Reflex save.</p><hr /><p><strong>Critical Success</strong> The creature is unaffected.</p><p><strong>Success</strong> The creature takes half damage.</p><p><strong>Failure</strong> The creature takes full damage. If it was flying, it is repositioned to the bottom of the cylinder, landing on its feet without taking additional falling damage.</p><p><strong>Critical Failure</strong> The creature takes full damage. If it was flying, it is repositioned to the bottom of the cylinder, landing on its feet without taking additional falling damage. If it is on the ground after the boulder's fall, it is knocked @UUID[Compendium.sf2e.conditions.Item.j91X7x0XSomq8d60]{Prone}. If it's still in the air, it's instead @UUID[Compendium.sf2e.conditions.Item.AJh5ex99aV6VTggg]{Off-Guard} for 1 round or until it spends an action to right itself, whichever comes first.</p><hr /><p><strong>Heightened (+1)</strong> The damage increases by 1d12 and the cylinder's maximum height increases by 10 feet.</p>"},"rules":[],"slug":null,"_migration":{"version":0.942,"lastMigration":null,"previous":{"schema":0.941,"foundry":"13.347","system":"7.3.1"}},"traits":{"otherTags":[],"value":["concentrate","earth","manipulate"],"rarity":"uncommon","traditions":["arcane","primal"]},"publication":{"title":"Battlezoo Bestiary: Elemental Storm (Pathfinder)","authors":"","license":"ORC","remaster":true},"level":{"value":4},"requirements":"","target":{"value":""},"range":{"value":"30 feet"},"area":{"value":5,"type":"cylinder"},"time":{"value":"2"},"duration":{"value":"","sustained":false},"damage":{"0X0G675Eo0owzjg2":{"formula":"4d12","kinds":["damage"],"type":"bludgeoning","category":null,"materials":[],"applyMod":false}},"defense":{"save":{"statistic":"reflex","basic":false}},"cost":{"value":""},"location":{"value":"KVTLsAT3QjxW1tet","heightenedLevel":7,"uses":{"max":2,"value":2}},"counteraction":false,"heightening":{"type":"interval","interval":1,"damage":{"0X0G675Eo0owzjg2":"1d12"},"area":0}},"img":"icons/magic/earth/projectile-spiked-stone-boulder-orange.webp","effects":[],"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":"Compendium.battlezoo-bestiary-es-pf2e.sf2e-spells.Item.QiTHjk7DMecYFlrS","duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"},"_id":"yzE840H5yvxpvdYZ"},{"folder":"xqlqJ6eeiNtWb7bq","img":"icons/magic/life/cross-beam-green.webp","name":"Regenerate","system":{"description":{"gm":"","value":"<p>An infusion of vital energy grants a creature continuous healing. The target temporarily gains regeneration 15, which restores 15 Hit Points to it at the start of each of its turns. While it has regeneration, the target can't die from taking Hit Point damage and its @UUID[Compendium.sf2e.conditions.Item.yZRUzMqrMmfLu0V1]{Dying} condition can't increase to a value that would kill it (this stops most creatures' dying condition at dying 3), though if its @UUID[Compendium.sf2e.conditions.Item.Yl48xTdMh3aeQYL2]{Wounded} value becomes 4 or higher, it stays @UUID[Compendium.sf2e.conditions.Item.fBnFDH2MTzgFijKf]{Unconscious} until its wounds are treated. If the target takes acid or fire damage, its regeneration deactivates until after the end of its next turn.</p>\n<p>Each time the creature regains Hit Points from regeneration, it also regrows one damaged or ruined organ (if any). During the spell's duration, the creature can also reattach severed body parts by spending an Interact action to hold the body part to the area it was severed from.</p>\n<p>@UUID[Compendium.sf2e.spell-effects.Item.dXq7z633ve4E0nlX]{Spell Effect: Regenerate}</p>\n<hr />\n<p><strong>Heightened (9th)</strong> The regeneration increases to 20.</p>"},"rules":[],"slug":"regenerate","_migration":{"version":0.942,"lastMigration":null,"previous":{"schema":0.941,"foundry":"13.347","system":"7.3.1"}},"traits":{"otherTags":[],"value":["concentrate","healing","manipulate","vitality"],"rarity":"common","traditions":["divine","primal"]},"publication":{"title":"Pathfinder Player Core","authors":"","license":"ORC","remaster":true},"level":{"value":7},"requirements":"","target":{"value":"1 willing living creature"},"range":{"value":"touch"},"area":null,"time":{"value":"2"},"duration":{"value":"1 minute","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"KVTLsAT3QjxW1tet","heightenedLevel":7},"counteraction":false},"type":"spell","_stats":{"compendiumSource":"Compendium.sf2e.spells.Item.2Vkd1IxylPceUAAF","duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"},"effects":[],"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_id":"rJECXJdzLSYgkQvv"},{"folder":"iDjm2cXyRAe4VZ35","img":"icons/magic/life/heart-shadow-red.webp","name":"Breath of Life","system":{"description":{"gm":"","value":"<p><strong>Trigger</strong> A living creature within range would die.</p>\n<hr />\n<p>Your blessing revives a creature at the moment of its death. You prevent the target from dying and restore 5d8 Hit Points to the target. You can't use breath of life if the triggering effect was a death effect or an effect that leaves no remains, such as @UUID[Compendium.sf2e.spells.Item.r7ihOgKv19eJQnik]{Disintegrate}</p>\n<hr />\n<p><strong>Heightened (+2)</strong> The healing increases by 1d8.</p>"},"rules":[],"slug":"breath-of-life","_migration":{"version":0.942,"lastMigration":null,"previous":{"schema":0.941,"foundry":"13.347","system":"7.3.1"}},"traits":{"otherTags":[],"value":["concentrate","healing","vitality"],"rarity":"common","traditions":["divine"]},"publication":{"title":"Pathfinder Player Core","authors":"","license":"ORC","remaster":true},"level":{"value":5},"requirements":"","target":{"value":"the triggering creature"},"range":{"value":"60 feet"},"area":null,"time":{"value":"reaction"},"duration":{"value":"","sustained":false},"damage":{"0":{"applyMod":false,"category":null,"formula":"5d8","kinds":["healing"],"materials":[],"type":"untyped"}},"defense":null,"cost":{"value":""},"location":{"value":"KVTLsAT3QjxW1tet","heightenedLevel":6,"uses":{"max":3,"value":3}},"counteraction":false,"heightening":{"damage":{"0":"1d8"},"interval":1,"type":"interval"}},"type":"spell","_stats":{"compendiumSource":"Compendium.sf2e.spells.Item.Hnc7eGi7vyZenAIm","duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"},"effects":[],"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_id":"yUuRtVEEzpkA5yMH"},{"folder":"T8AzYUgNIAgTJ9Iz","img":"systems/pf2e/icons/spells/sanctuary.webp","name":"Sanctuary","system":{"description":{"gm":"","value":"<p>You ward a creature with protective energy that deters attacks. Creatures attempting to attack the target must attempt a Will save each time. If the target uses a hostile action, the spell ends.</p>\n<hr />\n<p><strong>Critical Success</strong> <em>Sanctuary</em> ends.</p>\n<p><strong>Success</strong> The creature can attempt its attack and any other attacks against the target this turn.</p>\n<p><strong>Failure</strong> The creature can't attack the target and wastes the action. It can't attempt further attacks against the target this turn.</p>\n<p><strong>Critical Failure</strong> The creature wastes the action and can't attempt to attack the target for the rest of <em>sanctuary</em>'s duration.</p>"},"rules":[],"slug":"sanctuary","_migration":{"version":0.942,"lastMigration":null,"previous":{"schema":0.941,"foundry":"13.347","system":"7.3.1"}},"traits":{"otherTags":[],"value":["concentrate","manipulate"],"rarity":"common","traditions":["divine","occult"]},"publication":{"title":"Pathfinder Player Core","authors":"","license":"ORC","remaster":true},"level":{"value":1},"requirements":"","target":{"value":"1 creature"},"range":{"value":"touch"},"area":null,"time":{"value":"2"},"duration":{"value":"1 minute","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"KVTLsAT3QjxW1tet","heightenedLevel":1},"counteraction":false},"type":"spell","_stats":{"compendiumSource":"Compendium.sf2e.spells.Item.8xRzLhwGL7Dgy3EZ","duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"},"effects":[],"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_id":"4ABss17sgaVjmoI3"},{"folder":"D7UVaOiB40wTR6kv","img":"systems/pf2e/icons/spells/light.webp","name":"Light","system":{"description":{"gm":"","value":"<p>You create an orb of light that sheds bright light in a 20-foot radius (and dim light for the next 20 feet) in a color you choose. If you create the light in the same space as a willing creature, you can attach the light to the creature, causing it to float near that creature as it moves. You can Sustain the spell to move the light up to 60 feet; you can attach or detach it from a creature as part of this movement.</p>\n<p>You can Dismiss the spell. If you Cast the Spell while you already have four <em>light</em> spells active, you must choose one of the existing spells to end.</p>\n<p>@UUID[Compendium.sf2e.spell-effects.Item.cVVZXNbV0nElVOPZ]{Spell Effect: Light}</p>\n<hr />\n<p><strong>Heightened (4th)</strong> The orb sheds light in a 60-foot radius (and dim light for the next 60 feet).</p>"},"rules":[],"slug":"light","_migration":{"version":0.942,"lastMigration":null,"previous":{"schema":0.941,"foundry":"13.347","system":"7.3.1"}},"traits":{"otherTags":[],"value":["cantrip","concentrate","light","manipulate"],"rarity":"common","traditions":["arcane","divine","occult","primal"]},"publication":{"title":"Pathfinder Player Core","authors":"","license":"ORC","remaster":true},"level":{"value":1},"requirements":"","target":{"value":""},"range":{"value":"120 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"until your next daily preparations","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"KVTLsAT3QjxW1tet"},"counteraction":false},"type":"spell","_stats":{"compendiumSource":"Compendium.sf2e.spells.Item.WBmvzNDfpwka3qT4","duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"},"effects":[],"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_id":"3tXlveZRgkLw1AZh"},{"folder":"D7UVaOiB40wTR6kv","img":"icons/magic/control/debuff-energy-hold-yellow.webp","name":"Stabilize","system":{"description":{"gm":"","value":"<p>Life energy shuts death's door. The target loses the @UUID[Compendium.sf2e.conditions.Item.yZRUzMqrMmfLu0V1]{Dying} condition, though it remains @UUID[Compendium.sf2e.conditions.Item.fBnFDH2MTzgFijKf]{Unconscious} at 0 Hit Points.</p>"},"rules":[],"slug":"stabilize","_migration":{"version":0.942,"lastMigration":null,"previous":{"schema":0.941,"foundry":"13.347","system":"7.3.1"}},"traits":{"otherTags":[],"value":["cantrip","concentrate","healing","manipulate","vitality"],"rarity":"common","traditions":["divine","primal"]},"publication":{"title":"Pathfinder Player Core","authors":"","license":"ORC","remaster":true},"level":{"value":1},"requirements":"","target":{"value":"1 dying creature"},"range":{"value":"30 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"KVTLsAT3QjxW1tet"},"counteraction":false},"type":"spell","_stats":{"compendiumSource":"Compendium.sf2e.spells.Item.SnjhtQYexDtNDdEg","duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"},"effects":[],"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_id":"LXUorkx4TCOmebCi"},{"folder":"iDjm2cXyRAe4VZ35","img":"systems/pf2e/icons/spells/tongues.webp","name":"Truespeech (Constant)","system":{"description":{"gm":"","value":"<p>The target can understand all words regardless of language and also speak the languages of other creatures. When in a mixed group of creatures, each time the target speaks, it can choose a creature and speak in a language that creature understands, even if the target doesn't know what language that is.</p>\n<hr />\n<p><strong>Heightened (7th)</strong> The duration is 8 hours.</p>"},"rules":[],"slug":"truespeech","_migration":{"version":0.942,"lastMigration":null,"previous":{"schema":0.941,"foundry":"13.347","system":"7.3.1"}},"traits":{"otherTags":[],"value":["concentrate","manipulate"],"rarity":"uncommon","traditions":["arcane","divine","occult"]},"publication":{"title":"Pathfinder Player Core","authors":"","license":"ORC","remaster":true},"level":{"value":5},"requirements":"","target":{"value":"1 creature"},"range":{"value":"touch"},"area":null,"time":{"value":"2"},"duration":{"value":"1 hour","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"KVTLsAT3QjxW1tet","heightenedLevel":5},"counteraction":false},"type":"spell","_stats":{"compendiumSource":"Compendium.sf2e.spells.Item.SwUiVavHKMWG7t5K","duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"},"effects":[],"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_id":"ja7Jd1XgUujkrNME"},{"folder":"4fJHnYFqH0VjZXPv","img":"icons/magic/nature/plant-poison-spit-green.webp","name":"Speak with Plants (Constant)","system":{"description":{"gm":"","value":"<p>You can ask questions of and receive answers from plants and fungi, but the spell doesn't make them more friendly or intelligent than normal. Most normal plants and fungi have a distinctive view of the world around them, so they don't recognize details about creatures or know anything about the world beyond their immediate vicinity. Cunning plant or fungus monsters are likely to be terse and evasive, while less intelligent ones often make inane comments.</p>\n<hr />\n<p><strong>Heightened (4th)</strong> The duration is 8 hours.</p>"},"rules":[],"slug":"speak-with-plants","_migration":{"version":0.942,"lastMigration":null,"previous":{"schema":0.941,"foundry":"13.347","system":"7.3.1"}},"traits":{"otherTags":[],"value":["concentrate","manipulate","plant","wood"],"rarity":"common","traditions":["divine","occult","primal"]},"publication":{"title":"Pathfinder Player Core","authors":"","license":"ORC","remaster":true},"level":{"value":3},"requirements":"","target":{"value":""},"range":{"value":""},"area":null,"time":{"value":"2"},"duration":{"value":"1 hour","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"KVTLsAT3QjxW1tet","heightenedLevel":4},"counteraction":false},"type":"spell","_stats":{"compendiumSource":"Compendium.sf2e.spells.Item.qvwIwJ9QBihy8R0t","duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"},"effects":[],"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_id":"4cnxVFigsipxS06V"},{"folder":"lPzcDrjGDFbzuF2r","img":"icons/creatures/mammals/ox-buffalo-horned-green.webp","name":"Speak with Animals (Constant)","system":{"description":{"gm":"","value":"<p>You can ask questions of, receive answers from, and use the Diplomacy skill with animals. The spell doesn't make them more friendly than normal. Cunning animals are likely to be terse and evasive, while less intelligent ones often make inane comments.</p>"},"rules":[],"slug":"speak-with-animals","_migration":{"version":0.942,"lastMigration":null,"previous":{"schema":0.941,"foundry":"13.347","system":"7.3.1"}},"traits":{"otherTags":[],"value":["concentrate","manipulate"],"rarity":"common","traditions":["primal"]},"publication":{"title":"Pathfinder Player Core","authors":"","license":"ORC","remaster":true},"level":{"value":2},"requirements":"","target":{"value":""},"range":{"value":""},"area":null,"time":{"value":"2"},"duration":{"value":"1 hour","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"KVTLsAT3QjxW1tet","heightenedLevel":2},"counteraction":false},"type":"spell","_stats":{"compendiumSource":"Compendium.sf2e.spells.Item.BBvV7qoXGdw09q1C","duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"},"effects":[],"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_id":"Z1cK8prMjhXK38qS"},{"img":"systems/pf2e/icons/actions/Passive.webp","name":"Constant Spells","system":{"actionType":{"value":"passive"},"actions":{"value":null},"category":"interaction","description":{"value":"<p>@Localize[PF2E.NPC.Abilities.Glossary.ConstantSpells]</p>","gm":""},"publication":{"license":"ORC","remaster":true,"title":"Pathfinder Monster Core","authors":""},"rules":[],"traits":{"value":[],"otherTags":[]},"slug":"constant-spells","_migration":{"version":0.942,"previous":{"schema":0.941,"foundry":"13.347","system":"7.3.1"}}},"type":"action","_stats":{"compendiumSource":"Compendium.sf2e.bestiary-ability-glossary-srd.Item.kakyXBG5WA8c6Zfd","duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_id":"lh1gRfejpaYOpuyy"},{"folder":"6JF73zNhT8zbp1qC","img":"systems/pf2e/icons/spells/angelic-messenger.webp","name":"Angelic Messenger","system":{"description":{"gm":"","value":"<p>You transport yourself to either a celestial plane or a world in the Universe where worshippers of your patron can be found. You must be of no higher level than double angelic messenger's spell rank.</p>\n<hr />\n<p><strong>Critical Success</strong> As success, but if you've never visited that plane or world before, you appear right in front of the message's intended recipient.</p>\n<p><strong>Success</strong> You arrive on the target plane or world at the last location you visited on that plane or world, or to a random location within [[/r 10d10 #Miles Off]] miles of your message's intended recipient if you've never visited that plane or world before.</p>\n<p><strong>Failure</strong> You don't travel.</p>\n<p><strong>Critical Failure</strong> You accidentally travel to the wrong plane, possibly a dangerous plane.</p>"},"rules":[],"slug":"angelic-messenger","_migration":{"version":0.942,"lastMigration":null,"previous":{"schema":0.941,"foundry":"13.347","system":"7.3.1"}},"traits":{"otherTags":[],"value":[],"rarity":"uncommon","traditions":[]},"publication":{"title":"Pathfinder Monster Core","authors":"","license":"ORC","remaster":true},"level":{"value":1},"requirements":"","target":{"value":""},"range":{"value":""},"area":null,"time":{"value":"1 day"},"duration":{"value":"","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":null},"counteraction":false,"ritual":{"primary":{"check":"Religion (expert; you must be an angel)"},"secondary":{"casters":0,"checks":""}}},"type":"spell","_stats":{"compendiumSource":"Compendium.sf2e.spells.Item.joEruBVz31Uxczzq","duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"},"effects":[],"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_id":"Y6OUc6rqDLVr8W2q"},{"folder":"6JF73zNhT8zbp1qC","img":"icons/environment/wilderness/tree-spruce.webp","name":"Plant Growth","system":{"description":{"gm":"","value":"<p><strong>Area</strong> 1/2-mile-radius circle centered on you</p>\n<hr />\n<p>You cause the plants within the area to be healthier and more fruitful. In addition to other benefits of healthy plants, this increases the crop yield for farms, depending on your success. If you cast it in the area of a @UUID[Compendium.sf2e.spells.Item.7yWXx3qC4eFNHhxD]{Blight}, <em>plant growth</em> attempts to counteract the <em>blight</em> instead of producing its usual effect.</p>\n<hr />\n<p><strong>Critical Success</strong> Double the crop yield in the area, or increase the area to a 1-mile radius.</p>\n<p><strong>Success</strong> Increase the crop yield in the area by one-third.</p>\n<p><strong>Failure</strong> The ritual has no effect.</p>\n<p><strong>Critical Failure</strong> The flora in the area changes in an unanticipated way, determined by the GM but generally as contradictory to your true desires as possible (for instance, blighting crops when you would prefer to enrich them).</p>"},"rules":[],"slug":"plant-growth","_migration":{"version":0.942,"lastMigration":null,"previous":{"schema":0.941,"foundry":"13.347","system":"7.3.1"}},"traits":{"otherTags":[],"value":["plant","vitality","wood"],"rarity":"uncommon","traditions":[]},"publication":{"title":"Pathfinder Player Core","authors":"","license":"ORC","remaster":true},"level":{"value":4},"requirements":"","target":{"value":""},"range":{"value":""},"area":null,"time":{"value":"1 day"},"duration":{"value":"1 year","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":null},"counteraction":false,"ritual":{"primary":{"check":"Nature (expert)"},"secondary":{"casters":1,"checks":"Farming Lore or Survival"}}},"type":"spell","_stats":{"compendiumSource":"Compendium.sf2e.spells.Item.ZhJ8d9Uk4lwIx86b","duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"},"effects":[],"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_id":"vpDDjT7hYGEX7wnd"},{"folder":"6JF73zNhT8zbp1qC","img":"systems/pf2e/icons/spells/primal-call.webp","name":"Primal Call","system":{"description":{"gm":"","value":"<p>This functions as @UUID[Compendium.sf2e.spells.Item.vgy00hnqxN9VoeoF]{Planar Servitor} except you craft a faerie circle and call an animal, beast, fey, fungus, or plant from within 100 miles.</p>"},"rules":[],"slug":"primal-call","_migration":{"version":0.942,"lastMigration":null,"previous":{"schema":0.941,"foundry":"13.347","system":"7.3.1"}},"traits":{"otherTags":[],"value":[],"rarity":"uncommon","traditions":[]},"publication":{"title":"Pathfinder Player Core","authors":"","license":"ORC","remaster":true},"level":{"value":6},"requirements":"","target":{"value":"1 animal, beast, fey, fungus, or plant"},"range":{"value":"100 miles"},"area":null,"time":{"value":"1 day"},"duration":{"value":"see text","sustained":false},"damage":{},"defense":null,"cost":{"value":"faerie circle ingredients worth a total value of 1 gp × the spell rank × the target's level"},"location":{"value":null},"counteraction":false,"ritual":{"primary":{"check":"Nature (master)"},"secondary":{"casters":4,"checks":"Crafting, Diplomacy, Survival"}}},"type":"spell","_stats":{"compendiumSource":"Compendium.sf2e.spells.Item.pZc8ZwtsyWnxUUW0","duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"},"effects":[],"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_id":"pUV8e3ipYHrNxQjt"},{"type":"action","name":"Statue","system":{"actionType":{"value":"action"},"description":{"value":"<p>Until the next time they act, the arahabaki appears to be a statue. They have an automatic result of 50 on Deception checks and DCs to pass as a statue.</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":[]},"_migration":{"version":0.942,"previous":{"schema":0.941,"foundry":"13.347","system":"7.3.1"}},"actions":{"value":1},"category":"offensive","deathNote":false},"effects":[],"_id":"0lOs7VCn7PTyDWXX","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}}],"effects":[],"sort":12000000,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.351","systemId":"pf2e","systemVersion":"7.8.0"}}