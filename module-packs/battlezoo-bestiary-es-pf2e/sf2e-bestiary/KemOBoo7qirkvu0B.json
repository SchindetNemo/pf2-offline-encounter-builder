x":0},"slot5":{"prepared":[],"value":0,"max":0},"slot6":{"prepared":[],"value":0,"max":0},"slot7":{"prepared":[],"value":0,"max":0},"slot8":{"prepared":[],"value":0,"max":0},"slot9":{"prepared":[],"value":0,"max":0},"slot10":{"prepared":[],"value":0,"max":0},"slot11":{"prepared":[],"value":0,"max":0}},"autoHeightenLevel":{"value":null}},"_id":"pXTuFwEemiwl9kTY","img":"systems/pf2e/icons/default-icons/spellcastingEntry.svg","effects":[],"folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"folder":"lPzcDrjGDFbzuF2r","img":"systems/pf2e/icons/spells/create-food.webp","name":"Create Food","system":{"description":{"gm":"","value":"<p>You create enough food to feed six Medium creatures for a day. This food is bland and unappealing, but it is nourishing. After 1 day, if no one has eaten the food, it decays and becomes inedible. Most Small creatures eat one-quarter as much as a Medium creature (one-sixteenth as much for most Tiny creatures), and most Large creatures eat 10 times as much (100 times as much for Huge creatures and so on).</p>\n<hr />\n<p><strong>Heightened (4th)</strong> You can feed 12 Medium creatures.</p>\n<p><strong>Heightened (6th)</strong> You can feed 50 Medium creatures.</p>\n<p><strong>Heightened (8th)</strong> You can feed 200 Medium creatures.</p>"},"rules":[],"slug":"create-food","_migration":{"version":0.942,"lastMigration":null,"previous":{"schema":0.941,"foundry":"13.347","system":"7.3.1"}},"traits":{"otherTags":[],"value":["concentrate","manipulate"],"rarity":"common","traditions":["arcane","divine","primal"]},"publication":{"title":"Pathfinder Player Core","authors":"","license":"ORC","remaster":true},"level":{"value":2},"requirements":"","target":{"value":""},"range":{"value":"30 feet"},"area":null,"time":{"value":"1 hour"},"duration":{"value":"","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"pXTuFwEemiwl9kTY"},"counteraction":false},"type":"spell","_stats":{"compendiumSource":"Compendium.sf2e.spells.Item.Mt6ZzkVX8Q4xigFq","duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"},"effects":[],"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_id":"5pNqHmZ2CgmfUu7T"},{"folder":"lPzcDrjGDFbzuF2r","img":"icons/creatures/magical/construct-stone-earth-gray.webp","name":"Invisibility","system":{"description":{"gm":"","value":"<p>Illusions bend light around the target, rendering it @UUID[Compendium.sf2e.conditions.Item.zJxUflt9np0q4yML]{Invisible}. This makes it @UUID[Compendium.sf2e.conditions.Item.VRSef5y1LmL2Hkjf]{Undetected} to all creatures, though the creatures can attempt to find the target, making it @UUID[Compendium.sf2e.conditions.Item.iU0fEDdBp3rXpTMC]{Hidden} to them instead. If the target uses a hostile action, the spell ends after that hostile action is completed.</p>\n<hr />\n<p><strong>Heightened (4th)</strong> The spell lasts 1 minute, but it doesn't end if the target uses a hostile action.</p>"},"rules":[],"slug":"invisibility","_migration":{"version":0.942,"lastMigration":null,"previous":{"schema":0.941,"foundry":"13.347","system":"7.3.1"}},"traits":{"otherTags":[],"value":["illusion","manipulate","subtle"],"rarity":"common","traditions":["arcane","occult"]},"publication":{"title":"Pathfinder Player Core","authors":"","license":"ORC","remaster":true},"level":{"value":2},"requirements":"","target":{"value":"1 creature"},"range":{"value":"touch"},"area":null,"time":{"value":"2"},"duration":{"value":"10 minutes","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"pXTuFwEemiwl9kTY","heightenedLevel":2},"counteraction":false},"type":"spell","_stats":{"compendiumSource":"Compendium.sf2e.spells.Item.XXqE1eY3w3z6xJCB","duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"},"effects":[],"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_id":"IURsb7v0aCI8Oo2w"},{"folder":"T8AzYUgNIAgTJ9Iz","img":"systems/pf2e/icons/spells/create-water.webp","name":"Create Water","system":{"description":{"gm":"","value":"<p>As you cup your hands, water begins to flow forth from them. You create 2 gallons of water. If no one drinks it, it evaporates after 1 day.</p>"},"rules":[],"slug":"create-water","_migration":{"version":0.942,"lastMigration":null,"previous":{"schema":0.941,"foundry":"13.347","system":"7.3.1"}},"traits":{"otherTags":[],"value":["concentrate","manipulate","water"],"rarity":"common","traditions":["arcane","divine","primal"]},"publication":{"title":"Pathfinder Player Core","authors":"","license":"ORC","remaster":true},"level":{"value":1},"requirements":"","target":{"value":""},"range":{"value":"0 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"pXTuFwEemiwl9kTY","heightenedLevel":1},"counteraction":false},"type":"spell","_stats":{"compendiumSource":"Compendium.sf2e.spells.Item.WzLKjSw6hsBhuklC","duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"},"effects":[],"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_id":"eyEf12Pe6a3YTZzV"},{"folder":"T8AzYUgNIAgTJ9Iz","img":"systems/pf2e/icons/spells/sanctuary.webp","name":"Sanctuary","system":{"description":{"gm":"","value":"<p>You ward a creature with protective energy that deters attacks. Creatures attempting to attack the target must attempt a Will save each time. If the target uses a hostile action, the spell ends.</p>\n<hr />\n<p><strong>Critical Success</strong> <em>Sanctuary</em> ends.</p>\n<p><strong>Success</strong> The creature can attempt its attack and any other attacks against the target this turn.</p>\n<p><strong>Failure</strong> The creature can't attack the target and wastes the action. It can't attempt further attacks against the target this turn.</p>\n<p><strong>Critical Failure</strong> The creature wastes the action and can't attempt to attack the target for the rest of <em>sanctuary</em>'s duration.</p>"},"rules":[],"slug":"sanctuary","_migration":{"version":0.942,"lastMigration":null,"previous":{"schema":0.941,"foundry":"13.347","system":"7.3.1"}},"traits":{"otherTags":[],"value":["concentrate","manipulate"],"rarity":"common","traditions":["divine","occult"]},"publication":{"title":"Pathfinder Player Core","authors":"","license":"ORC","remaster":true},"level":{"value":1},"requirements":"","target":{"value":"1 creature"},"range":{"value":"touch"},"area":null,"time":{"value":"2"},"duration":{"value":"1 minute","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"pXTuFwEemiwl9kTY","heightenedLevel":1},"counteraction":false},"type":"spell","_stats":{"compendiumSource":"Compendium.sf2e.spells.Item.8xRzLhwGL7Dgy3EZ","duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"},"effects":[],"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_id":"o3pBLAIsHoLbJV3h"},{"folder":"T8AzYUgNIAgTJ9Iz","img":"icons/magic/control/control-influence-puppet.webp","name":"Ventriloquism","system":{"description":{"gm":"","value":"<p>Whenever you speak or make any other sound vocally, you can make your vocalization seem to originate from somewhere else within 60 feet, and you can change that apparent location freely as you vocalize. Any creature that hears the sound can attempt to disbelieve your illusion.</p>\n<hr />\n<p><strong>Heightened (2nd)</strong> The spell's duration increases to 1 hour, and you can also change the tone, quality, and other aspects of your voice. Before a creature can attempt to disbelieve your illusion, it must actively attempt a Perception check or otherwise use actions to interact with the sound.</p>"},"rules":[],"slug":"ventriloquism","_migration":{"version":0.942,"lastMigration":null,"previous":{"schema":0.941,"foundry":"13.347","system":"7.3.1"}},"traits":{"otherTags":[],"value":["auditory","concentrate","illusion","manipulate"],"rarity":"common","traditions":["arcane","divine","occult","primal"]},"publication":{"title":"Pathfinder Player Core","authors":"","license":"ORC","remaster":true},"level":{"value":1},"requirements":"","target":{"value":""},"range":{"value":""},"area":null,"time":{"value":"2"},"duration":{"value":"10 minutes","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"pXTuFwEemiwl9kTY","heightenedLevel":1},"counteraction":false},"type":"spell","_stats":{"compendiumSource":"Compendium.sf2e.spells.Item.yV7Ouzaoe7DHLESI","duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"},"effects":[],"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_id":"BWBjvMFSe6KNTxX6"},{"folder":"D7UVaOiB40wTR6kv","img":"systems/pf2e/icons/spells/light.webp","name":"Light","system":{"description":{"gm":"","value":"<p>You create an orb of light that sheds bright light in a 20-foot radius (and dim light for the next 20 feet) in a color you choose. If you create the light in the same space as a willing creature, you can attach the light to the creature, causing it to float near that creature as it moves. You can Sustain the spell to move the light up to 60 feet; you can attach or detach it from a creature as part of this movement.</p>\n<p>You can Dismiss the spell. If you Cast the Spell while you already have four <em>light</em> spells active, you must choose one of the existing spells to end.</p>\n<p>@UUID[Compendium.sf2e.spell-effects.Item.cVVZXNbV0nElVOPZ]{Spell Effect: Light}</p>\n<hr />\n<p><strong>Heightened (4th)</strong> The orb sheds light in a 60-foot radius (and dim light for the next 60 feet).</p>"},"rules":[],"slug":"light","_migration":{"version":0.942,"lastMigration":null,"previous":{"schema":0.941,"foundry":"13.347","system":"7.3.1"}},"traits":{"otherTags":[],"value":["cantrip","concentrate","light","manipulate"],"rarity":"common","traditions":["arcane","divine","occult","primal"]},"publication":{"title":"Pathfinder Player Core","authors":"","license":"ORC","remaster":true},"level":{"value":1},"requirements":"","target":{"value":""},"range":{"value":"120 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"until your next daily preparations","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"pXTuFwEemiwl9kTY"},"counteraction":false},"type":"spell","_stats":{"compendiumSource":"Compendium.sf2e.spells.Item.WBmvzNDfpwka3qT4","duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"},"effects":[],"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_id":"PUANrm5F7aLbiODl"},{"folder":"D7UVaOiB40wTR6kv","img":"icons/magic/control/debuff-energy-hold-yellow.webp","name":"Stabilize","system":{"description":{"gm":"","value":"<p>Life energy shuts death's door. The target loses the @UUID[Compendium.sf2e.conditions.Item.yZRUzMqrMmfLu0V1]{Dying} condition, though it remains @UUID[Compendium.sf2e.conditions.Item.fBnFDH2MTzgFijKf]{Unconscious} at 0 Hit Points.</p>"},"rules":[],"slug":"stabilize","_migration":{"version":0.942,"lastMigration":null,"previous":{"schema":0.941,"foundry":"13.347","system":"7.3.1"}},"traits":{"otherTags":[],"value":["cantrip","concentrate","healing","manipulate","vitality"],"rarity":"common","traditions":["divine","primal"]},"publication":{"title":"Pathfinder Player Core","authors":"","license":"ORC","remaster":true},"level":{"value":1},"requirements":"","target":{"value":"1 dying creature"},"range":{"value":"30 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"pXTuFwEemiwl9kTY"},"counteraction":false},"type":"spell","_stats":{"compendiumSource":"Compendium.sf2e.spells.Item.SnjhtQYexDtNDdEg","duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"},"effects":[],"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_id":"LLSIJ5bfiuGA2N17"},{"type":"action","name":"Ominous Hoot","system":{"actionType":{"value":"action"},"description":{"value":"<p>The amutu lets loose a loud otherworldly hoot that terrifies their foes. Each creature in a @Template[type:emanation|distance:30] must attempt a @Check[will|dc:18] save. Regardless of the result, creatures are temporarily immune for 1 minute.</p><hr /><p><strong>Critical Success</strong> The creature is unaffected.</p><p><strong>Success</strong> The creature is @UUID[Compendium.sf2e.conditions.Item.TBSHQspnbcqxsmjL]{Frightened 1}.</p><p><strong>Failure</strong> The creature is @UUID[Compendium.sf2e.conditions.Item.TBSHQspnbcqxsmjL]{Frightened 2}.</p><p><strong>Critical Failure</strong> The creature is @UUID[Compendium.sf2e.conditions.Item.sDPxOjQ9kx2RZE8D]{Fleeing} for 1 round and @UUID[Compendium.sf2e.conditions.Item.TBSHQspnbcqxsmjL]{Frightened 3}.</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":["auditory","divine","emotion","fear","mental"]},"_migration":{"version":0.942,"previous":{"schema":0.941,"foundry":"13.347","system":"7.3.1"}},"actions":{"value":2},"category":"offensive","deathNote":false},"effects":[],"_id":"zupGkV4OYETpttTM","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}}],"effects":[],"sort":11900000,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource