d.Item.Tkd8sH4pwFIPzqTr","duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_id":"0dRwdMHMKGqgE3Yc"},{"type":"action","name":"Pursue Prey","system":{"actionType":{"value":"reaction"},"description":{"value":"<p><strong>Trigger</strong> An enemy within the terrordactyl's reach attempts to move away from the terrordactyl</p><hr /><p><strong>Effect</strong> The terrordactyl keeps pace with the retreating foe. The terrordactyl Flies up to its fly Speed, following the enemy and keeping it in reach throughout its movement until the enemy stops moving or the terrordactyl has moved its full fly Speed.</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":["move"]},"_migration":{"version":0.942,"previous":{"schema":null,"foundry":"13.347","system":"7.4.1"}},"actions":{"value":null},"category":"defensive","deathNote":false},"effects":[],"_id":"n5dIuJQFLv7ychgz","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"action","name":"Drop From Above","system":{"actionType":{"value":"action"},"description":{"value":"<p><strong>Requirements</strong> The terrordactyl is Hiding while hanging upside down from a surface that is at least 15 feet off the ground, such as a cave ceiling or a rocky cliff face</p><hr /><p><strong>Effect</strong> The terrordactyl swoops down, Flying up to twice its Speed and then it makes a jaws or talon Strike against a creature in its reach.</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":[]},"_migration":{"version":0.942,"previous":{"schema":null,"foundry":"13.347","system":"7.4.1"}},"actions":{"value":2},"category":"offensive","deathNote":false},"effects":[],"_id":"1VUaFsFQjzKKyJ9T","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"action","name":"Swooping Bite","system":{"actionType":{"value":"action"},"description":{"value":"<p>The terrordactyl Flies, making jaws Strikes against any number of creatures that are adjacent to its path. Its multiple attack penalty applies to these Strikes normally.</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":[]},"_migration":{"version":0.942,"previous":{"schema":null,"foundry":"13.347","system":"7.4.1"}},"actions":{"value":3},"category":"offensive","deathNote":false},"effects":[],"_id":"d7YLpfXf5YGZgF8W","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"action","name":"Blend with Shadows","system":{"actionType":{"value":"passive"},"description":{"value":"<p>Terrordactyls are particularly adept at Hiding in shadowy areas. They have the @UUID[Compendium.sf2e.conditions.Item.DmAIPqOBomZ7H95W]{Concealed} condition in dim light against creatures with low-light vision (but not creatures with darkvision), and in darkness against creatures with darkvision (but not creatures with greater darkvision).</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":[]},"_migration":{"version":0.942,"previous":{"schema":null,"foundry":"13.347","system":"7.4.1"}},"actions":{"value":null},"category":"offensive","deathNote":false},"effects":[],"_id":"qEmPxMWTN5kZ0y6W","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"action","name":"Terrifying Ambush","system":{"actionType":{"value":"passive"},"description":{"value":"<p>The sudden appearance of a terrordactyl terrifies its prey. When a terrordactyl hits a creature that is @UUID[Compendium.sf2e.conditions.Item.AJh5ex99aV6VTggg]{Off-Guard} against it with a Strike, that creature takes 1d6 additional precision damage and must succeed at a @Check[will|dc:24] save or become @UUID[Compendium.sf2e.conditions.Item.TBSHQspnbcqxsmjL]{Frightened 1} (@UUID[Compendium.sf2e.conditions.Item.TBSHQspnbcqxsmjL]{Frightened 2} on a critical failure).</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[{"category":"precision","diceNumber":1,"dieSize":"d6","key":"DamageDice","predicate":["target:condition:off-guard"],"selector":"strike-damage"},{"key":"RollOption","label":"PF2E.SpecificRule.TOTMToggle.OffGuard","option":"target:condition:off-guard","toggleable":"totm"}],"slug":null,"traits":{"otherTags":[],"value":[]},"_migration":{"version":0.942,"previous":{"schema":null,"foundry":"13.347","system":"7.4.1"}},"actions":{"value":null},"category":"offensive","deathNote":false},"effects":[],"_id":"zWPryIjA5riow3oE","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}}],"effects":[],"sort":1100000,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.351","systemId":"pf2e","systemVersion":"7.8.0"}}