portSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"},"effects":[],"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_id":"eM6EUnXJKQZ9aBbH"},{"type":"action","name":"Motion Sense","system":{"actionType":{"value":"passive"},"description":{"value":"<p>An interstitial sludge can sense nearby motion through vibration and air movement.</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":[]},"_migration":{"version":0.942,"previous":{"schema":null,"foundry":"13.347","system":"7.3.1"}},"actions":{"value":null},"category":"interaction","deathNote":false},"effects":[],"_id":"bNkXhit7MXzqd3gs","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"action","name":"Disrupt Teleportation","system":{"actionType":{"value":"reaction"},"description":{"value":"<p><strong>Trigger</strong> A creature within 120 feet of the interstitial sludge uses a teleportation effect</p><hr /><p><strong>Effect</strong> The interstitial sludge unravels the magic, pulling from the void between the planes. The interstitial sludge attempts a counteract check (counteract modifier [[/r 1d20+30 #Counteract]]{+30}), with the following additional effects.</p><hr /><p><strong>Critical Success</strong> The triggering action is disrupted, and the creature using it is instead teleported within reach of the interstitial sludge.</p><p><strong>Success</strong> The triggering action is disrupted, and the creature using it is instead teleported in a random square within 120 feet of the interstitial sludge but outside its reach, determined by the GM.</p><p><strong>Critical Failure</strong> A violent magical feedback shakes the interstitial sludge's essence, leaving @UUID[Compendium.sf2e.conditions.Item.AJh5ex99aV6VTggg]{Off-Guard} until the end of its next turn.</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":["occult","teleportation"]},"_migration":{"version":0.942,"previous":{"schema":null,"foundry":"13.347","system":"7.3.1"}},"actions":{"value":null},"category":"defensive","deathNote":false},"effects":[],"_id":"Tw2tU0NVba8ZExWZ","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"action","name":"Light Weakness","system":{"actionType":{"value":"passive"},"description":{"value":"<p>If an interstitial sludge is hit by an attack with the light trait or fails a saving throw against an effect with the light trait, it is @UUID[Compendium.sf2e.conditions.Item.fesd1n5eVhpCSS18]{Sickened 1} in addition to the normal effects (@UUID[Compendium.sf2e.conditions.Item.fesd1n5eVhpCSS18]{Sickened 2} on a critical hit or critical failure).</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":[]},"_migration":{"version":0.942,"previous":{"schema":null,"foundry":"13.347","system":"7.3.1"}},"actions":{"value":null},"category":"defensive","deathNote":false},"effects":[],"_id":"Mgsuwxe1t3o1WYIX","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"action","name":"Retreat to the In-Between","system":{"actionType":{"value":"passive"},"description":{"value":"<p><strong>Trigger</strong> The interstitial sludge is reduced to 0 Hit Points</p><hr /><p><strong>Effect</strong> Instead of dying, the interstitial sludge is banished back to the space between planes. It casts 4th-rank @UUID[Compendium.sf2e.spells.Item.LiGbewa9pO0yjbsY]{confusion} on all creatures within its reach. Creatures that critically fail their @Check[will|dc:38] save must roll a @Check[reflex|dc:38|traits:incapacitation,teleportation] save, on a failure, they are drawn into the space between planes; this is an incapacitation and teleportation effect.</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":["occult"]},"_migration":{"version":0.942,"previous":{"schema":null,"foundry":"13.347","system":"7.3.1"}},"actions":{"value":null},"category":"defensive","deathNote":false},"effects":[],"_id":"UtBIjeZPVoKrOBqm","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"img":"systems/pf2e/icons/actions/FreeAction.webp","name":"Improved Grab","system":{"actionType":{"value":"free"},"actions":{"value":null},"category":"offensive","description":{"value":"<p>@Localize[PF2E.NPC.Abilities.Glossary.ImprovedGrab]</p>","gm":""},"publication":{"license":"ORC","remaster":true,"title":"Pathfinder Monster Core","authors":""},"rules":[],"traits":{"value":[],"otherTags":[]},"slug":"improved-grab","_migration":{"version":0.942,"previous":null}},"type":"action","_stats":{"compendiumSource":"Compendium.sf2e.bestiary-ability-glossary-srd.Item.i18TlebMzwONyPhI","duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_id":"LwWg62me5T0tYeD3"},{"type":"action","name":"Steal Vision","system":{"actionType":{"value":"passive"},"description":{"value":"<p>A creature hit by a sludge ball Strike must succeed at a @Check[fortitude|dc:36] save or be @UUID[Compendium.sf2e.conditions.Item.XgEqL1kFApUbl5Z2]{Blinded} for 1 round. While the creature is blinded, the interstitial sludge can see using the creature's typical visual senses, but the interstitial sludge loses its immunity to visual effects.</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":["darkness","occult","visual"]},"_migration":{"version":0.942,"previous":{"schema":null,"foundry":"13.347","system":"7.3.1"}},"actions":{"value":null},"category":"offensive","deathNote":false},"effects":[],"_id":"v86bURy1C59WTLtC","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"img":"systems/pf2e/icons/actions/OneAction.webp","name":"Greater Constrict","system":{"actionType":{"value":"action"},"actions":{"value":1},"category":"offensive","description":{"value":"<p>@Damage[(0)[bludgeoning]], @Check[fortitude|dc:|basic]</p>\n<hr />\n<p>@Localize[PF2E.NPC.Abilities.Glossary.GreaterConstrict]</p>","gm":""},"publication":{"license":"ORC","remaster":true,"title":"Pathfinder Monster Core","authors":""},"rules":[],"traits":{"value":[],"otherTags":[]},"slug":"greater-constrict","_migration":{"version":0.942,"previous":null}},"type":"action","_stats":{"compendiumSource":"Compendium.sf2e.bestiary-ability-glossary-srd.Item.OmV6E3aELvq9CkK1","duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_id":"9n3Pm5D7smmTefKQ"},{"type":"melee","name":"Pseudopod","effects":[],"system":{"_migration":{"version":0.942,"previous":null},"description":{"value":"","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":["magical","reach-15","unarmed"]},"damageRolls":{"jB2tXFIVbqOa3iRZ":{"damage":"3d12+16","damageType":"bludgeoning","category":null},"wQ3ubYMVQYfXlYvJ":{"damage":"1d10","damageType":"cold","category":null}},"bonus":{"value":30},"attackEffects":{"value":["improved-grab"]}},"_id":"aq0YlG9XScoRijik","img":"systems/pf2e/icons/default-icons/melee.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"melee","name":"Sludge Ball","effects":[],"system":{"_migration":{"version":0.942,"previous":null},"description":{"value":"","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":["brutal","magical","range-120"]},"damageRolls":{"arFnNrj8PNbDqHWz":{"damage":"3d6+14","damageType":"bludgeoning","category":null},"1XhSaAYMixyUAZ5g":{"damage":"1d10","damageType":"cold","category":null}},"bonus":{"value":28},"attackEffects":{"value":["steal-vision"]}},"_id":"zMyh9PkplYLPQqal","img":"systems/pf2e/icons/default-icons/melee.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"action","name":"Spatial Hop","system":{"actionType":{"value":"action"},"description":{"value":"<p>The interstitial sludge gathers its body into a 15-foot square that includes at least one of its initial spaces. It then picks a square within 10 feet of that 15-foot square to move into, and then finally redistributes its body into 9 contiguous squares that include the chosen square.</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":["occult","teleportation"]},"_migration":{"version":0.942,"previous":{"schema":null,"foundry":"13.347","system":"7.3.1"}},"actions":{"value":1},"category":"offensive","deathNote":false},"effects":[],"_id":"7eLXevlDQs9xAIkg","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"action","name":"Tendril Explosion","system":{"actionType":{"value":"action"},"description":{"value":"<p>The interstitial sludge makes a pseudopod Strike against all creatures within its reach, as well as all other creatures within 30 feet; it takes a –2 penalty on the Strikes against creatures that aren't in its reach. These attacks count toward the interstitial sludge's multiple attack penalty, but the multiple attack penalty doesn't increase until after it makes all its attacks. For any attack that hits, the interstitial sludge can choose to teleport the creature struck in any square inside its reach.</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":["occult","teleportation"]},"_migration":{"version":0.942,"previous":{"schema":null,"foundry":"13.347","system":"7.3.1"}},"actions":{"value":3},"category":"offensive","deathNote":false},"effects":[],"_id":"6ITrpiQ09WxPyLTY","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}}],"effects":[],"sort":7200000,"ownership":{"defau