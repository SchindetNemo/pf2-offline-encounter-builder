0},"slot2":{"prepared":[],"value":0,"max":0},"slot3":{"prepared":[],"value":0,"max":0},"slot4":{"prepared":[],"value":0,"max":0},"slot5":{"prepared":[],"value":0,"max":0},"slot6":{"prepared":[],"value":0,"max":0},"slot7":{"prepared":[],"value":0,"max":0},"slot8":{"prepared":[],"value":0,"max":0},"slot9":{"prepared":[],"value":0,"max":0},"slot10":{"prepared":[],"value":0,"max":0},"slot11":{"prepared":[],"value":0,"max":0}},"autoHeightenLevel":{"value":null}},"_id":"pkm0x6Avfjd06DzM","img":"systems/pf2e/icons/default-icons/spellcastingEntry.svg","effects":[],"folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"folder":"T8AzYUgNIAgTJ9Iz","img":"icons/magic/life/cross-worn-green.webp","name":"Heal","system":{"description":{"gm":"","value":"<p>You channel vital energy to heal the living or damage the undead. If the target is a willing living creature, you restore 1d8 Hit Points. If the target is undead, you deal that amount of vitality damage to it, and it gets a basic Fortitude save. The number of actions you spend when Casting this Spell determines its targets, range, area, and other parameters.</p>\n<p><span class=\"action-glyph\">1</span> The spell has a range of touch.</p>\n<p><span class=\"action-glyph\">2</span> <strong>(concentrate)</strong> The spell has a range of 30 feet. If you're healing a living creature, increase the Hit Points restored by 8.</p>\n<p><span class=\"action-glyph\">3</span> <strong>(concentrate)</strong> You disperse vital energy in a @Template[emanation|distance:30]. This targets all living and undead creatures in the burst.</p>\n<hr />\n<p><strong>Heightened (+1)</strong> The amount of healing or damage increases by 1d8, and the extra healing for the 2-action version increases by 8.</p>"},"rules":[],"slug":"heal","_migration":{"version":0.942,"lastMigration":null,"previous":null},"traits":{"otherTags":[],"value":["healing","manipulate","vitality"],"rarity":"common","traditions":["divine","primal"]},"publication":{"title":"Pathfinder Player Core","authors":"","license":"ORC","remaster":true},"level":{"value":1},"requirements":"","target":{"value":"1 willing living creature or 1 undead"},"range":{"value":"varies"},"area":null,"time":{"value":"1 to 3"},"duration":{"value":"","sustained":false},"damage":{"0":{"applyMod":false,"category":null,"formula":"1d8","kinds":["damage","healing"],"materials":[],"type":"vitality"}},"defense":{"save":{"basic":true,"statistic":"fortitude"}},"cost":{"value":""},"location":{"value":"pkm0x6Avfjd06DzM","heightenedLevel":3},"counteraction":false,"heightening":{"damage":{"0":"1d8"},"interval":1,"type":"interval"},"overlays":{"37gy7l19tik74o4s":{"_id":"37gy7l19tik74o4s","name":"Heal (vs. Living)","overlayType":"override","sort":2,"system":{"damage":{"0":{"formula":"1d8+8","kinds":["healing"]}},"defense":null,"heightening":{"damage":{"0":"1d8+8"}},"range":{"value":"30 feet"},"time":{"value":"2"},"traits":{"value":["concentrate","healing","manipulate","vitality"]}}},"7qdtetowq348s9oc":{"_id":"7qdtetowq348s9oc","overlayType":"override","sort":1,"system":{"range":{"value":"touch"},"time":{"value":"1"}}},"7vbvdrv2cl87sqta":{"_id":"7vbvdrv2cl87sqta","overlayType":"override","sort":4,"system":{"area":{"type":"emanation","value":30},"range":{"value":""},"target":{"value":"all living and undead creatures"},"time":{"value":"3"},"traits":{"value":["concentrate","healing","manipulate","vitality"]}}},"lfxcoz2d3f8j2zq1":{"_id":"lfxcoz2d3f8j2zq1","name":"Heal (vs. Undead)","overlayType":"override","sort":3,"system":{"damage":{"0":{"kinds":["damage"]}},"range":{"value":"30 feet"},"target":{"value":"1 undead"},"time":{"value":"2"},"traits":{"value":["concentrate","healing","manipulate","vitality"]}}}}},"type":"spell","_stats":{"compendiumSource":"Compendium.sf2e.spells.Item.rfZpqmj0AIIdkVIs","duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"},"effects":[],"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_id":"3IroSFgoL84aqFsY"},{"folder":"4fJHnYFqH0VjZXPv","img":"systems/pf2e/icons/spells/searing-light.webp","name":"Holy Light","system":{"description":{"gm":"","value":"<p>You shine a blazing ray of light tinged with holy energy. Make a ranged spell attack. The ray deals 5d6 fire damage. If the target has the unholy trait, you deal an extra 5d6 spirit damage.</p><hr /><p><strong>Critical Success</strong> The target takes double damage.</p>\n<p><strong>Success</strong> The target takes full damage.</p>\n<p>If the light passes through an area of magical darkness or targets a creature affected by magical darkness, <em>holy light</em> attempts to counteract the darkness. If you need to determine whether the light passes through an area of darkness, draw a line between yourself and the spell's target.</p><hr /><p><strong>Heightened (+1)</strong> The fire damage increases by 2d6, and the spirit damage against unholy creatures increases by 2d6.</p>"},"rules":[{"damageType":"spirit","diceNumber":"(@spell.level*2)-1","dieSize":"d6","key":"DamageDice","predicate":["target:trait:unholy"],"selector":"{item|_id}-damage"}],"slug":"holy-light","_migration":{"version":0.942,"lastMigration":null,"previous":null},"traits":{"otherTags":[],"value":["attack","concentrate","fire","holy","light","manipulate"],"rarity":"common","traditions":["divine","primal"]},"publication":{"title":"Pathfinder Player Core","authors":"","license":"ORC","remaster":true},"level":{"value":3},"requirements":"","target":{"value":"1 creature"},"range":{"value":"120 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"","sustained":false},"damage":{"0":{"applyMod":false,"category":null,"formula":"5d6","kinds":["damage"],"materials":[],"type":"fire"}},"defense":null,"cost":{"value":""},"location":{"value":"pkm0x6Avfjd06DzM","heightenedLevel":3},"counteraction":true,"heightening":{"damage":{"0":"2d6"},"interval":1,"type":"interval"}},"type":"spell","_stats":{"compendiumSource":"Compendium.sf2e.spells.Item.DyiD239dNS7RIxZE","duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"},"effects":[],"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_id":"SYesH3LHrGnDqdu2"},{"folder":"lPzcDrjGDFbzuF2r","img":"systems/pf2e/icons/spells/glitterdust.webp","name":"Revealing Light (At Will)","system":{"description":{"gm":"","value":"<p>A wave of magical light washes over the area. You choose the appearance of the light, such as colorful, heatless flames or sparkling motes. A creature affected by <em>revealing light</em> is @UUID[Compendium.sf2e.conditions.Item.TkIyaNPgTZFBCCuh]{Dazzled}. If the creature was @UUID[Compendium.sf2e.conditions.Item.zJxUflt9np0q4yML]{Invisible}, it becomes @UUID[Compendium.sf2e.conditions.Item.DmAIPqOBomZ7H95W]{Concealed} instead. If the creature was already concealed for any other reason, it is no longer concealed.</p>\n<hr />\n<p><strong>Critical Success</strong> The target is unaffected.</p>\n<p><strong>Success</strong> The light affects the creature for 2 rounds.</p>\n<p><strong>Failure</strong> The light affects the creature for 1 minute.</p>\n<p><strong>Critical Failure</strong> The light affects the creature for 10 minutes.</p>"},"rules":[],"slug":"revealing-light","_migration":{"version":0.942,"lastMigration":null,"previous":null},"traits":{"otherTags":[],"value":["concentrate","light","manipulate"],"rarity":"common","traditions":["arcane","divine","occult","primal"]},"publication":{"title":"Pathfinder Player Core","authors":"","license":"ORC","remaster":true},"level":{"value":2},"requirements":"","target":{"value":""},"range":{"value":"120 feet"},"area":{"type":"burst","value":10},"time":{"value":"2"},"duration":{"value":"varies","sustained":false},"damage":{},"defense":{"save":{"basic":false,"statistic":"reflex"}},"cost":{"value":""},"location":{"value":"pkm0x6Avfjd06DzM","heightenedLevel":2},"counteraction":false},"type":"spell","_stats":{"compendiumSource":"Compendium.sf2e.spells.Item.0qaqksrGGDj74HXE","duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"},"effects":[],"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_id":"NpMACWip4EpV1fIc"},{"type":"action","name":"Living Flame","system":{"actionType":{"value":"passive"},"description":{"value":"<p>The vigil flame is a literal flame contained in a lantern, and so it sheds bright light in a 60-foot radius and dim light in the next 60 feet.</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[{"key":"TokenLight","value":{"dim":120,"bright":60,"animation":{"intensity":1,"speed":1},"color":"#6b9c3a","alpha":0.1,"luminosity":0.15}}],"slug":null,"traits":{"otherTags":[],"value":[]},"_migration":{"version":0.942,"previous":{"schema":null,"foundry":"13.347","system":"7.4.1"}},"actions":{"value":null},"category":"interaction","deathNote":false},"effects":[],"_id":"pCTFcLqwjMG7fbFM","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"action","name":"Manifest Empathy","system":{"actionType":{"value":"passive"},"description":{"value":"<p>The vigil flame can communicate on a rudimentary level with all intelligent creatures by moving their flame and changing their color. This communication is limited to basic concepts and emotions.</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":[]},"_migration":{"version":0.942,"previous":{"schema":null,"foundry":"13.347","system":"7.4.1"}},"actions":{"value":null},"category":"interaction","deathNote":false},"effects":[],"_id":"623ifpDJULSkXJ2g","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"action","name":"Snuff the Flames","system":{"actionType":{"value":"reaction"},"description":{"value":"<p><strong>Trigger</strong> The vigil flame is reduced to 0 Hit Points</p><hr /><p><strong>Effect</strong> In a last, bright flash, the vigil flame consumes themselves completely. All allies within 20 feet of the vigil flame regain @Damage[2d6[healing]] Hit Points, and all foes within 30 feet take 2d6 damage (@Check[reflex|dc:22|basic] save); this damage is @Damage[2d6[void]|options:area-damage] to living creatures or @Damage[2d6[vitality]|options:area-damage] to undead.</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":["divine","fire","vitality","void"]},"_migration":{"version":0.942,"previous":{"schema":null,"foundry":"13.347","system":"7.4.1"}},"actions":{"value":null},"category":"defensive","deathNote":false},"effects":[],"_id":"0mKnld5H3MiOdpHW","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"action","name":"Stoke the Flames","system":{"actionType":{"value":"action"},"description":{"value":"<p>The vigil flame's flame burns brighter and hotter, both aiding those in need and punishing their foes. Living allies within a @Template[type:burst|distance:20] gain a +1 status bonus to attack rolls, damage rolls, and saves against fear effects for 1 round. Living foes in the radius take @Damage[3d6[fire],3d6[void]|options:area-damage] damage, and undead foes in the radius take @Damage[3d6[fire],3d6[vitality]|options:area-damage] damage (@Check[reflex|dc:22|basic] save). The vigil flame can't use Stoke the Flames again for [[/gmr 1d4 #Recharge Stoke the Flames]]{1d4 rounds}.</p><p>@UUID[Compendium.battlezoo-bestiary-es-pf2e.sf2e-effects.Item.C7tO9DSBB7BPFuXJ]{Effect: Stoke the Flames}</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":["divine","fire","vitality","void"]},"_migration":{"version":0.942,"previous":{"schema":null,"foundry":"13.347","system":"7.4.1"}},"actions":{"value":2},"category":"offensive","deathNote":false},"effects":[],"_id":"hK4NlFyuLCc35MrI","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"action","name":"Shepherd's Touch","system":{"actionType":{"value":"passive"},"description":{"value":"<p>A vigil flame's Strikes always have the benefit of a <em>ghost touch</em> property rune, and they deal an additional 2d6 void damage to living creatures or an additional 2d6 vitality damage to undead.</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[{"diceNumber":3,"dieSize":"d6","key":"DamageDice","slug":"shepherds-touch","selector":"strike-damage","damageType":"void","predicate":[{"or":["target:mode:undead","target:mode:living"]}]},{"key":"DamageAlteration","mode":"override","predicate":["target:mode:undead","dice:slug:shepherds-touch"],"property":"damage-type","selectors":["strike-damage"],"value":"vitality"},{"key":"AdjustStrike","mode":"add","property":"property-runes","value":"ghost-touch"}],"slug":null,"traits":{"otherTags":[],"value":[]},"_migration":{"version":0.