ition":-1,"displayBars":0,"bar1":{"attribute":"attributes.hp"},"bar2":{"attribute":null},"light":{"negative":false,"priority":0,"alpha":0.5,"angle":360,"bright":0,"color":null,"coloration":1,"dim":0,"attenuation":0.5,"luminosity":0.5,"saturation":0,"contrast":0,"shadows":0,"animation":{"type":null,"speed":5,"intensity":5,"reverse":false},"darkness":{"min":0,"max":1}},"sight":{"enabled":false,"range":0,"angle":360,"visionMode":"basic","color":null,"attenuation":0.1,"brightness":0,"saturation":0,"contrast":0},"detectionModes":[],"occludable":{"radius":0},"ring":{"enabled":true,"colors":{"ring":null,"background":null},"effects":1,"subject":{"scale":2,"texture":"modules/battlezoo-bestiary-es-pf2e/assets/subjects/thananycti.webp"}},"flags":{"sf2e":{"linkToActorSize":true,"autoscale":false}},"randomImg":false,"turnMarker":{"mode":1,"animation":null,"src":null,"disposition":false},"movementAction":null},"items":[{"img":"systems/pf2e/icons/actions/Passive.webp","name":"Constant Spells","system":{"actionType":{"value":"passive"},"actions":{"value":null},"category":"interaction","description":{"value":"<p>@Localize[PF2E.NPC.Abilities.Glossary.ConstantSpells]</p>","gm":""},"publication":{"license":"ORC","remaster":true,"title":"Pathfinder Monster Core","authors":""},"rules":[],"traits":{"value":[],"otherTags":[]},"slug":"constant-spells","_migration":{"version":0.942,"previous":null}},"type":"action","_stats":{"compendiumSource":"Compendium.sf2e.bestiary-ability-glossary-srd.Item.kakyXBG5WA8c6Zfd","duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_id":"SvKXuSR2wdXAL53S"},{"name":"Occult Innate Spells","type":"spellcastingEntry","system":{"description":{"gm":"","value":""},"rules":[],"slug":null,"_migration":{"version":0.942,"lastMigration":null},"traits":{"otherTags":[]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"ability":{"value":"cha"},"spelldc":{"value":35,"dc":43},"tradition":{"value":"occult"},"prepared":{"value":"innate"},"showSlotlessLevels":{"value":false},"proficiency":{"value":1},"slots":{"slot0":{"prepared":[],"value":0,"max":0},"slot1":{"prepared":[],"value":0,"max":0},"slot2":{"prepared":[],"value":0,"max":0},"slot3":{"prepared":[],"value":0,"max":0},"slot4":{"prepared":[],"value":0,"max":0},"slot5":{"prepared":[],"value":0,"max":0},"slot6":{"prepared":[],"value":0,"max":0},"slot7":{"prepared":[],"value":0,"max":0},"slot8":{"prepared":[],"value":0,"max":0},"slot9":{"prepared":[],"value":0,"max":0},"slot10":{"prepared":[],"value":0,"max":0},"slot11":{"prepared":[],"value":0,"max":0}},"autoHeightenLevel":{"value":null}},"_id":"vwMI9ej2cuMIp5lR","img":"systems/pf2e/icons/default-icons/spellcastingEntry.svg","effects":[],"folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"spell","name":"Shred Soul","folder":"vbnVstNlTmD9B4BL","system":{"description":{"gm":"","value":"<p>You reach directly into a creature's spiritual essence and shred it to pieces, dealing 14d10 spirit damage as well as additional effects depending upon a Will save. If the spell reduces a creature to 0 Hit Points, it dies, and all attempts to resurrect the creature must overcome a counteract check against shred soul or automatically fail; this is a death effect, though the other effects of the spell don't have the death trait.</p><hr /><p><strong>Critical Success</strong> The creature is unaffected.</p><p><strong>Success</strong> The creature takes half damage and is @UUID[Compendium.sf2e.conditions.Item.MIRkyAjyBeXivMa7]{Enfeebled 2}, @UUID[Compendium.sf2e.conditions.Item.i3OJZU2nk64Df3xm]{Clumsy 2}, and @UUID[Compendium.sf2e.conditions.Item.e1XGnhKNSQIm5IXg]{Stupefied 2} for 1 round.</p><p><strong>Failure</strong> The creature takes full damage and is enfeebled 2, clumsy 2, and stupefied 2 for 1 minute.</p><p><strong>Critical Failure</strong> The creature takes double damage and is @UUID[Compendium.sf2e.conditions.Item.MIRkyAjyBeXivMa7]{Enfeebled 4}, @UUID[Compendium.sf2e.conditions.Item.i3OJZU2nk64Df3xm]{Clumsy 4}, and @UUID[Compendium.sf2e.conditions.Item.e1XGnhKNSQIm5IXg]{Stupefied 4} for 1 minute.</p><hr /><p><strong>Heightened (+1)</strong> The damage increases by 2d10.</p>"},"rules":[],"slug":null,"_migration":{"version":0.942,"lastMigration":null,"previous":{"schema":0.941,"foundry":"13.347","system":"7.3.1"}},"traits":{"otherTags":[],"value":["concentrate","manipulate","sanctified"],"rarity":"uncommon","traditions":["divine","occult"]},"publication":{"title":"Battlezoo Bestiary: Elemental Storm (Pathfinder)","authors":"","license":"ORC","remaster":true},"level":{"value":9},"requirements":"","target":{"value":"1 creature"},"range":{"value":"400 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"","sustained":false},"damage":{"aErAg2fVYBk6A0WG":{"formula":"14d10","kinds":["damage"],"type":"spirit","category":null,"materials":[],"applyMod":false}},"defense":{"save":{"statistic":"will","basic":false}},"cost":{"value":""},"location":{"value":"vwMI9ej2cuMIp5lR","heightenedLevel":9,"uses":{"max":2,"value":2}},"counteraction":false,"heightening":{"type":"interval","interval":1,"damage":{"aErAg2fVYBk6A0WG":"2d10"},"area":0}},"img":"icons/magic/unholy/strike-body-life-soul-purple.webp","effects":[],"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":"Compendium.battlezoo-bestiary-es-pf2e.sf2e-spells.Item.akmRatyjSwifB35c","duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"},"_id":"IUlNxwxmp4mJoqkf"},{"folder":"fi1AYNmuCRvoT15b","img":"systems/pf2e/icons/spells/fatal-aria.webp","name":"Wails of the Damned","system":{"description":{"gm":"","value":"<p>You howl a lament of damned souls. Each living enemy in the area takes 8d10 void damage and must attempt a Fortitude save.</p>\n<hr />\n<p><strong>Critical Success</strong> The creature is unaffected.</p>\n<p><strong>Success</strong> The creature takes full damage.</p>\n<p><strong>Failure</strong> The creature takes full damage and is @UUID[Compendium.sf2e.conditions.Item.4D2KBtexWXa6oUMR]{Drained} [[/r 1d4]].</p>\n<p><strong>Critical Failure</strong> The creature takes double damage and is @UUID[Compendium.sf2e.conditions.Item.4D2KBtexWXa6oUMR]{Drained 4}.</p>"},"rules":[],"slug":"wails-of-the-damned","_migration":{"version":0.942,"lastMigration":null,"previous":null},"traits":{"otherTags":[],"value":["auditory","concentrate","death","manipulate","void"],"rarity":"common","traditions":["divine","occult"]},"publication":{"title":"Pathfinder Player Core","authors":"","license":"ORC","remaster":true},"level":{"value":9},"requirements":"","target":{"value":""},"range":{"value":""},"area":{"type":"emanation","value":40},"time":{"value":"2"},"duration":{"value":"","sustained":false},"damage":{"0":{"applyMod":false,"category":null,"formula":"8d10","kinds":["damage"],"materials":[],"type":"void"}},"defense":{"save":{"basic":false,"statistic":"fortitude"}},"cost":{"value":""},"location":{"value":"vwMI9ej2cuMIp5lR","heightenedLevel":9,"uses":{"max":2,"value":2}},"counteraction":false},"type":"spell","_stats":{"compendiumSource":"Compendium.sf2e.spells.Item.FEsuyf203wTNE2et","duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"},"effects":[],"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_id":"W82qRjfaxjbvUIt9"},{"folder":"IfuYSF4ymX48CZnm","img":"systems/pf2e/icons/spells/disapperance.webp","name":"Disappearance","system":{"description":{"gm":"","value":"<p>You shroud a creature from others' senses. The target becomes @UUID[Compendium.sf2e.conditions.Item.VRSef5y1LmL2Hkjf]{Undetected}, not just to sight but to all senses, allowing the target to count as @UUID[Compendium.sf2e.conditions.Item.zJxUflt9np0q4yML]{Invisible} no matter what precise and imprecise senses an observer might have. It's still possible for a creature to find the target by Seeking, looking for disturbed dust, hearing gaps in the sound spectrum, or finding some other way to discover the presence of an otherwise-undetectable creature.</p>"},"rules":[],"slug":"disappearance","_migration":{"version":0.942,"lastMigration":null,"previous":null},"traits":{"otherTags":[],"value":["illusion","manipulate","subtle"],"rarity":"common","traditions":["arcane","occult"]},"publication":{"title":"Pathfinder Player Core","authors":"","license":"ORC","remaster":true},"level":{"value":8},"requirements":"","target":{"value":"1 creature"},"range":{"value":"touch"},"area":null,"time":{"value":"2"},"duration":{"value":"10 minutes","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"vwMI9ej2cuMIp5lR","heightenedLevel":8},"counteraction":false},"type":"spell","_stats":{"compendiumSource":"Compendium.sf2e.spells.Item.wfleiawxsfhpRRwf","duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"},"effects":[],"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_id":"9GfHPajp8O2kbU0f"},{"type":"spell","name":"Dissonance","folder":"pcjidaJ7lvxI8BEP","system":{"description":{"gm":"","value":"<p>You induce deafening and nauseating vibrations throughout the bodies of all creatures in the area, dealing 5d10 sonic damage with a Fortitude save.</p><hr /><p><strong>Critical Success</strong> The creature is unaffected.</p><p><strong>Success</strong> The creature takes half damage and is @UUID[Compendium.sf2e.conditions.Item.9PR9y0bi4JPKnHPR]{Deafened} for [[/gmr 1d4 #rounds]]{1d4 rounds}.</p><p><strong>Failure</strong> The creature takes full damage, is @UUID[Compendium.sf2e.conditions.Item.fesd1n5eVhpCSS18]{Sickened 1}, and is deafened for 1 minute.</p><p><strong>Critical Failure</strong> The creature takes double damage, is @UUID[Compendium.sf2e.conditions.Item.fesd1n5eVhpCSS18]{Sickened 3}, and is deafened for 1 hour.</p><hr /><p><strong>Heightened (+1)</strong> The damage increases by 1d10.</p>"},"rules":[],"slug":null,"_migration":{"version":0.942,"lastMigration":null,"previous":{"schema":0.941,"foundry":"13.347","system":"7.3.1"}},"traits":{"otherTags":[],"value":["concentrate","manipulate"],"rarity":"uncommon","traditions":["arcane","occult"]},"publication":{"title":"Battlezoo Bestiary: Elemental Storm (Pathfinder)","authors":"","license":"ORC","remaster":true},"level":{"value":5},"requirements":"","target":{"value":""},"range":{"value":"200 feet"},"area":{"value":20,"type":"burst"},"time":{"value":"2"},"duration":{"value":"","sustained":false},"damage":{"cmZrdRqRiH1Hg3Mb":{"formula":"5d10","kinds":["damage"],"type":"sonic","category":null,"materials":[],"applyMod":false}},"defense":{"save":{"statistic":"fortitude","basic":false}},"cost":{"value":""},"location":{"value":"vwMI9ej2cuMIp5lR","heightenedLevel":8,"uses":{"max":3,"value":3}},"counteraction":false,"heightening":{"type":"interval","interval":1,"damage":{"cmZrdRqRiH1Hg3Mb":"1d10"},"area":0}},"img":"icons/magic/sonic/projectile-sound-rings-wave.webp","effects":[],"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":"Compendium.battlezoo-bestiary-es-pf2e.sf2e-spells.Item.M2uQp36xa8fzsyAZ","duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"},"_id":"Hr2UjFcUPN3AIAmF"},{"folder":"iDjm2cXyRAe4VZ35","img":"icons/creatures/slimes/slime-face-teeth-purple.webp","name":"Wave of Despair (At Will)","system":{"description":{"gm":"","value":"<p>You inflict despair on creatures in the area. The effects for each creature are determined by its Will save.</p>\n<hr />\n<p><strong>Critical Success</strong> The creature is unaffected.</p>\n<p><strong>Success</strong> For 1 round, the creature can't use reactions and must attempt another save at the start of its turn; on a failure, it is @UUID[Compendium.sf2e.conditions.Item.xYTAsEpcJE1Ccni3]{Slowed 1} for that turn as it sobs uncontrollably.</p>\n<p><strong>Failure</strong> As success, but the duration is 1 minute.</p>\n<p><strong>Critical Failure</strong> As failure, and the creature is automatically slowed 1 for 1 minute.</p>\n<hr />\n<p><strong>Heightened (7th)</strong> The area increases to a 60-foot cone.</p>"},"rules":[],"slug":"wave-of-despair","_migration":{"version":0.942,"lastMigration":null,"previous":null},"traits":{"otherTags":[],"value":["concentrate","emotion","manipulate","mental"],"rarity":"common","traditions":["arcane","occult"]},"publication":{"title":"Pathfinder Player Core","authors":"","license":"ORC","remaster":true},"level":{"value":5},"requirements":"","target":{"value":""},"range":{"value":""},"area":{"type":"cone","value":30},"time":{"value":"2"},"duration":{"value":"1 or more rounds","sustained":false},"damage":{},"defense":{"save":{"basic":false,"statistic":"will"}},"cost":{"value":""},"location":{"value":"vwMI9ej2cuMIp5lR","heightenedLevel":7},"counteraction":false,"heightening":{"levels":{"7":{"area":{"type":"cone","value":60}}},"type":"fixed"}},"type":"spell","_stats":{"compendiumSource":"Compendium.sf2e.spells.Item.GaRQlC9Yw1BGKHfN","duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"},"effects":[],"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_id":"IW7SECCeWSRfvgJI"},{"folder":"D7UVaOiB40wTR6kv","img":"systems/pf2e/icons/spells/ghost-sound.webp","name":"Figment","system":{"description":{"gm":"","value":"<p>You create a simple illusory sound or vision. A sound adds the auditory trait to the spell and the sound can't include intelligible words or elaborate music. A vision adds the visual trait, can be no larger than a 5-foot cube, and is clearly crude and undetailed if viewed from within 15 feet. When you Cast or Sustain the Spell, you can attempt to @UUID[Compendium.sf2e.actions.Item.GkmbTGfg8KcgynOA]{Create a Diversion} with the illusion, gaining a +2 circumstance bonus to your Deception check. If the attempt fails against a creature, that creature disbelieves the <em>figment</em>.</p>\n<p>@UUID[Compendium.sf2e.spell-effects.Item.2Hg3a06gZCSnUgSA]{Spell Effect: Figment}</p>"},"rules":[],"slug":"figment","_migration":{"version":0.942,"lastMigration":null,"previous":null},"traits":{"otherTags":[],"value":["cantrip","concentrate","illusion","manipulate","subtle"],"rarity":"common","traditions":["arcane","occult"]},"publication":{"title":"Pathfinder Player Core","authors":"","license":"ORC","remaster":true},"level":{"value":1},"requirements":"","target":{"value":""},"range":{"value":"30 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"","sustained":true},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"vwMI9ej2cuMIp5lR"},"counteraction":false},"type":"spell","_stats":{"compendiumSource":"Compendium.sf2e.spells.Item.0zU8CPejjQFnhZFI","duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"},"effects":[],"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_id":"Ox6EcDdygFgHJ3iw"},{"folder":"zDlxATrLAlbYA2Mv","img":"systems/pf2e/icons/spells/true-seeing.webp","name":"Truesight (Constant)","system":{"description":{"gm":"","value":"<p>You see things within 60 feet as they actually are. The GM rolls a secret counteract check against any illusion, morph or polymorph effect in the area, but only for the purpose of determining whether you see through it (for instance, if the check succeeds against a polymorph spell, you can see the creature's true form, but you don't end the polymorph spell).</p>"},"rules":[],"slug":"truesight","_migration":{"version":0.942,"lastMigration":null,"previous":null},"traits":{"otherTags":[],"value":["concentrate","manipulate","revelation"],"rarity":"common","traditions":["arcane","divine","occult","primal"]},"publication":{"title":"Pathfinder Player Core","authors":"","license":"ORC","remaster":true},"level":{"value":6},"requirements":"","target":{"value":""},"range":{"value":""},"area":null,"time":{"value":"2"},"duration":{"value":"10 minutes","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"vwMI9ej2cuMIp5lR","heightenedLevel":9},"counteraction":true},"type":"spell","_stats":{"compendiumSource":"Compendium.sf2e.spells.Item.uqlxMQQeSGWEVjki","duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"},"effects":[],"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_id":"vDNZzJIKznio8t5w"},{"name":"Soul Feather","type":"equipment","effects":[],"system":{"description":{"gm":"","value":""},"rules":[],"slug":null,"_migration":{"version":0.942,"lastMigration":null},"traits":{"otherTags":[],"value":[],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"level":{"value":0},"quantity":10,"baseItem":null,"bulk":{"value":0.1},"hp":{"value":0,"max":0},"hardness":0,"price":{"value":{}},"equipped":{"carryType":"worn","invested":null},"containerId":null,"size":"med","material":{"type":null,"grade":null},"identification":{"status":"identified","unidentified":{"name":"Unusual Object","img":"systems/pf2e/icons/unidentified_item_icons/adventuring_gear.webp","data":{"description":{"value":""}}},"misidentified":{}},"usage":{"value":"other"},"subitems":[]},"_id":"kabQ7FWHrd2C9wzN","img":"icons/commodities/materials/feather-blue-green.webp","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"action","name":"False Guide","system":{"actionType":{"value":"passive"},"description":{"value":"<p>The thananycti's magic repels efforts to pierce their disguise. They automatically attempt a counteract check (counteract modifier [[/r 1d20+35 #Counteract]]{+35}) against effects or abilities that would determine their traits. On a success, the effect seems to work but falsely claims that they are a monitor without the unholy trait.</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":["occult"]},"_migration":{"version":0.942,"previous":{"schema":null,"foundry":"13.347","system":"7.4.1"}},"actions":{"value":null},"category":"defensive","deathNote":false},"effects":[],"_id":"K525mc1Y75o2IZla","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"action","name":"Take Under Wing","system":{"actionType":{"value":"action"},"description":{"value":"<p><strong>Requirements</strong> At least one of the thananycti's soul feathers doesn't contain a soul</p><hr /><p><strong>Effect</strong> The thananycti traps the soul of a creature of up to 18th level in an empty soul feather on one of their wings. This functions as seize soul, using a feather in place of a valuable item, except the target must be either a creature who died within the last minute while drained from Sorrowful Melody or an incorporeal undead that is drained from Sorrowful Melody. When a living creature's soul trapped, its body swiftly turns to dust. The feathers generally can't be destroyed while attached to a living thananycti, but an adjacent creature can pluck a soul feather by spending two actions and succeeding on a @Check[thievery|dc:40] check.</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":["concentrate","occult","unholy"]},"_migration":{"version":0.942,"previous":{"schema":null,"foundry":"13.347","system":"7.4.1"}},"actions":{"value":1},"category":"offensive","deathNote":false},"effects":[],"_id":"OzU1tnW6WvJRkyuk","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"action","name":"Spirit Touch","system":{"actionType":{"value":"passive"},"description":{"value":"<p>A thananycti's Strikes have the benefit of a <em>ghost touch</em> property rune and deal an additional 3d6 void damage to living creatures or 3d6 vitality damage to undead.</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[{"diceNumber":3,"dieSize":"d6","key":"DamageDice","slug":"spirit-touch","selector":"strike-damage","damageType":"void","predicate":[{"or":["target:mode:undead","target:mode:living"]}]},{"key":"DamageAlteration","mode":"override","predicate":["target:mode:undead","dice:slug:spirit-touch"],"property":"damage-type","selectors":["strike-damage"],"value":"vitality"},{"key":"AdjustStrike","mode":"add","property":"property-runes","value":"ghost-touch"}],"slug":null,"traits":{"otherTags":[],"value":[]},"_migration":{"version":0.942,"previous":{"schema":null,"foundry":"13.347","system":"7.4.1"}},"actions":{"value":null},"category":"offensive","deathNote":false},"effects":[],"_id":"uYEdq6nCNBq6F36c","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"action","name":"Sorrowful Melody","system":{"actionType":{"value":"action"},"description":{"value":"<p>The thananycti sings an eerie song. Each living or undead creature within a @Template[type:emanation|distance:60] must attempt a @Check[will|dc:38] save. Despite being a mental effect, this ability affects mindless undead.</p><hr /><p><strong>Critical Success</strong> The creature is temporarily immune to Sorrowful Melody for 24 hours.</p><p><strong>Success</strong> The creature is @UUID[Compendium.sf2e.conditions.Item.e1XGnhKNSQIm5IXg]{Stupefied 1} for one round.</p><p><strong>Failure</strong> The creature is stupefied 1 for one minute and @UUID[Compendium.sf2e.conditions.Item.4D2KBtexWXa6oUMR]{Drained 1}. If the target was already drained, the value of the condition increases by 1 (to a maximum of @UUID[Compendium.sf2e.conditions.Item.4D2KBtexWXa6oUMR]{Drained 4}). Additionally, the creature is entranced by the thananycti and must spend the first action on its next turn to move closer to the thananycti as expediently as possible while avoiding obvious dangers. If it is already adjacent to the thananycti, it instead spends its first action standing still.</p><p><strong>Critical Failure</strong> As failure, but the creature must spend all of its actions on its next turn to move toward the thananycti, standing still once it is adjacent.</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":["auditory","concentrate","incapacitation","mental","occult"]},"_migration":{"version":0.942,"previous":{"schema":null,"foundry":"13.347","system":"7.4.1"}},"actions":{"value":1},"category":"offensive","deathNote":false},"effects":[],"_id":"5yuUlOWOONcNfXxy","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"action","name":"Devour Soul","system":{"actionType":{"value":"action"},"description":{"value":"<p><strong>Requirements</strong> A soul has been trapped in a soul feather for 24 hours</p><hr /><p><strong>Effect</strong> The thananycti consumes the soul. The soul is utterly destroyed, and the thananycti regains HP equal to three times the creature's level.</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":["occult","void"]},"_migration":{"version":0.942,"previous":{"schema":null,"foundry":"13.347","system":"7.4.1"}},"actions":{"value":1},"category":"offensive","deathNote":false},"effects":[],"_id":"qJXsxaZfu0MWzRmg","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"melee","name":"Talons","effects":[],"system":{"_migration":{"version":0.942,"previous":null},"description":{"value":"","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":["agile","magical","unarmed"]},"damageRolls":{"1QTK7gFsI7h0SuuN":{"damage":"2d12+14","damageType":"slashing","category":null}},"bonus":{"value":36},"attackEffects":{"value":["spirit-touch"]}},"_id":"0oYL34otBy3ORTWQ","img":"systems/pf2e/icons/default-icons/melee.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"melee","name":"Jaws","effects":[],"system":{"_migration":{"version":0.942,"previous":null},"description":{"value":"","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":["magical","unarmed"]},"damageRolls":{"t2yh8Zzaz2FJrVsn"