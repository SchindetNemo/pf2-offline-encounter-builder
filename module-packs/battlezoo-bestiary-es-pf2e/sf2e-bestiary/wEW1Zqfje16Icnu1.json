 feet (10 feet on a critical failure).</p>\n<hr />\n<p><strong>Heightened (+1)</strong> The damage increases by 2d6.</p>"},"rules":[],"slug":"hydraulic-torrent","_migration":{"version":0.942,"lastMigration":null,"previous":{"schema":0.941,"foundry":"13.347","system":"7.3.1"}},"traits":{"otherTags":[],"value":["concentrate","manipulate","water"],"rarity":"common","traditions":["primal"]},"publication":{"title":"Pathfinder Player Core","authors":"","license":"ORC","remaster":true},"level":{"value":4},"requirements":"","target":{"value":""},"range":{"value":""},"area":{"type":"line","value":60},"time":{"value":"2"},"duration":{"value":"","sustained":false},"damage":{"0":{"applyMod":false,"category":null,"formula":"8d6","kinds":["damage"],"materials":[],"type":"bludgeoning"}},"defense":{"save":{"basic":true,"statistic":"fortitude"}},"cost":{"value":""},"location":{"value":"Otx50PIBd9Cg6YOr","heightenedLevel":4,"uses":{"max":2,"value":2}},"counteraction":false,"heightening":{"area":0,"damage":{"0":"2d6"},"interval":1,"type":"interval"}},"type":"spell","_stats":{"compendiumSource":"Compendium.sf2e.spells.Item.Y3G6Y6EDgCY0s3fq","duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"},"effects":[],"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_id":"lgVisCpEZsRqxqZS"},{"folder":"lPzcDrjGDFbzuF2r","img":"icons/magic/water/wave-water-blue.webp","name":"Water Walk","system":{"description":{"gm":"","value":"<p>The target can walk on the surface of water and other liquids without falling through. It can go underwater if it wishes, but in that case it must Swim normally. This spell doesn't grant the ability to breathe underwater.</p>\n<hr />\n<p><strong>Heightened (4th)</strong> The spell's range increases to 30 feet, the duration increases to 1 hour, and you can target up to 10 creatures.</p>"},"rules":[],"slug":"water-walk","_migration":{"version":0.942,"lastMigration":null,"previous":{"schema":0.941,"foundry":"13.347","system":"7.3.1"}},"traits":{"otherTags":[],"value":["concentrate","manipulate","water"],"rarity":"common","traditions":["arcane","divine","primal"]},"publication":{"title":"Pathfinder Player Core","authors":"","license":"ORC","remaster":true},"level":{"value":2},"requirements":"","target":{"value":"1 creature"},"range":{"value":"touch"},"area":null,"time":{"value":"2"},"duration":{"value":"10 minutes","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"Otx50PIBd9Cg6YOr","heightenedLevel":4},"counteraction":false,"heightening":{"levels":{"4":{"range":{"value":"30 feet"},"target":{"value":"10 creatures"}}},"type":"fixed"}},"type":"spell","_stats":{"compendiumSource":"Compendium.sf2e.spells.Item.Seaah9amXg70RKw2","duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"},"effects":[],"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_id":"wdkVPcQLcgfrAaVk"},{"folder":"4fJHnYFqH0VjZXPv","img":"icons/skills/trades/music-singing-voice-blue.webp","name":"Dream Message","system":{"description":{"gm":"","value":"<p>You send a message to your target's dream. The message is one-way, up to 1 minute of speech (roughly 150 words). If the target is asleep, they receive the message instantly. If not, they receive it the next time they sleep. As soon as they receive it, the spell ends, and you know the message was sent.</p>\n<hr />\n<p><strong>Heightened (4th)</strong> You can target up to 10 creatures you know by name and have met in person. You must send the same message to all of them; the spell ends for each creature individually</p>"},"rules":[],"slug":"dream-message","_migration":{"version":0.942,"lastMigration":null,"previous":{"schema":0.941,"foundry":"13.347","system":"7.3.1"}},"traits":{"otherTags":[],"value":["concentrate","manipulate","mental"],"rarity":"common","traditions":["arcane","divine","occult"]},"publication":{"title":"Pathfinder Player Core","authors":"","license":"ORC","remaster":true},"level":{"value":3},"requirements":"","target":{"value":"1 creature you know by name and have met in person"},"range":{"value":"planetary"},"area":null,"time":{"value":"10 minutes"},"duration":{"value":"until your next daily preparations","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"Otx50PIBd9Cg6YOr","heightenedLevel":3},"counteraction":false,"heightening":{"levels":{"4":{"target":{"value":"10 creatures you know by name and have met in person"}}},"type":"fixed"}},"type":"spell","_stats":{"compendiumSource":"Compendium.pf2e-anachronism.spells.Item.yM3KTTSAIHhyuP14","duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"},"effects":[],"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_id":"hnO5yVcFsPb1nOu7"},{"type":"action","name":"Drown In Thought","system":{"actionType":{"value":"action"},"description":{"value":"<p>The astral flotsam sends a thoughtform to overwhelm all creatures in a @Template[type:cone|distance:30] with an onslaught of their thoughts. All creatures in the area take @Damage[6d6[mental]|options:area-damage] damage (@Check[will|dc:25] save). The astral flotsam can't use Drown in Thought again for [[/gmr 1d4 #Recharge Drown in Thought]]{1d4 rounds}.</p><hr /><p><strong>Critical Success</strong> The creature is unaffected.</p><p><strong>Success</strong> The creature takes half damage and is @UUID[Compendium.sf2e.conditions.Item.AJh5ex99aV6VTggg]{Off-Guard} until the end of its next turn.</p><p><strong>Failure</strong> The creature takes full damage and is off-guard for 1 minute. The target can attempt a new @Check[will|dc:25] save at the end of each of its turns to end this condition early.</p><p><strong>Critical Failure</strong> As failure, but the creature takes double damage.</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"o