f2e","systemVersion":"7.4.2"}},{"type":"action","name":"Electrical Discharge","system":{"actionType":{"value":"reaction"},"description":{"value":"<p><strong>Trigger</strong> A creature touches the boltspiker or Strikes them with a metal weapon in melee</p><hr /><p><strong>Effect</strong> Electricity surges into the triggering creature, dealing @Damage[2d12[electricity]] damage (@Check[reflex|dc:22|basic] save).</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":["electricity","primal"]},"_migration":{"version":0.942,"previous":{"schema":0.941,"foundry":"13.347","system":"7.3.1"}},"actions":{"value":null},"category":"defensive","deathNote":false},"effects":[],"_id":"polzaazIuoLpF40q","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"melee","name":"Lightning Whip","effects":[],"system":{"_migration":{"version":0.942,"previous":null},"description":{"value":"","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":["disarm","electricity","finesse","trip"]},"damageRolls":{"zK6S8lbOS0cWUHQj":{"damage":"2d12+4","damageType":"electricity","category":null}},"bonus":{"value":18},"attackEffects":{"value":[]}},"_id":"rDtmVAgc423YtGrT","img":"systems/pf2e/icons/default-icons/melee.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"melee","name":"Crystal Lance","effects":[],"system":{"_migration":{"version":0.942,"previous":null},"description":{"value":"","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":["range-increment-40"]},"damageRolls":{"pf4FoEved9KvUwkM":{"damage":"2d6","damageType":"piercing","category":null}},"bonus":{"value":18},"attackEffects":{"value":["boltspike"]}},"_id":"swujq3JJ9bVe3eh7","img":"systems/pf2e/icons/default-icons/melee.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"action","name":"Boltspike","system":{"actionType":{"value":"passive"},"description":{"value":"<p>When a boltspiker hits a creature with a crystal lance Strike, they attempt to stake them to the ground. The target must attempt a @Check[fortitude|dc:22] save. A creature that fails a check to Escape from the spike takes @Damage[1d6[electricity]] damage.</p><hr /><p><strong>Critical Success</strong> The target is unaffected.</p><p><strong>Success</strong> The target takes @Damage[1d6[electricity]] damage.</p><p><strong>Failure</strong> The target takes @Damage[1d6[persistent,electricity]] damage and takes a –10 foot status penalty to their Speeds until they [[/act escape dc=22]].</p><p><strong>Critical Failure</strong> The target takes @Damage[1d6[persistent,electricity]] damage and becomes @UUID[Compendium.sf2e.conditions.Item.eIcWbB5o3pP6OIMe]{Immobilized} until they [[/act escape dc=22]].</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":["electricity","primal"]},"_migration":{"version":0.942,"previous":{"schema":null,"foundry":"13.347","system":"7.3.1"}},"actions":{"value":null},"category":"offensive","deathNote":false},"effects":[],"_id":"DSHbsTEmrGmjHJAg","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"action","name":"Glide Charge","system":{"actionType":{"value":"action"},"description":{"value":"<p>The boltspiker's crystals gather power as they move through earthen material. The boltspiker Burrows at least 10 feet and then attempts a lightning whip Strike. If the Strike hits, it deals an additional 1d12 electricity damage.</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[{"key":"RollOption","option":"glide-charge","toggleable":true},{"diceNumber":1,"dieSize":"d12","key":"DamageDice","selector":"strike-damage","damageType":"electricity","predicate":["glide-charge"]}],"slug":null,"traits":{"otherTags":[],"value":[]},"_migration":{"version":0.942,"previous":{"schema":null,"foundry":"13.347","system":"7.3.1"}},"actions":{"value":2},"category":"offensive","deathNote":false},"effects":[],"_id":"MhP1Jt74fkPdcftL","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"action","name":"Ride the Lightning","system":{"actionType":{"value":"action"},"description":{"value":"<p>The boltspiker generates and then rides a powerful electric current. They move up to 150 feet in a straight line through the air without triggering reactions. If they are above the ground at the end of this movement, they fall safely to the ground at the end of their turn.</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":["move","primal"]},"_migration":{"version":0.942,"previous":{"schema":null,"foundry":"13.347","system":"7.3.1"}},"actions":{"value":1},"category":"offensive","deathNote":false},"ef