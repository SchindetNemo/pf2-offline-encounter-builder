.942,"previous":{"schema":0.941,"foundry":"13.347","system":"7.3.1"}},"attackEffects":{"value":["venom-touch"]}},"flags":{"sf2e":{"linkedWeapon":"pgEl3mrP4hnwdqtx"}},"img":"systems/pf2e/icons/default-icons/melee.svg","effects":[],"folder":null,"sort":100000,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"action","name":"Toxin Manipulation","system":{"actionType":{"value":"passive"},"description":{"value":"<p>20 feet. An agiyeft can alter the toxins in a creatures body, even turning them into neurotoxins. When any creature in the aura attempts a save against a disease or poison the agiyeft may grant a +1 status bonus or –1 status penalty to the save, and can choose to change it into a Will save instead of a Fortitude save.</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[{"key":"Aura","radius":20,"traits":["primal"],"effects":[{"uuid":"Compendium.battlezoo-bestiary-es-pf2e.sf2e-effects.Item.GvSf8oVI8GMulvY4","includesSelf":false}]}],"slug":null,"traits":{"otherTags":[],"value":["aura","primal"]},"_migration":{"version":0.942,"previous":{"schema":0.941,"foundry":"13.347","system":"7.3.1"}},"actions":{"value":null},"category":"defensive","deathNote":false},"effects":[],"_id":"jFEb6MumNEtR5zgB","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"action","name":"Hemodermal Spray","system":{"actionType":{"value":"reaction"},"description":{"value":"<p><strong>Trigger</strong> The agiyeft takes piercing or slashing damage.</p><hr /><p><strong>Effect</strong> The agiyeft flings medicinal toxins in their blood at a creature within 20 feet, either healing it @Damage[5d6[healing]] Hit Points, or dealing @Damage[5d6[poison]] damage (@Check[fortitude|dc:37|basic] save). The agiyeft chooses which.</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":["healing","poison"]},"_migration":{"version":0.942,"previous":{"schema":0.941,"foundry":"13.347","system":"7.3.1"}},"actions":{"value":null},"category":"defensive","deathNote":false},"effects":[],"_id":"C1cBMYxHQOARPzCv","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"action","name":"Venom Touch","system":{"actionType":{"value":"passive"},"description":{"value":"<p>hen an agiyeft deals piercing or slashing damage with a Strike they may expose the creature to Agiyeft's Meddling, Agiyeft's Whim, or any other poison they have on them. Any poison applied to a Strike this way gains the Injury trait, and has a @Check[fortitude|dc:37] or the poison's listed DC, which ever is higher. If the target is already suffering from a poison they take @Damage[1d6[poison]] damage instead.</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":[]},"_migration":{"version":0.942,"previous":{"schema":0.941,"foundry":"13.347","system":"7.3.1"}},"actions":{"value":null},"category":"offensive","deathNote":false},"effects":[],"_id":"8xYlcwAZvxCtRMmS","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"melee","name":"Claw","effects":[],"system":{"_migration":{"version":0.942,"previous":{"schema":0.941,"foundry":"13.347","system":"7.3.1"}},"description":{"value":"","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":["agile","finesse","versatile-p"]},"damageRolls":{"x22bSW8ZUyWbakiH":{"damage":"3d6+12","damageType":"slashing","category":null}},"bonus":{"value":30},"attackEffects":{"value":["venom-touch"]}},"_id":"0TuSdSk0JPPgkCLp","img":"systems/pf2e/icons/default-icons/melee.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"action","name":"Agiyeft's Meddling","system":{"actionType":{"value":"passive"},"description":{"value":"<p><strong>Saving Throw</strong> @Check[fortitude|dc:37]</p><p><strong>Maximum Duration</strong> 6 rounds</p><p><strong>Stage 1</strong> fast healing 1, @UUID[Compendium.sf2e.conditions.Item.i3OJZU2nk64Df3xm]{Clumsy 1}, @UUID[Compendium.sf2e.conditions.Item.MIRkyAjyBeXivMa7]{Enfeebled 1}, and @UUID[Compendium.sf2e.conditions.Item.e1XGnhKNSQIm5IXg]{Stupefied 1} (1 round)</p><p><strong>Stage 2</strong> fast healing 3, @UUID[Compendium.sf2e.conditions.Item.i3OJZU2nk64Df3xm]{Clumsy 2}, @UUID[Compendium.sf2e.conditions.Item.MIRkyAjyBeXivMa7]{Enfeebled 2}, and @UUID[Compendium.sf2e.conditions.Item.e1XGnhKNSQIm5IXg]{Stupefied 2} (1 round)</p><p><strong>Stage 3</strong> fast healing 5, @UUID[Compendium.sf2e.conditions.Item.i3OJZU2nk64Df3xm]{Clumsy 3}, @UUID[Compendium.sf2e.conditions.Item.MIRkyAjyBeXivMa7]{Enfeebled 3}, and @UUID[Compendium.sf2e.conditions.Item.e1XGnhKNSQIm5IXg]{Stupefied 3} (1 round)</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":["healing","poison","virulent"]},"_migration":{"version":0.942,"previous":{"schema":0.941,"foundry"