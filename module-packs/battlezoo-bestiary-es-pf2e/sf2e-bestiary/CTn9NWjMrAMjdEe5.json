nses"}]},{"key":"Weakness","type":"splash-damage","value":3,"predicate":[{"not":"hive-defenses"}]}],"slug":null,"traits":{"otherTags":[],"value":[]},"_migration":{"version":0.942,"previous":{"schema":null,"foundry":"13.347","system":"7.3.1"}},"actions":{"value":null},"category":"defensive","deathNote":false},"effects":[],"_id":"rqgmvYFTFPXCgn5f","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"melee","name":"Fist","effects":[],"system":{"_migration":{"version":0.942,"previous":null},"description":{"value":"","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":["agile","finesse","unarmed"]},"damageRolls":{"Lz61HrHJwYC3ET4z":{"damage":"1d4+3","damageType":"bludgeoning","category":null}},"bonus":{"value":9},"attackEffects":{"value":[]}},"_id":"RF2py2UeTxyezVCn","img":"systems/pf2e/icons/default-icons/melee.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"action","name":"Harmonic Impalement","system":{"actionType":{"value":"action"},"description":{"value":"<p><strong>Requirements</strong> The mellifican hive has just damaged a creature with a rapier Strike</p><hr /><p><strong>Effect</strong> The hive hums in unison, sending harmful vibrations down the rapier that tear at the wound. The target takes @Damage[1d6[sonic]] damage (@Check[fortitude|dc:17|basic] save).</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":[]},"_migration":{"version":0.942,"previous":{"schema":null,"foun