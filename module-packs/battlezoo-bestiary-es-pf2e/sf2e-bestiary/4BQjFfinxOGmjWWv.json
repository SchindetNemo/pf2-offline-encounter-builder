ong> The creature takes full damage and is @UUID[Compendium.sf2e.conditions.Item.TBSHQspnbcqxsmjL]{Frightened 1}.</p><p><strong>Critical Failure</strong> The creature takes double damage and is @UUID[Compendium.sf2e.conditions.Item.TBSHQspnbcqxsmjL]{Frightened 2} and @UUID[Compendium.sf2e.conditions.Item.sDPxOjQ9kx2RZE8D]{Fleeing} for 1 round.</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":["auditory","emotion","fear","mental","occult","sonic"]},"_migration":{"version":0.942,"previous":{"schema":null,"foundry":"13.347","system":"7.3.1"}},"actions":{"value":2},"category":"offensive","deathNote":false},"effects":[],"_id":"VxwVGJx3iyIU4jvS","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"img":"systems/pf2e/icons/actions/FreeAction.webp","name":"Improved Grab","system":{"actionType":{"value":"free"},"actions":{"value":null},"category":"offensive","description":{"value":"<p>@Localize[PF2E.NPC.Abilities.Glossary.ImprovedGrab]</p>","gm":""},"publication":{"license":"ORC","remaster":true,"title":"Pathfinder Monster Core","authors":""},"rules":[],"traits":{"value":[],"otherTags":[]},"slug":"improved-grab","_migration":{"version":0.942,"previous":null}},"type":"action","_stats":{"compendiumSource":"Compendium.sf2e.bestiary-ability-glossary-srd.Item.i18TlebMzwONyPhI","duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_id":"rX74fVufnNhbMXqI"},{"type":"melee","name":"Mouth Tentacle","effects":[],"system":{"_migration":{"version":0.942,"previous":null},"description":{"value":"","gm":""},"publication":{"title"