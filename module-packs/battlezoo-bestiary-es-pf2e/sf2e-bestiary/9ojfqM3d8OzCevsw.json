d":"pf2e","systemVersion":"7.4.2"}},{"type":"action","name":"Extinguish Knowledge","system":{"actionType":{"value":"reaction"},"description":{"value":"<p><strong>Trigger</strong> A creature within the staccarix's reach uses a concentrate action</p><hr /><p><strong>Effect</strong> The staccarix makes a beak Strike against the creature. On a hit, they disrupt the action. This Strike neither applies nor counts toward the staccarix's multiple attack penalty.</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":[]},"_migration":{"version":0.942,"previous":{"schema":null,"foundry":"13.347","system":"7.3.1"}},"actions":{"value":null},"category":"defensive","deathNote":false},"effects":[],"_id":"J8XcxH1QvnTDka86","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"melee","name":"Beak","effects":[],"system":{"_migration":{"version":0.942,"previous":null},"description":{"value":"","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":["magical","reach-20","unarmed"]},"damageRolls":{"PihxFAklmMdXmOZA":{"damage":"3d10+11","damageType":"piercing","category":null},"KFopqMHetX7RZFdL":{"damage":"2d6","damageType":"fire","category":null}},"bonus":{"value":31},"attackEffects":{"value":["choking-embers"]}},"_id":"dUwrp289ob2hurrn","img":"systems/pf2e/icons/default-icons/melee.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"melee","name":"Talon","effects":[],"system":{"_migration":{"version":0.942,"previous":null},"description":{"value":"","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":["agile","magical","reach-20","unarmed"]},"damageRolls":{"k3fNSlFXfODFQ7DL":{"damage":"2d8+11","damageType":"piercing","category":null},"vLQTURPBk4I84RXy":{"damage":"2d6","damageType":"fire","category":null}},"bonus":{"value":31},"attackEffects":{"value":["choking-embers"]}},"_id":"cugEaUrlDMD1afsu","img":"systems/pf2e/icons/default-icons/melee.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"action","name":"Ash Storm Mantle","system":{"actionType":{"value":"passive"},"description":{"value":"<p>30 feet. All creatures in the aura are @UUID[Compendium.sf2e.conditions.Item.DmAIPqOBomZ7H95W]{Concealed} by swirling smoke and ash, and all creatures outside the smoke become concealed to creatures within it. Any creature that needs to breathe must hold its breath while in the aura or begin to suffocate. A creature that breathes in the ash takes @Damage[2d6[fire],2d6[poison]|options:area-damage] damage.</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":["aura","divine","fire"]},"_migration":{"version":0.942,"previous":{"schema":null,"foundry":"13.347","system":"7.3.1"}},"actions":{"value":null},"category":"defensive","deathNote":false},"effects":[],"_id":"nBCmGpZyvINxrR9r","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"action","name":"Hateful Reformation","system":{"actionType":{"value":"passive"},"description":{"value":"<p>When a staccarix dies, their ashes are borne away by a sudden fell wind. Unless quickly gathered and kept within the confines of a holy temple, these ashes reconstitute the staccarix's body over the course of [[/gmr 1d6 #days]]{1d6 days}.</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":["divine"]},"_migration":{"version":0.942,"previous":{"schema":null,"foundry":"13.347","system":"7.3.1"}},"actions":{"value":null},"category":"defensive","deathNote":true},"effects":[],"_id":"F5qXcwiV4g2HnQEJ","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"action","name":"Weakness to Scattering","system":{"actionType":{"value":"passive"},"description":{"value":"<p>When the staccarix is hit by or fails a saving throw against an effect with the air trait, or when they start their turn in an area of wind that is strong enough to provide greater difficult terrain, they take @Damage[15[bludgeoning]] damage.</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":[]},"_migration":{"version":0.942,"previous":{"schema":null,"foundry":"13.347","system":"7.3.1"}},"actions":{"value":null},"category":"defensive","deathNote":false},"effects":[],"_id":"zMcJn8HmLgqppKPY","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"action","name":"Ashen Flight","system":{"actionType":{"value":"action"},"description":{"value":"<p>The staccarix discorporates into a cloud of superheated toxic ash and Flies twice. Their amorphous form allows them to pass through the squares of other creatures or into small cracks, and their Flight does not trigger reactions based on movement. Creatures within 20 feet of each square the staccarix moves through takes @Damage[4d6[fire],4d6[poison]] damage (@Check[fortitude|dc:28|basic] save); creatures that fail the save are also exposed to choking embers.</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":["divine","fire","poison"]},"_migration":{"version":0.942,"previous":{"schema":null,"foundry":"13.347","system":"7.3.1"}},"actions":{"value":2},"category":"offensive","deathNote":false},"effects":[],"_id":"VB71lA3sXm8OKdiz","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"action","name":"Choking Embers","system":{"actionType":{"value":"passive"},"description":{"value":"<p>With their Strikes and Ashen Flight, the staccarix's body releases painful embers that spew a sickening smoke. Affected creatures must succeed at a @Check[fortitude|dc:36] save or take @Damage[1d6[persistent,fire],1d6[persistent,poison]] damage and become @UUID[Compendium.sf2e.conditions.Item.fesd1n5eVhpCSS18]{Sickened 1}. On a critical failure, they become @UUID[Compendium.sf2e.conditions.Item.fesd1n5eVhpCSS18]{Sickened 2} and can't reduce or remove the sickened condition until they end the persistent poison damage.</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":["divine","fire","poison"]},"_migration":{"version":0.942,"previous":{"schema":null,"foundry":"13.347","system":"7.3.1"}},"actions":{"value":null},"category":"offensive","deathNote":false},"effects":[],"_id":"UKMuplfPtzpDldDp","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"action","name":"Darkened Skies","system":{"actionType":{"value":"passive"},"description":{"value":"<p>The staccarix doesn't need a secondary caster for their @UUID[Compendium.sf2e.spells.Item.XkDCzMIyc0YOjw05] ritual. In addition to the normal options, they can invoke an ashfall or volcanic tornado made of hot, poisonous gases.</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":[]},"_migration":{"version":0.942,"previous":{"schema":null,"foundry":"13.347","system":"7.3.1"}},"actions":{"value":null},"category":"offensive","deathNote":false},"effects":[],"_id":"78xmorrn0qUb9Alt","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"melee","name":"Superheated Ash","effects":[],"system":{"_migration":{"version":0.942,"previous":null},"description":{"value":"","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":["fire","magical","range-increment-30"]},"damageRolls":{"VN7V2H6x5JEPVLVa":{"damage":"6d8","damageType":"fire","category":null}},"bonus":{"value":30},"attackEffects":{"value":["choking-embers"]}},"_id":"ywQuMqsnyxremxER","img":"systems/pf2e/icons/default-icons/melee.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiu