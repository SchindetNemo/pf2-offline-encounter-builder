":[],"slug":null,"_migration":{"version":0.942,"lastMigration":null},"traits":{"otherTags":[]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"ability":{"value":"cha"},"spelldc":{"value":35,"dc":43},"tradition":{"value":"divine"},"prepared":{"value":"innate"},"showSlotlessLevels":{"value":false},"proficiency":{"value":1},"slots":{"slot0":{"prepared":[],"value":0,"max":0},"slot1":{"prepared":[],"value":0,"max":0},"slot2":{"prepared":[],"value":0,"max":0},"slot3":{"prepared":[],"value":0,"max":0},"slot4":{"prepared":[],"value":0,"max":0},"slot5":{"prepared":[],"value":0,"max":0},"slot6":{"prepared":[],"value":0,"max":0},"slot7":{"prepared":[],"value":0,"max":0},"slot8":{"prepared":[],"value":0,"max":0},"slot9":{"prepared":[],"value":0,"max":0},"slot10":{"prepared":[],"value":0,"max":0},"slot11":{"prepared":[],"value":0,"max":0}},"autoHeightenLevel":{"value":null}},"_id":"RINZKiMYeV4emjFj","img":"systems/pf2e/icons/default-icons/spellcastingEntry.svg","effects":[],"folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"folder":"lPzcDrjGDFbzuF2r","img":"systems/pf2e/icons/spells/dispel-magic.webp","name":"Dispel Magic","system":{"description":{"gm":"","value":"<p>You unravel the magic behind a spell or effect. Attempt a counteract check against the target. If you successfully counteract a magic item, the item becomes a mundane item of its type for 10 minutes. This doesn't change the item's non-magical properties. If the target is an artifact or similar item, you automatically fail.</p>"},"rules":[],"slug":"dispel-magic","_migration":{"version":0.942,"lastMigration":null,"previous":null},"traits":{"otherTags":[],"value":["concentrate","manipulate"],"rarity":"common","traditions":["arcane","divine","occult","primal"]},"publication":{"title":"Pathfinder Player Core","authors":"","license":"ORC","remaster":true},"level":{"value":2},"requirements":"","target":{"value":"1 spell effect or unattended magic item"},"range":{"value":"120 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"RINZKiMYeV4emjFj","heightenedLevel":9},"counteraction":true},"type":"spell","_stats":{"compendiumSource":"Compendium.sf2e.spells.Item.9HpwDN4MYQJnW0LG","duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"},"effects":[],"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_id":"uPnNEuAK102Y6lB8"},{"folder":"fi1AYNmuCRvoT15b","img":"icons/magic/light/projectile-beams-salvo-yellow.webp","name":"Falling Stars","system":{"description":{"gm":"","value":"<p><strong>Area</strong> 4 40-foot bursts</p>\n<hr />\n<p>You reach into the skies and call down an array of falling stars that explode upon colliding with the ground. Choose for the falling stars to be airbursts (sonic), asteroids (fire), comets (cold), or plasma (electricity). The spell gains the trait of the falling star type you chose. The four stars' central 10-foot bursts can't overlap. Each falling star deals 6d10 bludgeoning damage to each creature in the @Template[burst|distance:10] at the center of its area of effect before exploding, dealing 14d6 energy damage of the type you chose to each creature in its @Template[burst|distance:40]. A creature in any of the areas attempts one basic Reflex save against the spell no matter how many overlapping explosions it's caught in and can take each type of damage only once.</p>\n<hr />\n<p><strong>Heightened (+1)</strong> The bludgeoning damage increases by 1d10, and the energy damage increases by 2d6.</p>"},"rules":[],"slug":"falling-stars","_migration":{"version":0.942,"lastMigration":null,"previous":null},"traits":{"otherTags":[],"value":["concentrate","manipulate"],"rarity":"common","traditions":["arcane","primal"]},"publication":{"title":"Pathfinder Player Core","authors":"","license":"ORC","remaster":true},"level":{"value":9},"requirements":"","target":{"value":""},"range":{"value":"500 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"","sustained":false},"damage":{"5hgRJg7CfV9pZSUa":{"applyMod":false,"category":null,"formula":"6d10","kinds":["damage"],"materials":[],"type":"bludgeoning"},"RrsNfz6nzSiUPvoY":{"applyMod":false,"category":null,"formula":"14d6","kinds":["damage"],"materials":[],"type":"fire"}},"defense":{"save":{"basic":true,"statistic":"reflex"}},"cost":{"value":""},"location":{"value":"RINZKiMYeV4emjFj","heightenedLevel":9},"counteraction":false,"heightening":{"damage":{"5hgRJg7CfV9pZSUa":"1d10","RrsNfz6nzSiUPvoY":"2d6"},"interval":1,"type":"interval"},"overlays":{"3Ifk4ND7o6QBAYMp":{"name":"Falling Stars (Plasma)","overlayType":"override","sort":4,"system":{"damage":{"RrsNfz6nzSiUPvoY":{"type":"electricity"}},"traits":{"value":["concentrate","electricity","manipulate"]}}},"8dtcJWTSeGlvDAUL":{"name":"Falling Stars (Airbursts)","overlayType":"override","sort":1,"system":{"damage":{"RrsNfz6nzSiUPvoY":{"type":"sonic"}},"traits":{"value":["concentrate","manipulate","sonic"]}}},"TPSUk7tUquDQhIu3":{"name":"Falling Stars (Comets)","overlayType":"override","sort":3,"system":{"damage":{"RrsNfz6nzSiUPvoY":{"type":"cold"}},"traits":{"value":["cold","concentrate","manipulate"]}}},"UizWQQABRIkwrOZj":{"name":"Falling Stars (Asteroids)","overlayType":"override","sort":2,"system":{"traits":{"value":["concentrate","fire","manipulate"]}}}}},"type":"spell","_stats":{"compendiumSource":"Compendium.sf2e.spells.Item.jrBa9deU2ULFWvSl","duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"},"effects":[],"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_id":"D0AnaS85OEdERIGG"},{"folder":"fi1AYNmuCRvoT15b","img":"systems/pf2e/icons/spells/massacre.webp","name":"Massacre","system":{"description":{"gm":"","value":"<p>You unleash a wave of death to snuff out the life force of those in its path. Each living creature of 17th level or lower in the line must attempt a Fortitude save. If the damage from massacre reduces a creature to 0 Hit Points, that creature dies instantly. If massacre doesn't kill even a single creature, the void energy hungrily turns backward toward you, dealing an additional 30 void damage to every living creature in the line (even those above 17th level) and 30 void damage to you.</p>\n<hr />\n<p><strong>Critical Success</strong> The creature is unaffected.</p>\n<p><strong>Success</strong> The creature takes 9d6 void damage.</p>\n<p><strong>Failure</strong> The creature takes 100 void damage.</p>\n<p><strong>Critical Failure</strong> The creature dies.</p>\n<hr />\n<p><strong>Heightened (10th)</strong> The spell can affect living creatures up to 19th level. Increase the damage to 10d6 on a success, and to 115 on a failure.</p>"},"rules":[],"slug":"massacre","_migration":{"version":0.942,"lastMigration":null,"previous":null},"traits":{"otherTags":[],"value":["concentrate","death","manipulate","void"],"rarity":"common","traditions":["arcane","divine","primal"]},"publication":{"title":"Pathfinder Player Core","authors":"","license":"ORC","remaster":true},"level":{"value":9},"requirements":"","target":{"value":""},"range":{"value":""},"area":{"type":"line","value":60},"time":{"value":"2"},"duration":{"value":"","sustained":false},"damage":{"0":{"applyMod":false,"category":null,"formula":"9d6","kinds":["damage"],"materials":[],"type":"void"}},"defense":{"save":{"basic":false,"statistic":"fortitude"}},"cost":{"value":""},"location":{"value":"RINZKiMYeV4emjFj","heightenedLevel":9},"counteraction":false,"heightening":{"levels":{"10":{"damage":{"0":{"applyMod":false,"category":null,"formula":"10d6","materials":[],"type":"void"}}}},"type":"fixed"}},"type":"spell","_stats":{"compendiumSource":"Compendium.sf2e.spells.Item.10VcmSYNBrvBphu1","duplic