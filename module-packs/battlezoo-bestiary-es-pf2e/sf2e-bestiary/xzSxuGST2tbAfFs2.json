49KjZujZnSp6w","duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_id":"en4X3Xq9FgKwlW1S"},{"type":"action","name":"Planetary Lore","system":{"actionType":{"value":"passive"},"description":{"value":"<p>Drawing upon the combined knowledge of all the beings caught in the supernova, the nebulite uses Planetary Lore in place of any skill to @UUID[Compendium.sf2e.actions.Item.1OagaWtBpVXExToo]{Recall Knowledge}.</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":[]},"_migration":{"version":0.942,"previous":{"schema":null,"foundry":"13.347","system":"7.3.1"}},"actions":{"value":null},"category":"interaction","deathNote":false},"effects":[],"_id":"wt7WQ4in6TZRQgl9","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"action","name":"Planetary Polyglot","system":{"actionType":{"value":"passive"},"description":{"value":"<p>The nebulite speaks every language that was spoken by at least one person caught in the supernova.</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":[]},"_migration":{"version":0.942,"previous":{"schema":null,"foundry":"13.347","system":"7.3.1"}},"actions":{"value":null},"category":"interaction","deathNote":false},"effects":[],"_id":"xbzD7RNl7JvbJAo8","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"action","name":"Accretion Disc","system":{"actionType":{"value":"passive"},"description":{"value":"<p>60 feet. Creatures within the aura treat any squares they enter that are moving farther away from the nebulite as greater difficult terrain. Creatures that start their turn within the aura are pummeled by superheated particles, taking @Damage[8[fire],8[piercing]|options:area-damage] damage (@Check[fortitude|dc:32|basic] save). On a failure, the creature is also moved 5 feet toward the nebulite (or 10 feet on a critical failure); this is forced movement. By making quick calculations, a creature can temporarily escape the nebulite's pull. If a creature spends 1 action and succeeds at a @Check[arcana|dc:30] check or @Check[Astronomy Lore|dc:26] check, it ignores the greater difficult terrain until it is subjected to forced movement.</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[{"key":"Aura","radius":60,"traits":["occult"],"effects":[]}],"slug":null,"traits":{"otherTags":[],"value":["aura","occult"]},"_migration":{"version":0.942,"previous":{"schema":null,"foundry":"13.347","system":"7.3.1"}},"actions":{"value":null},"category":"defensive","deathNote":false},"effects":[],"_id":"PZaNbNBke4XdumHy","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"action","name":"Event Horizon","system":{"actionType":{"value":"passive"},"description":{"value":"<p>15 feet. Creatures within the aura are undetected by creatures outside the aura and can't communicate with them except by magical means or telepathy. Creatures beginning their turn within the aura are @UUID[Compendium.sf2e.conditions.Item.nlCjDvLMf2EkV2dl]{Quickened}. They can use the additional action to Stride or Strike, but can't use it to move farther away from the nebulite. A creature that leaves the aura during its turn loses the extra action and the quickened condition.</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[{"key":"Aura","radius":15,"traits":["occult","time"],"effects":[]}],"slug":null,"traits":{"otherTags":[],"value":["aura","occult","time"]},"_migration":{"version":0.942,"previous":{"schema":null,"foundry":"13.347","system":"7.3.1"}},"actions":{"value":null},"category":"defensive","deathNote":false},"effects":[],"_id":"mObvF1m2kgkEQ66t","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"action","name":"No Breath","system":{"actionType":{"value":"passive"},"description":{"value":"<p>A nebulite doesn't breathe and is immune to effects that require breathing.</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":[]},"_migration":{"version":0.942,"previous":{"schema":null,"foundry":"13.347","system":"7.3.1"}},"actions":{"value":null},"category":"defensive","deathNote":false},"effects":[],"_id":"rPTZ4PI6b6DS3wXa","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"action","name":"Gravitational Pull","system":{"actionType":{"value":"free"},"description":{"value":"<p><strong>Requirements</strong> The nebulite's last action was a successful tendril or graviton Strike against a creature</p><hr /><p><strong>Effect</strong> The creature is pulled in a direction of the nebulite's choice, either moving closer to the nebulite or maintaining its distance. This is forced movement. The creature must roll a @Check[fortitude|dc:34] save to determine the distance.</p><hr /><p><strong>Critical Success</strong> The creature is unaffected.</p><p><strong>Success</strong> The creature is pulled 5 feet.</p><p><strong>Failure</strong> The creature is pulled 10 feet.</p><p><strong>Critical Failure</strong> The creature is pulled 20 feet.</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":[]},"_migration":{"version":0.942,"previous":{"schema":null,"foundry":"13.347","system":"7.3.1"}},"actions":{"value":null},"category":"offensive","deathNote":false},"effects":[],"_id":"DIHuEGhWo0hocMhy","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"melee","name":"Tendril","effects":[],"system":{"_migration":{"version":0.942,"previous":null},"description":{"value":"","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":["magical","reach-20"]},"damageRolls":{"Z4Q9fdtUM7W1yuZz":{"damage":"2d6+7","damageType":"fire","category":null},"YVSzykk0FuQ8uIH2":{"damage":"2d6+7","damageType":"force","category":null}},"bonus":{"value":28},"attackEffects":{"value":["gravitational-pull"]}},"_id":"iJEFkwGeSR24UE1g","img":"systems/pf2e/icons/default-icons/melee.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"melee","name":"Graviton","effects":[],"system":{"_migration":{"version":0.942,"previous":null},"description":{"value":"","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":["agile","magical","range-200","volley-30"]},"damageRolls":{"XhJJOAE6dut1opAP":{"damage":"3d6+12","damageType":"force","category":null}},"bonus":{"value":28},"attackEffects":{"value":["gravitational-pull"]}},"_id":"MHFc5RU7ufc2MuzW","img":"systems/pf2e/icons/default-icons/melee.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"action","name":"Fusion","system":{"actionType":{"value":"free"},"description":{"value":"<p><strong>Trigger</strong> The nebulite forces a creature to move, and their path is blocked by another creature</p><hr /><p><strong>Effect</strong> The movement ends, and both creatures begin to glow. At the end of each affected creature's next turn, the light violently flares around it. Creatures in a @Template[type:emanation|distance:10] take @Damage[4d6[force]|options:area-damage] damage (@Check[reflex|dc:31|basic] save) and are @UUID[Compendium.sf2e.conditions.Item.TkIyaNPgTZFBCCuh]{Dazzled} for 1 round on a failed save.</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":[]},"_migration":{"version":0.942,"previous":{"schema":null,"foundry":"13.347","system":"7.3.1"}},"actions":{"value":null},"category":"offensive","deathNote":false},"effects":[],"_id":"e5jxyQHnOjU0odJk","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}}],"effects":[],"sort":5200000,"ownership":{"default":0,"1Lps0