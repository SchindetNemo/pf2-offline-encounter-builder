slashing damage each increase by 1d10.</p>"},"rules":[],"slug":null,"_migration":{"version":0.942,"lastMigration":null,"previous":{"schema":0.941,"foundry":"13.347","system":"7.3.1"}},"traits":{"otherTags":[],"value":["concentrate","manipulate"],"rarity":"uncommon","traditions":["arcane","occult"]},"publication":{"title":"Battlezoo Bestiary: Elemental Storm (Pathfinder)","authors":"","license":"ORC","remaster":true},"level":{"value":7},"requirements":"","target":{"value":""},"range":{"value":"500 feet"},"area":{"value":60,"type":"burst"},"time":{"value":"2"},"duration":{"value":"","sustained":false},"damage":{"1INqzpPek4JYuHpT":{"formula":"4d10","kinds":["damage"],"type":"bludgeoning","category":null,"materials":[],"applyMod":false},"0wDwGLVI00quwcUM":{"formula":"4d10","kinds":["damage"],"type":"piercing","category":null,"materials":[],"applyMod":false},"Ok9dwwuj8KkwFavT":{"formula":"4d10","kinds":["damage"],"type":"slashing","category":null,"materials":[],"applyMod":false}},"defense":{"save":{"statistic":"reflex","basic":true}},"cost":{"value":""},"location":{"value":"8FDRcLVZcfNCJljc","heightenedLevel":7,"uses":{"max":2,"value":2}},"counteraction":false,"heightening":{"type":"interval","interval":1,"damage":{"1INqzpPek4JYuHpT":"1d10","0wDwGLVI00quwcUM":"1d10","Ok9dwwuj8KkwFavT":"1d10"},"area":0}},"img":"icons/commodities/treasure/goblet-worn-gold.webp","effects":[],"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":"Compendium.battlezoo-bestiary-es-pf2e.sf2e-spells.Item.ty07K2w88LGu9FC7","duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"},"_id":"SYYpo5kvHYwsGx3Q"},{"type":"spell","name":"Knock Heads","folder":"pcjidaJ7lvxI8BEP","system":{"description":{"gm":"","value":"<p>Choose two creatures in the area to telekinetically grab and smash into each other. Both targets are repositioned to the midpoint between them and battered against each other, taking 16d6 bludgeoning damage. If either creature critically succeeds at their saving throw, the other creature takes no damage from the spell.</p><hr /><p><strong>Critical Success</strong> The creature is unaffected.</p><p><strong>Success</strong> The creature is repositioned and takes half damage.</p><p><strong>Failure</strong> The creature is repositioned and takes full damage.</p><p><strong>Critical Failure</strong> The creature is repositioned and takes double damage.</p><hr /><p><strong>Heightened (+1)</strong> The damage increases by 2d6 and the maximum distance between the two targets increases by 5 feet.</p>"},"rules":[],"slug":null,"_migration":{"version":0.942,"lastMigration":null,"previous":{"schema":0.941,"foundry":"13.347","system":"7.3.1"}},"traits":{"otherTags":[],"value":["concentrate","manipulate"],"rarity":"uncommon","traditions":["arcane","occult"]},"publication":{"title":"Battlezoo Bestiary: Elemental Storm (Pathfinder)","authors":"","license":"ORC","remaster":true},"level":{"value":5},"requirements":"","target":{"value":"2 creatures that are up to 40 feet apart"},"range":{"value":"120 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"","sustained":false},"damage":{"MVmbidLGsVwqvVZe":{"formula":"16d6","kinds":["damage"],"type":"bludgeoning","category":null,"materials":[],"applyMod":false}},"defense":{"save":{"statistic":"reflex","basic":false}},"cost":{"value":""},"location":{"value":"8FDRcLVZcfNCJljc","heightenedLevel":7},"counteraction":false,"heightening":{"type":"interval","interval":1,"damage":{"MVmbidLGsVwqvVZe":"2d6"},"area":0}},"img":"icons/magic/control/energy-stream-link-teal.webp","effects":[],"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":"Compendium.battlezoo-bestiary-es-pf2e.sf2e-spells.Item.smmpGbgKYBTwW73W","duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"},"_id":"OeagnF4iDOaQ7oNN"},{"folder":"zDlxATrLAlbYA2Mv","img":"systems/pf2e/icons/spells/wall-of-force.webp","name":"Wall of Force","system":{"description":{"gm":"","value":"<p>You form an @UUID[Compendium.sf2e.conditions.Item.zJxUflt9np0q4yML]{Invisible} wall of pure magical force up to 50 feet long and up to 20 feet high. The wall has no discernible thickness. You must create the wall in an unbroken open space so its edges don't pass through any creatures or objects, or the spell is lost. The wall has AC 10, Hardness 30, and 60 Hit Points, and it's immune to critical hits and precision damage. The wall blocks physical effects from passing through it, and because it's made of force, it blocks incorporeal and ethereal creatures as well. Teleportation effects can pass through the barrier, as can visual effects (since the wall is invisible). Wall of force is immune to counteracting effects of its level or lower, but the wall is automatically destroyed by a @UUID[Compendium.sf2e.spells.Item.r7ihOgKv19eJQnik]{Disintegrate} spell of any rank.</p><hr /><p><strong>Heightened (+2)</strong> The Hit Points of the wall increase by 20.</p>"},"rules":[],"slug":"wall-of-force","_migration":{"version":0.942,"lastMigration":null,"previous":null},"traits":{"otherTags":[],"value":["concentrate","force","manipulate"],"rarity":"common","traditions":["arcane","occult"]},"publication":{"title":"Pathfinder Player Core","authors":"","license":"ORC","remaster":true},"level":{"value":6},"requirements":"","target":{"value":""},"range":{"value":"30 feet"},"area":null,"time":{"value":"3"},"duration":{"value":"1 minute","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"8FDRcLVZcfNCJljc","heightenedLevel":6},"counteraction":false},"type":"spell","_stats":{"compendiumSource":"Compendium.sf2e.spells.Item.7Iela4GgVeO3LfAo","duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"},"effects":[],"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_id":"nHSgsng4nYG1o1a1"},{"folder":"iDjm2cXyRAe4VZ35","img":"icons/magic/sonic/projectile-sound-rings-wave.webp","name":"Telekinetic Haul (At Will)","system":{"description":{"gm":"","value":"<p>You move the target up to 20 feet, potentially suspending it in midair. When you Sustain the Spell, you can do so again, or you can shift your telekinetic focus to a different eligible target within range, moving it instead.</p>"},"rules":[],"slug":"telekinetic-haul","_migration":{"version":0.942,"lastMigration":null,"previous":null},"traits":{"otherTags":[],"value":["concentrate","manipulate"],"rarity":"common","traditions":["arcane","occult"]},"publication":{"title":"Pathfinder Player Core","authors":"","license":"ORC","remaster":true},"level":{"value":5},"requirements":"","target":{"value":"1 unattended object of up to 80 Bulk with no dimension longer than 20 feet"},"range":{"value":"120 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"1 minute","sustained":true},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"8FDRcLVZcfNCJljc","heightenedLevel":5},"counteraction":false},"type":"spell","_stats":{"compendiumSource":"Compendium.sf2e.spells.Item.tpLTLbJUrYcMWGld","duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"},"effects":[],"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_id":"Tz56XHUOHomv2SzW"},{"folder":"lPzcDrjGDFbzuF2r","img":"icons/skills/melee/strike-weapon-polearm-ice-blue.webp","name":"Telekinetic Maneuver (At Will)","system":{"description":{"gm":"","value":"<p>With a rush of telekinetic power, you move a foe or something they carry. You can attempt to @UUID[Compendium.sf2e.actions.Item.Dt6B1slsBy8ipJu9]{Disarm}, @UUID[Compendium.sf2e.actions.Item.7blmbDrQFNfdT731]{Shove}, @UUID[Compendium.sf2e.actions.Item.lOE4yjUnETTdaf2T]{Reposition}, or @UUID[Compendium.sf2e.actions.Item.ge56Lu1xXVFYUnLP]{Trip} the target using a spell attack roll instead of an Athletics check.</p>"},"rules":[],"slug":"telekinetic-maneuver","_migration":{"version":0.942,"lastMigration":null,"previous":null},"traits":{"otherTags":[],"value":["attack","concentrate","force","manipulate"],"rarity":"common","traditions":["arcane","occult"]},"publication":{"title":"Pathfinder Player Core","authors":"","license":"ORC","remaster":true},"level":{"value":2},"requirements":"","target":{"value":"1 creature"},"range":{"value":"60 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"8FDRcLVZcfNCJljc","heightenedLevel":2},"counteraction":false},"type":"spell","_stats":{"compendiumSource":"Compendium.sf2e.spells.Item.mrDi3v933gsmnw25","duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"},"effects":[],"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_id":"cG8KzJWLnnR3qVeG"},{"type":"action","name":"Force Bubble","system":{"actionType":{"value":"action"},"description":{"value":"<p>The braincase molds an opaque bubble of magical force around a creature within 60 feet (@Check[reflex|dc:33] negates). On a failed save, the creature is @UUID[Compendium.sf2e.conditions.Item.eIcWbB5o3pP6OIMe]{Immobilized} and @UUID[Compendium.sf2e.conditions.Item.XgEqL1kFApUbl5Z2]{Blinded} until the bubble is popped (AC 10, Hardness 5, HP 30, BT 15); the bubble breaks automatically after 1 minute. Bubbles are immune to critical hits and precision damage. At the end of the braincase's turn, they can affect each active force bubble, moving it up to 30 feet, popping it, or both.</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":["force","manipulate","occult"]},"_migration":{"version":0.942,"previous":{"schema":null,"foundry":"13.347","system":"7.3.1"}},"actions":{"value":1},"category":"offensive","deathNote":false},"effects":[],"_id":"fOlkf7VDmsMkzhlA","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"action","name":"Six Palms Stance","system":{"actionType":{"value":"action"},"description":{"value":"<p>The braincase creates a massive, six-armed torso from magical force. Theirs size increases to Gargantuan, and they can use their force palm Strike and Obstructing Palm reaction. They gain an additional reaction each round, but their second reaction must be used for a different action than their first reaction. The stance breaks if the braincase Casts a Spell.</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[{"key":"RollOption","option":"six-palms-stance","toggleable":true},{"damage":{"base":{"damageType":"force","dice":3,"die":"d12","modifier":12}},"attackModifier":27,"traits":["finesse","force","magical","reach-20"],"key":"Strike","slug":"force-palm","label":"BZES.SpecificRule.Braincase.ForcePalm","predicate":["six-palms-stance"]},{"key":"CreatureSize","value":"gargantuan","predicate":["six-palms-stance"]}],"slug":null,"traits":{"otherTags":[],"value":["concentrate","force","occult","stance"]},"_migration":{"version":0.942,"previous":{"schema":null,"foundry":"13.347","system":"7.3.1"}},"actions":{"value":1},"category":"offensive","deathNote":false},"effects":[],"_id":"KjTrka1nX8EB8SRm","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.348","systemId":"pf2e","systemVersion":"7.4.3"}},{"type":"action","name":"Telekinetic Shove","system":{"actionType":{"value":"free"},"description":{"value":"<p><strong>Requirements</strong> The braincase's last action was a successful telekinetic beam Strike against a creature of size Huge or smaller</p><hr /><p><strong>Effect</strong> The braincase attempts to push the creature away, rolling a spell attack roll against the creature's Fortitude DC. On a success, the creature is pushed back 20 feet (40 feet on a critical success). This attack roll neither applies nor counts toward the braincase's multiple attack penalty.</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":[]},"_migration":{"version":0.942,"previous":{"schema":null,"foundry":"13.347","system":"7.3.1"}},"actions":{"value":null},"category":"offensive","deathNote":false},"effects":[],"_id":"x48g6apUpSwI5MuE","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"action","name":"Telekinetic Trip","system":{"actionType":{"value":"free"},"description":{"value":"<p><strong>Requirements</strong> The braincase's last action was a successful force palm Strike against a creature of size Huge or smaller</p><hr /><p><strong>Effect</strong> The braincase attempts to [[/act trip statistic=spell]] the creature, using their spell attack modifier in place of their Athletics modifier. This attempt neither applies nor counts toward the braincase's multiple attack penalty.</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":[]},"_migration":{"version":0.942,"previous":{"schema":null,"foundry":"13.347","system":"7.3.1"}},"actions":{"value":null},"category":"offensive","deathNote":false},"effects":[],"_id":"xzDmGF3pJWh3UpPy","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{