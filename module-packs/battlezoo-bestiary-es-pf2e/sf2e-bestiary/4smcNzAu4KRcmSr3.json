":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":["fortune","occult","time"]},"_migration":{"version":0.942,"previous":{"schema":null,"foundry":"13.347","system":"7.3.1"}},"actions":{"value":3},"category":"offensive","deathNote":false},"effects":[],"_id":"ntjSxv2AuhZOMtbL","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"action","name":"Twin Timelines","system":{"actionType":{"value":"action"},"description":{"value":"<p>The paradoxical past makes two time loop Strikes against the same target. If the first Strike misses the target, the paradoxical past rolls twice and takes the better result on the second attack roll. This is a fortune effect.</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":["occult","time"]},"_migration":{"version":0.942,"previous":{"schema":null,"foundry":"13.347","system":"7.3.1"}},"actions":{"value":2},"category":"offensive","deathNote":false},"effects":[],"_id":"VCTjIIYZZbz7WJLW","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}}],"effects":[],"sort":100000,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.351","systemId":"pf2e","systemVersion":"7.8.0"}}