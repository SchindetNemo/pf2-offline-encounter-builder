oa3vIF":{"_id":"cUFX7ExSLeoa3vIF","name":"Telekinetic Projectile (Piercing)","overlayType":"override","sort":2,"system":{"damage":{"0":{"category":null,"type":"piercing"}}}},"zFWsMjoeCnLxqJaV":{"_id":"zFWsMjoeCnLxqJaV","name":"Telekinetic Projectile (Slashing)","overlayType":"override","sort":3,"system":{"damage":{"0":{"category":null,"type":"slashing"}}}}}},"type":"spell","_stats":{"compendiumSource":"Compendium.pf2e.spells-srd.Item.60sgbuMWN0268dB7","duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"},"effects":[],"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_id":"jNUeqhHz9L1IPdAp"},{"folder":"wnvibtD90h7CStDC","img":"systems/pf2e/icons/spells/triple-time.webp","name":"Triple Time","system":{"description":{"gm":"","value":"<p>Your music sets a fast pace. You and all allies in the area gain a +10-foot status bonus to all Speeds for 1 round.</p>\n<p>@UUID[Compendium.pf2e.spell-effects.Item.HtaDbgTIzdiTiKLX]{Spell Effect: Triple Time}</p>"},"rules":[],"slug":"triple-time","_migration":{"version":0.942,"lastMigration":null,"previous":{"schema":0.941,"foundry":"13.347","system":"7.3.1"}},"traits":{"otherTags":[],"value":["bard","cantrip","composition","emotion","manipulate","mental"],"rarity":"uncommon","traditions":[]},"publication":{"title":"Pathfinder Player Core","authors":"","license":"ORC","remaster":true},"level":{"value":2},"requirements":"","target":{"value":""},"range":{"value":""},"area":{"type":"emanation","value":60},"time":{"value":"1"},"duration":{"value":"1 round","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"Iab6M7iEYrUwKvDK"},"counteraction":false},"type":"spell","_stats":{"compendiumSource":"Compendium.pf2e.spells-srd.Item.c8R2fpk88fBwJ1ie","duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"},"effects":[],"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_id":"GPYYMAHhgdI0Ypd5"},{"type":"action","name":"Resonant Tempo","system":{"actionType":{"value":"passive"},"description":{"value":"<p>The tempo of the beat hopper's composition spells resonates profoundly through the bodies of those who hear them, generating the following additional effects.</p><ul><li><strong>Courageous Anthem</strong> This inspiring performance helps steady the hearts and bodies of those who hear it. In addition to its normal effects, creatures affected by this performance are unaffected by the @UUID[Compendium.pf2e.conditionitems.Item.nlCjDvLMf2EkV2dl]{Quickened} and slowed conditions, and they are also unaffected by both status bonuses and status penalties to their Speeds.</li><li><strong>Rallying Anthem</strong> Creatures affected by this gradually building performance focus so intently on preparations to shore up their defenses that they lose some of their offensive power. In addition to its normal effects, hey take a –10-foot status penalty to their Speeds and a –1 status penalty to attack rolls.</li><li><strong>Triple Time</strong> Creatures affected by this frantic performance are quickened, in addition to the performance's normal effects. They can only use this extra action to Stride their full Speed (if they want to go somewhere nearby, they can do so by taking a circuitous path or circling back).</li></ul>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":["occult"]},"_migration":{"version":0.942,"previous":{"schema":0.941,"foundry":"13.347","system":"7.3.1"}},"actions":{"value":null},"category":"offensive","deathNote":false},"effects":[],"_id":"pojvgqiJHs9HDmpx","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}}],"effects":[],"sor