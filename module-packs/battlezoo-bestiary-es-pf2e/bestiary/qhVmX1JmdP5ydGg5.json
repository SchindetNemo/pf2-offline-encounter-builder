m rips out a chunk of the creature's throat. The creature takes @Damage[(2d8+9)[piercing]] damage (@Check[fortitude|dc:26] save). On a failure, until the creature receives healing, it must succeed at a @Check[flat|dc:5] before performing an action that requires speech or the action is lost.</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":[]},"_migration":{"version":0.942,"previous":{"schema":0.941,"foundry":"13.347","system":"7.3.1"}},"actions":{"value":1},"category":"offensive","deathNote":false},"effects":[],"_id":"56O2vqFbb6lt57Sk","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}}],"effects":[],"sort":12400000,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.351","systemId":"pf2e","systemVersion":"7.8.0"}}