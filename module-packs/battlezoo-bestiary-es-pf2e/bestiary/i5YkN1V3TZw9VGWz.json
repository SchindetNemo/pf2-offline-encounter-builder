cons/other-consumables.webp","data":{"description":{"value":""}}},"misidentified":{}},"category":"other","uses":{"value":1,"max":1,"autoDestroy":true},"damage":null,"usage":{"value":"held-in-one-hand"},"stackGroup":null,"spell":null},"_id":"D2xy12ATFOhca6K0","img":"icons/consumables/potions/bottle-circular-corked-labeled-green.webp","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"img":"icons/equipment/chest/breastplate-banded-leather-brown.webp","name":"Padded Armor","system":{"description":{"gm":"","value":"<p>This armor is simply a layer of heavy, quilted cloth, but it is sometimes used because it's so inexpensive. Padded armor is easier to damage and destroy than other types of armor. Heavy armor comes with a padded armor undercoat included in its Price, though it loses the comfort trait when worn under heavy armor. You can wear just that padded armor undercoat to sleep in, if your heavy armor is destroyed, or when otherwise not wearing the full heavy armor. This allows you to keep magic armor invested and benefit from the power of any runes on the associated heavy armor, but no one else can wear your heavy armor without the padded undercoat.</p>"},"rules":[],"slug":"padded-armor","_migration":{"version":0.942,"lastMigration":null,"previous":null},"traits":{"otherTags":[],"value":["comfort"],"rarity":"common"},"publication":{"title":"Pathfinder Player Core","authors":"","license":"ORC","remaster":true},"level":{"value":0},"quantity":1,"baseItem":"padded-armor","bulk":{"value":0.1},"hp":{"value":0,"max":0},"hardness":0,"price":{"value":{"sp":2}},"equipped":{"carryType":"worn","invested":null},"containerId":null,"size":"med","material":{"type":null,"grade":null},"identification":{"status":"identified","unidentified":{"name":"","img":"","data":{"description":{"value":""}}},"misidentified":{}},"category":"light","group":"cloth","acBonus":1,"strength":0,"dexCap":3,"checkPenalty":0,"speedPenalty":0,"grade":null,"runes":{"potency":0,"resilient":0,"property":[]},"subitems":[]},"type":"armor","_stats":{"compendiumSource":"Compendium.pf2e.equipment-srd.Item.zBYEU9E7034ENCmh","duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_id":"6L5Xw7iVvwyDeyGw"},{"type":"action","name":"Bounce","system":{"actionType":{"value":"reaction"},"description":{"value":"<p><strong>Trigger</strong> The gasbelly goblin is hit by an attack that deals bludgeoning or slashing damage, and the attack is not a critical hit</p><hr /><p><strong>Effect</strong> The gasbelly goblin flies 30 feet directly away from the attacker (this is not forced movement, and it triggers reactions as normal). The gasbelly goblin takes no bludgeoning or slashing damage from the attack. If they collide with an obstacle, the gasbelly goblin changes direction and continues moving until they have used up the full 30 feet of movement.</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":[]},"_migration":{"version":0.942,"previous":{"schema":null,"foundry":"13.347","system":"7.3.1"}},"actions":{"value":null},"category":"defensive","deathNote":false},"effects":[],"_id":"wrAd1GGczOr957Ps","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"_id":"pxYuRxKrKGpwSyfX","name":"Dogslicer","type":"melee","system":{"slug":"dogslicer","bonus":{"value":12},"damageRolls":{"w2N1zZLHGAiNJrAX":{"damage":"1d6+4","damageType":"slashing","category":null}},"traits":{"value":["agile","backstabber","finesse"],"otherTags":[]},"rules":[],"description":{"value":"","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"_migration":{"version":0.942,"previous":{"schema":null,"foundry":"13.347","system":"7.3.1"}},"attackEffects":{"value":[]}},"flags":{"pf2e":{"linkedWeapon":"igdf27q5gItQOw2R"}},"img":"systems/pf2e/icons/default-icons/melee.svg","effects":[],"folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"action","name":"Numbing Toxin","system":{"actionType":{"value":"passive"},"description":{"value":"<p>Direct exposure to a gasbelly goblin's poison causes numbness and tingling. A creature hit by a gasbelly poison flask Strike must succeed at a @Check[fortitude|dc:20] save or become @UUID[Compendium.pf2e.conditionitems.Item.i3OJZU2nk64Df3xm]{Clumsy 1} for 1 round. Creatures exposed to only the splash damage do not need to attempt this saving throw.</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":["poison"]},"_migration":{"version":0.942,"previous":{"schema":null,"foundry":"13.347","system":"7.3.1"}},"actions":{"value":null},"category":"offensive","deathNote":false},"effects":[],"_id":"liSTXH42QXPswt8o","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"melee","name":"Gasbelly Poison Flask","effects":[],"system":{"_migration":{"version":0.942,"previous":null},"description":{"value":"","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":["poison","range-increment-20","splash"]},"damageRolls":{"Yf8ONuHjKC38VQEa":{"damage":"1d6","damageType":"poison","category":null},"pRjP69OBIM6bhd6q":{"damage":"1d6","damageType":"poison","category":"persistent"},"VoqWi5bc4ZHlEqMI":{"damage":"2","damageType":"poison","category":"splash"}},"bonus":{"value":12},"attackEffects":{"value":["numbing-toxin"]}},"_id":"hU6nziHWItR3Je2f","img":"systems/pf2e/icons/default-icons/melee.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"action","name":"Belching Jet","system":{"actionType":{"value":"action"},"description":{"value":"<p>The gasbelly goblin moves up to 50 feet in a straight line. All creatures that the gasbelly passes adjacent to during this movement take @Damage[5d6[poison]] damage (@Check[fortitude|dc:17|basic] save). The goblin can't use Belching Jet again until they drink a gasbelly poison flask.</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":["move","poison"]},"_migration":{"version":0.942,"previous":{"schema":null,"foundry":"13.347","system":"7.3.1"}},"actions":{"value":2},"category":"offensive","deathNote":false},"effects":[],"_id":"2EiBN9x65qQnYdxe","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"action","name":"Quickfingered Poisoner","system":{"actionType":{"value":"action"},"description":{"value":"<p>The gasbelly goblin Interacts to draw a gasbelly poison flask, then Strikes with it or drinks it.</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":[]},"_migration":{"version":0.942,"previous":{"schema":null,"foundry":"13.347","system":"7.3.1"}},"actions":{"value":1},"category":"offensive","deathNote":false},"effects":[],"_id":"ldMNE5XikxqKSet7","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"action","name":"Spit Up and Slash","system":{"actionType":{"value":"action"},"description":{"value":"<p>With a hiccup and a lurch, the gasbelly goblin Interacts to dredge up poison from their stomach, spitting it on to their weapon to prepare for a more deadly attack. The goblin then Strikes with their dogslicer; the Strike deals an additional 1d6 poison damage.</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[{"key":"RollOption","option":"spit-up-and-slash","toggleable":true},{"diceNumber":1,"dieSize":"d6","key":"DamageDice","selector":"dogslicer-damage","damageType":"poison","predicate":["spit-up-and-slash"]}],"slug":"spit-up-and-slash","traits":{"otherTags":[],"value":[]},"_migration":{"version":0.942,"previous":{"schema":null,"foundry":"13.347","system":"7.3.1"}},"actions":{"value":1},"category":"offensive","deathNote":false},"effects":[],"_id":"XgYGpE2JYGt36Kzb","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}}],"effects":[],"sort":8000000,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.351","systemId":"pf2e","systemVersion":"7.8.0"}}