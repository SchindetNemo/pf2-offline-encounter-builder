UID[Compendium.pf2e.conditionitems.Item.dfCMdR4wnpbYNTix]{Stunned 3}, and takes a –2 circumstance penalty to AC until the end of its next turn.</p><p>@UUID[Compendium.battlezoo-bestiary-es-pf2e.effects.Item.ca80CidR1g2AUjt6]{Effect: Voltaic Overload}</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":["arcane","electricity"]},"_migration":{"version":0.942,"previous":{"schema":null,"foundry":"13.347","system":"7.3.1"}},"actions":{"value":null},"category":"defensive","deathNote":false},"effects":[],"_id":"Jy45pfEFdoeeLI8m","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"action","name":"Lightning Rod","system":{"actionType":{"value":"reaction"},"description":{"value":"<p><strong>Trigger</strong> A creature or area within 30 feet is targeted by an effect with the electricity trait</p><hr /><p><strong>Effect</strong> The living lightning rod attempts a counteract check against the effect (counteract modifier [[/r 1d20+30 #Counteract]]{+30}). If the counteract check succeeds, the living lightning rod is @UUID[Compendium.battlezoo-bestiary-es-pf2e.effects.Item.Bi2aHykg6CZrQCnR].</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":[]},"_migration":{"version":0.942,"previous":{"schema":null,"foundry":"13.347","system":"7.3.1"}},"actions":{"value":null},"category":"defensive","deathNote":false},"effects":[],"_id":"iXHLwxcil5G1Q9Yt","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","s