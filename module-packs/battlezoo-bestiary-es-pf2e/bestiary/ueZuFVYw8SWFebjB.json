ir next turn. All foes within a @Template[type:emanation|distance:60] must attempt a @Check[will|dc:26] save. The spectral conductor can't use Ritenuto again until after they have used Accelerando.</p><hr /><p><strong>Critical Success</strong> The creature is unaffected.</p><p><strong>Success</strong> The creature takes @Damage[2d6[sonic]|options:area-damage] damage.</p><p><strong>Failure</strong> The creature takes @Damage[4d6[sonic]|options:area-damage] damage and is slowed 1 for 1 round.</p><p><strong>Critical Failure</strong> The creature takes @Damage[8d6[sonic]|options:area-damage] damage and is slowed 1 for 1 minute.</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":["auditory","manipulate","occult"]},"_migration":{"version":0.942,"previous":{"schema":null,"foundry":"13.347","system":"7.3.1"}},"actions":{"value":2},"category":"offensive","deathNote":false},"effects":[],"_id":"EXWHsIGDxMI0QWyj","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}}],"effects":[],"sort":2100000,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.351","systemId":"pf2e","systemVersion":"7.8.0"}}