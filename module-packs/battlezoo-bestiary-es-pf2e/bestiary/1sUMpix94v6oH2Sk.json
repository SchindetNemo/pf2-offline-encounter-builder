942,"previous":null},"deathNote":false},"type":"action","_stats":{"compendiumSource":"Compendium.pf2e.bestiary-ability-glossary-srd.Item.W7SbTykXrNwxDzJc","duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_id":"Z4K8Q4rcsxKLCQk3"},{"type":"action","name":"Adaptive Resistance","system":{"actionType":{"value":"reaction"},"description":{"value":"<p>A neoctri would take acid, bludgeoning, cold, electricity, fire, piercing, slashing, or sonic damage</p><hr /><p><strong>Effect</strong> The neoctri gains resistance against one of the types of damage that they are about to take. They gain resistance 4 against bludgeoning, piercing, or slashing damage or resistance 8 against acid, cold, electricity, fire, or sonic damage. If they would take multiple types of damage at once, they chose which resistance to gain. The resistance lasts until the neoctri use adaptive resistance again.</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[{"key":"RollOption","option":"adaptive-resistances","suboptions":[{"label":"PF2E.TraitBludgeoning","value":"bludgeoning"},{"label":"PF2E.TraitPiercing","value":"piercing"},{"label":"PF2E.TraitSlashing","value":"slashing"},{"label":"PF2E.TraitAcid","value":"acid"},{"label":"PF2E.TraitCold","value":"cold"},{"label":"PF2E.TraitElectricity","value":"electricity"},{"label":"PF2E.TraitFire","value":"fire"},{"label":"PF2E.TraitSonic","value":"sonic"}],"toggleable":true,"alwaysActive":true},{"key":"Resistance","type":"{item|flags.pf2e.rulesSelections.adaptiveResistances}","value":4},{"key":"Resistance","type":"{item|flags.pf2e.rulesSelections.adaptiveResistances}","value":8,"predicate":[{"nor":["adaptive-resistances:bludgeoning","adaptive-resistances:slashing","adaptive-resistances:piercing"]}]}],"slug":null,"traits":{"otherTags":[],"value":["arcane","polymorph"]}