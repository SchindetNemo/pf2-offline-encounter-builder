:null}},"bonus":{"value":20},"attackEffects":{"value":[]}},"_id":"vIuRn3eCo1ucEgc9","img":"systems/pf2e/icons/default-icons/melee.svg","folder":null,"sort":0,"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.348","systemId":"pf2e","systemVersion":"7.4.2"},"ownership":{"default":0}},{"type":"melee","name":"Saw Launcher","effects":[],"system":{"_migration":{"version":0.942,"previous":null},"description":{"value":"","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":["range-increment-30"]},"damageRolls":{"AuIU2i1K5atIMI1E":{"damage":"2d6+11","damageType":"slashing","category":null}},"bonus":{"value":19},"attackEffects":{"value":[]}},"_id":"phOgwksHm0EQvSpY","img":"systems/pf2e/icons/default-icons/melee.svg","folder":null,"sort":0,"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.348","systemId":"pf2e","systemVersion":"7.4.2"},"ownership":{"default":0}},{"type":"action","name":"Chaotic Gizmos","system":{"actionType":{"value":"action"},"description":{"value":"<p><strong>Frequency</strong> once per round</p><hr /><p><strong>Effect</strong> The cranklejack unleashes an unpredictable flurry of attacks that even the cranklejack themself can't predict. Roll [[/gmr 1d6]] twice. For each roll of 1 or 2, nothing happens. For each roll of 3, the cranklejack makes a hammer Strike, for each roll of 4, the cranklejack make an impaling spike Strike, for each roll of 5, the cranklejack makes a saw Strike, and for each roll of 6, the cranklejack makes a volt fist Strike. If the cranklejack makes two Strikes, they can choose which order to make them.</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":[]},"_migration":{"version":0.942,"previous":{"schema":null,"foundry":"13.347","system":"7.3.1"}},"act