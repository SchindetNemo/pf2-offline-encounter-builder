null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"action","name":"Focus Light","system":{"actionType":{"value":"action"},"description":{"value":"<p><strong>Requirements</strong> The lightling's lantern is lit</p><hr /><p><strong>Effect</strong> The lightling focuses a beam of light that travels to the edge of the lantern's range (typically 120 feet if the lantern isn't broken). All creatures in a line take @Damage[4d4[fire]] damage (@Check[reflex|dc:22|basic] save). Creatures in dim light treat the result of their saving throw as one degree of success better.</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":["concentrate","fire","light","occult"]},"_migration":{"version":0.942,"previous":{"schema":null,"foundry":"13.347","system":"7.3.1"}},"actions":{"value":2},"category":"offensive","deathNote":false},"effects":[],"_id":"NkrtOaJBRg8DdsTT","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}}],"effects":[],"sort":200000,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.351","systemId":"pf2e","systemVersion":"7.8.0"}}