umSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"action","name":"Titan's Reach","system":{"actionType":{"value":"action"},"description":{"value":"<p>The Forgemaster reaches through the very stone to strike at their enemies. The Forgemaster makes a single Strike against any enemy that they can see. This attack can be made at any range and ignores all cover and concealment.</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":["attack","earth","primal"]},"_migration":{"version":0.942,"previous":{"schema":null,"foundry":"13.347","system":"7.3.1"}},"actions":{"value":1},"category":"offensive","deathNote":false},"effects":[],"_id":"uGVNGP1cCbUWmpLe","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"action","name":"Unworthy Wielder","system":{"actionType":{"value":"action"},"description":{"value":"<p>The Forgemaster declares the target unworthy of bearing its weapon, and compels the weapon to rebel. The target takes @Damage[15d6[untyped]] damage of whatever type the weapon typically deals (@Check[will|dc:46] save). If the target is wielding an intelligent weapon, use the higher of the wielder's result and the weapon's result. Regardless of the result, the target is then temporarily immune to this effect for 1 minute.</p><hr /><p><strong>Critical Success</strong> The target is unaffected.</p><p><strong>Success</strong> The target takes half damage.</p><p><strong>Failure</strong> the target takes full damage.</p><p><strong>Critical Failure</strong> The target takes double damage. They drop their weapon and can't pick it back up again for 1 minute; if the target is an intelligent weapon PC, they are instead stunned for 1 minute. The target can attempt a new Will save at the end of each of their turns to end this effect.</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":[]},"_migration":{"version":0.942,"previous":{"schema":null,"foundry":"13.347","system":"7.3.1"}},"actions":{"value":1},"category":"offensive","deathNote":false},"effects":[],"_id":"Vt25RiIoWfcTF1tt","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"img":"icons/weapons/hammers/hammer-war-rounding.webp","name":"forgemaster's Warhammer","system":{"description":{"gm":"","value":"<p>This weapon has a wooden shaft ending in a large, heavy metal head. The head of the hammer might be single-sided or double-sided, but it's always capable of delivering powerful bludgeoning blows.</p>"},"rules":[],"slug":"warhammer","_migration":{"version":0.942,"lastMigration":null,"previous":null},"traits":{"otherTags":[],"value":["shove"],"rarity":"unique"},"publication":{"title":"Pathfinder Player Core","authors":"","license":"ORC","remaster":true},"level":{"value":0},"quantity":1,"baseItem":"warhammer","bulk":{"value":1},"hp":{"value":0,"max":0},"hardness":0,"price":{"value":{"gp":1}},"equipped":{"carryType":"worn","invested":null,"handsHeld":0},"containerId":null,"size":"huge","material":{"type":null,"grade":null},"identification":{"status":"identified","unidentified":{"name":"Unusual Warhammer","img":"systems/pf2e/icons/unidentified_item_icons/weapon.webp","data":{"description":{"value":""}}},"misidentified":{}},"usage":{"value":"held-in-one-hand"},"category":"martial","group":"hammer","bonus":{"value":0},"damage":{"dice":1,"die":"d8","damageType":"bludgeoning","persisten