tats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"img":"systems/pf2e/icons/actions/TwoActions.webp","name":"Engulf","system":{"actionType":{"value":"action"},"actions":{"value":2},"category":"offensive","description":{"value":"<p>@Check[reflex|dc:29], @Damage[(6d6)[acid]] damage, [[/act escape dc=29]], Rupture 17</p><hr /><p>@Localize[PF2E.NPC.Abilities.Glossary.Engulf]</p>","gm":""},"publication":{"license":"ORC","remaster":true,"title":"Pathfinder Monster Core","authors":""},"rules":[],"traits":{"value":[],"otherTags":[]},"slug":"engulf","_migration":{"version":0.942,"previous":null},"deathNote":false},"type":"action","_stats":{"compendiumSource":"Compendium.pf2e.bestiary-ability-glossary-srd.Item.zU3Ovaet4xQ5Gmvy","duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_id":"hFoe73UCSn0Unl6X"},{"type":"action","name":"Disincorporate","system":{"actionType":{"value":"action"},"description":{"value":"<p>Until the next time it acts, the dewdrop ooze disperses its body into tiny droplets. It has an automatic result of 42 on Deception checks and DCs to pass as mundane dew. If the dewdrop ooze had any creatures @UUID[Compendium.pf2e.conditionitems.Item.kWc1fhmv9LBiTuei]{Grabbed} or engulfed, they are automatically released.</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":[]},"_migration":{"version":0.942,"previous":{"schema":null,"foundry":"13.347","system":"7.3.1"}},"actions":{"value":1},"category":"offensive","deathNote":false},"effects":[],"_id":"2ZM2BgOfZ0zCBMx6","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplica