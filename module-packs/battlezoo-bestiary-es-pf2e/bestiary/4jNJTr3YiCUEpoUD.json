e creature is confused for [[/gmr 1d4 #rounds]]{1d4 rounds}.</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[{"key":"Aura","traits":["divine","emotion","incapacitation","mental","visual"],"effects":[],"radius":30}],"slug":null,"traits":{"otherTags":[],"value":["aura","divine","emotion","incapacitation","mental","visual"]},"_migration":{"version":0.942,"previous":{"schema":0.941,"foundry":"13.347","system":"7.3.1"}},"actions":{"value":null},"category":"defensive","deathNote":false},"effects":[],"_id":"seJrR7hhExVGQS7A","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"action","name":"Infinite Refraction","system":{"actionType":{"value":"reaction"},"description":{"value":"<p><strong>Trigger</strong> The fractrix is targeted by an effect with the light trait</p><hr /><p><strong>Effect</strong> The fractrix's body refracts the light in a dazzling display. Each creature within 30 feet must succeed at a @Check[fortitude|dc:32] save or become @UUID[Compendium.pf2e.conditionitems.Item.TkIyaNPgTZFBCCuh]{Dazzled} for 1 round, or for 1 minute on a critical failure.</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":["light","visual"]},"_migration":{"version":0.942,"previous":{"schema":0.941,"foundry":"13.347","system":"7.3.1"}},"actions":{"value":null},"category":"offensive","deathNote":false},"effects":[],"_id":"511wXpVp07TVZ6GX","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"action","name":"Spatial Reckoning","system":{"actionType":{"value":"passive"},"description":{"value":"<p>A fractrix automatically detects and identifies space-altering magic (including teleportation effects) and is only affected by the magic if they choose to be.</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":["divine","revelation"]},"_migration":{"version":0.942,"previous":{"schema":0.941,"foundry":"13.347","system":"7.3.1"}},"actions":{"value":null},"category":"defensive","deathNote":false},"effects":[],"_id":"YUoTsvVBjYqXHgp8","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"melee","name":"Spike","effects":[],"system":{"_migration":{"version":0.942,"previous":{"schema":0.941,"foundry":"13.347","system":"7.3.1"}},"description":{"value":"","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":["magical"]},"damageRolls":{"a3NDsAwFh57mbkHH":{"damage":"3d10+14","damageType":"piercing","category":null}},"bonus":{"value":26},"attackEffects":{"value":[]}},"_id":"wHpHkg7wiJ5x8Ev2","img":"systems/pf2e/icons/default-icons/melee.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"melee","name":"Fractal Tendril","effects":[],"system":{"_migration":{"version":0.942,"previous":{"schema":0.941,"foundry":"13.347","system":"7.3.1"}},"description":{"value":"","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":["agile","magical","reach-10"]},"damageRolls":{"DM3G4uwK6UBq6CiS":{"damage":"3d6+14","damageType":"bludgeoning","category":null}},"bonus":{"value":26},"attackEffects":{"value":["improved-grab"]}},"_id":"q3VPVoLwYP5EzNgC","img":"systems/pf2e/icons/default-icons/melee.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"img":"systems/pf2e/icons/actions/FreeAction.webp","name":"Improved Grab","system":{"actionType":{"value":"free"},"actions":{"value":null},"category":"offensive","description":{"value":"<p>@Localize[PF2E.NPC.Abilities.Glossary.ImprovedGrab]</p>","gm":""},"publication":{"license":"ORC","remaster":true,"title":"Pathfinder Monster Core","authors":""},"rules":[],"traits":{"value":[],"otherTags":[]},"slug":"improved-grab","_migration":{"version":0.942,"previous":{"schema":0.941,"foundry":"13.347","system":"7.3.1"}}},"type":"action","_stats":{"compendiumSource":"Compendium.pf2e.bestiary-ability-glossary-srd.Item.i18TlebMzwONyPhI","duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_id":"jCuQgRnyyLoEeGsJ"},{"type":"action","name":"Angle of Invisibility","system":{"actionType":{"value":"action"},"description":{"value":"<p>When viewed from certain angles, a fractrix is imperceptible to the eye. The fractrix carefully aligns themselves. Until they move or use this ability again, they are @UUID[Compendium.pf2e.conditionitems.Item.zJxUflt9np0q4yML]{Invisible} to creatures viewing them from within a @Template[type:cone|distance:60] of their choice. If an affected creature also occupies spaces outside of the area, the fractrix is instead @UUID[Compendium.pf2e.conditionitems.Item.DmAIPqOBomZ7H95W]{Concealed} to that creature.</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":[]},"_migration":{"version":0.942,"previous":{"schema":0.941,"foundry":"13.347","system":"7.3.1"}},"actions":{"value":1},"category":"offensive","deathNote":false},"effects":[],"_id":"bMMiighwdh1tphj0","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"action","name":"Recursive Coil","system":{"actionType":{"value":"action"},"description":{"value":"<p>The fractrix endlessly tightens their fractal tendril around a creature they have @UUID[Compendium.pf2e.conditionitems.Item.kWc1fhmv9LBiTuei]{Grabbed} or @UUID[Compendium.pf2e.conditionitems.Item.VcDeM8A5oI6VqhbM]{Restrained}. The target takes @Damage[3d10[bludgeoning]] damage, and it takes @Damage[1d10[persistent,bludgeoning]] damage at the end of each of its turns until it Escapes.</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":[]},"_migration":{"version":0.942,"previous":{"schema":0.941,"foundry":"13.347","system":"7.3.1"}},"actions":{"value":1},"category":"offensive","deathNote":false},"effects":[],"_id":"7aPS1vB7zSCnVC4H","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"action","name":"Warp Geometry","system":{"actionType":{"value":"action"},"description":{"value":"<p><strong>Frequency</strong> Once per minute</p><hr /><p><strong>Effect</strong> The fractrix warps space in a @Template[type:burst|distance:30] within 120 feet, distorting geometry in the area for 1 minute. When a creature uses an action with the move trait to enter a square in the area, it must attempt a @Check[will|dc:32] save. Each creature can only be affected by Warp Geometry once per round.</p><hr /><p><strong>Success</strong> The creature is unaffected and is temporarily immune to Warp Geometry for 1 hour.</p><p><strong>Failure</strong> The fractrix bends space, depositing the creature in another square within the warped area of the fractrix's choice. This is forced movement. If the creature has not yet moved their entire Speed, it can continue its movement from its new location.</p><p><strong>Critical Failure</strong> As failure, but the creature is too disoriented to continue their movement.</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":["concentrate","divine","teleportation"]},"_migration":{"version":0.942,"previous":{"schema":0.941,"foundry":"13.347","system":"7.3.1"}},"actions":{"value":2},"category":"offensive","deathNote":false,"frequency":{"max":1,"per":"PT1M"}},"effects":[],"_id":"nFqKsUZdqHevJyOq","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"name":"Divine Innate Spells","type":"spellcastingEntry","system":{"description":{"gm":"","value":""},"rules":[],"slug":null,"_migration":{"version":0.942,"lastMigration":null,"previous":{"schema":0.941,"foundry":"13.347","system":"7.3.1"}},"traits":{"otherTags":[]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"ability":{"value":"cha"},"spelldc":{"value":24,"dc":32},"tradition":{"value":"divine"},"prepared":{"value":"innate"},"showSlotlessLevels":{"value":false},"proficiency":{"value":1},"slots":{"slot0":{"prepared":[],"value":0,"max":0},"slot1":{"prepared":[],"value":0,"max":0},"slot2":{"prepared":[],"value":0,"max":0},"slot3":{"prepared":[],"value":0,"max":0},"slot4":{"prepared":[],"value":0,"max":0},"slot5":{"prepared":[],"value":0,"max":0},"slot6":{"prepared":[],"value":0,"max":0},"slot7":{"prepared":[],"value":0,"max":0},"slot8":{"prepared":[],"value":0,"max":0},"slot9":{"prepared":[],"value":0,"max":0},"slot10":{"prepared":[],"value":0,"max":0},"slot11":{"prepared":[],"value":0,"max":0}},"autoHeightenLevel":{"value":null}},"_id":"9oStlcUiRNXiW2Jr","img":"systems/pf2e/icons/default-icons/spellcastingEntry.svg","effects":[],"folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"folder":"zDlxATrLAlbYA2Mv","img":"systems/pf2e/icons/spells/teleport.webp","name":"Teleport","system":{"description":{"gm":"","value":"<p>You and the targets are instantly transported to any location within range, as long as you can identify the location precisely both by its position relative to your starting position and by its appearance (or other identifying features). Incorrect knowledge of the location's appearance usually causes the spell to fail, but it could instead lead to teleporting to an unwanted location or some other unusual mishap determined by the GM. <em>Teleport</em> is not precise over great distances. The targets appear at a distance from the intended destination equal to roughly 1 percent of the total distance traveled, in a direction determined by the GM. For short journeys, this lack of precision is irrelevant, but for long distances this could be up to 1 mile.</p>\n<hr />\n<p><strong>Heightened (7th)</strong> You and the other targets can travel to any location within 1,000 miles.</p>\n<p><strong>Heightened (8th)</strong> You and the other targets can travel to any location on the same planet. If you travel more than 1,000 miles, you arrive only 10 miles off target.</p>\n<p><strong>Heightened (9th)</strong> You and the other targets can travel to any location on another planet within the same solar system. Assuming you have accurate knowledge of the location's position and appearance, you arrive on the new planet 100 miles off target.</p>\n<p><strong>Heightened (10th)</strong> As the 9th-rank version, but you and the other targets can travel to any planet within the same galaxy.</p>"},"rules":[],"slug":"teleport","_migration":{"version":0.942,"lastMigration":null,"previous":{"schema":0.941,"foundry":"13.347","system":"7.3.1"}},"traits":{"otherTags":[],"value":["concentrate","manipulate","teleportation"],"rarity":"uncommon","traditions":["arcane","occult"]},"publication":{"title":"Pathfinder Player Core","authors":"","license":"ORC","remaster":true},"level":{"value":6},"requirements":"","target":{"value":"you and up to 4 targets touched, either willing creatures or objects roughly the size of a creature."},"range":{"value":"100 miles"},"area":null,"time":{"value":"10 minutes"},"duration":{"value":"","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"9oStlcUiRNXiW2Jr","heightenedLevel":6},"counteraction":false},"type":"spell","_stats":{"compendiumSource":"Compendium.pf2e.spells-srd.Item.69L70wKfGDY66Mk9","duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"},"effects":[],"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_id":"korJTeQ9QeqMZ4UX"},{"folder":"7cyoYPoPYA01mErU","img":"icons/equipment/shield/heater-steel-segmented-purple.webp","name":"Planar Tether","system":{"description":{"gm":"","value":"<p>You stitch the target to its current plane. While the target is affected by <em>planar tether</em>, the spell attempts to counteract any teleportation effect that would move the target, or any effect that would transport it to a different plane. <em>Planar tether</em>'s duration is determined by the target's Will save.</p>\n<hr />\n<p><strong>Critical Success</strong> The target is unaffected.</p>\n<p><strong>Success</strong> The effect's duration is 1 minute.</p>\n<p><strong>Failure</strong> The effect's duration is 10 minutes.</p>\n<p><strong>Critical Failure</strong> The effect's duration is 1 hour.</p>"},"rules":[],"slug":"planar-tether","_migration":{"version":0.942,"lastMigration":null,"previous":{"schema":0.941,"foundry":"13.347","system":"7.3.1"}},"traits":{"otherTags":[],"value":["concentrate","manipulate"],"rarity":"common","traditions":["arcane","divine","occult"]},"publication":{"title":"Pathfinder Player Core","authors":"","license":"ORC","remaster":true},"level":{"value":4},"requirements":"","target":{"value":"1 creature"},"range":{"value":"30 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"varies","sustained":false},"damage":{},"defense":{"save":{"basic":false,"statistic":"will"}},"cost":{"value":""},"location":{"value":"9oStlcUiRNXiW2Jr","heightenedLevel":4},"counteraction":false},"type":"spell","_stats":{"compendiumSource":"Compendium.pf2e.spells-srd.Item.ksLCg62cLOojw3gN","duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"},"effects":[],"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_id":"Os7XvweSI7QNwfiY"},{"folder":"7cyoYPoPYA01mErU","img":"icons/magic/symbols/ring-circle-smoke-blue.webp","name":"Translocate","system":{"description":{"gm":"","value":"<p>You instantly transport yourself and any items you're wearing and holding from your current space to an unoccupied space within range you can see. If this would bring another creature with you—even if you're carrying it in an extradimensional container—the spell is lost.</p>\n<hr />\n<p><strong>Heightened (5th)</strong> The range increases to 1 mile. You don't need to be able to see your destination, as long as you have been there in the past and know its relative location and distance from you. You are then temporarily immune for 1 hour.</p>"},"rules":[],"slug":"translocate","_migration":{"version":0.942,"lastMigration":null,"previous":{"schema":0.941,"foundry":"13.347","system":"7.3.1"}},"traits":{"otherTags":[],"value":["concentrate","manipulate","teleportation"],"rarity":"common","traditions":["arcane","occult"]},"publication":{"title":"Pathfinder Player Core","authors":"","license":"ORC","remaster":true},"level":{"value":4},"requirements":"","target":{"value":""},"range":{"value":"120 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"9oStlcUiRNXiW2Jr","heightenedLevel":4,"uses":{"max":3,"value":3}},"counteraction":false,"heightening":{"levels":{"5":{"range":{"value":"1 mile"}}},"type":"fixed"}},"type":"spell","_stats":{"compendiumSource":"Compendium.pf2e.spells-srd.Item.VlNcjmYyu95vOUe8","duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"},"effects":[],"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_id":"WHtoFYPrasTvX1KI"},{"folder":"4fJHnYFqH0VjZXPv","img":"systems/pf2e/icons/spells/hypnotic-pattern.webp","name":"Hypnotize (At Will)","system":{"description":{"gm":"","value":"<p>You create a cloud of mesmerizing patterns and colors that hovers in the air. Creatures are @UUID[Compendium.pf2e.conditionitems.Item.TkIyaNPgTZFBCCuh]{Dazzled} while inside the cloud. In addition, a creature must attempt a Will saving throw if it is inside the cloud when you cast it, when it enters the cloud, when it ends its turn within the cloud, or if it uses a @UUID[Compendium.pf2e.actionspf2e.Item.BlAOM2X92SI6HMtJ]{Seek} or Interact action on the cloud. A creature currently @UUID[Compendium.pf2e.conditionitems.Item.AdPVz7rbaVSRxHFg]{Fascinated} by hypnotize doesn't attempt new saves.</p>\n<p><strong>Success</strong> The target is unaffected.</p>\n<p><strong>Failure</strong> The target is fascinated by the cloud.</p>\n<p><strong>Critical Failure</strong> The target is fascinated by the cloud. While it remains fascinated, it can't use reactions.</p>"},"rules":[],"slug":"hypnotize","_migration":{"version":0.942,"lastMigration":null,"previous":{"schema":0.941,"foundry":"13.347","system":"7.3.1"}},"traits":{"otherTags":[],"value":["illusion","manipulate","subtle","visual"],"rarity":"common","traditions":["arcane","occult"]},"publication":{"title":"Pathfinder Player Core","authors":"","license":"ORC","remaster":true},"level":{"value":3},"requirements":"","target":{"value":""},"range":{"value":"120 feet"},"area":{"type":"burst","value":10},"time":{"value":"2"},"duration":{"value":"1 minute","sustained":true},"damage":{},"defense":{"save":{"basic":false,"statistic":"will"}},"cost":{"value":""},"location":{"value":"9oStlcUiRNXiW2Jr","heightenedLevel":3},"counteraction":false},"type":"spell","_stats":{"compendiumSource":"Compendium.pf2e.spells-srd.Item.K2WpC3FFoHrqX9Q5","duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"},"effects":[],"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_id":"9dbeBUG0oIIq5MOQ"},{"folder":"lPzcDrjGDFbzuF2r","img":"icons/magic/unholy/silhouette-evil-horned-giant.webp","name":"Enlarge (Self Only, At Will)","system":{"description":{"gm":"","value":"<p>Bolstered by magical power, the target grows to size Large. Its equipment grows with it but returns to natural size if removed. The creature is @UUID[Compendium.pf2e.conditionitems.Item.i3OJZU2nk64Df3xm]{Clumsy 1}. Its reach increases by 5 feet (or by 10 feet if it started out Tiny), and it gains a +2 status bonus to melee damage. This spell has no effect on a Large or larger creature.</p>\n<p>@UUID[Compendium.pf2e.spell-effects.Item.sPCWrhUHqlbGhYSD]{Spell Effect: Enlarge}</p>\n<hr />\n<p><strong>Heightened (4th)</strong> The creature instead grows to size Huge. The status bonus to melee damage is +4 and the creature's reach increases by 10 feet (or 15 feet if the creature started out Tiny). The spell has no effect on a Huge or larger creature.</p>\n<p><strong>Heightened (6th)</strong> Choose either the 2nd-rank or 4th-rank version of this spell and apply its effects to up to 10 willing creatures.</p>"},"rules":[],"slug":"enlarge","_migration":{"version":0.942,"lastMigration":null,"previous":{"schema":0.941,"foundry":"13.347","system":"7.3.1"}},"traits":{"otherTags":[],"value":["concentrate","manipulate","polymorph"],"rarity":"common","traditions":["arcane","primal"]},"publication":{"title":"Pathfinder Player Core","authors":"","license":"ORC","remaster":true},"level":{"value":2},"requirements":"","target":{"value":"1 willing creature"},"range":{"value":"30 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"5 minutes","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"9oStlcUiRNXiW2Jr","heightenedLevel":2},"counteraction":false,"heightening":{"levels":{"6":{"target":{"value":"10 willing creatures"}}},"type":"fixed"}},"type":"spell","_stats":{"compendiumSource":"Compendium.pf2e.spells-srd.Item.wzctak6BxOW8xvFV","duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"},"effects":[],"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_id":"4iT9iQYDnehVCLoN"},{"folder":"lPzcDrjGDFbzuF2r","img":"icons/magic/unholy/strike-body-life-soul-purple.webp","name":"Shrink (Self Only, At Will)","system":{"description":{"gm":"","value":"<p>You warp space to make a creature smaller. The target shrinks to become Tiny in size. Its equipment shrinks with it but returns to its original size if removed. The creature's reach changes to 0 feet. This spell has no effect on a Tiny creature.</p>\n<p>@UUID[Compendium.pf2e.spell-effects.Item.LXf1Cqi1zyo4DaLv]{Spell Effect: Shrink}</p>\n<hr />\n<p><strong>Heightened (6th)</strong> The spell can target up to 10 creatures.</p>"},"rules":[],"slug":"shrink","_migration":{"version":0.942,"lastMigration":null,"previous":{"schema":0.941,"foundry":"13.347","system":"7.3.1"}},"traits":{"otherTags":[],"value":["concentrate","manipulate","polymorph"],"rarity":"common","traditions":["arcane","primal"]},"publication":{"title":"Pathfinder Player Core","authors":"","license":"ORC","remaster":true},"level":{"value":2},"requirements":"","target":{"value":"1 willing creature"},"range":{"value":"30 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"5 minutes","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"9oStlcUiRNXiW2Jr","heightenedLevel":2},"counteraction":false,"heightening":{"levels":{"6":{"target":{"value":"10 willing creatures"}}},"type":"fixed"}},"type":"spell","_stats":{"compendiumSource":"Compendium.pf2e.spells-srd.Item.PjhUmyKnq6K5uDby","duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"},"effects":[],"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_id":"OPqiyNYUrGTyYC6v"},{"folder":"zDlxATrLAlbYA2Mv","img":"systems/pf2e/icons/spells/true-seeing.webp","name":"Truesight (Constant)","system":{"description":{"gm":"","value":"<p>You see things within 60 feet as they actually are. The GM rolls a secret counteract check against any illusion, morph or polymorph effect in the area, but only for the purpose of determining whether you see through it (for instance, if the check succeeds against a polymorph spell, you can see the creature's true form, but you don't end the polymorph spell).</p>"},"rules":[],"slug":"truesight","_migration":{"version":0.942,"lastMigration":null,"previous":{"schema":0.941,"foundry":"13.347","system":"7.3.1"}},"traits":{"otherTags":[],"value":["concentrate","manipulate","revelation"],"rarity":"common","traditions":["arcane","divine","occult","primal"]},"publication":{"title":"Pathfinder Player Core","authors":"","license":"ORC","remaster":true},"level":{"value":6},"requirements":"","target":{"value":""},"range":{"value":""},"area":null,"time":{"value":"2"},"duration":{"value":"10 minutes","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"9oStlcUiRNXiW2Jr","heightenedLevel":6},"counteraction":true},"type":"spell","_stats":{"compendiumSource":"Compendium.pf2e.spells-srd.Item.uqlxMQQeSGWEVjki","duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"},"effects":[],"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_id":"ZSJSjrSWov7UgeVL"},{"img":"systems/pf2e/icons/actions/Passive.webp","name":"Constant Spells","system":{"actionType":{"value":"passive"},"actions":{"value":null},"category":"interaction","description":{"value":"<p>@Localize[PF2E.NPC.Abilities.Glossary.ConstantSpells]</p>","gm":""},"publication":{"license":"ORC","remaster":true,"title":"Pathfinder Monster Core","authors":""},"rules":[],"traits":{"value":[],"otherTags":[]},"slug":"constant-spells","_migration":{"version":0.942,"previous":{"schema":0.941,"foundry":"13.347","system":"7.3.1"}}},"type":"action","_stats":{"compendiumSource":"Compendium.pf2e.bestiary-ability-glossary-srd.Item.kakyXBG5WA8c6Zfd","duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_id":"evCjaoQrrXYh6XaZ"}],"effects":[],"sort":100000,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.351","systemId":"pf2e","systemVersion":"7.8.0"}}