,"foundry":"13.347","system":"7.3.1"}},"actions":{"value":null},"category":"offensive","deathNote":false},"effects":[],"_id":"ZYxpU5HJCtHSB5Dw","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"action","name":"Crank the Heat","system":{"actionType":{"value":"action"},"description":{"value":"<p><strong>Requirements</strong> The calliophant has at least 1 gallon in its water reservoir</p><hr /><p><strong>Effect</strong> The calliophant expends 1 gallon of water from its water reservoir to create steam. Until the start of the calliophant's next turn, creatures that hit it with an unarmed attack or a melee attack or who otherwise touch it take @Damage[3d6[fire]] damage. A @UUID[Compendium.pf2e.conditionitems.Item.kWc1fhmv9LBiTuei]{Grabbed} creature takes this damage once at the start of that creature's turn.</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":["arcane","fire","water"]},"_migration":{"version":0.942,"previous":{"schema":null,"foundry":"13.347","system":"7.3.1"}},"actions":{"value":1},"category":"offensive","deathNote":false},"effects":[],"_id":"UVQwRryi3H3ySRHz","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"action","name":"Drink Water","system":{"actionType":{"value":"action"},"description":{"value":"<p>The calliophant's uses its trunk to siphon up to two gallons of water from a source within fifteen feet into its water reservoir.</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":[]},"_migration":{"version":0.942,"previous":{"schema":null,"foundry":"13.347","system":"7.3.1"}},"actions":{"value":1},"category":"offensive","deathNote":false},"effects":[],"_id":"geBcieByYJBNFiNZ","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"action","name":"Steam Scream","system":{"actionType":{"value":"action"},"description":{"value":"<p><strong>Requirements</strong> The calliophant has at least 1 gallon in its water reservoir per action</p><hr /><p><strong>Effect</strong> The calliophant expends 1 gallon of water per action to produce an ear-splitting steam-powered tune, dealing sonic damage to all creatures in an emanation (@Check[fortitude|dc:30|basic] save). The radius of the emanation and amount of sonic damage depend upon the number of actions spent.</p><p><span class=\"pf2-icon\">1</span> @Damage[5d6[sonic]|options:area-damage] damage in a @Template[type:emanation|distance:5]</p><p><span class=\"pf2-icon\">2</span> @Damage[10d6[sonic]|options:area-damage] damage in a @Template[type:emanation|distance:15]</p><p><span class=\"pf2-icon\">3</span> @Damage[15d6[sonic]|options:area-damage] damage in a @Template[type:emanation|distance:30]</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":["arcane","sonic","water"]},"_migration":{"version":0.942,"previous":{"schema":null,"foundry":"13.347","system":"7.3.1"}},"actions":{"value":1},"category":"offensive","deathNote":false},"effects":[],"_id":"sAjLcZ0AffYRaZyJ","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumS