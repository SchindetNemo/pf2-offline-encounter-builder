Version":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"action","name":"Sparkling Armor","system":{"actionType":{"value":"passive"},"description":{"value":"<p>While the electrum juggernaut is within bright or dim light, they sparkle majestically. Their attempts to @UUID[Compendium.pf2e.actionspf2e.Item.2u915NdUyQan6uKF]{Demoralize} have the visual trait instead of the auditory trait, ignore the penalty for not sharing a language, and also dazzle the target for 1 round on a success or critical success.</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":["divine","light","visual"]},"_migration":{"version":0.942,"previous":{"schema":null,"foundry":"13.347","system":"7.3.1"}},"actions":{"value":null},"category":"offensive","deathNote":false},"effects":[],"_id":"QfT9wJFT1JjF8WWu","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"action","name":"Wide Swing","system":{"actionType":{"value":"action"},"description":{"value":"<p>The electrum juggernaut makes a longsword Strike and compares the attack roll result to the ACs of up to two foes within their reach. They roll damage only once and apply it to each creature they hit. A Wide Swing counts as two attacks for their multiple attack penalty.</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":[]},"_migration":{"version":0.942,"previous":{"schema":null,"foundry":"13.347","system":"7.3.1"}},"actions":{"value":2},"category":"offensive","deathNote":false},"effects":[],"_id":"VJslT5apwkJb71E8","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}}],"effects":[],"sort":9200000,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.351","systemId":"pf2e","systemVersion":"7.8.0"}}