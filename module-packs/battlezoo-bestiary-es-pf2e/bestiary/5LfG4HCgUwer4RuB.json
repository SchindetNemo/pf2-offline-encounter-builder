":[],"folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"folder":"lPzcDrjGDFbzuF2r","img":"icons/skills/melee/unarmed-punch-fist-blue.webp","name":"Knock","system":{"description":{"gm":"","value":"<p>You make the target easier to open. Knock grants a +4 status bonus to any creature that tries to open the target door, lock, or container with an Athletics or a Thievery check. You can attempt a Thievery check to open the target as part of casting knock, and you add your level even if you're untrained.</p>\n<p><em>Knock</em> counteracts @UUID[Compendium.pf2e.spells-srd.Item.Azoh0BSoCASrA1lr]{Lock}.</p>\n<p>@UUID[Compendium.pf2e.spell-effects.Item.OSapCU8heNHst21y]{Spell Effect: Knock}</p>"},"rules":[],"slug":"knock","_migration":{"version":0.942,"lastMigration":null,"previous":null},"traits":{"otherTags":[],"value":["concentrate","manipulate"],"rarity":"common","traditions":["arcane","occult"]},"publication":{"title":"Pathfinder Player Core","authors":"","license":"ORC","remaster":true},"level":{"value":2},"requirements":"","target":{"value":"1 door, lock, or container"},"range":{"value":"30 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"1 minute","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"XGIrSzF2JfHbJnfg","heightenedLevel":2},"counteraction":false},"type":"spell","_stats":{"compendiumSource":"Compendium.pf2e.spells-srd.Item.6Ot4N22t5tPD51BO","duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"},"effects":[],"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_id":"8Sfa04liAITp6MpA"},{"folder":"T8AzYUgNIAgTJ9Iz","img":"systems/pf2e/icons/spells/pest-form.webp","name":"Pest Form (At Will)","system":{"description":{"gm":"","value":"<p>You transform into the battle form of a Tiny animal, such as a cat, insect, lizard, or rat. You can decide the specific type of animal (such as a rat or praying mantis), but this has no effect on the form's Size or statistics. While in this form, you gain the animal trait and you can't make Strikes. You can Dismiss the spell.</p>\n<p>You gain the following statistics and abilities:</p>\n<ul>\n<li>AC = 15 + your level. Ignore your armor's check penalty and Speed reduction.</li>\n<li>Speed 20 feet.</li>\n<li>Weakness 5 to physical damage. (If you take physical damage in this form, you take 5 additional damage.)</li>\n<li>Low-light vision and imprecise scent 30 feet.</li>\n<li>Acrobatics and Stealth modifiers of +10, unless your own modifier is higher; Athletics modifier -4.</li>\n</ul>\n<hr />\n<p><strong>Heightened (4th)</strong> You can turn into a flying creature, such as a bird, which grants you a fly Speed of 20 feet.</p>\n<p>@UUID[Compendium.pf2e.spell-effects.Item.ydsLEGjY89Akc4oZ]{Spell Effect: Pest Form}</p>"},"rules":[],"slug":"pest-form","_migration":{"version":0.942,"lastMigration":null,"previous":null},"traits":{"otherTags":[],"value":["concentrate","manipulate","polymorph"],"rarity":"common","traditions":["arcane","primal"]},"publication":{"title":"Pathfinder Player Core","authors":"","license":"ORC","remaster":true},"level":{"value":1},"requirements":"","target":{"value":""},"range":{"value":""},"area":null,"time":{"value":"2"},"duration":{"value":"10 minutes","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"XGIrSzF2JfHbJnfg","heightenedLevel":1},"counteraction":false},"type":"spell","_stats":{"compendiumSource":"Compendium.pf2e.spells-srd.Item.gfPjmG6Fe6D3MFjl","duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"},"effects":[],"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_id":"drd84zzPSeb6bv4s"},{"folder":"lPzcDrjGDFbzuF2r","img":"icons/creatures/mammals/ox-buffalo-horned-green.webp","name":"Speak with Animals (Constant)","system":{"description":{"gm":"","value":"<p>You can ask questions of, receive answers from, and use the Diplomacy skill with animals. The spell doesn't make them more friendly than normal. Cunning animals are likely to be terse and evasive, while less intelligent ones often make inane comments.</p>"},"rules":[],"slug":"speak-with-animals","_migration":{"version":0.942,"lastMigration":null,"previous":null},"traits":{"otherTags":[],"value":["concentrate","manipulate"],"rarity":"common","traditions":["primal"]},"publication":{"title":"Pathfinder Player Core","authors":"","license":"ORC","remaster":true},"level":{"value":2},"requirements":"","target":{"value":""},"range":{"value":""},"area":null,"time":{"value":"2"},"duration":{"value":"1 hour","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"XGIrSzF2JfHbJnfg","heightenedLevel":2},"counteraction":false},"type":"spell","_stats":{"compendiumSource":"Compendium.pf2e.spells-srd.Item.BBvV7qoXGdw09q1C","duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"},"effects":[],"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_id":"VQcDkuPo2VSGTV8i"},{"type":"action","name":"Pilatatry Toxin","system":{"actionType":{"value":"passive"},"description":{"value":"<p><strong>Saving Throw</strong> @Check[fortitude|dc:20]</p><p><strong>Maximum Duration</strong> 6 rounds</p><p><strong>Stage 1</strong> @Damage[1d4[poison]] damage and @UUID[Compendium.pf2e.conditionitems.Item.fesd1n5eVhpCSS18]{Sickened 1} (1 round)</p><p><strong>Stage 2</strong> @Damage[2d4[poison]] damage and sickened 1 (1 round)</p><p><strong>Stage 3</strong> @Damage[4d4[poison]] damage and @UUID[Compendium.pf2e.conditionitems.Item.fesd1n5eVhpCSS18]{Sickened 2} (1 round).</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":["poison"]},"_migration":{"version":0.942,"previous":{"schema":null,"foundry":"13.347","system":"7.3.1"}},"actions":{"value":null},"category":"offensive","deathNote":false},"effects":[],"_id":"LeGFgtll5qfEwKGK","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"action","name":"Strange Taste","system":{"actionType":{"value":"reaction"},"description":{"value":"<p><strong>Trigger</strong> A creature within 10 feet of the pilatatry Interacts to consume food or drink, including consumable items</p><hr /><p><strong>Effect</strong> The pilatatry quickly adds extra ingredients to the mix. The pilatatry attempts a Thievery check against the creature's Reflex DC. On a success, the target is exposed to pilatatry toxin.</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":[]},"_migration":{"version":0.942,"previous":{"schema":null,"foundry":"13.347","system":"7.3.1"}},"actions":{"value":null},"category":"defensive","deathNote":false},"effects":[],"_id":"hpMvurXXbPSTrZHZ","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"action","name":"Corrupted Products","system":{"actionType":{"value":"passive"},"description":{"value":"<p>The pilatatry spends 1 hour tending to livestock, corrupting their products in secret. For 24 hours, all products produced from those livestock carry a latent form of pilatatry toxin, which the pilatatry can activate using Twisted Snack. Those who consume these modified products can detect an odd, unpleasant aftertaste with a @Check[perception|dc:24] check. Additionally, if a pilatatry corrupts the same animals' products each day for 1 week, they can attempt to Craft a common alchemical poison of their choice of 4th level or lower, using those products as the only ingredients.</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":[]},"_migration":{"version":0.942,"previous":{"schema":null,"foundry":"13.347","system":"7.3.1"}},"actions":{"value":null},"category":"interaction","deathNote":false},"effects":[],"_id":"VXVlBx6KvEvoS97t","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"type":"action","name":"Twisted Snack","system":{"actionType":{"value":"action"},"description":{"value":"<p>The pilatatry causes the toxins in corrupted food to suddenly flare up. Each creature within 30 feet that has eaten food laced with Corrupted Products is exposed to pilatatry toxin. The poison gains the virulent trait when applied from this ability.</p>","gm":""},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"rules":[],"slug":null,"traits":{"otherTags":[],"value":["poison","primal"]},"_migration":{"version":0.942,"previous":{"schema":null,"foundry":"13.347","system":"7.3.1"}},"actions":{"value":2},"category":"offensive","deathNote":false},"effects":[],"_id":"rUUMjwJrl4BITI7x","img":"systems/pf2e/icons/default-icons/action.svg","folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"}},{"img":"icons/commodities/materials/bowl-powder-teal.webp","name":"Arsenic","system":{"description":{"gm":"","value":"<p>This toxin is a compound of arsenic and other substances. You can't reduce your sickened condition while affected.</p>\n<hr />\n<p><strong>Activate</strong> <span class=\"action-glyph\">A</span> (manipulate)</p>\n<p><strong>Saving Throw</strong> @Check[fortitude|dc:18]</p>\n<p><strong>Onset</strong> 10 minutes</p>\n<p><strong>Maximum Duration</strong> 5 minutes</p>\n<p><strong>Stage 1</strong> @Damage[1d4[poison]] damage and @UUID[Compendium.pf2e.conditionitems.Item.fesd1n5eVhpCSS18]{Sickened 1} (1 minute)</p>\n<p><strong>Stage 2</strong> @Damage[1d6[poison]] damage and @UUID[Compendium.pf2e.conditionitems.Item.fesd1n5eVhpCSS18]{Sickened 2} (1 minute)</p>\n<p><strong>Stage 3</strong> @Damage[1d8[poison]] damage and @UUID[Compendium.pf2e.conditionitems.Item.fesd1n5eVhpCSS18]{Sickened 3} (1 minute)</p>"},"rules":[],"slug":"arsenic","_migration":{"version":0.942,"lastMigration":null,"previous":null},"traits":{"otherTags":[],"value":["alchemical","consumable","ingested","poison"],"rarity":"common"},"publication":{"title":"Pathfinder GM Core","authors":"","license":"ORC","remaster":true},"level":{"value":1},"quantity":1,"baseItem":null,"bulk":{"value":0.1},"hp":{"value":0,"max":0},"hardness":0,"price":{"value":{"gp":3}},"equipped":{"carryType":"worn"},"containerId":null,"size":"med","material":{"type":null,"grade":null},"identification":{"status":"identified","unidentified":{"name":"","img":"","data":{"description":{"value":""}}},"misidentified":{}},"category":"poison","uses":{"value":1,"max":1,"autoDestroy":true},"damage":null,"usage":{"value":"held-in-one-hand"},"stackGroup":null,"spell":null},"type":"consumable","_stats":{"compendiumSource":"Compendium.pf2e.equipment-srd.Item.OIirLySQDLZgT15S","duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_id":"kGZuNt3LDiLJIc2a"},{"img":"systems/pf2e/icons/equipment/alchemical-items/alchemical-poisons/graveroot.webp","name":"Graveroot","system":{"description":{"gm":"","value":"<p>The opaque white sap from the graveroot shrub clouds the mind.</p>\n<hr />\n<p><strong>Activate</strong> <span class=\"action-glyph\">2</span> (manipulate)</p>\n<p><strong>Saving Throw</strong> @Check[fortitude|dc:19]</p>\n<p><strong>Maximum Duration</strong> 4 rounds</p>\n<p><strong>Stage 1</strong> @Damage[1d8[poison]] damage (1 round)</p>\n<p><strong>Stage 2</strong> @Damage[1d10[poison]] damage and @UUID[Compendium.pf2e.conditionitems.Item.e1XGnhKNSQIm5IXg]{Stupefied 1} (1 round)</p>\n<p><strong>Stage 3</strong> @Damage[2d6[poison]] damage and @UUID[Compendium.pf2e.conditionitems.Item.e1XGnhKNSQIm5IXg]{Stupefied 2} (1 round)</p>"},"rules":[],"slug":"graveroot","_migration":{"version":0.942,"lastMigration":null,"previous":null},"traits":{"otherTags":[],"value":["alchemical","consumable","injury","poison"],"rarity":"common"},"publication":{"title":"Pathfinder GM Core","authors":"","license":"ORC","remaster":true},"level":{"value":3},"quantity":1,"baseItem":null,"bulk":{"value":0.1},"hp":{"value":0,"max":0},"hardness":0,"price":{"value":{"gp":10}},"equipped":{"carryType":"worn"},"containerId":null,"size":"med","material":{"type":null,"grade":null},"identification":{"status":"identified","unidentified":{"name":"","img":"","data":{"description":{"value":""}}},"misidentified":{}},"category":"poison","uses":{"value":1,"max":1,"autoDestroy":true},"damage":null,"usage":{"value":"held-in-one-hand"},"stackGroup":null,"spell":null},"type":"consumable","_stats":{"compendiumSource":"Compendium.pf2e.equipment-srd.Item.qQqAY59NgGNoy2xr","duplicateSource":null,"exportSource":null,"coreVersion":"13.347","systemId":"pf2e","systemVersion":"7.4.2"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0,"1Lps0mi7tMJnjtuv":3},"flags":{},"_id":"6qogskIvUZhDJeXQ"},{"name":"Putrid Eggs","type":"consumable","effects":[],"system":{"description":{"gm":"","value":""},"rules":