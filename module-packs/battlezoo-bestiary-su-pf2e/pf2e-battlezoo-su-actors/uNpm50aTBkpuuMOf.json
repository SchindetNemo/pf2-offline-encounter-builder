Deafened for 1 minute, and is @UUID[Compendium.pf2e.conditionitems.Item.dfCMdR4wnpbYNTix]{Stunned 1}.</p>\n<hr />\n<p><strong>Heightened (+1)</strong> The damage increases by 1d10.</p>"},"rules":[],"slug":"sound-burst","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","manipulate","sonic"],"rarity":"common","traditions":["divine","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":2},"requirements":"","target":{"value":""},"range":{"value":"30 feet"},"area":{"type":"burst","value":10},"time":{"value":"2"},"duration":{"value":"","sustained":false},"damage":{"0":{"formula":"2d10","type":"sonic","category":null,"materials":[],"kinds":["damage"]}},"defense":{"passive":null,"save":{"statistic":"fortitude","basic":false}},"cost":{"value":""},"location":{"value":"AvSasQ39axqUh27r","heightenedLevel":4},"counteraction":false,"heightening":{"damage":{"0":"1d10"},"interval":1,"type":"interval"}},"type":"spell","flags":{"core":{}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"_stats":{"systemId":"pf2e","systemVersion":"5.1.1","coreVersion":"14.360","createdTime":1688834291540,"modifiedTime":1688834291540,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":"Compendium.pf2e.spells-srd.Item.wzLkNU3AAqOSKFPR","duplicateSource":null,"exportSource":null},"_id":"nwSMqWFyLTthBRsN"},{"img":"systems/pf2e/icons/spells/soothe.webp","name":"Soothe","system":{"description":{"gm":"","value":"<p>You grace the target's mind, boosting its mental defenses and healing its wounds. The target regains 1d10+4 Hit Points when you Cast the Spell and gains a +2 status bonus to saves against mental effects for the duration.</p>\n<p>@UUID[Compendium.pf2e.spell-effects.Item.nkk4O5fyzrC0057i]{Spell Effect: Soothe}</p>\n<hr />\n<p><strong>Heightened (+1)</strong> The amount of healing increases by 1d10+4.</p>"},"rules":[],"slug":"soothe","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","emotion","healing","manipulate","mental"],"rarity":"common","traditions":["occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":1},"requirements":"","target":{"value":"1 willing creature"},"range":{"value":"30 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"1 minute","sustained":false},"damage":{"0":{"applyMod":false,"formula":"1d10+4","type":"untyped","category":null,"materials":[],"kinds":["healing"]}},"defense":null,"cost":{"value":""},"location":{"value":"AvSasQ39axqUh27r","heightenedLevel":3,"uses":{"max":3,"value":3}},"counteraction":false,"heightening":{"damage":{"0":"1d10+4"},"interval":1,"type":"interval"}},"type":"spell","flags":{"core":{}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"_stats":{"systemId":"pf2e","systemVersion":"5.1.1","coreVersion":"14.360","createdTime":1688834294084,"modifiedTime":1688834300575,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":"Compendium.pf2e.spells-srd.Item.szIyEsvihc5e1w8n","duplicateSource":null,"exportSource":null},"_id":"zfZIdKbNWa4dOcAJ"},{"img":"systems/pf2e/icons/spells/ghost-sound.webp","name":"Ghost Sound","system":{"description":{"gm":"","value":"<p>You create an auditory illusion of simple sounds that has a maximum volume equal to four normal humans shouting. The sounds emanate from a square you designate within range. You can't create intelligible words or other intricate sounds (such as music).</p>\n<hr />\n<p><strong>Heightened (3rd)</strong> The range increases to 60 feet.</p>\n<p><strong>Heightened (5th)</strong> The range increases to 120 feet.</p>"},"rules":[],"slug":"ghost-sound","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"fo