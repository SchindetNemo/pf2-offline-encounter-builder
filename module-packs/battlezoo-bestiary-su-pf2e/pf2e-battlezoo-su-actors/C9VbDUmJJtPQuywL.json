red":[],"value":0,"max":0}},"autoHeightenLevel":{"value":null},"showUnpreparedSpells":{"value":false},"displayLevels":{}},"_id":"IHCwCzhj7teI5gMF","img":"systems/pf2e/icons/default-icons/spellcastingEntry.svg","effects":[],"folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"5.1.2","coreVersion":"14.360","createdTime":1689179827590,"modifiedTime":1689179904228,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"KI32MfhEMFKC2sBz","img":"systems/pf2e/icons/spells/knock.webp","name":"Knock","system":{"description":{"gm":"","value":"<p>You make the target easier to open. Knock grants a +4 status bonus to any creature that tries to open the target door, lock, or container with an Athletics or a Thievery check. You can attempt a Thievery check to open the target as part of casting knock, and you add your level even if you're untrained.</p>\n<p>Knock counteracts <em>@UUID[Compendium.pf2e.spells-srd.Item.Azoh0BSoCASrA1lr]{Lock}</em>.</p>"},"rules":[],"slug":"knock","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","manipulate"],"rarity":"common","traditions":["arcane","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":2},"requirements":"","target":{"value":"1 door, lock, or container"},"range":{"value":"30 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"1 minute","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"IHCwCzhj7teI5gMF"},"counteraction":false},"type":"spell","flags":{"core":{}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"_stats":{"systemId":"pf2e","systemVersion":"5.1.2","coreVersion":"14.360","createdTime":1689179842203,"modifiedTime":1689179842203,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":"Compendium.pf2e.spells-srd.Item.6Ot4N22t5tPD51BO","duplicateSource":null,"exportSource":null}},{"_id":"4dIyFWVIE7BHlfvc","img":"systems/pf2e/icons/spells/illusory-object.webp","name":"Illusory Object","system":{"description":{"gm":"","value":"<p>You create an illusory visual image of a stationary object. The entire image must fit within the spell's area. The object appears to animate naturally, but it doesn't make sounds or generate smells. For example, water would appear to pour down an illusory waterfall, but it would be silent.</p>\n<p>Any creature that touches the image or uses the Seek action to examine it can attempt to disbelieve your illusion.</p>\n<hr />\n<p><strong>Heightened (2nd)</strong> Your image makes appropriate sounds, generates normal smells, and feels right to the touch. The spell gains the auditory trait. The duration increases to 1 hour.</p>\n<p><strong>Heightened (5th)</strong> As the 2nd-level version, but the duration is unlimited.</p>"},"rules":[],"slug":"illusory-object","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","illusion","manipulate","visual"],"rarity":"common","traditions":["arcane","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":1},"requirements":"","target":{"value":""},"range":{"value":"500 feet"},"area":{"type":"burst","value":20},"time":{"value":"2"},"duration":{"value":"10 minutes","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"IHCwCzhj7teI5gMF"},"counteraction":false},"type":"spell","flags":{"core":{}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"_stats":{"systemId":"pf2e","systemVersion":"5.1.2","coreVersion":"14.360","createdTime":1689179843651,"modifiedTime":1689179843651,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":"Compendium.pf2e.spells-srd.Item.2oH5IufzdESuYxat","duplicateSource":null,"exportSource":null}},{"_id":"rADV0IqDmpbp6up3","img":"systems/pf2e/icons/spells/color-spray.webp","name":"Color Spray","system":{"description":{"gm":"","value":"<p>Swirling colors affect viewers based on their Will saves.</p>\n<hr />\n<p><strong>Critical Success</strong> The creature is unaffected.</p>\n<p><strong>Success</strong> The creature is @UUID[Compendium.pf2e.conditionitems.Item.TkIyaNPgTZFBCCuh]{Dazzled} for 1 round.</p>\n<p><strong>Failure</strong> The creature is @UUID[Compendium.pf2e.conditionitems.Item.dfCMdR4wnpbYNTix]{Stunned 1}, @UUID[Compendium.pf2e.conditionitems.Item.XgEqL1kFApUbl5Z2]{Blinded} for 1 round, and Dazzled for 1 minute.</p>\n<p><strong>Critical Failure</strong> The creature is Stunned for 1 round and Blinded for 1 minute.</p>"},"rules":[],"slug":"color-spray","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","illusion","incapacitation","manipulate","visual"],"rarity":"common","traditions":["arcane","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":1},"requirements":"","target":{"value":""},"range":{"value":""},"area":{"type":"cone","value":15},"time":{"value":"2"},"duration":{"value":"1 or more rounds (see below)","sustained":false},"damage":{},"defense":{"passive":null,"save":{"statistic":"will","basic":false}},"cost":{"value":""},"location":{"value":"IHCwCzhj7teI5gMF"},"counteraction":false},"type":"spell","flags":{"core":{}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"_stats":{"systemId":"pf2e","systemVersion":"5.1.2","coreVersion":"14.360","createdTime":1689179848555,"modifiedTime":1689179848555,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":"Compendium.pf2e.spells-srd.Item.UKsIOWmMx4hSpafl","duplicateSource":null,"exportSource":null}},{"_id":"7Do3CIGwHbSdEBI2","img":"systems/pf2e/icons/spells/floating-disc.webp","name":"Floating Disk","system":{"description":{"gm":"","value":"<p>A disk of magical force materializes adjacent to you. This disk is 2 feet in diameter and follows 5 feet behind you, floating just above the ground. It holds up to 5 Bulk of objects (though they must be able to fit and balance on its surface). Any objects atop the disk fall to the ground when the spell ends.</p>\n<p>The spell ends if a creature tries to ride atop the disk, if the disk is overloaded, if anyone tries to lift or force the disk higher above the ground, or if you move more than 30 feet away from the disk.</p>"},"rules":[],"slug":"floating-disk","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","force","manipulate"],"rarity":"common","traditions":["arcane","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":1},"requirements":"","target":{"value":""},"range":{"value":""},"area":null,"time":{"value":"2"},"duration":{"value":"8 hours","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"IHCwCzhj7teI5gMF"},"counteraction":false},"type":"spell","flags":{"core":{}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"_stats":{"systemId":"pf2e","systemVersion":"5.1.2","coreVersion":"14.360","createdTime":1689179850212,"modifiedTime":1689179850212,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":"Compendium.pf2e.spells-srd.Item.LvezN4a3kYf1OHMg","duplicateSource":null,"exportSource":null}},{"_id":"EfoZitAVhDp7kEEk","img":"systems/pf2e/icons/spells/sleep.webp","name":"Sleep","system":{"description":{"gm":"","value":"<p>Each creature in the area becomes drowsy and might fall asleep. A creature that falls @UUID[Compendium.pf2e.conditionitems.Item.fBnFDH2MTzgFijKf]{Unconscious} from this spell doesn't fall @UUID[Compendium.pf2e.conditionitems.Item.j91X7x0XSomq8d60]{Prone} or release what it's holding. This spell doesn't prevent creatures from waking up due to a successful Perception check, limiting its utility in combat.</p>\n<hr />\n<p><strong>Critical Success</strong> The creature is unaffected.</p>\n<p><strong>Success</strong> The creature takes a -1 status penalty to Perception checks for 1 round.</p>\n<p><strong>Failure</strong> The creature falls Unconscious. If it's still Unconscious after 1 minute, it wakes up automatically.</p>\n<p><strong>Critical Failure</strong> The creature falls Unconscious. If it's still Unconscious after 1 hour, it wakes up automatically.</p>\n<hr />\n<p><strong>Heightened (4th)</strong> The creatures fall Unconscious for 1 round on a failure or 1 minute on a critical failure. They fall Prone and release what they're holding, and they can't attempt Perception checks to wake up. When the duration ends, the creature is sleeping normally instead of automatically waking up.</p>"},"rules":[],"slug":"sleep","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","incapacitation","manipulate","mental","sleep"],"rarity":"common","traditions":["arcane","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":1},"requirements":"","target":{"value":""},"range":{"value":"30 feet"},"area":{"type":"burst","value":5},"time":{"value":"2"},"duration":{"value":"","sustained":false},"damage":{},"defense":{"passive":null,"save":{"statistic":"will","basic":false}},"cost":{"value":""},"location":{"value":"IHCwCzhj7teI5gMF"},"counteraction":false},"type":"spell","flags":{"core":{}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"_stats":{"systemId":"pf2e","systemVersion":"5.1.2","coreVersion":"14.360","createdTime":1689179851446,"modifiedTime":1689179851446,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":"Compendium.pf2e.spells-srd.Item.o4lRVTwSxnOOn5vl","duplicateSource":null,"exportSource":null}},{"_id":"loqEnq8io2Hthk5q","img":"systems/pf2e/icons/spells/daze.webp","name":"Daze","system":{"description":{"gm":"","value":"<p>You cloud the target's mind and daze it with a mental jolt. The jolt deals mental damage equal to your spellcasting ability modifier; the target must attempt a basic Will save. If the target critically fails the save, it is also @UUID[Compendium.pf2e.conditionitems.Item.dfCMdR4wnpbYNTix]{Stunned 1}.</p>\n<hr />\n<p><strong>Heightened (+2)</strong> The damage increases by 1d6.</p>"},"rules":[],"slug":"daze","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["cantrip","concentrate","manipulate","mental","nonlethal"],"rarity":"common","traditions":["arcane","divine","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":1},"requirements":"","target":{"value":"1 creature"},"range":{"value":"60 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"1 round","sustained":false},"damage":{"0":{"applyMod":true,"formula":"0","type":"mental","category":null,"materials":[],"kinds":["damage"]}},"defense":{"passive":null,"save":{"statistic":"will","basic":true}},"cost":{"value":""},"location":{"value":"IHCwCzhj7teI5gMF"},"counteraction":false,"heightening":{"damage":{"0":"1d6"},"interval":2,"type":"interval"}},"type":"spell","flags":{"core":{}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"_stats":{"systemId":"pf2e","systemVersion":"5.1.2","coreVersion":"14.360","createdTime":1689179854461,"modifiedTime":1689179854461,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":"Compendium.pf2e.spells-srd.Item.4gBIw4IDrSfFHik4","duplicateSource":null,"exportSource":null}},{"_id":"uqI5ioEhWbquUTPm","img":"systems/pf2e/icons/spells/detect-magic.webp","name":"Detect Magic","system":{"description":{"gm":"","value":"<p>You send out a pulse that registers the presence of magic. You receive no information beyond the presence or absence of magic. You can choose to ignore magic you're fully aware of, such as the magic items and ongoing spells of you and your allies.</p>\n<p>You detect illusion magic only if that magic's effect has a lower level than the level of your detect magic spell. However, items that have an illusion aura but aren't deceptive in appearance (such as an invisibility potion) typically are detected normally.</p>\n<hr />\n<p><strong>Heightened (3rd)</strong> You learn the school of magic for the highest-level effect within range that the spell detects. If multiple effects are equally strong, the GM determines which you learn.</p>\n<p><strong>Heightened (4th)</strong> As 3rd level, but you also pinpoint the source of the highest-level magic. Like for an imprecise sense, you don't learn the exact location, but can narrow down the source to within a 5-foot cube (or the nearest if larger than that).</p>"},"rules":[],"slug":"detect-magic","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["cantrip","concentrate","detection","manipulate"],"rarity":"common","traditions":["arcane","divine","occult","primal"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":1},"requirements":"","target":{"value":""},"range":{"value":""},"area":{"type":"emanation","value":30},"time":{"value":"2"},"duration":{"value":"","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"IHCwCzhj7teI5gMF"},"counteraction":false},"type":"spell","flags":{"core":{}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"_stats":{"systemId":"pf2e","systemVersion":"5.1.2","coreVersion":"14.360","createdTime":1689179855413,"modifiedTime":1689179855413,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":"Compendium.pf2e.spells-srd.Item.gpzpAAAJ1Lza2JVl","duplicateSource":null,"exportSource":null}},{"_id":"MQmHdu1VeqMs3Nvw","img":"systems/pf2e/icons/spells/ghost-sound.webp","name":"Ghost Sound","system":{"description":{"gm":"","value":"<p>You create an auditory illusion of simple sounds that has a maximum volume equal to four normal humans shouting. The sounds emanate from a square you designate within range. You can't create intelligible words or other intricate sounds (such as music).</p>\n<hr />\n<p><strong>Heightened (3rd)</strong> The range increases to 60 feet.</p>\n<p><strong>Heightened (5th)</strong> The range increases to 120 feet.</p>"},"rules":[],"slug":"ghost-sound","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["auditory","cantrip","concentrate","illusion","manipulate"],"rarity":"common","traditions":["arcane","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":1},"requirements":"","target":{"value":""},"range":{"value":"30 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"","sustained":true},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"IHCwCzhj7teI5gMF"},"counteraction":false,"heightening":{"levels":{"3":{"range":{"value":"60 feet"}},"5":{"range":{"value":"120 feet"}}},"type":"fixed"}},"type":"spell","flags":{"core":{}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"_stats":{"systemId":"pf2e","systemVersion":"5.1.2","coreVersion":"14.360","createdTime":1689179856237,"modifiedTime":1689179856237,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":"Compendium.pf2e.spells-srd.Item.atlgGNI1E1Ox3O3a","duplicateSource":null,"exportSource":null}},{"_id":"lBFUWErZW6Zr6t7q","img":"systems/pf2e/icons/spells/mage-hand.webp","name":"Mage Hand","system":{"description":{"gm":"","value":"<p>You create a single magical hand, either invisible or ghostlike, that grasps the target object and moves it slowly up to 20 feet. Because you're levitating the object, you can move it in any direction. When you Sustain the Spell, you can move the object an additional 20 feet. If the object is in the air when the spell ends, the object falls.</p>\n<hr />\n<p><strong>Heightened (3rd)</strong> You can target an unattended object with a Bulk of 1 or less.</p>\n<p><strong>Heightened (5th)</strong> The range increases to 60 feet, and you can target an unattended object with a Bulk of 1 or less.</p>\n<p><strong>Heightened (7th)</strong> The range increases to 60 feet, and you can target an unattended object with a Bulk of 2 or less.</p>"},"rules":[],"slug":"mage-hand","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["cantrip","concentrate","manipulate"],"rarity":"common","traditions":["arcane","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":1},"requirements":"","target":{"value":"1 unattended object of light Bulk or less"},"range":{"value":"30 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"","sustained":true},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"IHCwCzhj7teI5gMF"},"counteraction":false,"heightening":{"levels":{"3":{"target":{"value":"1 unattended object with a Bulk of 1 or less"}},"5":{"range":{"value":"60 feet"}},"7":{"target":{"value":"1 unattended object with a Bulk of 2 or less"}}},"type":"fixed"}},"type":"spell","flags":{"core":{}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"_stats":{"systemId":"pf2e","systemVersion":"5.1.2","coreVersion":"14.360","createdTime":1689179857229,"modifiedTime":1689179857229,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":"Compendium.pf2e.spells-srd.Item.pwzdSlJgYqN7bs2w","duplicateSource":null,"exportSource":null}},{"_id":"3fsDr9uHDQl6DY7Z","img":"systems/pf2e/icons/spells/telekinetic-projectile.webp","name":"Telekinetic Projectile","system":{"description":{"gm":"","value":"<p>You hurl a loose, unattended object that is within range and that has 1 Bulk or less at the target. Make a spell attack roll against the target. If you hit, you deal bludgeoning, piercing, or slashing damage-as appropriate for the object you hurled-equal to 1d6 plus your spellcasting ability modifier. No specific traits or magic properties of the hurled item affect the attack or the damage.</p>\n<hr />\n<p><strong>Critical Success</strong> You deal double damage.</p>\n<p><strong>Success</strong> You deal full damage.</p>\n<hr />\n<p><strong>Heightened (+1)</strong> The damage increases by 1d6.</p>"},"rules":[],"slug":"telekinetic-projectile","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["attack","cantrip","concentrate","manipulate"],"rarity":"common","traditions":["arcane","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":1},"requirements":"","target":{"value":"1 creature"},"range":{"value":"30 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"","sustained":false},"damage":{"0":{"applyMod":true,"formula":"1d6","type":"untyped","category":null,"materials":[],"kinds":["damage"]}},"defense":null,"cost":{"value":""},"location":{"value":"IHCwCzhj7teI5gMF"},"counteraction":false,"heightening":{"damage":{"0":"1d6"},"interval":1,"type":"interval"},"overlays":{"2I469pfbYcmFvzOA":{"_id":"2I469pfbYcmFvzOA","name":"Telekinetic Projectile (Bludgeoning)","overlayType":"override","sort":1,"system":{"damage":{"0":{"type":"bludgeoning"}}}},"cUFX7ExSLeoa3vIF":{"_id":"cUFX7ExSLeoa3vIF","name":"Telekinetic Projectile (Piercing)","overlayType":"override","sort":2,"system":{"damage":{"0":{"type":"piercing"}}}},"zFWsMjoeCnLxqJaV":{"_id":"zFWsMjoeCnLxqJaV","name":"Telekinetic Projectile (Slashing)","overlayType":"override","sort":3,"system":{"damage":{"0":{"type":"slashing"}}}}}},"type":"spell","flags":{"core":{}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"_stats":{"systemId":"pf2e","systemVersion":"5.1.2","coreVersion":"14.360","createdTime":1689179858110,"modifiedTime":1689179858110,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":"Compendium.pf2e.spells-srd.Item.60sgbuMWN0268dB7","duplicateSource":null,"exportSource":null}},{"type":"action","img":"systems/pf2e/icons/default-icons/action.svg","name":"Numbing Breath","system":{"description":{"gm":"","value":"<p>The tidragat breathes a @Template[type:cone|distance:15] of invisible numbing gas. Each creature in the area must attempt a @Check[type:fortitude|dc:20] save, with the following effects. The tidragat can't use Numbing Breath again for [[/br 1d4 #Numbing Breath Recharge]]{1d4 rounds}.</p>\n<hr />\n<p><strong>Critical Success</strong> the creature is unaffected.</p>\n<p><strong>Success</strong> The creature is @Compendium[pf2e.conditionitems.Clumsy]{Clumsy 1} and @Compendium[pf2e.conditionitems.Enfeebled]{Enfeebled 1} for 1 round as its body is awash with pins and needles.</p>\n<p><strong>Failure</strong> The creature becomes numb for 1 minute. In addition to being clumsy 1 and enfeebled 1, they automatically critically fail Perception checks that rely on touch, and they take a –2 circumstance penalty when using Perception for an initiative roll, as well as to any checks that involve touch but also use other senses. If a numb creature performs an action with the manipulate trait, they must succeed at a @Check[type:flat|dc:5] or the action is lost.</p>\n<p><strong>Critical Failure</strong> As failure, but @Compendium[pf2e.conditionitems.i3OJZU2nk64Df3xm]{Clumsy 2} and @Compendium[pf2e.conditionitems.MIRkyAjyBeXivMa7]{Enfeebled 2}.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["arcane","poison"]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":2},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"effects":[],"_id":"legf3GC7eTL0bT5I","folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"5.3.0","coreVersion":"14.360","createdTime":1689179922148,"modifiedTime":1691129385183,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"type":"action","img":"systems/pf2e/icons/default-icons/action.svg","name":"Pickpocket","system":{"description":{"gm":"","value":"<p>A tidragat can @Compendium[pf2e.actionspf2e.Steal]{Steal} or @Compendium[pf2e.actionspf2e.ijZ0DDFpMkWqaShd]{Palm an Object} that's closely guarded, such as in a pocket, without taking the –5 penalty. The tidragat can also attempt to Steal from a creature in combat or otherwise on guard. When doing so, Stealing requires 2 manipulate actions instead of 1, and it takes a –5 penalty.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"offensive","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"effects":[],"_id":"Mm9JLi12W0Z6Ivzo","folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"5.1.2","coreVersion":"14.360","createdTime":1689180017021,"modifiedTime":1689180048718,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":null,"duplicateSource":null,"exportSource":null}}],"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"6.1.0","coreVersion":"14.360","createdTime":1685401626117,"modifiedTime":1736542839469,"lastModifiedBy":"l2rbNx2a8f5ocpeL","compendiumSource":null,"duplicateSource":null,"exportSource":null},"_id":"C9VbDUmJJtPQuywL","folder":"3x5VQ7TD4gePAtOj","ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"sort":0}