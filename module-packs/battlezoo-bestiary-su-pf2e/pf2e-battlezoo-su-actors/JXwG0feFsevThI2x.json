default-icons/spellcastingEntry.svg","effects":[],"folder":null,"sort":0,"ownership":{"default":0,"CIWVguTLismR00HG":3},"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"5.1.1","coreVersion":"14.360","createdTime":1688941607127,"modifiedTime":1688941725664,"lastModifiedBy":"CIWVguTLismR00HG","compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"img":"systems/pf2e/icons/spells/telekinetic-projectile.webp","name":"Telekinetic Projectile","system":{"description":{"gm":"","value":"<p>You hurl a loose, unattended object that is within range and that has 1 Bulk or less at the target. Make a spell attack roll against the target. If you hit, you deal bludgeoning, piercing, or slashing damage-as appropriate for the object you hurled-equal to 1d6 plus your spellcasting ability modifier. No specific traits or magic properties of the hurled item affect the attack or the damage.</p>\n<hr />\n<p><strong>Critical Success</strong> You deal double damage.</p>\n<p><strong>Success</strong> You deal full damage.</p>\n<hr />\n<p><strong>Heightened (+1)</strong> The damage increases by 1d6.</p>"},"rules":[],"slug":"telekinetic-projectile","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["attack","cantrip","concentrate","manipulate"],"rarity":"common","traditions":["arcane","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":1},"requirements":"","target":{"value":"1 creature"},"range":{"value":"30 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"","sustained":false},"damage":{"0":{"applyMod":true,"formula":"1d6","type":"untyped","category":null,"materials":[],"kinds":["damage"]}},"defense":null,"cost":{"value":""},"location":{"value":"fm9t4xtxEAuzMGSv"},"counteraction":false,"heightening":{"damage":{"0":"1d6"},"interval":1,"type":"interval"},"overlays":{"2I469pfbYcmFvzOA":{"_id":"2I469pfbYcmFvzOA","name":"Telekinetic Projectile (Bludgeoning)","overlayType":"override","sort":1,"system":{"damage":{"0":{"type":"bludgeoning"}}}},"cUFX7ExSLeoa3vIF":{"_id":"cUFX7ExSLeoa3vIF","name":"Telekinetic Projectile (Piercing)","overlayType":"override","sort":2,"system":{"damage":{"0":{"type":"piercing"}}}},"zFWsMjoeCnLxqJaV":{"_id":"zFWsMjoeCnLxqJaV","name":"Telekinetic Projectile (Slashing)","overlayType":"override","sort":3,"system":{"damage":{"0":{"type":"slashing"}}}}}},"type":"spell","flags":{"core":{}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0,"CIWVguTLismR00HG":3},"_stats":{"systemId":"pf2e","systemVersion":"5.1.1","coreVersion":"14.360","createdTime":1688941634428,"modifiedTime":1688941634428,"lastModifiedBy":"CIWVguTLismR00HG","compendiumSource":"Compendium.pf2e.spells-srd.Item.60sgbuMWN0268dB7","duplicateSource":null,"exportSource":null},"_id":"Xgyy7Ux1Wd8eKUKn"},{"img":"systems/pf2e/icons/spells/mage-hand.webp","name":"Mage Hand","system":{"description":{"gm":"","value":"<p>You create a single magical hand, either invisible or ghostlike, that grasps the target object and moves it slowly up to 20 feet. Because you're levitating the object, you can move it in any direction. When you Sustain the Spell, you can move the object an additional 20 feet. If the object is in the air when the spell ends, the object falls.</p>\n<hr />\n<p><strong>Heightened (3rd)</strong> You can target an unattended object with a Bulk of 1 or less.</p>\n<p><strong>Heightened (5th)</strong> The range increases to 60 feet, and you can target an unattended object with a Bulk of 1 or less.</p>\n<p><strong>Heightened (7th)</strong> The range increases to 60 feet, and you can target an unattended object with a Bulk of 2 or less.</p>"},"rules":[],"slug":"mage-hand","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["cantrip","concentrate","manipulate"],"rarity":"common","traditions":["arcane","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":1},"requirements":"","target":{"value":"1 unattended object of light Bulk or less"},"range":{"value":"30 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"","sustained":true},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"fm9t4xtxEAuzMGSv"},"counteraction":false,"heightening":{"levels":{"3":{"target":{"value":"1 unattended object with a Bulk of 1 or less"}},"5":{"range":{"value":"60 feet"}},"7":{"target":{"value":"1 unattended object with a Bulk of 2 or less"}}},"type":"fixed"}},"type":"spell","flags":{"core":{}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0,"CIWVguTLismR00HG":3},"_stats":{"systemId":"pf2e","systemVersion":"5.1.1","coreVersion":"14.360","createdTime":1688941636275,"modifiedTime":1688941636275,"lastModifiedBy":"CIWVguTLismR00HG","compendiumSource":"Compendium.pf2e.spells-srd.Item.pwzdSlJgYqN7bs2w","duplicateSource":null,"exportSource":null},"_id":"wLCKFbVlJZzxM9D4"},{"img":"systems/pf2e/icons/spells/ghost-sound.webp","name":"Ghost Sound","system":{"description":{"gm":"","value":"<p>You create an auditory illusion of simple sounds that has a maximum volume equal to four normal humans shouting. The sounds emanate from a square you designate within range. You can't create intelligible words or other intricate sounds (such as music).</p>\n<hr />\n<p><strong>Heightened (3rd)</strong> The range increases to 60 feet.</p>\n<p><strong>Heightened (5th)</strong> The range increases to 120 feet.</p>"},"rules":[],"slug":"ghost-sound","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["auditory","cantrip","concentrate","illusion","manipulate"],"rarity":"common","traditions":["arcane","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":1},"requirements":"","target":{"value":""},"range":{"value":"30 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"","sustained":true},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"fm9t4xtxEAuzMGSv"},"counteraction":false,"heightening":{"levels":{"3":{"range":{"value":"60 feet"}},"5":{"range":{"value":"120 feet"}}},"type":"fixed"}},"type":"spell","flags":{"core":{}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0,"CIWVguTLismR00HG":3},"_stats":{"systemId":"pf2e","systemVersion":"5.1.1","coreVersion":"14.360","createdTime":1688941638478,"modifiedTime":1688941638478,"lastModifiedBy":"CIWVguTLismR00HG","compendiumSource":"Compendium.pf2e.spells-srd.Item.atlgGNI1E1Ox3O3a","duplicateSource":null,"exportSource":null},"_id":"VPvjkpOdUJ2Owfv2"},{"img":"systems/pf2e/icons/spells/nightmare.webp","name":"Nightmare","system":{"description":{"gm":"","value":"<p>You send disturbing nightmares to your target. The next time the target falls asleep, it must attempt a Will save. If you know the target only by name and have never met them, the target gets a +4 circumstance bonus to the Will save.</p>\n<hr />\n<p><strong>Critical Success</strong> The target suffers no adverse effects and is temporarily immune for 1 week.</p>\n<p><strong>Success</strong> The target experiences the nightmares but suffers no adverse effects other than unpleasant memories.</p>\n<p><strong>Failure</strong> The target experiences the nightmares and awakens @UUID[Compendium.pf2e.conditionitems.Item.HL2l2VRSaQHu9lUw]{Fatigued}.</p>\n<p><strong>Critical Failure</strong> The target experiences the nightmares, awakens Fatigued, and is @UUID[Compendium.pf2e.conditionitems.Item.4D2KBtexWXa6oUMR]{Drained 2} until it is no longer Fatigued.</p>"},"rules":[],"slug":"nightmare","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","illusion","manipulate","mental"],"rarity":"common","traditions":["arcane","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":4},"requirements":"","target":{"value":"1 creature you know by name"},"range":{"value":"planetary"},"area":null,"time":{"value":"10 minutes"},"duration":{"value":"1 day","sustained":false},"damage":{},"defense":{"passive":null,"save":{"statistic":"will","basic":false}},"cost":{"value":""},"location":{"value":"fm9t4xtxEAuzMGSv","heightenedLevel":4},"counteraction":false},"type":"spell","flags":{"core":{}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0,"CIWVguTLismR00HG":3},"_stats":{"systemId":"pf2e","systemVersion":"5.1.1","coreVersion":"14.360","createdTime":1688941644400,"modifiedTime":1688941644400,"lastModifiedBy":"CIWVguTLismR00HG","compendiumSource":"Compendium.pf2e.spells-srd.Item.Uqj344bezBq3ESdq","duplicateSource":null,"exportSource":null},"_id":"1xGgI9GB0dhGiWB7"},{"img":"systems/pf2e/icons/spells/invisibility.webp","name":"Invisibility (At Will) (Self Only) (Unlimited Duration)","system":{"description":{"gm":"","value":"<p>Cloaked in illusion, the target becomes @UUID[Compendium.pf2e.conditionitems.Item.zJxUflt9np0q4yML]{Invisible}. This makes it @UUID[Compendium.pf2e.conditionitems.Item.VRSef5y1LmL2Hkjf]{Undetected} to all creatures, though the creatures can attempt to find the target, making it @UUID[Compendium.pf2e.conditionitems.Item.iU0fEDdBp3rXpTMC]{Hidden} to them instead. If the target uses a hostile action, the spell ends after that hostile action is completed.</p>\n<hr />\n<p><strong>Heightened (4th)</strong> The spell lasts 1 minute, but it doesn't end if the target uses a hostile action.</p>"},"rules":[],"slug":"invisibility","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["illusion","manipulate"],"rarity":"common","traditions":["arcane","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":2},"requirements":"","target":{"value":"1 creature"},"range":{"value":"touch"},"area":null,"time":{"value":"2"},"duration":{"value":"unlimited","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"fm9t4xtxEAuzMGSv","heightenedLevel":4},"counteraction":false,"heightening":{"type":"interval","interval":1,"damage":{}}},"type":"spell","flags":{"core":{}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0,"CIWVguTLismR00HG":3},"_stats":{"systemId":"pf2e","systemVersion":"5.1.1","coreVersion":"14.360","createdTime":1688941645699,"modifiedTime":1688941716215,"lastModifiedBy":"CIWVguTLismR00HG","compendiumSource":"Compendium.pf2e.spells-srd.Item.XXqE1eY3w3z6xJCB","duplicateSource":null,"exportSource":null},"_id":"ZfUWV2THXaTNSIAO"},{"img":"systems/pf2e/icons/spells/confusion.webp","name":"Confusion","system":{"description":{"gm":"","value":"<p>You befuddle your target with strange impulses, causing it to act randomly. The effects are determined by the target's Will save. You can Dismiss the spell.</p>\n<hr />\n<p><strong>Critical Success</strong> The target is unaffected.</p>\n<p><strong>Success</strong> The target babbles incoherently and is @UUID[Compendium.pf2e.conditionitems.Item.dfCMdR4wnpbYNTix]{Stunned 1}.</p>\n<p><strong>Failure</strong> The target is @UUID[Compendium.pf2e.conditionitems.Item.yblD8fOR1J8rDwEQ]{Confused} for 1 minute. It can attempt a new save at the end of each of its turns to end the confusion.</p>\n<p><strong>Critical Failure</strong> The target is Confused for 1 minute, with no save to end early.</p>\n<hr />\n<p><strong>Heightened (8th)</strong> You can target up to 10 creatures.</p>"},"rules":[],"slug":"confusion","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","emotion","manipulate","mental"],"rarity":"common","traditions":["arcane","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":4},"requirements":"","target":{"value":"1 creature"},"range":{"value":"30 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"1 minute","sustained":false},"damage":{},"defense":{"passive":null,"save":{"statistic":"will","basic":false}},"cost":{"value":""},"location":{"value":"fm9t4xtxEAuzMGSv","heightenedLevel":4},"counteraction":false,"heightening":{"levels":{"8":{"target":{"value":"10 creatures"}}},"type":"fixed"}},"type":"spell","flags":{"core":{}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0,"CIWVguTLismR00HG":3},"_stats":{"systemId":"pf2e","systemVersion":"5.1.1","coreVersion":"14.360","createdTime":1688941667512,"modifiedTime":1688941667512,"lastModifiedBy":"CIWVguTLismR00HG","compendiumSource":"Compendium.pf2e.spells-srd.Item.LiGbewa9pO0yjbsY","duplicateSource":null,"exportSource":null},"_id":"LbR3W2jAqGk4gGoT"},{"img":"systems/pf2e/icons/spells/phantom-pain.webp","name":"Phantom Pain","system":{"description":{"gm":"","value":"<p>Illusory pain wracks the target, dealing 2d4 mental damage and 1d4 persistent mental damage. The target must attempt a Will save.</p>\n<hr />\n<p><strong>Critical Success</strong> The target is unaffected.</p>\n<p><strong>Success</strong> The target takes full initial damage but no persistent damage, and the spell ends immediately.</p>\n<p><strong>Failure</strong> The target takes full initial and persistent damage, and the target is @UUID[Compendium.pf2e.conditionitems.Item.fesd1n5eVhpCSS18]{Sickened 1}. If the target recovers from being Sickened, the persistent damage ends and the spell ends.</p>\n<p><strong>Critical Failure</strong> As failure, but the target is @UUID[Compendium.pf2e.conditionitems.Item.fesd1n5eVhpCSS18]{Sickened 2}.</p>\n<hr />\n<p><strong>Heightened (+1)</strong> The damage increases by 2d4 and the persistent damage by 1d4.</p>\n<p>[[/r (@item.level)d4[persistent,mental]]]{Leveled Persistent Mental Damage}</p>"},"rules":[],"slug":"phantom-pain","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","illusion","manipulate","mental","nonlethal"],"rarity":"common","traditions":["occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":1},"requirements":"","target":{"value":"1 creature"},"range":{"value":"30 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"1 minute","sustained":false},"damage":{"0":{"applyMod":false,"formula":"2d4","type":"mental","category":null,"materials":[],"kinds":["damage"]}},"defense":{"passive":null,"save":{"statistic":"will","basic":false}},"cost":{"value":""},"location":{"value":"fm9t4xtxEAuzMGSv","heightenedLevel":6,"uses":{"max":3,"value":3}},"counteraction":false,"heightening":{"damage":{"0":"2d4"},"interval":1,"type":"interval"}},"type":"spell","flags":{"core":{}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0,"CIWVguTLismR00HG":3},"_stats":{"systemId":"pf2e","systemVersion":"5.1.1","coreVersion":"14.360","createdTime":1688941674300,"modifiedTime":1688941681517,"lastModifiedBy":"CIWVguTLismR00HG","compendiumSource":"Compendium.pf2e.spells-srd.Item.R8bqnYiThB6MYTxD","duplicateSource":null,"exportSource":null},"_id":"sBuod01Xm5YjzV3I"}],"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"6.1.0","coreVersion":"14.360","createdTime":1685401626117,"modifiedTime":1736309335988,"lastModifiedBy":"pE7amWuydpTk8Jkp","compendiumSource":null,"duplicateSource":null,"exportSource":null},"_id":"JXwG0feFsevThI2x","folder":"QqEyWiBhCvupt0ox","ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"sort":0}