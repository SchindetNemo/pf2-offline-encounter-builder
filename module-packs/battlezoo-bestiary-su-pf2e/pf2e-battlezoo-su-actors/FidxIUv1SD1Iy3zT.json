DAmGcgt3X6Rq":3},"_stats":{"systemId":"pf2e","systemVersion":"5.1.2","coreVersion":"14.360","createdTime":1689044723532,"modifiedTime":1689044726889,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":"Compendium.pf2e.equipment-srd.Item.AITVZmakiu3RgfKo","duplicateSource":null,"exportSource":null},"_id":"r8v03SqwgMmlmKOf"},{"type":"action","img":"systems/pf2e/icons/default-icons/action.svg","name":"Exposure","system":{"description":{"gm":"","value":"<p>Whenever someone with a connection to the secradow's secret (determined by the GM, but this generally includes people affected by the secret directly or those who know enough about the topic to be curious of the details) discovers the truth, the secradow becomes @Compendium[pf2e.conditionitems.Drained]{Drained 1}, or has its drained condition increased by 1 if it's already drained, to a maximum of @Compendium[pf2e.conditionitems.Drained]{Drained 4}.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"defensive","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"effects":[],"_id":"GDheZ0FQG8KjYRLz","folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"5.1.2","coreVersion":"14.360","createdTime":1689044763817,"modifiedTime":1689044785106,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"type":"action","img":"systems/pf2e/icons/default-icons/action.svg","name":"Rejuvenation","system":{"description":{"gm":"","value":"<p>When a secradow is killed, it reforms on the Shadow Plane after [[/br 2d4 #days]]{2d4 days}, fully healed. A secradow can only be permanently destroyed by revealing the truth of the secret until it either becomes public knowledge or at least is established as fact to everyone with a direct connection to the secret (as determined by the GM).</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["occult"]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"defensive","actions":{"value":null},"deathNote":true,"requirements":{"value":""},"trigger":{"value":""}},"effects":[],"_id":"Nrn9sK4ddVsm46Bd","folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"5.1.2","coreVersion":"14.360","createdTime":1689044791819,"modifiedTime":1689044837897,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"type":"action","img":"systems/pf2e/icons/default-icons/action.svg","name":"Split","system":{"description":{"gm":"","value":"<p><strong>Trigger</strong> The secradow is hit with a Strike, and it was aware of the attack</p>\n<hr />\n<p><strong>Effect</strong> The secradow Steps and leaves an illusion behind momentarily; this doesn't prevent the triggering Strike from hitting due to reach, but it does grant the secradow the @Compendium[pf2e.conditionitems.Concealed]{Concealed} condition against the triggering Strike, forcing the attacker to succeed at the usual @Check[type:flat|dc:5] or lose the attack. Using Split deactivates the effect of the secradow's Never Show ability until the end of the current turn, allowing everyone to see that the secradow has actually been hurt until the Never Show ability returns.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"reaction"},"category":"defensive","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"effects":[],"_id":"5zFWkUpMksSCuAGf","folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"5.1.2","coreVersion":"14.360","createdTime":1689044841527,"modifiedTime":1689044862186,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":null,"duplicateSource":null,"exportSource":null}}],"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"6.1.0","coreVersion":"14.360","createdTime":1685401626117,"modifiedTime":1736542894072,"lastModifiedBy":"l2rbNx2a8f5ocpeL","compendiumSource":null,"duplicateSource":null,"exportSource":null},"_id":"FidxIUv1SD1Iy3zT","folder":"QqEyWiBhCvupt0ox","ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"sort":0}