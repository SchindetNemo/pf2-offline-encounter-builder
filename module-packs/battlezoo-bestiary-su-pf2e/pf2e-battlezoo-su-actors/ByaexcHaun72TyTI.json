schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"offensive","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"effects":[],"_id":"5WDNaqV260OPaB1J","folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"5.1.2","coreVersion":"14.360","createdTime":1689183189006,"modifiedTime":1689183207792,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"type":"action","img":"systems/pf2e/icons/default-icons/action.svg","name":"Drain Life","system":{"description":{"gm":"","value":"<p>The tree of eyes's roots come out of the ground and attempt to sap an adjacent creature of nutrients. The target must attempt a @Check[type:fortitude|dc:25] save. @Compendium[pf2e.conditionitems.j91X7x0XSomq8d60]{Prone} creatures treat the result of their save as one degree worse.</p>\n<hr />\n<p><strong>Success</strong> The target is unaffected.</p>\n<p><strong>Failure</strong> The target becomes @Compendium[pf2e.conditionitems.Drained]{Drained 1} or increases its drained value by 1 if it was already drained (to a maximum of @Compendium[pf2e.conditionitems.Drained]{Drained 3}). The tree of eyes gains 5 temporary Hit Points.</p>\n<p><strong>Critical Failure</strong> The target becomes @Compendium[pf2e.conditionitems.Drained]{Drained 2}, or increases its drained value by 2 if it was already drained (to a maximum of drained 3). and the target becomes @Compendium[pf2e.conditionitems.Blinded]{Blinded} for 1 round and @Compendium[pf2e.conditionitems.Dazzled]{Dazzled} for 1 minute. The tree of eyes gains 10 temporary Hit Points.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":2},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"effects":[],"_id":"WbRq9XfXx571HLaA","folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"5.1.2","coreVersion":"14.360","createdTime":1689183215099,"modifiedTime":1689183343049,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"type":"action","img":"systems/pf2e/icons/default-icons/action.svg","name":"Hypnotic Gaze","system":{"description":{"gm":"","value":"<p>The tree of eyes hypnotizes a creature it can see within 60 feet. The target must attempt a @Check[type:will|dc:25] save.</p>\n<hr />\n<p><strong>Success</strong> The target is unaffected.</p>\n<p><strong>Failure</strong> The target must use its next action to Stride toward the tree of eyes, falling @Compendium[pf2e.conditionitems.Prone]{Prone} if it ends this movement adjacent to the tree of eyes.</p>\n<p><strong>Critical Failure</strong> As a failure, except the target must use all of its actions on its next turn to do so.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["incapacitation","mental","visual"]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":2},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"effects":[],"_id":"AxJ278xQqY6Irfg4","folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"5.1.2","coreVersion":"14.360","createdTime":1689183215677,"modifiedTime":1689183377736,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"type":"action","img":"systems/pf2e/icons/default-icons/action.svg","name":"Lung Rot","system":{"description":{"gm":"","value":"<p>While a creature is afflicted by this poison, it can't reduce its sickened condition below 1</p>\n<p><strong>Saving Throw</strong> @Check[type:fortitude|dc:25]</p>\n<p><strong>Maximum Duration</strong> 5 rounds</p>\n<p><strong>Stage 1</strong> @Damage[2d6[poison]] damage and @Compendium[pf2e.conditionitems.Sickened]{Sickened 1} (1 round)</p>\n<p><strong>Stage 2</strong> [[/r 2d8[poison]]] damage and @Compendium[pf2e.conditionitems.Sickened]{Sickened 2} (1 round)</p>\n<p><strong>Stage 3</strong> [[/r 3d8[poison]]] damage and sickened 2 (1 round).</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["inhaled","poison"]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"offensive","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"effects":[],"_id":"pAniNRnURkU1KLw7","folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"5.3.0","coreVersion":"14.360","createdTime":1689183217395,"modifiedTime":1691261012235,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"type":"action","img":"systems/pf2e/icons/default-icons/action.svg","name":"Transfer Host","system":{"description":{"gm":"","value":"<p><strong>Requirements</strong> The tree of eyes is touching another tree beyond its host, either along its current host's branches (within 30 feet) or root system (within 50 feet)</p>\n<hr />\n<p><strong>Effect</strong> The tree of eyes moves to the other tree. The tree of eyes's Hit Points represent damage to the fungus, not the host, so they aren't affected by transferring hosts.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["move"]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":1},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"effects":[],"_id":"gUEXQ2b87W2cc13b","folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"5.1.2","coreVersion":"14.360","createdTime":1689183219643,"modifiedTime":1689183455312,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":null,"duplicateSource":null,"exportSource":null}}],"flags":{"core":{}},"_stats":{"systemId":"pf2e","systemVersion":"6.1.0","coreVersion":"14.360","createdTime":1685401626117,"modifiedTime":1736542839377,"lastModifiedBy":"l2rbNx2a8f5ocpeL","compendiumSource":null,"duplicateSource":null,"exportSource":null},"_id":"ByaexcHaun72TyTI","folder":"3x5VQ7TD4gePAtOj","ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"sort":0}