re in a @Template[type:emanation|distance:100] takes @Damage[7d6[mental]] damage with a @Check[type:will|dc:29|basic:true] save. On a failure, they become @Compendium[pf2e.conditionitems.Frightened]{Frightened 2}, and on a critical failure they become @Compendium[pf2e.conditionitems.Frightened]{Frightened 3}.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["divine","emotion","fear","mental"]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":2},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"effects":[],"_id":"CqxVuTSEPcsB8Ntg","folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"5.3.0","coreVersion":"14.360","createdTime":1687310623031,"modifiedTime":1691261014074,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"type":"action","img":"systems/pf2e/icons/default-icons/action.svg","name":"Reap the Crop","system":{"description":{"gm":"","value":"<p>The demon shepherd makes a sweeping move with its scythe, creating a wave of negative energy that affects all creatures that aren't part of its flock. All creatures in a @Template[type:cone|distance:30] take @Damage[7d6[void]] damage with a @Check[type:will|dc:29|basic:true] save. Creatures that fail the saving throw also become @Compendium[pf2e.conditionitems.Frightened]{Frightened 2}, or @Compendium[pf2e.conditionitems.Frightened]{Frightened 3} on a critical failure. The demon shepherd can't Reap the Crop again for [[/br 1d4 #rounds]]{1d4 rounds}.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["divine","emotion","fear"