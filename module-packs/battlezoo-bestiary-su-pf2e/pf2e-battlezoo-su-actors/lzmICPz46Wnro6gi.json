ot6":{"prepared":[],"value":0,"max":0},"slot7":{"prepared":[],"value":0,"max":0},"slot8":{"prepared":[],"value":0,"max":0},"slot9":{"prepared":[],"value":0,"max":0},"slot10":{"prepared":[],"value":0,"max":0},"slot11":{"prepared":[],"value":0,"max":0}},"autoHeightenLevel":{"value":null},"showUnpreparedSpells":{"value":false},"displayLevels":{}},"_id":"fpkQPBddTh2RrsSJ","img":"systems/pf2e/icons/default-icons/spellcastingEntry.svg","effects":[],"folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"5.0.1","coreVersion":"14.360","createdTime":1687310569764,"modifiedTime":1687310600896,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"img":"systems/pf2e/icons/spells/impending-doom.webp","name":"Impending Doom","system":{"description":{"gm":"","value":"<p>You sift through myriad potential futures, seize upon one potential moment in which the target meets a particularly gruesome and fatal end, and then show it a vision of its impending demise. The intense mental vision grows more and more terrifying to the target as the doom grows closer, and it takes 3 rounds to reach its conclusion. The target must attempt a Will saving throw to determine the effects. At the end of the spell's duration, if the target was affected, the target witnesses its death and takes 6d6 mental damage.</p>\n<hr />\n<p><strong>Critical Success</strong> The creature is unaffected.</p>\n<p><strong>Success</strong> The creature is unaffected for 1 round. On the second round, it becomes @UUID[Compendium.pf2e.conditionitems.Item.AJh5ex99aV6VTggg]{Off-Guard}. Finally, on the third round, it becomes @UUID[Compendium.pf2e.conditionitems.Item.TBSHQspnbcqxsmjL]{Frightened 1}. At the end of the third round, it takes half damage.</p>\n<p><strong>Failure</strong> The creature is immediately off-guard. On the second round, it becomes @UUID[Compendium.pf2e.conditionitems.Item.TBSHQspnbcqxsmjL]{Frightened 2}. Finally, on the third round, it also becomes @UUID[Compendium.pf2e.conditionitems.Item.dfCMdR4wnpbYNTix]{Stunned 1}. At the end of the third round, the creature takes full damage.</p>\n<p><strong>Critical Failure</strong> The creature is immediately off-guard and @UUID[Compendium.pf2e.conditionitems.Item.TBSHQspnbcqxsmjL]{Frightened 3}. On the second round, it becomes stunned 1. Finally, on the third round, it also becomes @UUID[Compendium.pf2e.conditionitems.Item.6uEgoh53GbXuHpTF]{Paralyzed}. At the end of the third round, the creature takes double damage.</p>\n<hr />\n<p><strong>Heightened (+1)</strong> The damage increases by 2d6.</p>"},"rules":[],"slug":"impending-doom","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","emotion","fear","incapacitation","manipulate","mental","prediction"],"rarity":"common","traditions":["arcane","divine","occult"]},"publication":{"title":"Pathfinder Secrets of Magic","authors":"","license":"OGL","remaster":false},"level":{"value":3},"requirements":"","target":{"value":"1 living creature"},"range":{"value":"30 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"3 round","sustained":false},"damage":{"0":{"applyMod":false,"formula":"6d6","type":"mental","category":null,"materials":[],"kinds":["damage"]}},"defense":{"passive":null,"save":{"statistic":"will","basic":false}},"cost":{"value":""},"location":{"value":"fpkQPBddTh2RrsSJ","heightenedLevel":5},"counteraction":false,"heightening":{"damage":{"0":"2d6"},"interval":1,"type":"interval"}},"type":"spell","flags":{"core":{}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"_stats":{"systemId":"pf2e","systemVersion":"5.0.1","coreVersion":"14.360","createdTime":1687310580690,"modifiedTime":1687310583595,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":"Compendium.pf2e.spells-srd.Item.rfFZKfeCSweFv7P3","duplicateSource":null,"exportSource":null},"_id":"j7YejTU6YQ6RTr0x"},{"img":"systems/pf2e/icons/spells/rip-the-spirit.webp","name":"Rip the Spirit","system":{"description":{"gm":"","value":"<p>You supernaturally rip the spirit from a living creature's body, dooming the target to pain and death. The target takes 5d6 negative damage, depending on its basic Fortitude save, and is @UUID[Compendium.pf2e.conditionitems.Item.4D2KBtexWXa6oUMR]{Drained 1} if it fails its save. The spell's effect is based on how many actions you spend when Casting the Spell.</p>\n<p><span class=\"pf2-icon\">1</span> <strong>(somatic)</strong> The spell targets one living creature in range.</p>\n<p><span class=\"pf2-icon\">2</span> <strong>(somatic, verbal)</strong> The spell targets one living creature in range and the damage is [[/r 10d6[void]]] damage instead of 5d6.</p>\n<p><span class=\"pf2-icon\">3</span> <strong>(material, somatic, verbal)</strong> The spell targets all living creatures in a 30-foot emanation.</p>\n<hr />\n<p><strong>Heightened (+1)</strong> The amount of damage increases by 1d6, or by [[/r 2d6]] for the 2-action version.</p>"},"rules":[],"slug":"rip-the-spirit","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["death","void"],"rarity":"common","traditions":["divine","occult"]},"publication":{"title":"Pathfinder Secrets of Magic","authors":"","license":"OGL","remaster":false},"level":{"value":5},"requirements":"","target":{"value":"1 living creature"},"range":{"value":"30 feet"},"area":null,"time":{"value":"1 to 3"},"duration":{"value":"","sustained":false},"damage":{"0":{"applyMod":false,"formula":"5d6","type":"void","category":null,"materials":[],"kinds":["damage"]}},"defense":{"passive":null,"save":{"statistic":"fortitude","basic":true}},"cost":{"value":""},"location":{"value":"fpkQPBddTh2RrsSJ","heightenedLevel":5},"counteraction":false,"heightening":{"damage":{"0":"1d6"},"interval":1,"type":"interval"},"overlays":{"7dx7zf6stp6umc4r":{"_id":"7dx7zf6stp6umc4r","overlayType":"override","sort":3,"system":{"area":{"areaType":"emanation","value":"30"},"target":{"value":"All living creatures"},"time":{"value":"3"},"traits":{"value":["concentrate","death","manipulate","void"]}}},"jma2elwwr2saf9s6":{"_id":"jma2elwwr2saf9s6","overlayType":"override","sort":1,"system":{"time":{"value":"1"},"traits":{"value":["death","manipulate","void"]}}},"jq9loelhf38up0e1":{"_id":"jq9loelhf38up0e1","overlayType":"override","sort":2,"system":{"damage":{"0":{"formula":"10d6"}},"heightening":{"damage":{"0":"2d6"}},"time":{"value":"2"},"traits":{"value":["concentrate","death","manipulate","void"]}}}}},"type":"spell","flags":{"core":{}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"_stats":{"systemId":"pf2e","systemVersion":"5.0.1","coreVersion":"14.360","createdTime":1687310588733,"modifiedTime":1687310588733,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":"Compendium.pf2e.spells-srd.Item.1bw6XJMOERcbC5Iq","duplicateSource":null,"exportSource":null},"_id":"uepWQ6QHNrE1MM2f"},{"img":"systems/pf2e/icons/spells/command.webp","name":"Command (At Will)","system":{"description":{"gm":"","value":"<p>You shout a command that's hard to ignore. You can command the target to approach you, run away (as if it had the @UUID[Compendium.pf2e.conditionitems.Item.sDPxOjQ9kx2RZE8D]{Fleeing} condition), release what it's holding, drop @UUID[Compendium.pf2e.conditionitems.Item.j91X7x0XSomq8d60]{Prone}, or stand in place. It can't Delay or take any reactions until it has obeyed your command. The effects depend on the target's Will save.</p>\n<hr /><strong>Success</strong> The creature is unaffected.\n<p><strong>Failure</strong> For the first action on its next turn, the creature must use a single action to do as you command.</p>\n<p><strong>Critical Failure</strong> The target must use all its actions on its next turn to obey your command.</p>\n<hr /><strong>Heightened (5th)</strong> You can target up to 10 creatures."},"rules":[],"slug":"command","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["auditory","concentrate","linguistic","manipulate","mental"],"rarity":"common","traditions":["arcane","divine","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":1},"requirements":"","target":{"value":"1 creature"},"range":{"value":"30 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"until the end of the target's next turn","sustained":false},"damage":{},"defense":{"passive":null,"save":{"statistic":"will","basic":false}},"cost":{"value":""},"location":{"value":"fpkQPBddTh2RrsSJ","heightenedLevel":1},"counteraction":false,"heightening":{"levels":{"5":{"target":{"value":"10 creatures"}}},"type":"fixed"}},"type":"spell","flags":{"core":{}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"_stats":{"systemId":"pf2e","systemVersion":"5.0.1","coreVersion":"14.360","createdTime":1687310593231,"modifiedTime":1687310598759,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":"Compendium.pf2e.spells-srd.Item.aIHY2DArKFweIrpf","duplicateSource":null,"exportSource":null},"_id":"x5dU3DBO60WvKrJc"},{"img":"systems/pf2e/icons/actions/Passive.webp","name":"At-Will Spells","system":{"description":{"gm":"","value":"<p>@Localize[PF2E.NPC.Abilities.Glossary.AtWillSpells]</p>"},"rules":[],"slug":"at-will-spells","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[],"rarity":"common"},"publication":{"title":"Pathfinder Bestiary","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"interaction","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""},"weapon":{"value":""}},"type":"action","flags":{"core":{}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"_stats":{"systemId":"pf2e","systemVersion":"5.0.1","coreVersion":"14.360","createdTime":1687310605503,"modifiedTime":1687310605503,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":"Compendium.pf2e.bestiary-ability-glossary-srd.Item.2YRDYVnC1eljaXKK","duplicateSource":null,"exportSource":null},"_id":"kYySRvUhy3s9wUb7"},{"img":"systems/pf2e/icons/spells/abyssal-pact.webp","name":"Abyssal Pact","system":{"description":{"gm":"","value":"<p>You call in a favor from another demon whose level is no more than double <em>Abyssal pact's</em> spell level, two demons whose levels are each at least 2 less than double the spell level, or three demons whose levels are each at least 3 less than double the spell level.</p>\n<hr />\n<p><strong>Critical Success</strong> You conjure the demon or demons. They are eager to pursue the task, so they don't ask for a favor.</p>\n<p><strong>Success</strong> You conjure the demon or demons. They are not eager to pursue the task, so they require a favor in return.</p>\n<p><strong>Failure</strong> You don't conjure any demons.</p>\n<p><strong>Critical Failure</strong> The demon or demons are angry that you disturbed them. They appear before you, but they immediately attack you.</p>"},"rules":[],"slug":"abyssal-pact","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[],"rarity":"uncommon","traditions":[]},"publication":{"title":"Pathfinder Bestiary","authors":"","license":"OGL","remaster":false},"level":{"value":1},"requirements":"","target":{"value":""},"range":{"value":""},"area":null,"time":{"value":"1 day"},"duration":{"value":"","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":null},"counteraction":false,"ritual":{"primary":{"check":"Religion (exper