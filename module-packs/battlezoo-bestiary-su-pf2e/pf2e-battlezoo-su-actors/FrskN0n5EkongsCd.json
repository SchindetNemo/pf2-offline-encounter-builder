portSource":null}},{"img":"systems/pf2e/icons/actions/OneAction.webp","name":"Grab","system":{"description":{"gm":"","value":"<p>@Localize[PF2E.NPC.Abilities.Glossary.Grab]</p>"},"rules":[],"slug":"grab","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[],"rarity":"common"},"publication":{"title":"Pathfinder Bestiary","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":1},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""},"weapon":{"value":""}},"type":"action","flags":{"core":{}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"_stats":{"systemId":"pf2e","systemVersion":"5.1.2","coreVersion":"14.360","createdTime":1689042537991,"modifiedTime":1689042537991,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":"Compendium.pf2e.bestiary-ability-glossary-srd.Item.Tkd8sH4pwFIPzqTr","duplicateSource":null,"exportSource":null},"_id":"mXiNZDXmoy1pBvgd"},{"type":"action","img":"systems/pf2e/icons/default-icons/action.svg","name":"Scyphozoid Toxin","system":{"description":{"gm":"","value":"<p><strong>Saving Throw</strong> @Check[type:fortitude|dc:31]</p>\n<p><strong>Maximum Duration</strong> 6 rounds</p>\n<p><strong>Stage 1</strong> @Damage[6d6[poison]] damage (1 round)</p>\n<p><strong>Stage 2</strong> [[/r 6d6[poison]]] damage and @Compendium[pf2e.conditionitems.Slowed]{Slowed 1} (1 round)</p>\n<p><strong>Stage 3</strong> [[/r 6d6[poison]]] damage and @Compendium[pf2e.conditionitems.Paralyzed]{Paralyzed} (1 round)</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["poison"]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"offensive","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"effects":[],"_id":"Muyd0fc3VdKuh6iU","folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"5.3.0","coreVersion":"14.360","createdTime":1689042548100,"modifiedTime":1691261012699,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"type":"action","img":"systems/pf2e/icons/default-icons/action.svg","name":"Digestive Embrace","system":{"description":{"gm":"","value":"<p>A creature @Compendium[pf2e.conditionitems.Grabbed]{Grabbed} by the scyphozoid eye's arm takes [[/r (2d6+4)[acid]]] damage at the end of each of its turns.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"offensive","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"effects":[],"_id":"kTtzSwT9LXnqWLPl","folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"5.1.2","coreVersion":"14.360","createdTime":1689042572648,"modifiedTime":1689042592563,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"name":"Occult Innate Spells","type":"spellcastingEntry","system":{"description":{"gm":"","value":""},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"ability":{"value":"cha"},"spelldc":{"value":25,"dc":33},"tradition":{"value":"occult"},"prepared":{"value":"innate"},"showSlotlessLevels":{"value":false},"proficiency":{"value":1},"slots":{"slot0":{"prepared":[],"value":0,"max":0},"slot1":{"prepared":[],"value":0,"max":0},"slot2":{"prepared":[],"value":0,"max":0},"slot3":{"prepared":[],"value":0,"max":0},"slot4":{"prepared":[],"value":0,"max":0},"slot5":{"prepared":[],"value":0,"max":0},"slot6":{"prepared":[],"value":0,"max":0},"slot7":{"prepared":[],"value":0,"max":0},"slot8":{"prepared":[],"value":0,"max":0},"slot9":{"prepared":[],"value":0,"max":0},"slot10":{"prepared":[],"value":0,"max":0},"slot11":{"prepared":[],"value":0,"max":0}},"autoHeightenLevel":{"value":null},"showUnpreparedSpells":{"value":false},"displayLevels":{}},"_id":"PS9apN3xZy8rh4uB","img":"systems/pf2e/icons/default-icons/spellcastingEntry.svg","effects":[],"folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"5.1.2","coreVersion":"14.360","createdTime":1689042699150,"modifiedTime":1689042748708,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"img":"systems/pf2e/icons/spells/color-spray.webp","name":"Color Spray","system":{"description":{"gm":"","value":"<p>Swirling colors affect viewers based on their Will saves.</p>\n<hr />\n<p><strong>Critical Success</strong> The creature is unaffected.</p>\n<p><strong>Success</strong> The creature is @UUID[Compendium.pf2e.conditionitems.Item.TkIyaNPgTZFBCCuh]{Dazzled} for 1 round.</p>\n<p><strong>Failure</strong> The creature is @UUID[Compendium.pf2e.conditionitems.Item.dfCMdR4wnpbYNTix]{Stunned 1}, @UUID[Compendium.pf2e.conditionitems.Item.XgEqL1kFApUbl5Z2]{Blinded} for 1 round, and Dazzled for 1 minute.</p>\n<p><strong>Critical Failure</strong> The creature is Stunned for 1 round and Blinded for 1 minute.</p>"},"rules":[],"slug":"color-spray","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","illusion","incapacitation","manipulate","visual"],"rarity":"common","traditions":["arcane","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":1},"requirements":"","target":{"value":""},"range":{"value":""},"area":{"type":"cone","value":15},"time":{"value":"2"},"duration":{"value":"1 or more rounds (see below)","sustained":false},"damage":{},"defense":{"passive":null,"save":{"statistic":"will","basic":false}},"cost":{"value":""},"location":{"value":"PS9apN3xZy8rh4uB","heightenedLevel":7,"uses":{"max":2,"value":2}},"counteraction":false},"type":"spell","flags":{"core":{}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"_stats":{"systemId":"pf2e","systemVersion":"5.1.2","coreVersion":"14.360","createdTime":1689042700460,"modifiedTime":1689042726570,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":"Compendium.pf2e.spells-srd.Item.UKsIOWmMx4hSpafl","duplicateSource":null,"exportSource":null},"_id":"aL2dvNSQVIqjacoj"},{"img":"systems/pf2e/icons/spells/chromatic-ray.webp","name":"Chromatic Ray","system":{"description":{"gm":"","value":"<p>You send out a ray of colored light streaming toward your enemy, with a magical effect depending on the ray's color. Make a spell attack roll. If you hit, roll [[/r 1d4]]{1d4} to see which beam you cast. If the ray deals damage, that damage is doubled on a critical hit. Any additional traits that apply to a ray are listed in parentheses just after the name of the color.</p>\n<ol>\n<li><strong>Red</strong> (fire) The ray deals [[/r 30[fire]]] damage to the target.</li>\n<li><strong>Orange</strong> (acid) The ray deals [[/r 40[acid]]] damage to the target.</li>\n<li><strong>Yellow</strong> (electricity) The ray deals [[/r 50[electricity]]] damage to the target.</li>\n<li><strong>Green</strong> (poison) The ray deals [[/r 25[poison]]] damage to the target, and the target must succeed at a Fortitude save or be @UUID[Compendium.pf2e.conditionitems.Item.MIRkyAjyBeXivMa7]{Enfeebled 1} for 1 minute (@UUID[Compendium.pf2e.conditionitems.Item.MIRkyAjyBeXivMa7]{Enfeebled 2} on a critical failure).</li>\n</ol>\n<hr />\n<p><strong>Heightened (6th)</strong> The damage for [[/r 40[fire]]]{Red}, [[/r 50[acid]]]{Orange}, [[/r 60[electricity]]]{Yellow}, and [[/r 35[poison]]]{Green} each increase by 10. Roll [[/r 1d8]]{1d8} to determine the ray's color, using the results for 1-4 above and the results for 5-8 below.</p>\n<ol start=\"5\">\n<li><strong>Blue</strong> The ray has the effect of the <em>@UUID[Compendium.pf2e.spells-srd.Item.znv4ECL7ZtuiagtA]{Flesh to Stone}</em> spell. On a critical hit, the target is @UUID[Compendium.pf2e.conditionitems.Item.i3OJZU2nk64Df3xm]{Clumsy 1} as long as it's @UUID[Compendium.pf2e.conditionitems.Item.xYTAsEpcJE1Ccni3]{Slowed} by the <em>flesh to stone</em> effect.</li>\n<li><strong>Indigo</strong> (emotion, incapacitation, mental) The ray has the effect of the <em>@UUID[Compendium.pf2e.spells-srd.Item.LiGbewa9pO0yjbsY]{Confusion}</em> spell. On a critical hit, it has the effect of <em>@UUID[Compendium.pf2e.spells-srd.Item.8kJbiBEjMWG4VUjs]{Warp Mind}</em> instead.</li>\n<li><strong>Violet</strong> The target is @UUID[Compendium.pf2e.conditionitems.Item.xYTAsEpcJE1Ccni3]{Slowed} for 1 minute. It must also succeed at a will save or be teleported 120 feet directly away from you (if there isn't room for it to appear there, it appears in the nearest open space); this is a teleportation effect.</li>\n<li><strong>Intense Color</strong> The target is @UUID[Compendium.pf2e.conditionitems.Item.TkIyaNPgTZFBCCuh]{Dazzled} until the end of your next turn, or @UUID[Compendium.pf2e.conditionitems.Item.XgEqL1kFApUbl5Z2]{Blinded} if your attack roll was a critical hit. Roll again and add the effects of another color (rerolling results of 8).</li>\n</ol>"},"rules":[],"slug":"chromatic-ray","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["attack","concentrate","light","manipulate"],"rarity":"common","traditions":["arcane","occult"]},"publication":{"title":"Pathfinder Secrets of Magic","authors":"","license":"OGL","remaster":false},"level":{"value":4},"requirements":"","target":{"value":"1 creature"},"range":{"value":"30 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"","sustained":false},"damage":{},"defense":{"passive":null,"save":{"statistic":"fortitude","basic":false}},"cost":{"value":""},"location":{"value":"PS9apN3xZy8rh4uB","heightenedLevel":6,"uses":{"max":2,"value":2}},"counteraction":false},"type":"spell","flags":{"core":{}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"_stats":{"systemId":"pf2e","systemVersion":"5.1.2","coreVersion":"14.360","createdTime":1689042703050,"modifiedTime":1689042734315,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":"Compendium.pf2e.spells-srd.Item.Hb8GdAhP0zBCv3zU","duplicateSource":null,"exportSource":null},"_id":"nC5LvqQ1ZoAGm3Zp"},{"img":"systems/pf2e/icons/spells/chromatic-image.webp","name":"Chromatic Image","system":{"description":{"gm":"","value":"<p>You call forth three illusory images of yourself, and each of the four of you takes on a different color, your colors all shifting each time someone attacks you. This has the effects of <em>@UUID[Compendium.pf2e.spells-srd.Item.j8vIoIEWElvpwkcI]{Mirror Image}</em>, except that whenever a foe destroys one of the images, roll [[/r 1d4]]{1d4} to see which color the image was when it was destroyed. The attacker takes the corresponding effect.</p>\n<ol>\n<li><strong>Red</strong> [[/r 5[fire]]] damage and [[/r 5[mental]]] damage.</li>\n<li><strong>Orange</strong> [[/r 5[acid]]] damage and [[/r 5[mental]]] damage.</li>\n<li><strong>Yellow</strong> [[/r 5[electricity]]] damage and [[/r 5[mental]]] damage.</li>\n<li><strong>Green</strong> [[/r 5[poison]]] damage and [[/r 5[mental]]] damage, plus it's @UUID[Compendium.pf2e.conditionitems.Item.TBSHQspnbcqxsmjL]{Frightened 1}.</li>\n</ol>"},"rules":[],"slug":"chromatic-image","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","illusion","manipulate","visual"],"rarity":"common","traditions":["arcane","occult"]},"publication":{"title":"Pathfinder Secrets of Magic","authors":"","license":"OGL","remaster":false},"level":{"value":6},"requirements":"","target":{"value":""},"range":{"value":""},"area":null,"time":{"value":"2"},"duration":{"value":"1 minute","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"PS9apN3xZy8rh4uB","heightenedLevel":6},"counteraction":false},"type":"spell","flags":{"core":{}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"_stats":{"systemId":"pf2e","systemVersion":"5.1.2","coreVersion":"14.360","createdTime":1689042708334,"modifiedTime":1689042708334,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":"Compendium.pf2e.spells-srd.Item.FgRpddPORsRFwNoX","duplicateSource":null,"exportSource":null},"_id":"OmVpLxXscLG6keOo"},{"img":"systems/pf2e/icons/spells/cloak-of-colors.webp","name":"Cloak of Colors","system":{"description":{"gm":"","value":"<p>A cloak of swirling colors shrouds the target. Creatures are @UUID[Compendium.pf2e.conditionitems.Item.TkIyaNPgTZFBCCuh]{Dazzled} while adjacent to it, and attacking the target causes a brilliant flash of light. A creature that hits the target with a melee attack must attempt a Will save.The creature is temporarily immune until the end of its turn; this effect has the incapacitation trait.</p>\n<hr />\n<p><strong>Success</strong> The attacker is unaffected.</p>\n<p><strong>Failure</strong> The attacker is @UUID[Compendium.pf2e.conditionitems.Item.XgEqL1kFApUbl5Z2]{Blinded} for 1 round.</p>\n<p><strong>Critical Failure</strong> The attacker is @UUID[Compendium.pf2e.conditionitems.Item.dfCMdR4wnpbYNTix]{Stunned} for 1 round.</p>"},"rules":[],"slug":"cloak-of-colors","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","illusion","manipulate","visual"],"rarity":"common","traditions":["arcane","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":5},"requirements":"","target":{"value":"1 creature"},"range":{"value":"30 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"1 minute","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"PS9apN3xZy8rh4uB","heightenedLevel":5,"uses":{"max":2,"value":2}},"counteraction":false},"type":"spell","flags":{"core":{}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"_stats":{"systemId":"pf2e","systemVersion":"5.1.2","coreVersion":"14.360","createdTime":1689042712322,"modifiedTime":1689042739740,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":"Compendium.pf2e.spells-srd.Item.TCk2MDwf5L5OYjFC","duplicateSource":null,"exportSource":null},"_id":"B2R6RkLsr4OqO8Rn"},{"img":"systems/pf2e/icons/spells/chroma-leach.webp","name":"Chroma Leach","system":{"description":{"gm":"","value":"<p>Your hand glows with impossible colors from beyond the stars, and your touch saps both color and vitality from the living. The target must attempt a Fortitude save; creatures with the gnome trait take a -2 circumstance penalty to this save.</p>\n<hr />\n<p><strong>Critical Success</strong> The target is unaffected.</p>\n<p><strong>Success</strong> The target is @UUID[Compendium.pf2e.conditionitems.Item.MIRkyAjyBeXivMa7]{Enfeebled 2} for 1 round.</p>\n<p><strong>Failure</strong> The target is @UUID[Compendium.pf2e.conditionitems.Item.MIRkyAjyBeXivMa7]{Enfeebled 2} for 1 minute and @UUID[Compendium.pf2e.conditionitems.Item.4D2KBtexWXa6oUMR]{Drained 1}. The target is also filled with listlessness and ennui. For 1 round, if the target tries to use a move action, it must succeed at a Will save against your spell DC or the action is lost; this effect has the mental and emotion traits.</p>\n<p><strong>Critical Failure</strong> As failure, but the creature is permanently @UUID[Compendium.pf2e.conditionitems.Item.MIRkyAjyBeXivMa7]{Enfeebled 2} and @UUID[Compendium.pf2e.conditionitems.Item.4D2KBtexWXa6oUMR]{Drained 2} (although magic such as <em>@UUID[Compendium.pf2e.spells-srd.Item.SnaLVgxZ9ryUFmUr]{Restoration}</em> can reduce or remove these conditions).</p>"},"rules":[],"slug":"chroma-leach","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","manipulate"],"rarity":"common","traditions":["occult"]},"publication":{"title":"Pathfinder Advanced Player's Guide","authors":"","license":"OGL","remaster":false},"level":{"value":4},"requirements":"","target":{"value":"1 living creature"},"range":{"value":"touch"},"area":null,"time":{"value":"2"},"duration":{"value":"","sustained":false},"damage":{},"defense":{"passive":null,"save":{"statistic":"fortitude","basic":false}},"cost":{"value":""},"location":{"value":"PS9apN3xZy8rh4uB","heightenedLevel":4,"uses":{"max":2,"value":2}},"counteraction":false},"type":"spell","flags":{"core":{}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"_stats":{"systemId":"pf2e","systemVersion":"5.1.2","coreVersion":"14.360","createdTime":1689042713690,"modifiedTime":1689042743844,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":"Compendium.pf2e.spells-srd.Item.4y2DMq9DV5HvmnxC","duplicateSource":null,"exportSource":null},"_id":"xhYl8tKvKGb2F0It"},{"img":"systems/pf2e/icons/spells/detect-magic.webp","name":"Detect Magic","system":{"description":{"gm":"","value":"<p>You send out a pulse that registers the presence of magic. You receive no information beyond the presence or absence of magic. You can choose to ignore magic you're fully aware of, such as the magic items and ongoing spells of you and your allies.</p>\n<p>You detect illusion magic only if that magic's effect has a lower level than the level of your detect magic spell. However, items that have an illusion aura but aren't deceptive in appearance (such as an invisibility potion) typically are detected normally.</p>\n<hr />\n<p><strong>Heightened (3rd)</strong> You learn the school of magic for the highest-level effect within range that the spell detects. If multiple effects are equally strong, the GM determines which you learn.</p>\n<p><strong>Heightened (4th)</strong> As 3rd level, but you also pinpoint the source of the highest-level magic. Like for an imprecise sense, you don't learn the exact location, but can narrow down the source to within a 5-foot cube (or the nearest if larger than that).</p>"},"rules":[],"slug":"detect-magic","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["cantrip","concentrate","detection","manipulate"],"rarity":"common","traditions":["arcane","divine","occult","primal"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":1},"requirements":"","target":{"value":""},"range":{"value":""},"area":{"type":"emanation","value":30},"time":{"value":"2"},"duration":{"value":"","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"PS9apN3xZy8rh4uB"},"counteraction":false},"type":"spell","flags":{"core":{}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"_stats":{"systemId":"pf2e","systemVersion":"5.1.2","coreVersion":"14.360","createdTime":1689042715050,"modifiedTime":1689042715050,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":"Compendium.pf2e.spells-srd.Item.gpzpAAAJ1Lza2JVl","duplicateSource":null,"exportSource":null},"_id":"sj4cnivum8cqv1W1"},{"img":"systems/pf2e/icons/spells/tongues.webp","name":"Tongues (Constant)","system":{"description":{"gm":"","value":"<p>The target can understand all words regardless of language and also speak the languages of other creatures. When in a mixed group of creatures, each time the target speaks, it can choose a creature and speak in a language that creature understands, even if the target doesn't know what language that is.</p>\n<hr />\n<p><strong>Heightened (7th)</strong> The duration is 8 hours.</p>"},"rules":[],"slug":"tongues","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","manipulate"],"rarity":"uncommon","traditions":["arcane","divine","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":5},"requirements":"","target":{"value":"1 creature"},"range":{"value":"touch"},"area":null,"time":{"value":"2"},"duration":{"value":"1 hour","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"PS9apN3xZy8rh4uB","heightenedLevel":7},"counteraction":false},"type":"spell","flags":{"core":{}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"_stats":{"systemId":"pf2e","systemVersion":"5.1.2","coreVersion":"14.360","createdTime":1689042716404,"modifiedTime":1689042771369,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":"Compendium.pf2e.spells-srd.Item.SwUiVavHKMWG7t5K","duplicateSource":null,"exportSource":null},"_id":"zd0fmbOG4Mrp5HhR"},{"type":"action","img":"systems/pf2e/icons/default-icons/action.svg","name":"Ravenous Arms","system":{"description":{"gm":"","value":"<p>The scyphozoid eye makes up to four arm Strikes, each against a different target. These count toward the scyphozoid eye's multiple attack penalty, but the multiple attack penalty doesn't increase until after all the attacks.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":2},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"effects":[],"_id":"8t6BFeShwKwCIUl3","folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"5.3.0","coreVersion":"14.360","createdTime":1691129907618,"modifiedTime":1691129929395,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":null,"duplicateSource":null,"exportSource":null}}],"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"6.1.0","coreVersion":"14.360","createdTime":1685401626117,"modifiedTime":1736542894158,"lastModifiedBy":"l2rbNx2a8f5ocpeL","compendiumSource":null,"duplicateSource":null,"exportSource":null},"_id":"FrskN0n5EkongsCd","folder":"QqEyWiBhCvupt0ox","ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"sort":0}