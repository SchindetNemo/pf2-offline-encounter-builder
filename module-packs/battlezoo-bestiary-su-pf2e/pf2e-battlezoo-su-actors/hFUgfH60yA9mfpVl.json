 listed circumstance bonus to AC. Your shield remains raised until the start of your next turn.</p>\n<p>@UUID[Compendium.pf2e.equipment-effects.Item.2YgXoHvJfrDHucMr]</p>"},"rules":[],"slug":"raise-a-shield","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["general"],"rarity":"common"},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"defensive","actions":{"value":1},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""},"weapon":{"value":""}},"type":"action","flags":{"core":{}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"_stats":{"systemId":"pf2e","systemVersion":"4.12.6","coreVersion":"14.360","createdTime":1685988957714,"modifiedTime":1685988957714,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":"Compendium.pf2e.actionspf2e.Item.xjGwis0uaC2305pm","duplicateSource":null,"exportSource":null},"_id":"3crKEDXFAeqPPqAZ"},{"img":"systems/pf2e/icons/actions/Reaction.webp","name":"Shield Block","system":{"description":{"gm":"","value":"<p>@Localize[PF2E.NPC.Abilities.Glossary.ShieldBlock]</p>"},"rules":[],"slug":"shield-block","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[],"rarity":"common"},"publication":{"title":"Pathfinder Bestiary","authors":"","license":"OGL","remaster":false},"actionType":{"value":"reaction"},"category":"defensive","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""},"weapon":{"value":""}},"type":"action","flags":{"core":{}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"_stats":{"systemId":"pf2e","systemVersion":"4.12.6","coreVersion":"14.360","createdTime":1685988965276,"modifiedTime":1685988965276,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":"Compendium.pf2e.bestiary-ability-glossary-srd.Item.m4HQ2o5aPxjXf2kY","duplicateSource":null,"exportSource":null},"_id":"aka4gUPXebZBIWDg"},{"name":"Warefare Lore","type":"lore","system":{"description":{"gm":"","value":""},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"mod":{"value":12},"proficient":{"value":0}},"effects":[],"_id":"sYOlcj4hwkOqo531","img":"systems/pf2e/icons/default-icons/lore.svg","folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"4.12.6","coreVersion":"14.360","createdTime":1685989037263,"modifiedTime":1685989044513,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"img":"systems/pf2e/icons/actions/Passive.webp","name":"Constant Spells","system":{"description":{"gm":"","value":"<p>@Localize[PF2E.NPC.Abilities.Glossary.ConstantSpells]</p>"},"rules":[],"slug":"constant-spells","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[],"rarity":"common"},"publication":{"title":"Pathfinder Bestiary","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"interaction","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""},"weapon":{"value":""}},"type":"action","flags":{"core":{}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"_stats":{"systemId":"pf2e","systemVersion":"4.12.6","coreVersion":"14.360","createdTime":1685989083329,"modifiedTime":1685989083329,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":"Compendium.pf2e.bestiary-ability-glossary-srd.Item.kakyXBG5WA8c6Zfd","duplicateSource":null,"exportSource":null},"_id":"WFnA57bUgui3GYvV"},{"type":"action","img":"systems/pf2e/icons/default-icons/action.svg","name":"Detached Face","system":{"description":{"gm":"","value":"<p>The arrongtata commander's face is detached from its body, and there is a telepathic connection between the two. The face has two unblinking eyes that provide vision, hearing, scent, and the ability to perform a Stunning Glare. All other functions and abilities are performed by the arrongtata commander's body. When the arrongtata commander's body has its face in its possession, it perceives normally. The arrongtata commander's face can still see, hear, and smell even if it's away from its body, but it can only see whatever is visible from its current position, possibly making it unable to see, hear, or smell what's going on around it (using effects similar to the @Compendium[pf2e.conditionitems.Blinded]{Blinded} and @Compendium[pf2e.conditionitems.Deafened]{Deafened} conditions to handle this). Even if its head can see its body from afar, the confusion from the distant viewpoint causes the arrongtata commander to be @Compendium[pf2e.conditionitems.Off-Guard]{Off-Guard} while it isn't holding its head.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"interaction","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"effects":[],"_id":"yfOtfY0j1lQ7rwem","folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"4.12.6","coreVersion":"14.360","createdTime":1685989095375,"modifiedTime":1685989134992,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"type":"action","img":"systems/pf2e/icons/default-icons/action.svg","name":"Shield Face","system":{"description":{"gm":"","value":"<p>The face of an arrongtata commander is incredibly sturdy, and acts as both a shield and weapon, though only for that arrongtata commander. When the arrongtata commander holds its arrongtata face in at least one hand, it can use the face to Raise a Shield, Shield Block, or Strike (Hardness 8, HP 48, BT 24). Because of their mystical connection to their head, when an arrongtata commander Raises a Shield with their head, they gain a +4 circumstance bonus to AC, and if their face breaks, it remains partially functional. While broken, it can no longer be used to Strike but can still act as a shield with a circumstance bonus of +2 AC when raised. If an arrongtata commander's face is fully destroyed, the arrongtata becomes @Compendium[pf2e.conditionitems.Blinded]{Blinded} and @Compendium[pf2e.conditionitems.Deafened]{Deafened} and can't use Stunning Glare.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"interaction","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"effects":[],"_id":"IVKaoPFkXtR5irYP","folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"5.0.2","coreVersion":"14.360","createdTime":1685989095797,"modifiedTime":1687551737952,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"type":"action","img":"systems/pf2e/icons/default-icons/action.svg","name":"Summon Face","system":{"description":{"gm":"","value":"<p><strong>Requirements</strong> The arrongtata commander has a free hand</p>\n<hr />\n<p><strong>Effect</strong> The arrongtata commander immediately teleports its face from anywhere into its hand.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["primal"]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"interaction","actions":{"value":2},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"effects":[],"_id":"TRaUzDeEzkKJ4Sr3","folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"4.12.6","coreVersion":"14.360","createdTime":1685989178736,"modifiedTime":1685989248561,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"img":"systems/pf2e/icons/equipment/weapons/spear.webp","name":"Spear","system":{"description":{"gm":"","value":"<p>A long metal shaft ending with a metal spike, a spear can be used one‑handed as a melee weapon and can be thrown.</p>"},"rules":[],"slug":"spear","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["thrown-20"],"rarity":"common"},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":0},"quantity":5,"baseItem":"spear","bulk":{"value":1},"hp":{"value":0,"max":0},"hardness":0,"price":{"value":{"sp":1}},"equipped":{"carryType":"worn","invested":null,"handsHeld":0},"containerId":null,"size":"med","material":{"type":null,"grade":null},"identification":{"status":"identified","unidentified":{"name":"","img":"","data":{"description":{"value":""}}},"misidentified":{}},"usage":{"value":"held-in-one-hand"},"category":"simple","group":"spear","bonus":{"value":0},"damage":{"dice":1,"die":"d6","damageType":"piercing","persistent":null},"splashDamage":{"value":0},"range":null,"expend":null,"ammo":null