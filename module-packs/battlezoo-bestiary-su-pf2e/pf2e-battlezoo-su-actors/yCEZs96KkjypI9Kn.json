{"prototypeToken":{"displayName":20,"displayBars":20,"flags":{"pf2e":{"linkToActorSize":true,"autoscale":true}},"height":1,"width":1,"name":"Akaky","actorLink":false,"texture":{"src":"modules/battlezoo-bestiary-su-pf2e/art/tokens/akaky.webp","scaleX":2,"scaleY":2,"tint":"#ffffff","anchorX":0.5,"anchorY":0.5,"fit":"contain","alphaThreshold":0.75},"lockRotation":false,"rotation":0,"alpha":1,"disposition":-1,"bar1":{"attribute":"attributes.hp"},"bar2":{"attribute":null},"light":{"alpha":0.5,"angle":360,"bright":0,"color":null,"coloration":1,"dim":0,"attenuation":0.5,"luminosity":0.5,"saturation":0,"contrast":0,"shadows":0,"animation":{"type":null,"speed":5,"intensity":5,"reverse":false},"darkness":{"min":0,"max":1},"negative":false,"priority":0},"sight":{"enabled":false,"range":0,"angle":360,"visionMode":"basic","color":null,"attenuation":0.1,"brightness":0,"saturation":0,"contrast":0},"detectionModes":{},"randomImg":false,"appendNumber":false,"prependAdjective":false,"occludable":{"radius":0},"ring":{"enabled":true,"colors":{"ring":null,"background":null},"effects":1,"subject":{"scale":2,"texture":"modules/battlezoo-bestiary-su-pf2e/art/subjects/akaky.webp"}},"turnMarker":{"mode":1,"animation":null,"src":null,"disposition":false},"movementAction":null,"depth":1},"name":"Akaky","type":"npc","effects":[],"system":{"attributes":{"hp":{"value":25,"temp":0,"max":25,"details":"negative healing, rejuvenation"},"ac":{"value":18,"details":""},"allSaves":{"value":""},"speed":{"value":0,"otherSpeeds":[{"type":"fly","value":25}],"details":""},"immunities":[{"type":"death-effects","exceptions":[]},{"type":"disease","exceptions":[]},{"type":"paralyzed","exceptions":[]},{"type":"poison","exceptions":[]},{"type":"precision","exceptions":[]},{"type":"unconscious","exceptions":[]}],"resistances":[{"type":"all-damage","value":5,"exceptions":["force","ghost-touch","vitality"],"doubleVs":["non-magical"]}]},"initiative":{"statistic":"perception"},"details":{"languages":{"value":["common","necril"],"details":""},"level":{"value":3},"blurb":"","publicNotes":"<p>Akakys are the souls of mortals who died from hypothermia or illness, typically after they were ambushed and robbed of their valuables and, more importantly, their warm clothes during the winter.</p>\n<p>These spirits, filled with unspeakable hatred for the living and jealousy for their warmth, stalk city streets in the dead of cold winter nights, only to unleash a spectral phantasm of their own suffering upon anyone unlucky enough to cross their path.</p>\n<h2>Cold Comfort</h2>\n<p>City dwellers share rumors about how to survive akaky encounters whenever the chill of winter approaches. Some say dropping a doll wearing winter clothing will distract an akaky, while others say the smell of roasted marshmallows repels akakys or that fire will slow down an approaching akaky. Nobody's exactly sure as to why, to date, none of this advice has actually worked.</p>\n<h2>Suggested Monster Parts</h2>\n<p><strong>Monster Parts</strong> 7/18/30 gp</p>\n<p><strong>Eligible Refinements</strong> perception item, skill items (Acrobatics, Intimidation, Society)</p>\n<p><strong>Eligible Imbued Properties</strong> chaotic, cold, dexterity, energy resistant (negative), evil, fortification, negative, wild, winged</p>","privateNotes":"","publication":{"title":"Battlezoo Bestiary: Strange and Unusual","authors":"Ivan Kulikov","license":"OGL","remaster":false},"creatureType":""},"resources":{},"_migration":{"version":0.932,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"abilities":{"str":{"mod":-5},"dex":{"mod":-4},"con":{"mod":0},"int":{"mod":0},"wis":{"mod":3},"cha":{"mod":0}},"perception":{"details":"","mod":8,"senses":[{"type":"darkvision"}],"vision":true},"saves":{"fortitude":{"value":5,"saveDetail":""},"reflex":{"value":11,"saveDetail":""},"will":{"value":10,"saveDetail":""}},"skills":{"acrobatics":{"base":9},"intimidation":{"base":7},"society":{"base":9}},"traits":{"value":["chaotic","evil","incorporeal","spirit","undead","unholy"],"rarity":"uncommon","size":{"value":"med"}}},"img":"modules/battlezoo-bestiary-su-pf2e/art/Portraits/akaky.webp","items":[{"img":"systems/pf2e/icons/actions/Passive.webp","name":"Darkvision","system":{"description":{"gm":"","value":"<p>@Localize[PF2E.NPC.Abilities.Glossary.Darkvision]</p>"},"rules":[],"slug":"darkvision","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[],"rarity":"common"},"publication":{"title":"Pathfinder Bestiary","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"interaction","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""},"weapon":{"value":""}},"type":"action","flags":{"core":{}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"_stats":{"systemId":"pf2e","systemVersion":"4.12.6","coreVersion":"14.360","createdTime":1685577138320,"modifiedTime":1685577138320,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":"Compendium.pf2e.bestiary-ability-glossary-srd.Item.qCCLZhnp2HhP3Ex6","duplicateSource":null,"exportSource":null},"_id":"HiN9Xr8kAVEAbLGz"},{"img":"systems/pf2e/icons/actions/Passive.webp","name":"Negative Healing","system":{"description":{"gm":"","value":"<p>@Localize[PF2E.NPC.Abilities.Glossary.NegativeHealing]</p>"},"rules":[{"key":"ActiveEffectLike","mode":"override","path":"system.attributes.hp.negativeHealing","value":true}],"slug":"negative-healing","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[],"rarity":"common"},"publication":{"title":"Pathfinder Bestiary 2","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"defensive","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""},"weapon":{"value":""}},"type":"action","flags":{"core":{}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"_stats":{"systemId":"pf2e","systemVersion":"4.12.6","coreVersion":"14.360","createdTime":1685577641314,"modifiedTime":1685577641314,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":"Compendium.pf2e.bestiary-ability-glossary-srd.Item.TTCw5NusiSSkJU1x","duplicateSource":null,"exportSource":null},"_id":"oV6BuqUzKwXprKUf"},{"img":"systems/pf2e/icons/actions/Passive.webp","name":"Rejuvenation","system":{"description":{"gm":"","value":"<p>When an akaky is destroyed, it reforms, fully healed, at the location where its clothing was stolen after [[/br 2d4 #Days]]{2d4 days}. If someone willingly gives at least a piece of its original garment to the akaky, it is permanently destroyed.</p>"},"rules":[],"slug":"ghost-rejuvenation","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["divine"],"rarity":"common"},"publication":{"title":"Pathfinder Bestiary","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"defensive","actions":{"value":null},"deathNote":true,"requirements":{"value":""},"trigger":{"value":""},"weapon":{"value":""}},"type":"action","flags":{"core":{}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"_stats":{"systemId":"pf2e","systemVersion":"4.12.6","coreVersion":"14.360","createdTime":1685577647150,"modifiedTime":1685577706830,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":"Compendium.pf2e.bestiary-family-ability-glossary.Item.unR8VVR4yyRnsmnB","duplicateSource":null,"exportSource":null},"_id":"cpIqw9iaIxvWplIa"},{"type":"action","img":"systems/pf2e/icons/default-icons/action.svg","name":"Winter Aura","system":{"description":{"gm":"","value":"<p>10 feet. The air grows supernaturally colder in close proximity to an akaky, causing the temperature to become two steps colder. Mild cold becomes extreme cold, Severe or extreme cold becomes incredible cold and so on. As long as this brings the temperature to severe cold or colder, creatures other than the akaky who end their turn in the aura who aren't wearing winter clothing take @Damage[1d4[cold]] damage, with a @Check[type:fortitude|dc:17|basic:true] save.</p>"},"rules":[{"key":"Aura","radius":10,"traits":["cold"]}],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["aura","cold"]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"defensive","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"effects":[],"_id":"b0UJiNZ7fAPDyYsT","folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"5.3.0","coreVersion":"14.360","createdTime":1685577717099,"modifiedTime":1691261014600,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"img":"systems/pf2e/icons/actions/OneAction.webp","name":"Ghostly Grab","system":{"description":{"gm":"","value":"<p>As Grab, but the akaky can Grab a corporeal creature despite being incorporeal itself. It is only able to do so by manifesting a fading image of a ghostly overcoat onto the creature and then clutching onto the incorporeal coat. This spiritual garment superimposes over any winter clothing a target might have, allowing the akaky to potentially tear the warm clothing off the victim after killing them. The @Compendium[pf2e.actionspf2e.Escape]{Escape} DC for victims of an akaky's Grab is 20, rather than the akaky's Athletics DC.</p>\n<hr />\n<p>@Localize[PF2E.NPC.Abilities.Glossary.Grab]</p>"},"rules":[],"slug":"ghostly-grab","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[],"rarity":"common"},"publication":{"title":"Pathfinder Bestiary","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":1},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""},"weapon":{"value":""}},"type":"action","flags":{"core":{}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"_stats":{"systemId":"pf2e","systemVersion":"5.3.0","coreVersion":"14.360","createdTime":1685578099373,"modifiedTime":1691127980398,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":"Compendium.pf2e.bestiary-ability-glossary-srd.Item.Tkd8sH4pwFIPzqTr","duplicateSource":null,"exportSource":null},"_id":"dkj3t4y9Hn88lLEI"},{"type":"action","img":"systems/pf2e/icons/default-icons/action.svg","name":"Steal Coat","system":{"description":{"gm":"","value":"<p><strong>Requirements</strong> The akaky has a creature @Compendium[pf2e.conditionitems.Grabbed]{Grabbed}</p>\n<hr />\n<p><strong>Effect</strong> The akaky rips the ghostly overcoat off and fills the target with the freezing cold of a fierce winter night. The target takes [[/r (1d8+6)[cold]]] damage, with a @Check[type:fortitude|dc:20] save.</p>\n<hr />\n<p><strong>Critical Success</strong> Target is unaffected.</p>\n<p><strong>Success</strong> Target takes half damage but its coat remains secure.</p>\n<p><strong>Failure</strong> Target takes full damage. If the target was wearing winter clothing, the clothing phases off their body along with the superimposed ghostly overcoat and falls to the ground in the target's space. Because the akaky is only able to grab the coat, not the creature directly, this causes the creature's grabbed condition to end, though it doesn't stop the akaky from using its Ghostly Grab ability again later to manifest a new coat.</p>\n<p><strong>Critical Failure</strong> As failure, but the target is also @Compendium[pf2e.conditionitems.Clumsy]{Clumsy 1} and @Compendium[pf2e.conditionitems.Enfeebled]{Enfeebled 1} until it spends 10 minutes in a warm environment.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":1},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"effects":[],"_id":"1OA0QNgNuZG4AYsT","folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"4.12.6","coreVersion":"14.360","createdTime":1685578150720,"modifiedTime":1685578188222,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"type":"action","img":"systems/pf2e/icons/default-icons/action.svg","name":"Jealous Hatred","system":{"description":{"gm":"","value":"<p>An akaky gains +2 circumstance bonus to all its attack rolls against targets wearing winter clothing, but its hatred for such creatures is also ultimately its undoing. Strikes made by creature wearing winter clothing are treated as magical when attacking the akaky.</p>"},"rules":[{"domain":"all","key":"RollOption","option":"target:equipment:winter-clothing","toggleable":true,"label":"Target is wearing winter clothing"},{"key":"FlatModifier","selector":"attack","value":2,"type":"circumstance","predicate":["target:equipment:winter-clothing"]}],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"offensive","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"effects":[],"_id":"BZc7vdreuGwM78ZP","folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"4.12.6","coreVersion":"14.360","createdTime":1685578190570,"modifiedTime":1685578271826,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"type":"melee","img":"systems/pf2e/icons/default-icons/melee.svg","name":"Ghostly Hand","system":{"description":{"gm":"","value":""},"rules":[],"slug":null,"traits":{"value":["agile","finesse","magical"],"otherTags":[]},"damageRolls":{"OWtz6EUVSybi6zom":{"damage":"1d8+6","damageType":"void"}},"bonus":{"value":11},"attackEffects":{"value":["ghostly-grab"]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"_migration":{"version":0.932,"previous":{"schema":null,"foundry":"12.328","system":"6.1.0"}}},"effects":[],"_id":"lEUgStfpkgw56VSy","folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"6.1.0","coreVersion":"14.360","createdTime":1685578313453,"modifiedTime":1721535402974,"lastModifiedBy":"l2rbNx2a8f5ocpeL","compendiumSource":null,"duplicateSource":null,"exportSource":null}}],"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"6.1.0","coreVersion":"14.360","createdTime":1685401626117,"modifiedTime":1736542899524,"lastModifiedBy":"l2rbNx2a8f5ocpeL","compendiumSource":null,"duplicateSource":null,"exportSource":null},"_id":"yCEZs96KkjypI9Kn","folder":"rnSyamM9GQTIpuOo","ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"sort":10600000}