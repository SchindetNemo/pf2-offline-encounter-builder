at enters the cloud must succeed at a @Check[type:fortitude|dc:31] save. On a failure, the creature is @Compendium[pf2e.conditionitems.Sickened]{Sickened 1} and on a critical failure, the creature is @Compendium[pf2e.conditionitems.Sickened]{Sickened 2}. Afterward, the creature is temporarily immune for 1 minute. The powder is suppressed underwater or while the morphoid's Flame Shroud is active.</p>"},"rules":[{"key":"Aura","radius":20}],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["aura"]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"defensive","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"effects":[],"_id":"hQwARg8qAuNnxxeN","folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"5.1.1","coreVersion":"14.360","createdTime":1689025313385,"modifiedTime":1689025355947,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"type":"melee","img":"systems/pf2e/icons/default-icons/melee.svg","name":"Hammer Fist","system":{"description":{"gm":"","value":""},"rules":[],"slug":null,"traits":{"value":["reach-10"],"otherTags":[]},"damageRolls":{"e8mHqby0iY10g9do":{"damage":"3d10+18","damageType":"bludgeoning","category":null}},"bonus":{"value":29},"attackEffects":{"value":["improved-push"]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"_migration":{"version":0.932,"previous":{"schema":null,"foundry":"12.328","system":"6.1.0"}}},"effects":[],"_id":"IXBTjeuknwaujcNL","folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"5.1.1","coreVersion":"14.360","createdTime":1689025375139,"modifiedTime":1689025406114,"lastModifiedBy":"W75