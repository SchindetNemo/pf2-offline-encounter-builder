,"primal"]},"publication":{"title":"Pathfinder Secrets of Magic","authors":"","license":"OGL","remaster":false},"level":{"value":1},"requirements":"","target":{"value":""},"range":{"value":"30 feet"},"area":{"type":"burst","value":5},"time":{"value":"2"},"duration":{"value":"","sustained":false},"damage":{"0":{"applyMod":true,"formula":"1d4","type":"bludgeoning","category":null,"materials":[],"kinds":["damage"]}},"defense":{"passive":null,"save":{"statistic":"reflex","basic":true}},"cost":{"value":""},"location":{"value":"A9YCTKFGY5AO6Xzr"},"counteraction":false,"heightening":{"damage":{"0":"1d4"},"interval":1,"type":"interval"}},"type":"spell","flags":{"core":{}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"_stats":{"systemId":"pf2e","systemVersion":"5.1.0","coreVersion":"14.360","createdTime":1688757695201,"modifiedTime":1688757695201,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":"Compendium.pf2e.spells-srd.Item.eSL5hVT9gXrnRLtd","duplicateSource":null,"exportSource":null},"_id":"xlJddQGHHDanme3Q"},{"img":"systems/pf2e/icons/spells/darkness.webp","name":"Darkness","system":{"description":{"gm":"","value":"<p>You create a shroud of darkness that prevents light from penetrating or emanating within the area. Light does not enter the area and any non-magical light sources, such as a torch or lantern, do not emanate any light while inside the area, even if their light radius would extend beyond the darkness. This also suppresses magical light of your darkness spell's level or lower. Light can't pass through, so creatures in the area can't see outside. From outside, it appears as a globe of pure darkness.</p>\n<hr />\n<p><strong>Heightened (4th)</strong> Even creatures with darkvision (but not greater darkvision) can barely see through the darkness. They treat targets seen through the darkness as @UUID[Compendium.pf2e.conditionitems.Item.DmAIPqOBomZ7H95W]{Concealed}.</p>"},"rules":[],"slug":"darkness","_migration":{"versio