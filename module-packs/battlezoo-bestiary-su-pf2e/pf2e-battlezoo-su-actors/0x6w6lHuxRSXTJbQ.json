":"one-degree-worse","failure":"one-degree-worse"},"predicate":[{"or":["inflicts:unconscious","sleep"]}]}],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"defensive","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"effects":[],"_id":"sXVpS9Cj4CM0QR8r","folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"5.0.1","coreVersion":"14.360","createdTime":1687134984901,"modifiedTime":1687135515513,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"type":"action","img":"systems/pf2e/icons/default-icons/action.svg","name":"Just a Dream","system":{"description":{"gm":"","value":"<p><strong>Trigger</strong> A creature damages the bannog thief</p>\n<hr />\n<p><strong>Effect</strong> The thief gains resistance 5 all (except force) against the triggering damage and teleports up to 10 feet in any direction.</p>"},"rules":[{"domain":"all","key":"RollOption","option":"just-a-dream","toggleable":true,"value":false},{"key":"Resistance","type":"all-damage","value":5,"predicate":["just-a-dream"]}],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["mental","occult","teleportation"]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"reaction"},"category":"defensive","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"effects":[],"_id":"4pNnSO5k0TS65tPY","folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"5.0.1","core