ong> @Check[type:will|dc:29]</p>\n<p><strong>Stage 1</strong> Whenever the target rolls initiative, they become @Compendium[pf2e.conditionitems.Quickened]{Quickened} until the end of their first turn. They can use the extra action only to Strike or Stride (1 day)</p>\n<p><strong>Stage 2</strong> As Stage 1, and the target gains the ability to cast an innate spell chosen by the GM once per day, typically of a level up to half the victim's level – 1. The spell is intended to tempt the victim and suit the victim's interests (1 day)</p>\n<p><strong>Stage 3</strong> As Stage 2, and the victim can use the spell once per hour instead of once per day (1 day)</p>\n<p><strong>Stage 4</strong> As Stage 3, and the target becomes an NPC thrall controlled by the vile ascender (permanent).</p>"},"rules":[{"key":"Note","selector":"claw-attack","text":"{item|system.description.value}","outcome":["criticalSuccess"],"title":"{item|name}","visibility":"owner"}],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["curse","mental","primal"]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"offensive","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"effects":[],"_id":"xY4nNhjsBs0Xr7rY","folder":null,"sort":0,"ownership":{"default":0,"CIWVguTLismR00HG":3},"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"5.1.1","coreVersion":"14.360","createdTime":1688939602746,"modifiedTime":1688939863950,"lastModifiedBy":"CIWVguTLismR00HG","compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"type":"action","img":"systems/pf2e/icons/default-icons/action.svg","name":"Ascending Gift","system":{"description":{"gm":"","value":"<p>The vile ascender draws and presents a wondrous gift to another creature. If the creature accepts the gift the vile ascender offers, they are exposed to curse of ascendance.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["manipulate"]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":2},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"effects":[],"_id":"px7uCjHx8YPekz8H","folder":null,"sort":0,"ownership":{"default":0,"CIWVguTLismR00HG":3},"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"5.1.1","coreVersion":"14.360","createdTime":1688939875707,"modifiedTime":1688939921880,"lastModifiedBy":"CIWVguTLismR00HG","compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"img":"systems/pf2e/icons/actions/Passive.webp","name":"Sneak Attack","system":{"description":{"gm":"","value":"<p>The vile ascender deals @Damage[2d6[precision]] damage against @Compendium[pf2e.conditionitems.Off-Guard]{Off-Guard} creatures. When a creature takes precision damage from a vile ascender, they are exposed to curse of ascendance.</p>"},"rules":[{"category":"precision","diceNumber":2,"dieSize":"d6","key":"DamageDice","predicate":["target:condition:off-guard"],"selector":"strike-damage"},{"domain":"all","key":"RollOption","label":"PF2E.SpecificRule.TOTMToggle.OffGuard","option":"target:condition:off-guard","toggleable":"totm"}],"slug":"sneak-attack","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[],"rarity":"common"},"publication":{"title":"Pathfinder Bestiary","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"offensive","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""},"weapon":{"value":""}},"type":"action","flags":{"core":{}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0,"CIWVguTLismR00HG":3},"_stats":{"systemId":"pf2e","systemVersion":"5.3.0","coreVersion":"14.360","createdTime":1688939930296,"modifiedTime":1691261013023,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":"Compendium.pf2e.bestiary-ability-glossary-srd.Item.AWvNPE4U0kEJSL1T","duplicateSource":null,"exportSource":null},"_id":"PiG5a5YFIfyE7ChB"},{"type":"action","img":"systems/pf2e/icons/default-icons/action.svg","name":"Wanderer's Bane","system":{"description":{"gm":"","value":"<p>Vile ascenders know exactly how to take advantage of others when their targets are distracted by the environment. Creatures in difficult terrain are @Compendium[pf2e.conditionitems.Off-Guard]{Off-Guard} to the vile ascender.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"offensive","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"effects":[],"_id":"4B46fokMJ8timpSo","folder":null,"sort":0,"ownership":{"default":0,"CIWVguTLismR00HG":3},"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"5.1.1","coreVersion":"14.360","createdTime":1688939976016,"modifiedTime":1688940005651,"lastModifiedBy":"CIWVguTLismR00HG","compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"name":"Primal Innate Spells","type":"spellcastingEntry","system":{"description":{"gm":"","value":""},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"ability":{"value":"cha"},"spelldc":{"value":21,"dc":29},"tradition":{"value":"primal"},"prepared":{"value":"innate"},"showSlotlessLevels":{"value":false},"proficiency":{"value":1},"slots":{"slot0":{"prepared":[],"value":0,"max":0},"slot1":{"prepared":[],"value":0,"max":0},"slot2":{"prepared":[],"value":0,"max":0},"slot3":{"prepared":[],"value":0,"max":0},"slot4":{"prepared":[],"value":0,"max":0},"slot5":{"prepared":[],"value":0,"max":0},"slot6":{"prepared":[],"value":0,"max":0},"slot7":{"prepared":[],"value":0,"max":0},"slot8":{"prepared":[],"value":0,"max":0},"slot9":{"prepared":[],"value":0,"max":0},"slot10":{"prepared":[],"value":0,"max":0},"slot11":{"prepared":[],"value":0,"max":0}},"autoHeightenLevel":{"value":null},"showUnpreparedSpells":{"value":false},"displayLevels":{}},"_id":"yZsCxLODWKJ0vepR","img":"systems/pf2e/icons/default-icons/spellcastingEntry.svg","effects":[],"folder":null,"sort":0,"ownership":{"default":0,"CIWVguTLismR00HG":3},"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"5.1.1","coreVersion":"14.360","createdTime":1688940053129,"modifiedTime":1688940209746,"lastModifiedBy":"CIWVguTLismR00HG","compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"img":"systems/pf2e/icons/spells/locate.webp","name":"Locate (Thrall Only)","system":{"description":{"gm":"","value":"<p>You learn the direction to the target (if you picked a specific object, such as \"my mother's sword\") or the nearest target (if you picked a type of object, such as \"swords\"). If the target is a specific object, you must have observed it directly with your own senses. If it's a type of object, you still need to have an accurate mental image of the type of object. If there's lead or running water between you and the target, this spell can't locate the object. This means you might find a type of object farther away if the nearest one is behind lead or running water.</p>\n<hr />\n<p><strong>Heightened (5th)</strong> You can target a specific creature or ancestry instead of an object, but you must have met or seen up close the creature or ancestry you want to target.</p>"},"rules":[],"slug":"locate","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","detection","manipulate"],"rarity":"uncommon","traditions":["arcane","divine","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":3},"requirements":"","target":{"value":"1 specific object or type of object"},"range":{"value":"500 feet"},"area":null,"time":{"value":"10 minutes"},"duration":{"value":"","sustained":true},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"yZsCxLODWKJ0vepR","heightenedLevel":5,"uses":{"max":2,"value":2}},"counteraction":false,"heightening":{"levels":{"5":{"target":{"value":"1 specific object or type of object, or a specific creature or ancestry"},"time":{"value":"10 minutes"}}},"type":"fixed"}},"type":"spell","flags":{"core":{}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0,"CIWVguTLismR00HG":3},"_stats":{"systemId":"pf2e","systemVersion":"5.1.1","coreVersion":"14.360","createdTime":1688940085258,"modifiedTime":1688940153507,"lastModifiedBy":"CIWVguTLismR00HG","compendiumSource":"Compendium.pf2e.spells-srd.Item.LQzlKbYjZSMFQawP","duplicateSource":null,"exportSource":null},"_id":"hBDVRlOubREeMPxy"},{"img":"systems/pf2e/icons/spells/darkness.webp","name":"Darkness","system":{"description":{"gm":"","value":"<p>You create a shroud of darkness that prevents light from penetrating or emanating within the area. Light does not enter the area and any non-magical light sources, such as a torch or lantern, do not emanate any light while inside the area, even if their light radius would extend beyond the darkness. This also suppresses magical light of your darkness spell's level or lower. Light can't pass through, so creatures in the area can't see outside. From outside, it appears as a globe of pure darkness.</p>\n<hr />\n<p><strong>Heightened (4th)</strong> Even creatures with darkvision (but not greater darkvision) can barely see through the darkness. They treat targets seen through the darkness as @UUID[Compendium.pf2e.conditionitems.Item.DmAIPqOBomZ7H95W]{Concealed}.</p>"},"rules":[],"slug":"darkness","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","darkness","manipulate"],"rarity":"common","traditions":["arcane","divine","occult","primal"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":2},"requirements":"","target":{"value":""},"range":{"value":"120 feet"},"area":{"type":"burst","value":20},"time":{"value":"3"},"duration":{"value":"1 minute","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"yZsCxLODWKJ0vepR","heightenedLevel":4,"uses":{"value":2,"max":2}},"counteraction":false},"type":"spell","flags":{"core":{}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0,"CIWVguTLismR00HG":3},"_stats":{"systemId":"pf2e","systemVersion":"5.1.1","coreVersion":"14.360","createdTime":1688940092158,"modifiedTime":1688940152674,"lastModifiedBy":"CIWVguTLismR00HG","compendiumSource":"Compendium.pf2e.spells-srd.Item.4GE2ZdODgIQtg51c","duplicateSource":null,"exportSource":null},"_id":"6d6Kp870Ro9E7PrA"},{"img":"systems/pf2e/icons/spells/dimension-door.webp","name":"Dimension Door","system":{"description":{"gm":"","value":"<p>Opening a door that bypasses normal space, you instantly transport yourself and any items you're wearing and holding from your current space to a clear space within range you can see. If this would bring another creature with you-even if you're carrying it in an extradimensional container-the spell is lost.</p>\n<hr />\n<p><strong>Heightened (5th)</strong> The range increases to 1 mile. You don't need to be able to see your destination, as long as you have been there in the past and know its relative location and distance from you. You are temporarily immune for 1 hour.</p>"},"rules":[],"slug":"dimension-door","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","manipulate","teleportation"],"rarity":"common","traditions":["arcane","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":4},"requirements":"","target":{"value":""},"range":{"value":"120 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"yZsCxLODWKJ0vepR","heightenedLevel":4,"uses":{"max":2,"value":2}},"counteraction":false,"heightening":{"levels":{"5":{"range":{"value":"1 mile"}}},"type":"fixed"}},"type":"spell","flags":{"core":{}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0,"CIWVguTLismR00HG":3},"_stats":{"systemId":"pf2e","systemVersion":"5.1.1","coreVersion":"14.360","createdTime":1688940097090,"modifiedTime":1688940151912,"lastModifiedBy":"CIWVguTLismR00HG","compendiumSource":"Compendium.pf2e.spells-srd.Item.VlNcjmYyu95vOUe8","duplicateSource":null,"exportSource":null},"_id":"lnGO9XXG2MSjv4iA"},{"img":"systems/pf2e/icons/spells/haste.webp","name":"Haste","system":{"description":{"gm":"","value":"<p>Magic empowers the target to act faster. It gains the @UUID[Compendium.pf2e.conditionitems.Item.nlCjDvLMf2EkV2dl]{Quickened} condition and can use the extra action each round only for Strike and Stride actions.</p>\n<hr />\n<p><strong>Heightened (7th)</strong> You can target up to 6 creatures.</p>"},"rules":[],"slug":"haste","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","manipulate"],"rarity":"common","traditions":["arcane","occult","primal"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":3},"requirements":"","target":{"value":"1 creature"},"range":{"value":"30 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"1 minute","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"yZsCxLODWKJ0vepR","heightenedLevel":3},"counteraction":false,"heightening":{"levels":{"7":{"target":{"value":"6 creatures"}}},"type":"fixed"}},"type":"spell","flags":{"core":{}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0,"CIWVguTLismR00HG":3},"_stats":{"systemId":"pf2e","systemVersion":"5.1.1","coreVersion":"14.360","createdTime":1688940100917,"modifiedTime":1688940100917,"lastModifiedBy":"CIWVguTLismR00HG","compendiumSource":"Compendium.pf2e.spells-srd.Item.o6YCGx4lycsYpww4","duplicateSource":null,"exportSource":null},"_id":"dftKpei5yCVorz02"},{"img":"systems/pf2e/icons/spells/entangle.webp","name":"Entangle (At Will)","system":{"description":{"gm":"","value":"<p><strong>Area</strong> all squares in a 20-foot burst that contain plants or fungi</p>\n<p>Plants and fungi entangle creatures. The area is difficult terrain. Each round that a creature starts its turn in the area, it must attempt a Reflex save. On a failure, it takes a -10-foot circumstance penalty to its Speeds until it leaves the area, and on a critical failure, it is also @UUID[Compendium.pf2e.conditionitems.Item.eIcWbB5o3pP6OIMe]{Immobilized} for 1 round. Creatures can attempt to @UUID[Compendium.pf2e.actionspf2e.Item.SkZAQRkLLkmBQNB9]{Escape} at <em>entangle</em>'s DC to remove these effects.</p>\n<p>@UUID[Compendium.pf2e.spell-effects.Item.rjM25qfw5BKj9h97]{Spell Effect: Entangle}</p>"},"rules":[],"slug":"entangle","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","manipulate","plant"],"rarity":"common","traditions":["primal"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":2},"requirements":"","target":{"value":""},"range":{"value":"120 feet"},"area":{"details":"all squares in a 20-foot-radius burst that contain plants","type":"burst","value":20},"time":{"value":"2"},"duration":{"value":"1 minute","sustained":false},"damage":{},"defense":{"passive":null,"save":{"statistic":"reflex","basic":false}},"cost":{"value":""},"location":{"value":"yZsCxLODWKJ0vepR","heightenedLevel":2},"counteraction":false,"heightening":{"type":"interval","interval":1,"damage":{}}},"type":"spell","flags":{"core":{}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0,"CIWVguTLismR00HG":3},"_stats":{"systemId":"pf2e","systemVersion":"5.1.1","coreVersion":"14.360","createdTime":1688940105261,"modifiedTime":1688940119108,"lastModifiedBy":"CIWVguTLismR00HG","compendiumSource":"Compendium.pf2e.spells-srd.Item.J6vNvrUT3b1hx2iA","duplicateSource":null,"exportSource":null},"_id":"GvHhNYXh3mhiCb1n"},{"img":"systems/pf2e/icons/spells/acid-splash.webp","name":"Acid Splash","system":{"description":{"gm":"","value":"<p>You splash a glob of acid that splatters your target and nearby creatures. Make a spell attack. If you hit, you deal 1d6 acid damage plus 1 splash acid damage. On a critical success, the target also takes 1 persistent acid damage.</p>\n<hr />\n<p><strong>Heightened (3rd)</strong> The initial damage increases to 1d6 + your spellcasting ability modifier, and the persistent damage increases to 2.</p>\n<p><strong>Heightened (5th)</strong> The initial damage increases to 2d6 + your spellcasting ability modifier, the persistent damage increases to 3, and the splash damage increases to 2.</p>\n<p><strong>Heightened (7th)</strong> The initial damage increases to 3d6 + your spellcasting ability modifier, the persistent damage increases to 4, and the splash damage increases to 3.</p>\n<p><strong>Heightened (9th)</strong> The initial damage increases to 4d6 + your spellcasting ability modifier, the persistent damage increases to 5, and the splash damage increases to 4.</p>\n<p>[[/r (ceil(@item.level/2))[persistent,acid]]]{Leveled Persistent Acid Damage}</p>"},"rules":[],"slug":"acid-splash","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["acid","attack","cantrip","concentrate","manipulate"],"rarity":"common","traditions":["arcane","primal"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":1},"requirements":"","target":{"value":"1 creature"},"range":{"value":"30 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"","sustained":false},"damage":{"0":{"applyMod":false,"formula":"1d6","type":"acid","category":null,"materials":[],"kinds":["damage"]},"gcovwqxwitqchoin":{"applyMod":false,"formula":"1","type":"acid","category":"splash","materials":[],"kinds":["damage"]}},"defense":null,"cost":{"value":""},"location":{"value":"yZsCxLODWKJ0vepR"},"counteraction":false,"heightening":{"levels":{"3":{"damage":{"0":{"applyMod":true,"formula":"1d6","type":"acid","materials":[]},"gcovwqxwitqchoin":{"applyMod":false,"formula":"1","type":"acid","category":"splash","materials":[]}}},"5":{"damage":{"0":{"applyMod":true,"formula":"2d6","type":"acid","materials":[]},"gcovwqxwitqchoin":{"applyMod":false,"formula":"2","type":"acid","category":"splash","materials":[]}}},"7":{"damage":{"0":{"applyMod":true,"formula":"3d6","type":"acid","materials":[]},"gcovwqxwitqchoin":{"applyMod":false,"formula":"3","type":"acid","category":"splash","materials":[]}}},"9":{"damage":{"0":{"applyMod":true,"formula":"4d6","type":"acid","materials":[]},"gcovwqxwitqchoin":{"applyMod":false,"formula":"4","type":"acid","category":"splash","materials":[]}}}},"type":"fixed"}},"type":"spell","flags":{"core":{}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0,"CIWVguTLismR00HG":3},"_stats":{"systemId":"pf2e","systemVersion":"5.1.1","coreVersion":"14.360","createdTime":1688940110363,"modifiedTime":1688940110363,"lastModifiedBy":"CIWVguTLismR00HG","compendiumSource":"Compendium.pf2e.spells-srd.Item.gISYsBFby1TiXfBt","duplicateSource":null,"exportSource":null},"_id":"8REMdxSAbvJPwApZ"},{"img":"systems/pf2e/icons/spells/tanglefoot.webp","name":"Tanglefoot","system":{"description":{"gm":"","value":"<p>A vine covered in sticky sap appears from thin air, flicking from your hand and lashing itself to the target. Attempt a spell attack against the target.</p>\n<hr />\n<p><strong>Critical Success</strong> The target gains the @UUID[Compendium.pf2e.conditionitems.Item.eIcWbB5o3pP6OIMe]{Immobilized} condition and takes a -10-foot circumstance penalty to its Speeds for 1 round. It can attempt to Escape against your spell DC to remove the penalty and the @UUID[Compendium.pf2e.conditionitems.Item.eIcWbB5o3pP6OIMe]{Immobilized} condition.</p>\n<p><strong>Success</strong> The target takes a -10-foot circumstance penalty to its Speeds for 1 round. It can attempt to Escape against your spell DC to remove the penalty.</p>\n<p>@UUID[Compendium.pf2e.spell-effects.Item.TwtUIEyenrtAbeiX]{Spell Effect: Tanglefoot}</p>\n<p><strong>Failure</strong> The target is unaffected.</p>\n<hr />\n<p><strong>Heightened (2nd)</strong> The effects last for 2 rounds.</p>\n<p><strong>Heightened (4th)</strong> The effects last for 1 minute.</p>"},"rules":[],"slug":"tanglefoot","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["attack","cantrip","concentrate","manipulate","plant"],"rarity":"common","traditions":["arcane","primal"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":1},"requirements":"","target":{"value":"1 creature"},"range":{"value":"30 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"yZsCxLODWKJ0vepR"},"counteraction":false},"type":"spell","flags":{"core":{}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0,"CIWVguTLismR00HG":3},"_stats":{"systemId":"pf2e","systemVersion":"5.1.1","coreVersion":"14.360","createdTime":1688940111457,"modifiedTime":1688940111457,"lastModifiedBy":"CIWVguTLismR00HG","compendiumSource":"Compendium.pf2e.spells-srd.Item.uZK2BYzPnxUBnDjr","duplicateSource":null,"exportSource":null},"_id":"BbauXdJwpAMOqN3v"},{"img":"systems/pf2e/icons/spells/geas.webp","name":"Geas","system":{"description":{"gm":"","value":"<p>You enforce a magic rule on a willing target, forcing it to either perform or refrain from carrying out a certain act. A <em>geas</em> to perform an act is usually conditional, such as, \"Always offer hospitality to strangers seeking a place to stay.\" An unconditional <em>geas</em> to perform a certain act doesn't require the target to perform that act exclusively, though it must prioritize the task above all leisurely pursuits. The most common <em>geas</em> to refrain from carrying out an act is a specification to avoid violating a contract. In those cases, the secondary caster usually takes charge of making sure the wording of the contract is attuned correctly with the ritual's magic. Because the target is willing, <em>geas</em> can have a duration that lasts for as long as the target agrees to. If the target is unable to fulfill the <em>geas</em>, it becomes @UUID[Compendium.pf2e.conditionitems.Item.fesd1n5eVhpCSS18]{Sickened 1}, and the sickened condition increases by 1 for each consecutive day it is prevented from following the <em>geas</em>, to a maximum of sickened 4. The sickened condition ends immediately when it follows the <em>geas</em> again; it can't remove the sickened condition in any other way. Only powerful magic such as a <em>@UUID[Compendium.pf2e.spells-srd.Item.6dDtGIUerazSHIOu]{Wish}</em> spell can remove the effects of <em>geas</em> from a willing target.</p>\n<hr />\n<p><strong>Critical Success</strong> The <em>geas</em> succeeds, and the target receives a +1 status bonus to skill checks that directly uphold the <em>geas</em> (at the GM's discretion).</p>\n<p><strong>Success</strong> The <em>geas</em> succeeds.</p>\n<p><strong>Failure</strong> The <em>geas</em> fails.</p>\n<p><strong>Critical Failure</strong> The <em>geas</em> fails, and you are instead affected by the <em>geas</em> you were attempting to place on the target. You are considered an unwilling target, so the <em>geas</em> can be counteracted with a <em>@UUID[Compendium.pf2e.spells-srd.Item.SUKaxVZW2TlM8lu0]{Cleanse Affliction}</em> spell.</p>\n<hr />\n<p><strong>Heightened (5th)</strong> You can use <em>geas</em> on an unwilling creature; it can attempt a Will save to negate the effect. If the target fails this Will save, the <em>geas</em> lasts up to 1 week. A <em>remove curse</em> spell can counteract a <em>geas</em> on an unwilling creature, in addition to powerful magic such as a <em>wish</em> spell. A clever unwilling creature can subvert the <em>geas</em> by contriving situations that prevent it from complying, but in that case it becomes @UUID[Compendium.pf2e.conditionitems.Item.fesd1n5eVhpCSS18]{Sickened} (as described above).</p>\n<p><strong>Heightened (7th)</strong> As 5th level, but the <em>geas</em> lasts for up to 1 year on an unwilling creature.</p>\n<p><strong>Heightened (9th)</strong> As 5th level, but the <em>geas</em> lasts for a duration you choose (even unlimited) on an unwilling creature.</p>"},"rules":[],"slug":"geas","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["curse","mental"],"rarity":"uncommon","traditions":[]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":5},"requirements":"","target":{"value":"1 creature of a level no greater than double the geas ritual's level"},"range":{"value":"10 feet"},"area":null,"time":{"value":"1 day"},"duration":{"value":"see text","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":null},"counteraction":false,"ritual":{"primary":{"check":"Arcana (expert), Occultism (expert), or Religion (expert)"},"secondary":{"checks":"Society or Legal Lore","casters":1}}},"type":"spell","flags":{"core":{}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0,"CIWVguTLismR00HG":3},"_stats":{"systemId":"pf2e","systemVersion":"5.1.1","coreVersion":"14.360","createdTime":1688940183925,"modifiedTime":1688940206496,"lastModifiedBy":"CIWVguTLismR00HG","compendiumSource":"Compendium.pf2e.spells-srd.Item.Q690d3mw3TUrKX7E","duplicateSource":null,"exportSource":null},"_id":"WQ6ARoSaMfSG8ZqV"}],"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"6.1.0","coreVersion":"14.360","createdTime":1685401626117,"modifiedTime":1736542895044,"lastModifiedBy":"l2rbNx2a8f5ocpeL","compendiumSource":null,"duplicateSource":null,"exportSource":null},"_id":"Jbqrk08KsmvS6YG7","folder":"QqEyWiBhCvupt0ox","ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"sort":0}