":"","value":"<p><strong>Requirements</strong> The crystalline owl must be in an area of bright light</p>\n<hr />\n<p><strong>Effect</strong> The crystalline owl uses the reflective surfaces of its body or wing to direct the light into the eyes of all creatures within 30 feet. The creatures must attempt a @Check[type:reflex|dc:18] save.</p>\n<hr />\n<p><strong>Critical Success</strong> The creature is unaffected.</p>\n<p><strong>Success</strong> The creature is @Compendium[pf2e.conditionitems.Dazzled]{Dazzled} for 1 round.</p>\n<p><strong>Failure</strong> The creature is dazzled for 3 rounds.</p>\n<p><strong>Critical Failure</strong> The creature is @Compendium[pf2e.conditionitems.Blinded]{Blinded} for 1 round and dazzled for 1 minute.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["light","visual"]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":2},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"effects":[],"_id":"QFVDTPwUzhdgk7J5","folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"5.0.1","coreVersion":"14.360","createdTime":1687308696218,"modifiedTime":1687308724537,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":null,"duplicateSource":null,"exportSource":null}}],"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"6.1.0","coreVersion":"14.360","createdTime":1685401626117,"modifiedTime":1736542898378,"lastModifiedBy":"l2rbNx2a8f5ocpeL","compendiumSource":null,"duplicateSource":null,"exportSource":null},"_id":"mlnha6g2gxH9hxL8","folder":"rnSyamM9GQTIpuOo","ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"sort":7700000}