:"","authors":"","license":"OGL","remaster":false},"_migration":{"version":0.932,"previous":{"schema":null,"foundry":"12.328","system":"6.1.0"}}},"effects":[],"_id":"JuWhi4TgvGUG2voc","folder":null,"sort":0,"ownership":{"default":0,"CIWVguTLismR00HG":3},"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"5.1.1","coreVersion":"14.360","createdTime":1688871738586,"modifiedTime":1688879109334,"lastModifiedBy":"CIWVguTLismR00HG","compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"img":"systems/pf2e/icons/actions/OneAction.webp","name":"Grab","system":{"description":{"gm":"","value":"<p>@Localize[PF2E.NPC.Abilities.Glossary.Grab]</p>"},"rules":[],"slug":"grab","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[],"rarity":"common"},"publication":{"title":"Pathfinder Bestiary","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":1},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""},"weapon":{"value":""}},"type":"action","flags":{"core":{}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0,"CIWVguTLismR00HG":3},"_stats":{"systemId":"pf2e","systemVersion":"5.1.1","coreVersion":"14.360","createdTime":1688871838055,"modifiedTime":1688871838055,"lastModifiedBy":"CIWVguTLismR00HG","compendiumSource":"Compendium.pf2e.bestiary-ability-glossary-srd.Item.Tkd8sH4pwFIPzqTr","duplicateSource":null,"exportSource":null},"_id":"je98VhuRMitaTM3y"},{"type":"action","img":"systems/pf2e/icons/default-icons/action.svg","name":"Extra Reaction","system":{"description":{"gm":"","value":"<p>A whorl ooze gains an extra reaction each round. It can only use this reaction to Spin Whorls.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"defensive","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"effects":[],"_id":"cbZB80SSEahUrydL","folder":null,"sort":0,"ownership":{"default":0,"CIWVguTLismR00HG":3},"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"5.1.1","coreVersion":"14.360","createdTime":1688871842230,"modifiedTime":1688871869803,"lastModifiedBy":"CIWVguTLismR00HG","compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"type":"action","img":"systems/pf2e/icons/default-icons/action.svg","name":"Spin Whorls","system":{"description":{"gm":"","value":"<p><strong>Trigger</strong> A creature that the whorl ooze can sense makes a ranged attack targeting the whorl ooze;</p>\n<hr />\n<p><strong>Effect</strong> The patterns and spirals on the whorl ooze begin to spin and rotate hypnotically, overloading the creature's mind and distorting the creature's spatial reasoning. The creature must attempt a @Check[type:will|dc:26] save.</p>\n<p><strong>Success</strong> The creature is unaffected.</p>\n<p><strong>Failure</strong> The creature takes @Damage[4d10[mental]] damage and is @Compendium[pf2e.conditionitems.Sickened]{Sickened 1}.</p>\n<p><strong>Critical Failure</strong> The creature takes [[/r 8d10[mental]]] damage and is @Compendium[pf2e.conditionitems.Sickened]{Sickened 2}, and the creature's ranged attack automatically fails.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["mental","visual"]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"reaction"},"category":"defensive","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"effects":[],"_id":"scCHwe6LFRgWRkDl","folder":null,"sort":0,"ownership":{"default":0,"CIWVguTLismR00HG":3},"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"5.3.0","coreVersion":"14.360","createdTime":1688871870873,"modifiedTime":1691261013213,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"type":"action","img":"systems/pf2e/icons/default-icons/action.svg","name":"Transfixing Display","system":{"description":{"gm":"","value":"<p>10 feet.</p>\n<p>A creature that enters or begins its turn within the aura must succeed at a @Check[type:fortitude|dc:26] save or be @Compendium[pf2e.conditionitems.Sickened]{Sickened 1} and also @Compendium[pf2e.conditionitems.Dazzled]{Dazzled} for 1 round. Regardless of the result of the saving throw, the creature is temporarily immune to this ability for 24 hours.</p>"},"rules":[{"key":"Aura","radius":10,"traits":["aura","mental","visual"]}],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["aura","mental","visual"]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"defensive","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"effects":[],"_id":"0du0LClFXhnIQa0T","folder":null,"sort":0,"ownership":{"default":0,"CIWVguTLismR00HG":3},"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"5.1.1","coreVersion":"14.360","createdTime":1688871952782,"modifiedTime":1688875529390,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"type":"action","img":"systems/pf2e/icons/default-icons/action.svg","name":"Gelatinizing Strike","system":{"description":{"gm":"","value":"<p>When a whorl ooze critically succeeds at an attack against a creature, the creature liquefies into an ooze, as per the <em>@Compendium[pf2e.spells-srd.0gdZrT9lwO17EIxc]{Ooze Form}</em> spell unless it succeeds at a @Check[type:fortitude|dc:26] save. Like the spell, this effect lasts for 1 minute, but each round, on the target's turn, it must attempt a @Check[type:will|dc:26] save or it becomes @Compendium[pf2e.conditionitems.Confused]{Confused} for the remaining duration of the transformation. While confused, the target doesn't attack other oozes. Roll 1d4 to determine the battle form, with the following results.</p>\n<table class=\"pf2-table\">\n<thead>\n<tr>\n<th>d4</th>\n<th>Form</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>1</td>\n<td>@UUID[Compendium.pf2e.spell-effects.Item.EKdqKCuyWSkpXpyJ]{Black Pudding}</td>\n</tr>\n<tr>\n<td>2</td>\n<td>@UUID[Compendium.pf2e.spell-effects.Item.3zdBGENpmaze1bpq]{Gelatinous Cube}</td>\n</tr>\n<tr>\n<td>3</td>\n<td>@UUID[Compendium.pf2e.spell-effects.Item.7tfF8ifVvOKNud8t]{Gray Ooze}</td>\n</tr>\n<tr>\n<td>4</td>\n<td>@UUID[Compendium.pf2e.spell-effects.Item.PpkOZVoHkBZUmddx]{Ochre Jelly}</td>\n</tr>\n</tbody>\n</table>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["polymorph"]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"offensive","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"effects":[],"_id":"GtLc1iliENyFSXhK","folder":null,"sort":0,"ownership":{"default":0,"CIWVguTLismR00HG":3},"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"5.1.1","coreVersion":"14.360","createdTime":1688872066602,"modifiedTime":1688879063820,"lastModifiedBy":"CIWVguTLismR00HG","compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"type":"action","img":"systems/pf2e/icons/default-icons/action.svg","name":"Mind Vice","system":{"description":{"gm":"","value":"<p><strong>Requirements</strong> The whorl ooze has a creature @Compendium[pf2e.conditionitems.Grabbed]{Grabbed}</p>\n<hr />\n<p><strong>Effect</strong> While grabbed, the whorl ooze can overwhelm the creature's brain, dulling perception and dealing [[/r (2d12+9)[mental]]] damage, with a @Check[type:will|dc:26|basic:true] save. On a critical failure, the creature is also @Compendium[pf2e.conditionitems.Stunned]{Stunned 1}.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["mental"]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":1},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"effects":[],"_id":"YyHT1Vr5Png9Hzae","folder":null,"sort":0,"ownership":{"default":0,"CIWVguTLismR00HG":3},"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"5.1.1","coreVersion":"14.360","createdTime":1688879058112,"modifiedTime":1688879097694,"lastModifiedBy":"CIWVguTLismR00HG","compendiumSource":null,"duplicateSource":null,"exportSource":null}}],"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"6.1.0","coreVersion":"14.360","createdTime":1685401626117,"modifiedTime":1736542895763,"lastModifiedBy":"l2rbNx2a8f5ocpeL","compendiumSource":null,"duplicateSource":null,"exportSource":null},"_id":"PVncScpbR5s49g4m","folder":"rnSyamM9GQTIpuOo","ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"sort":1900000}