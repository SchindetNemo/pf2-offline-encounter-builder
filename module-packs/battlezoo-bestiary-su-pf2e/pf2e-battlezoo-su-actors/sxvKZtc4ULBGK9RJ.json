[],"slug":"vomit-swarm","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","manipulate"],"rarity":"common","traditions":["arcane","occult","primal"]},"publication":{"title":"Pathfinder Advanced Player's Guide","authors":"","license":"OGL","remaster":false},"level":{"value":2},"requirements":"","target":{"value":""},"range":{"value":""},"area":{"type":"cone","value":30},"time":{"value":"2"},"duration":{"value":"","sustained":false},"damage":{"0":{"formula":"2d8","type":"piercing","category":null,"materials":[],"kinds":["damage"]}},"defense":{"passive":null,"save":{"statistic":"reflex","basic":true}},"cost":{"value":""},"location":{"value":"UhDeKlxEaXdDODE9","heightenedLevel":2},"counteraction":false,"heightening":{"damage":{"0":"1d8"},"interval":1,"type":"interval"}},"type":"spell","flags":{"core":{}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"_stats":{"systemId":"pf2e","systemVersion":"5.0.1","coreVersion":"14.360","createdTime":1687204678966,"modifiedTime":1687204678966,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":"Compendium.pf2e.spells-srd.Item.cB17yFc9456Pyfec","duplicateSource":null,"exportSource":null},"_id":"cYDIKko14jXOiVhz"},{"img":"systems/pf2e/icons/spells/acidic-burst.webp","name":"Acidic Burst","system":{"description":{"gm":"","value":"<p>You create a shell of acid around yourself that immediately bursts outward, dealing 2d6 acid damage to each creature in the area.</p>\n<hr />\n<p><strong>Heightened (+1)</strong> The damage increases by 2d6.</p>"},"rules":[],"slug":"acidic-burst","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["acid","concentrate","manipulate"],"rarity":"common","traditions":["arcane","primal"]},"publication":{"title":"Pathfinder Lost Omens: Gods & Magic","authors":"","license":"OGL","remaster":false},"level":{"value":1},"requirements":"","target":{"value":""},"range":{"value":""},"area":{"type":"emanation","value":5},"time":{"value":"2"},"duration":{"value":"","sustained":false},"damage":{"0":{"formula":"2d6","type":"acid","category":null,"materials":[],"kinds":["damage"]}},"defense":{"passive":null,"save":{"statistic":"reflex","basic":true}},"cost":{"value":""},"location":{"value":"UhDeKlxEaXdDODE9","heightenedLevel":1},"counteraction":false,"heightening":{"damage":{"0":"2d6"},"interval":1,"type":"interval"}},"type":"spell","flags":{"core":{}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"_stats":{"systemId":"pf2e","systemVersion":"5.0.1","coreVersion":"14.360","createdTime":1687204684369,"modifiedTime":1687204684369,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":"Compendium.pf2e.spells-srd.Item.rnNGALRtsjspFTws","duplicateSource":null,"exportSource":null},"_id":"I1qqQMjrI2oNfssj"},{"img":"systems/pf2e/icons/spells/prestidigitation.webp","name":"Prestidigitation","system":{"description":{"gm":"","value":"<p>The simplest magic does your bidding. You can perform simple magical effects for as long as you Sustain the Spell. Each time you Sustain the Spell, you can choose one of four options.</p>\n<ul>\n<li><strong>Cook</strong> Cool, warm, or flavor 1 pound of nonliving material.</li>\n<li><strong>Lift</strong> <strong>Slowly</strong> lift an unattended object of light Bulk or less 1 foot off the ground.</li>\n<li><strong>Make</strong> Create a temporary object of negligible Bulk, made of congealed magical substance. The object looks crude and artificial and is extremely fragile-it can't be used as a tool, weapon, or spell component.</li>\n<li><strong>Tidy</strong> Color, clean, or soil an object of light Bulk or less. You can affect an object of 1 Bulk with 10 rounds of concentration, and a larger object a 1 minute per Bulk.</li>\n</ul>\n<p>Prestidigitation can't deal damage or cause adverse conditions. Any actual change to an object (beyond what is noted above) persists only as long as you Sustain the Spell.</p>"},"rules":[],"slug":"prestidigitation","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["cantrip","concentrate","manipulate"],"rarity":"common","traditions":["arcane","divine","occult","primal"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":1},"requirements":"","target":{"value":"1 object (cook, lift, or tidy only)"},"range":{"value":"10 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"","sustained":true},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"UhDeKlxEaXdDODE9"},"counteraction":false},"type":"spell","flags":{"core":{}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"_stats":{"systemId":"pf2e","systemVersion":"5.0.1","coreVersion":"14.360","createdTime":1687204689901,"modifiedTime":1687204689901,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":"Compendium.pf2e.spells-srd.Item.Qw3fnUlaUbnn7ipC","duplicateSource":null,"exportSource":null},"_id":"NEOiGPUOJQTYu45h"},{"type":"action","img":"systems/pf2e/icons/default-icons/action.svg","name":"Pack Attack","system":{"description":{"gm":"","value":"<p>A bulbekken deals 1d4 extra damage to any creature that's within reach of at least two of the bulbekken's allies.</p>"},"rules":[{"domain":"damage","key":"RollOption","option":"pack-attack","toggleable":true,"value":false},{"diceNumber":1,"dieSize":"d4","key":"DamageDice","predicate":["pack-attack"],"selector":"strike-damage"}],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"offensive","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"effects":[],"_id":"7iwEXwvLvcyXgFpH","folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"5.3.0","coreVersion":"14.360","createdTime":1687204716950,"modifiedTime":1691128644561,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":null,"duplicateSource":null,"exportSource":null}}],"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"6.1.0","coreVersion":"14.360","createdTime":1685401626117,"modifiedTime":1736542898895,"lastModifiedBy":"l2rbNx2a8f5ocpeL","compendiumSource":null,"duplicateSource":null,"exportSource":null},"_id":"sxvKZtc4ULBGK9RJ","folder":"rnSyamM9GQTIpuOo","ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"sort":9000000}