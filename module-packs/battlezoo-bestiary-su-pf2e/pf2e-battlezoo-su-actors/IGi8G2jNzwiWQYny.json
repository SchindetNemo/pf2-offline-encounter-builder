ach full moon, the cursed creature must succeed at another Fortitude save or turn into the same kind of werecreature until dawn. The creature is under the GM's control and goes on a rampage for half the night before falling @Compendium[pf2e.conditionitems.Unconscious]{Unconscious} until dawn.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["curse","primal"]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"offensive","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"effects":[],"_id":"5P7EQlTDuTlHR0fI","folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"5.1.2","coreVersion":"14.360","createdTime":1689188585862,"modifiedTime":1689188611479,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"type":"melee","img":"systems/pf2e/icons/default-icons/melee.svg","name":"Jaws","system":{"description":{"gm":"","value":""},"rules":[],"slug":null,"traits":{"value":[],"otherTags":[]},"damageRolls":{"n7lbnnxtZd1vgTs1":{"damage":"2d8+6","damageType":"piercing","category":null}},"bonus":{"value":15},"attackEffects":{"value":["curse-of-the-twistwere"]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"_migration":{"version":0.932,"previous":{"schema":null,"foundry":"12.328","system":"6.1.0"}}},"effects":[],"_id":"BZkPUSvIV1gHBiHe","folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"5.1.2","coreVersion":"14.360","createdTime":1689188614582,"modifiedTime":1689188641759,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"type":"melee","img":"systems/pf2e/icons/default-