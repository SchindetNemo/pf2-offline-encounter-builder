cDAmGcgt3X6Rq","compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"img":"systems/pf2e/icons/actions/OneAction.webp","name":"Grab","system":{"description":{"gm":"","value":"<p>@Localize[PF2E.NPC.Abilities.Glossary.Grab]</p>"},"rules":[],"slug":"grab","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[],"rarity":"common"},"publication":{"title":"Pathfinder Bestiary","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":1},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""},"weapon":{"value":""}},"type":"action","flags":{"core":{}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"_stats":{"systemId":"pf2e","systemVersion":"5.0.1","coreVersion":"14.360","createdTime":1687223985457,"modifiedTime":1687223985457,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":"Compendium.pf2e.bestiary-ability-glossary-srd.Item.Tkd8sH4pwFIPzqTr","duplicateSource":null,"exportSource":null},"_id":"BNIPPjE3KZr40KWb"},{"type":"action","img":"systems/pf2e/icons/default-icons/action.svg","name":"Cathartic Gaze","system":{"description":{"gm":"","value":"<p><strong>Trigger</strong> A creature within 30 feet of the cathartic worm that can see the cathartic worm and that the cathartic worm can see targets the cathartic worm with a Strike, spell, or ability</p>\n<hr />\n<p><strong>Effect</strong> The cathartic worm locks eyes with the triggering creature. The triggering creature must attempt a @Check[type:will|dc:25] save or become overwhelmed with a fit of powerful emotion.</p>\n<hr />\n<p><strong>Success</strong> The target isn't affected and is temporarily immune for the next 24 hours.</p>\n<p><strong>Failure</strong> The gaze has an effect depending on the result of a [[/r 1d6]]{d6} below. The effect lasts for 1 round, except for the fear result on a d6 roll of 3.</p>\n<p><strong>Critical Failure</strong> As failure, but the effect lasts for 1 minute, except for the fear result on a d6 roll of 3.</p>\n<h3>d6 Effect</h3>\n<p><strong>1 Anger</strong>: The target's rage causes it to become @Compendium[pf2e.conditionitems.Clumsy]{Clumsy 1}.</p>\n<p><strong>2 Awe</strong>: The target's awe toward the cathartic worm causes it to become @Compendium[pf2e.conditionitems.Stupefied]{Stupefied 1}.</p>\n<p><strong>3 Fear</strong>: The target is @Compendium[pf2e.conditionitems.Frightened]{Frightened 1}. On a critical failure, the target is also @Compendium[pf2e.conditionitems.Fleeing]{Fleeing} for 1 round.</p>\n<p><strong>4 Hatred</strong>: The target's hatred toward the cathartic worm causes it to become @Compendium[pf2e.conditionitems.Off-Guard]{Off-Guard} to the cathartic worm.</p>\n<p><strong>5 Love</strong>: The target falls in love with the cathartic worm, but this bizarre emotion causes it to become @Compendium[pf2e.conditionitems.Confused]{Confused}.</p>\n<p><strong>6 Remorse</strong>: The target sobs and becomes @Compendium[pf2e.conditionitems.Immobilized]{Immobilized} with remorse.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["emotion","mental","primal","visual"]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"reaction"},"category":"offensive","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"effects":[],"_id":"q8s85yarDJurlcTY","folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"5.0.1","coreVersion":"14.360","createdTime":1687224053040,"modifiedTime":1687224212189,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"img":"systems/pf2e/icons/actions/OneAction.webp","name":