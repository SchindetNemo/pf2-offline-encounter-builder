.1.2","coreVersion":"14.360","createdTime":1689127606691,"modifiedTime":1689127636404,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"type":"melee","img":"systems/pf2e/icons/default-icons/melee.svg","name":"Serpent Tail","system":{"description":{"gm":"","value":""},"rules":[],"slug":"serpent-tail","traits":{"value":["agile","reach-20"],"otherTags":[]},"damageRolls":{"Ayh1KoKe4mzoAOMG":{"damage":"4d8+18","damageType":"bludgeoning","category":null}},"bonus":{"value":36},"attackEffects":{"value":[]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"_migration":{"version":0.932,"previous":{"schema":null,"foundry":"12.328","system":"6.1.0"}}},"effects":[],"_id":"keA5Ivv6BLnZ432V","folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"5.1.2","coreVersion":"14.360","createdTime":1689127607407,"modifiedTime":1689128151312,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"type":"action","img":"systems/pf2e/icons/default-icons/action.svg","name":"Bestial Frenzy","system":{"description":{"gm":"","value":"<p>The testudan makes up to six bear claw Strikes, attacking a given creature no more than once. It doesn't increase its multiple attack penalty until after making all six attacks.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":2},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"effects":[],"_id":"YgQNA1e8fGH9IyyG","folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"5.1.2","coreVersion":"14.360","createdTime":1689127733154,"modifiedTime":1689127757731,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"type":"action","img":"systems/pf2e/icons/default-icons/action.svg","name":"Shell Defense","system":{"description":{"gm":"","value":"<p>The testudan retracts its limbs and head into its shell and ends its turn. It gains a +4 circumstance bonus to AC, increasing its AC to 44, as well as to Reflex saves against area attacks. However, while in its shell, it can't act except to Shell Slam, Stand, or use the Shell Defense action again to re- emerge. If the testudan is @Compendium[pf2e.conditionitems.Prone]{Prone} while in its shell, it doesn't gain the circumstance bonus to AC from Shell Defense and it must spend two actions in order to Stand.</p>"},"rules":[{"key":"FlatModifier","selector":"ac","value":4,"predicate":["shell-defense"],"slug":"shell-defense-ac"},{"key":"FlatModifier","selector":"reflex","value":4,"predicate":["shell-defense","area-effect"],"slug":"shell-defense-reflex"},{"key":"AdjustModifier","selector":"ac","slug":"shell-defense-ac","mode":"override","value":0,"predicate":["self:condition:prone"]},{"domain":"all","key":"RollOption","option":"shell-defense","toggleable":true,"value":false}],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":1},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"effects":[],"_id":"Tq1zSWRrdOoDycTf","folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"5.1.2","coreVersion":"14.360","createdTime":1689127733543,"modifiedTime":1689128199479,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"type":"action","img":"systems/pf2e/icons/default-icons/action.svg","name":"Shell Slam","system":{"description":{"gm":"","value":"<p><strong>Requirements</strong> The testudan is in its shell from Shell Defense and is not @Compendium[pf2e.conditionitems.Prone]{Prone}</p>\n<hr />\n<p><strong>Effect</strong> The testudan Leaps up to 20 feet horizontally, passing over the space of any Large or smaller creature before landing prone. Any creature within the testudan's space at the end of its movement takes 10d6 piercing and @Damage[10d6[bludgeoning]] damage and must attempt a @Check[type:reflex|dc:38] save with the following effects. Regardless of the result, the creature is moved out of the testudan's space to the closest empty space. If the testudan attempts to pass through the space of a Huge or larger creature, it stops its movement early and lands adjacent to the creature, forcing that creature to make the Reflex save in addition to all creatures in the testudan's space.</p>\n<hr />\n<p><strong>Critical Success</strong> The creature takes no damage.</p>\n<p><strong>Success</strong> The creature takes half damage.</p>\n<p><strong>Failure</strong> The creature takes full damage and is knocked prone.</p>\n<p><strong>Critical Failure</strong> The creature takes double damage, is knocked prone, and is @Compendium[pf2e.conditionitems.Paralyzed]{Paralyzed} for 1 round.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":2},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"effects":[],"_id":"07rVE1eFV1Y6LvUp","folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"5.3.0","coreVersion":"14.360","createdTime":1689127734101,"modifiedTime":1691261012387,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":null,"duplicateSource":null,"exportSource":null}}],"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"6.1.0","coreVersion":"14.360","createdTime":1685401626117,"modifiedTime":1736542839609,"lastModifiedBy":"l2rbNx2a8f5ocpeL","compendiumSource":null,"duplicateSource":null,"exportSource":null},"_id":"CX3yyKzW1gSYmP22","folder":"3x5VQ7TD4gePAtOj","ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"sort":0}