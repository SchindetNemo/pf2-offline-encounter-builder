onType":{"value":"reaction"},"category":"offensive","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"effects":[],"_id":"2NfgQSbRNWDYFxJh","folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"5.1.1","coreVersion":"14.360","createdTime":1688872934749,"modifiedTime":1688872955461,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"type":"action","img":"systems/pf2e/icons/default-icons/action.svg","name":"Hey! Look Out!","system":{"description":{"gm":"","value":"<p><strong>Requirements</strong> Maramacula has heard a specific creature speak, or use an action with the auditory or the linguistic trait</p>\n<hr />\n<p><strong>Effect</strong> Maramacula imitates the creature's voice and shouts inaccurate warnings, befuddling the creature and its allies. The mimicked creature and its allies in a @Template[type:emanation|distance:20] must attempt a @Check[type:will|dc:34] save.</p>\n<hr />\n<p><strong>Critical Success</strong> The creature recognizes Maramacula's schemes and is temporarily immune for 1 hour.</p>\n<p><strong>Success</strong> The creature doesn't fall for Maramacula's schemes and is unaffected.</p>\n<p><strong>Failure</strong> The creature is @Compendium[pf2e.conditionitems.Off-Guard]{Off-Guard} until the end of Maramacula's next turn.</p>\n<p><strong>Critical Failure</strong> The creature can't completely shake off the lies coming from Maramacula's voice and distinguish it from the original's voice, even if it was their own. The creature becomes off-guard and @Compendium[pf2e.conditionitems.Stupefied]{Stupefied 1} for 1 minute.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["auditory","mental"]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":1},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"effects":[],"_id":"jnOMmUBfOoTQZf3x","folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"5.1.1","coreVersion":"14.360","createdTime":1688872963285,"modifiedTime":1688873004706,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"type":"action","img":"systems/pf2e/icons/default-icons/action.svg","name":"Slippery Slope","system":{"description":{"gm":"","value":"<p>Maramacula leaves a sticky, slippery trail on its path. Whenever it leaves a square on land, that square becomes difficult terrain for every other creature for 1 round.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"offensive","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"effects":[],"_id":"P4aLEPyB5TsJxhWZ","folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"5.1.1","coreVersion":"14.360","createdTime":1688873011508,"modifiedTime":1688873054738,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":null,"duplicateSource":null,"exportSource":null}}],"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"6.1.0","coreVersion":"14.360","createdTime":1685401626117,"modifiedTime":1736542895717,"lastModifiedBy":"l2rbNx2a8f5ocpeL","compendiumSource":null,"duplicateSource":null,"exportSource":null},"_id":"OaZE9q3kRUxAiYPl","folder":"rnSyamM9GQTIpuOo","ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"sort":1800000}