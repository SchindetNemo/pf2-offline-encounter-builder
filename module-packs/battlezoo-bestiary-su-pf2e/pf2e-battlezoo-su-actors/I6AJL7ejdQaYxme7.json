efault-icons/action.svg","name":"Pain Link","system":{"description":{"gm":"","value":"<p><strong>Trigger</strong> The proselytizer takes damage and has a creature @Compendium[pf2e.conditionitems.Grabbed]{Grabbed} or @Compendium[pf2e.conditionitems.Restrained]{Restrained} with its chain</p>\n<hr />\n<p><strong>Effect</strong> The proselytizer shares its pain with the grappled creature, causing the creature to take mental damage equal to the total triggering damage the proselytizer took, with a @Check[type:fortitude|dc:36|basic:true] save.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["divine","nonlethal"]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"reaction"},"category":"defensive","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"effects":[],"_id":"oJ9SCXUiyGAYAV2K","folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"5.3.0","coreVersion":"14.360","createdTime":1688955146481,"modifiedTime":1691130018440,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"type":"action","img":"systems/pf2e/icons/default-icons/action.svg","name":"Unnerving Gaze","system":{"description":{"gm":"","value":"<p>30 feet. When a creature ends its turn in the aura, it must succeed at a @Check[type:will|dc:33] save or become @Compendium[pf2e.conditionitems.Frightened]{Frightened 1}.</p>"},"rules":[{"key":"Aura","radius":30,"traits":["divine","fear","mental","visual"]}],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["aura","divine","fear","mental","visual"]},"publication":{"title":"","authors":"","license":"OGL","remaster":false