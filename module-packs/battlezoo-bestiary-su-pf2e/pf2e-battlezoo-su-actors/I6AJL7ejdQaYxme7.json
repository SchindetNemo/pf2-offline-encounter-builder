":""}},"type":"action","flags":{"core":{}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"_stats":{"systemId":"pf2e","systemVersion":"5.1.1","coreVersion":"14.360","createdTime":1688955273705,"modifiedTime":1688955273705,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":"Compendium.pf2e.bestiary-ability-glossary-srd.Item.Tkd8sH4pwFIPzqTr","duplicateSource":null,"exportSource":null},"_id":"yO2NNG2BFgKrPu6q"},{"type":"melee","img":"systems/pf2e/icons/default-icons/melee.svg","name":"Spike","system":{"description":{"gm":"","value":""},"rules":[],"slug":null,"traits":{"value":["thrown-30","unholy"],"otherTags":[]},"damageRolls":{"8g7MBJKNPXmXcJ3O":{"damage":"3d6+14","damageType":"piercing","category":null}},"bonus":{"value":30},"attackEffects":{"value":[]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"_migration":{"version":0.932,"previous":{"schema":null,"foundry":"12.328","system":"6.1.0"}}},"effects":[],"_id":"lPka5riJHYGeQtA2","folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"5.1.1","coreVersion":"14.360","createdTime":1688955298027,"modifiedTime":1688955318579,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"type":"action","img":"systems/pf2e/icons/default-icons/action.svg","name":"Hidden Shadow Chain","system":{"description":{"gm":"","value":"<p>Hundreds of chains emerge from the sleeves of the proselytizer's hood and shoot out, skewering everything in their path. Each creature in a @Template[type:line|distance:30] takes [[/r 10d4[slashing],5[bleed]]]{10d4 slashing damage and 5 persistent bleed} damage, depending on a @Check[type:fortitude|dc:36] save. The proselytizer can't use Hidden Shadow Chain again for [[/br 1d4 #Hidden Shadow Chain Recharge]]{1d4 rounds}.</p>\n<hr />\n<p><strong>Critical Success</strong> The target is unaffected.</p>\n<p><strong>Success</strong> The target takes half damage.</p>\n<p><strong>Failure</strong> The target takes full damage and is @Compendium[pf2e.conditionitems.Grabbed]{Grabbed} by the proselytizer's spiked chain .</p>\n<p><strong>Critical Failure</strong> The target takes double damage and is @Compendium[pf2e.conditionitems.Restrained]{Restrained} by the proselytizer's spiked chain.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["divine"]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":2},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"effects":[],"_id":"jmenRv3QCiXmzqKX","folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"5.3.0","coreVersion":"14.360","createdTime":1688955326667,"modifiedTime":1691130027023,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"type":"action","img":"systems/pf2e/icons/default-icons/action.svg","name":"Infinite Chains","system":{"description":{"gm":"","value":"<p>The proselytizer can have any number of creatures @Compendium[pf2e.conditionitems.Grabbed]{Grabbed} with its chain and can continue to Strike with it's chain even if it has a creature grabbed with its chain.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"offensive","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"effects":[],"_id":"Od9g5pY8wq1B0RbK","folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"5.1.1","coreVersion":"14.360","createdTime":1688955412621,"modifiedTime":1688955432760,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"type":"action","img":"systems/pf2e/icons/default-icons/action.svg","name":"Painful Determination","system":{"description":{"gm":"","value":"<p><strong>Frequency</strong> once per round</p>\n<hr />\n<p><strong>Effect</strong> The proselytizer stabs themselves in a vital point with a spike, leaving the spike embedded in their flesh. They take [[/r 50]] damage, which can't be prevented in any way (though they can share the damage with another creature using Pain Link). The proselytizer then chooses one spell or condition affecting them, attempting to counteract the spell or condition with a counteract level of 8 and a counteract modifier of [[/r 1d20+30 #Counteract]]{+30}. This doesn't prevent the condition from affecting the proselytizer again later, and it can't remove situational or positional conditions such as being @Compendium[pf2e.conditionitems.Prone]{Prone} or being @Compendium[pf2e.conditionitems.Off-Guard]{Off-Guard} due to being flanked.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","divine"]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":1},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"effects":[],"_id":"Xwgnf9cZqDZwbdmn","folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"5.1.1","coreVersion":"14.360","createdTime":1688955440531,"modifiedTime":1688955490479,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":null,"duplicateSource":null,"exportSource":null}}],"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"6.1.0","coreVersion":"14.360","createdTime":1685401626117,"modifiedTime":1736542894474,"lastModifiedBy":"l2rbNx2a8f5ocpeL","compendiumSource":null,"duplicateSource":null,"exportSource":null},"_id":"I6AJL7ejdQaYxme7","folder":"QqEyWiBhCvupt0ox","ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"sort":0}