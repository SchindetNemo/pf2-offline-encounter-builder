or volume. While Inhabiting an object, the contortion crown gains a +2 circumstance bonus to AC and loses its weakness to slashing damage. The crown remains Inhabiting the object until the object breaks or the crown Inhabits a new object. When not Inhabiting an object, the crown can't use its junk carapace Strike.</p>"},"rules":[{"domain":"all","key":"RollOption","option":"inhabit","toggleable":true,"value":false},{"key":"FlatModifier","selector":"ac","value":2,"type":"circumstance","predicate":["inhabit"]},{"key":"Weakness","type":"slashing","value":15,"predicate":[{"not":"inhabit"}]}],"slug":"","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["move"]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":2},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"effects":[],"_id":"jScpSYyGoEpMxSdk","folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"5.0.1","coreVersion":"14.360","createdTime":1687304066617,"modifiedTime":1687305438912,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"type":"action","img":"systems/pf2e/icons/default-icons/action.svg","name":"Retract","system":{"description":{"gm":"","value":"<p><strong>Requirements</strong> The contortion crown Inhabits an object</p>\n<hr />\n<p><strong>Effect</strong> The crown fully withdraws into their improvised carapace. Their circumstance bonus to AC increases to +4, and they can't take actions except to use Improved Block, Enforce Dominion, or this action again to come out of their carapace.</p>"},"rules":[{"domain":"all","key":"RollOption","option":"retract","toggleable":true,"predicate":["inhabit"],"value":false},{"key":"AdjustModifier","slug":"inhabit","selector":"ac","mode":"upgrade","value":4,"predicate":["retract"]}],"slug":"","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":1},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"effects":[],"_id":"uGxGurID0dpo37iv","folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"5.0.1","coreVersion":"14.360","createdTime":1687304068366,"modifiedTime":1687305597073,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"img":"systems/pf2e/icons/actions/Passive.webp","name":"Darkvision","system":{"description":{"gm":"","value":"<p>@Localize[PF2E.NPC.Abilities.Glossary.Darkvision]</p>"},"rules":[],"slug":"darkvision","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[],"rarity":"common"},"publication":{"title":"Pathfinder Bestiary","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"interaction","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""},"weapon":{"value":""}},"type":"action","flags":{"core":{}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"_stats":{"systemId":"pf2e","systemVersion":"5.0.1","coreVersion":"14.360","createdTime":1687304445029,"modifiedTime":1687304445029,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":"Compendium.pf2e.bestiary-ability-glossary-srd.Item.qCCLZhnp2HhP3Ex6","duplicateSource":null,"exportSource":null},"_id":"7ZZyUOEIdkD65ZX2"},{"img":"systems/pf2e/icons/actions/FreeAction.webp","name":"Improved Push","system":{"description":{"gm":"","value":"<p>@Localize[PF2E.NPC.Abilities.Glossary.ImprovedPush]</p>"},"rules":[],"slug":"improved-push","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[],"rarity":"common"},"publication":{"title":"Pathfinder Bestiary","authors":"","license":"OGL","remaster":false},"actionType":{"value":"free"},"category":"offensive","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""},"weapon":{"value":""}},"type":"action","flags":{"core":{}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"_stats":{"systemId":"pf2e","systemVersion":"5.0.1","coreVersion":"14.360","createdTime":1687304948635,"modifiedTime":1687304948635,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":"Compendium.pf2e.bestiary-ability-glossary-srd.Item.6l7e7CHQLESlI57U","duplicateSource":null,"exportSource":null},"_id":"lmknmLsn6cpL0Ftb"},{"type":"action","img":"systems/pf2e/icons/default-icons/action.svg","name":"Enforce Dominion","system":{"description":{"gm":"","value":"<p><strong>Frequency</strong> once per round</p>\n<p><strong>Requirements</strong> A Huge or Gargantuan object or building suitable for a dwelling is within the contortion crown's reach, and there are creatures inside of that object or dwelling</p>\n<hr />\n<p><strong>Effect</strong> The contortion crown attempts to force out all creatures (except itself, if applicable) from the object or dwelling. The occupying creatures must succeed on a Fortitude save against the contortion crown's Athletics DC. On a failed save, a creature is pushed out of the object and to an adjacent square. On a critical failure, a creature is pushed 15 feet away from the object and then the creature falls @Compendium[pf2e.conditionitems.Prone]{Prone}.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":1},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""},"frequency":{"max":1,"per":"round"}},"effects":[],"_id":"JCHciJgazJj1cY0p","folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"5.0.1","coreVersion":"14.360","createdTime":1687305162462,"modifiedTime":1687305179549,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"type":"action","img":"systems/pf2e/icons/default-icons/action.svg","name":"Forceful Seizure","system":{"description":{"gm":"","value":"<p>With a sweeping motion, the contortion crown Interacts to pick up a Small, Medium, or Large object and Strikes up to two creatures within 10 feet of it using its limb Strike. Its multiple attack penalty does not increase until after it makes both limb Strikes, and its +1 circumstance bonus to attack rolls from the sweep trait applies to both Strikes.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":2},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"effects":[],"_id":"oAgPTan63tcyqyk7","folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"5.0.1","coreVersion":"14.360","createdTime":1687305225938,"modifiedTime":1687305254513,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"type":"action","img":"systems/pf2e/icons/default-icons/action.svg","name":"Throw Junk","system":{"description":{"gm":"","value":"<p>The contortion crown picks up an object within reach (typically a piece of junk) and throws it, making a ranged junk Strike.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.853,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":1},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"effects":[],"_id":"HgFqeIMw7JwBmXRp","folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"5.0.1","coreVersion":"14.360","createdTime":1687305457900,"modifiedTime":1687305698042,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":null,"duplicateSource":null,"exportSource":null}}],"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"6.1.0","coreVersion":"14.360","createdTime":1685401626117,"modifiedTime":1736542895392,"lastModifiedBy":"l2rbNx2a8f5ocpeL","compendiumSource":null,"duplicateSource":null,"exportSource":null},"_id":"MRT5JJDzH1U14fm8","folder":"rnSyamM9GQTIpuOo","ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"sort":1200000}