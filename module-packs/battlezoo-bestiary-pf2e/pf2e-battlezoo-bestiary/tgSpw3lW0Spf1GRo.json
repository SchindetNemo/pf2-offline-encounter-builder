se},"proficiency":{"value":0},"slots":{"slot0":{"prepared":[],"value":0,"max":0},"slot1":{"prepared":[],"value":0,"max":0},"slot2":{"prepared":[],"value":0,"max":0},"slot3":{"prepared":[],"value":0,"max":0},"slot4":{"prepared":[],"value":0,"max":0},"slot5":{"prepared":[],"value":0,"max":0},"slot6":{"prepared":[],"value":0,"max":0},"slot7":{"prepared":[],"value":0,"max":0},"slot8":{"prepared":[],"value":0,"max":0},"slot9":{"prepared":[],"value":0,"max":0},"slot10":{"prepared":[],"value":0,"max":0},"slot11":{"prepared":[],"value":0,"max":0}},"autoHeightenLevel":{"value":null},"showUnpreparedSpells":{"value":true},"displayLevels":{}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"dx6j942QAWHcR6za","name":"Haste","type":"spell","img":"systems/pf2e/icons/spells/haste.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>Magic empowers the target to act faster. It gains the @Compendium[pf2e.conditionitems.nlCjDvLMf2EkV2dl]{Quickened} condition and can use the extra action each round only for Strike and Stride actions.</p>\n<hr />\n<p><strong>Heightened (7th)</strong> You can target up to 6 creatures.</p>"},"rules":[],"slug":"haste","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","manipulate"],"rarity":"common","traditions":["arcane","occult","primal"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":3},"requirements":"","target":{"value":"1 creature"},"range":{"value":"30 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"1 minute","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"4knvQe9lTCNmBUcL","heightenedLevel":3},"counteraction":false,"heightening":{"levels":{"7":{"target":{"value":"6 creatures"}}},"type":"fixed"}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.o6YCGx4lycsYpww4","duplicateSource":null,"exportSource":null}},{"_id":"wQ1PTeKuQv3yTLJT","name":"Soothe","type":"spell","img":"systems/pf2e/icons/spells/soothe.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>You grace the target's mind, boosting its mental defenses and healing its wounds. The target regains 1d10+4 Hit Points when you Cast the Spell and gains a +2 status bonus to saves against mental effects for the duration.</p>\n<p>@Compendium[pf2e.spell-effects.nkk4O5fyzrC0057i]{Spell Effect: Soothe}</p>\n<hr />\n<p><strong>Heightened (+1)</strong> The amount of healing increases by 1d10+4.</p>"},"rules":[],"slug":"soothe","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","emotion","healing","manipulate","mental"],"rarity":"common","traditions":["occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":1},"requirements":"","target":{"value":"1 willing living creature"},"range":{"value":"30 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"1 minute","sustained":false},"damage":{"0":{"formula":"1d10+4","type":"untyped","category":null,"materials":[],"kinds":["healing"]}},"defense":null,"cost":{"value":""},"location":{"value":"4knvQe9lTCNmBUcL","heightenedLevel":2},"counteraction":false,"heightening":{"type":"interval","interval":1,"damage":{"0":"1d10+4"}}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.szIyEsvihc5e1w8n","duplicateSource":null,"exportSource":null}},{"_id":"SNAvsbDrWDkdZ5tJ","name":"True Strike","type":"spell","img":"systems/pf2e/icons/spells/true-strike.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>A glimpse into the future ensures your next blow strikes true. The next time you make an attack roll before the end of your turn, roll the attack twice and use the better result. The attack ignores circumstance penalties to the attack roll and any flat check required due to the target being @Compendium[pf2e.conditionitems.DmAIPqOBomZ7H95W]{Concealed} or @Compendium[pf2e.conditionitems.iU0fEDdBp3rXpTMC]{Hidden}.</p>"},"rules":[],"slug":"true-strike","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","fortune"],"rarity":"common","traditions":["arcane","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":1},"requirements":"","target":{"value":""},"range":{"value":""},"area":null,"time":{"value":"1"},"duration":{"value":"until the end of your turn","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"4knvQe9lTCNmBUcL","heightenedLevel":1},"counteraction":false},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.Gb7SeieEvd0pL2Eh","duplicateSource":null,"exportSource":null}},{"_id":"s3Df91pJy1Ev78ni","name":"Tongues (Constant)","type":"spell","img":"systems/pf2e/icons/spells/tongues.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>The target can understand all words regardless of language and also speak the languages of other creatures. When in a mixed group of creatures, each time the target speaks, it can choose a creature and speak in a language that creature understands, even if the target doesn't know what language that is.</p>\n<hr />\n<p><strong>Heightened (7th)</strong> The duration is 8 hours.</p>"},"rules":[],"slug":"tongues","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","manipulate"],"rarity":"uncommon","traditions":["arcane","divine","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":5},"requirements":"","target":{"value":"1 creature"},"range":{"value":"touch"},"area":null,"time":{"value":"2"},"duration":{"value":"1 hour","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"4knvQe9lTCNmBUcL","heightenedLevel":5},"counteraction":false},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.SwUiVavHKMWG7t5K","duplicateSource":null,"exportSource":null}},{"_id":"HQmeGnEUuc8NzDfi","name":"Constant Spells","type":"action","img":"systems/pf2e/icons/actions/Passive.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>@Localize[PF2E.NPC.Abilities.Glossary.ConstantSpells]</p>"},"rules":[],"slug":"constant-spells","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"interaction","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""},"weapon":{"value":""}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.bestiary-ability-glossary-srd.Item.kakyXBG5WA8c6Zfd","duplicateSource":null,"exportSource":null}},{"_id":"EPRWxMszHbdte6gS","name":"Geas (See Curse of the Living Blade)","type":"spell","img":"systems/pf2e/icons/spells/geas.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>You enforce a magic rule on a willing target, forcing it to either perform or refrain from carrying out a certain act. A <em>geas</em> to perform an act is usually conditional, such as, \"Always offer hospitality to strangers seeking a place to stay.\" An unconditional <em>geas</em> to perform a certain act doesn't require the target to perform that act exclusively, though it must prioritize the task above all leisurely pursuits. The most common <em>geas</em> to refrain from carrying out an act is a specification to avoid violating a contract. In those cases, the secondary caster usually takes charge of making sure the wording of the contract is attuned correctly with the ritual's magic. Because the target is willing, <em>geas</em> can have a duration that lasts for as long as the target agrees to. If the target is unable to fulfill the <em>geas</em>, it becomes @Compendium[pf2e.conditionitems.fesd1n5eVhpCSS18]{Sickened 1}, and the sickened condition increases by 1 for each consecutive day it is prevented from following the <em>geas</em>, to a maximum of sickened 4. The sickened condition ends immediately when it follows the <em>geas</em> again; it can't remove the sickened condition in any other way. Only powerful magic such as a @Compendium[pf2e.spells-srd.6dDtGIUerazSHIOu]{Wish} spell can remove the effects of <em>geas</em> from a willing target.</p>\n<hr />\n<p><strong>Critical Success</strong> The <em>geas</em> succeeds, and the target receives a +1 status bonus to skill checks that directly uphold the <em>geas</em> (at the GM's discretion).</p>\n<p><strong>Success</strong> The <em>geas</em> succeeds.</p>\n<p><strong>Failure</strong> The <em>geas</em> fails.</p>\n<p><strong>Critical Failure</strong> The <em>geas</em> fails, and you are instead affected by the <em>geas</em> you were attempting to place on the target. You are considered an unwilling target, so the <em>geas</em> can be counteracted with a @Compendium[pf2e.spells-srd.OyFCwQuw8XRazsNr]{Remove Curse} spell.</p>\n<hr />\n<p><strong>Heightened (5th)</strong> You can use <em>geas</em> on an unwilling creature; it can attempt a Will save to negate the effect. If the target fails this Will save, the <em>geas</em> lasts up to 1 week. A <em>remove curse</em> spell can counteract a <em>geas</em> on an unwilling creature, in addition to powerful magic such as a <em>wish</em> spell. A clever unwilling creature can subvert the <em>geas</em> by contriving situations that prevent it from complying, but in that case it becomes @Compendium[pf2e.conditionitems.fesd1n5eVhpCSS18]{Sickened} (as described above).</p>\n<p><strong>Heightened (7th)</strong> As 5th level, but the <em>geas</em> lasts for up to 1 year on an unwilling creature.</p>\n<p><strong>Heightened (9th)</strong> As 5th level, but the <em>geas</em> lasts for a duration you choose (even unlimited) on an unwilling creature.</p>"},"rules":[],"slug":"geas","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["curse","mental"],"rarity":"uncommon","traditions":[]},"publication":{"title":"Pathfinder Secrets of Magic","authors":"","license":"OGL","remaster":false},"level":{"value":3},"requirements":"","target":{"value":"1 creature of a level no greater than double the geas ritual's level"},"range":{"value":"10 feet"},"area":null,"time":{"value":"1 day"},"duration":{"value":"see text","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":null},"counteraction":false,"ritual":{"primary":{"check":"Arcana (expert), Occultism (expert), or Religion (expert)"},"secondary":{"checks":"Society or Legal Lore","casters":1}}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.Q690d3mw3TUrKX7E","duplicateSource":null,"exportSource":null}},{"_id":"ROaSCv1dc59YcOUd","name":"Curse of the Living Blade","type":"action","img":"systems/pf2e/icons/actions/Passive.webp","effects":[],"folder":null,"sort":-200000,"flags":{},"system":{"description":{"gm":"","value":"<p>Any creature that attempts to wield the living blade is affected by its curse;</p>\n<p><strong>Saving Throw</strong> @Check[type:will|dc:27|name:Curse of the Living Blade DC|traits:curse, enchantment, mental, occult|showDC:gm]{Will};</p>\n<p><strong>Effect</strong> The living blade attempts to curse its wielder, compelling the creature to further the living blade's personal agenda. The living blade instantly casts a geas ritual on the triggering creature; the living blade always succeeds at casting this ritual. If the target critically succeeds its saving throw, it is immune to this curse for 24 hours. On a failure, the creature succumbs to the geas. While cursed, the creature must advance the living blade's agenda, which might be something discrete like \"avenge my master's death\" or something broader like \"achieve glory in my name.\" The cursed creature cannot willingly drop or give away the living blade. The geas lasts for 1 week, after which the wielder can make a new Will save.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["curse","mental","occult"],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"offensive","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"onfQQoxqltyX2pNf","name":"Summon Phantom Warrior","type":"action","img":"systems/pf2e/icons/actions/ThreeActions.webp","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"gm":"","value":"<p><strong>Frequency</strong> once per hour;</p>\n<p><strong>Requirements</strong> The living blade isn't being wielded or carried by an intelligent creature;</p>\n\n<p><strong>Effect</strong> The living blade manifests a phantom warrior that resembles a ghostly version of its original master, allowing the blade to move and act of its own accord. The phantom is made of nondescript soul-stuff from the Ethereal Plane and has no individual personality or identity, though it can interact with the physical world. A creature can identify the phantom warrior for what it is with a successful @Check[type:perception|dc:27|name:Identify Phantom Warrior DC|traits:occult, conjuration|showDC:gm]{Perception} check. The living blade can dismiss the phantom warrior as a free action. This stat block represents the living blade while it has its phantom warrior active.</p>\n<p>When reduced to 0 Hit Points or counteracted with <em>@Compendium[pf2e.spells-srd.9HpwDN4MYQJnW0LG]{Dispel Magic}</em> (counteract DC 27), the living blade assumes its weapon form (see Weapon Form) until the next time it uses Summon Phantom Warrior.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","occult"],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":3},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"ohq0Vz9BAhc3btqJ","name":"Scimitar","type":"weapon","img":"systems/pf2e/icons/equipment/weapons/scimitar.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>This one-handed curved blade is sharp on one side.</p>"},"rules":[],"slug":"scimitar","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["forceful","sweep"],"rarity":"common"},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":0},"quantity":1,"baseItem":"scimitar","bulk":{"value":1},"hp":{"value":0,"max":0},"hardness":0,"price":{"value":{"gp":1}},"equipped":{"carryType":"worn","invested":null,"handsHeld":0},"containerId":null,"size":"med","material":{"type":null,"grade":null},"identification":{"status":"identified","unidentified":{"name":"Unusual Scimitar","img":"systems/pf2e/icons/unidentified_item_icons/weapon.webp","data":{"description":{"value":""}}},"misidentified":{}},"usage":{"value":"held-in-one-hand"},"category":"martial","group":"sword","bonus":{"value":0},"damage":{"dice":1,"die":"d6","damageType":"slashing","persistent":null,"value":""},"splashDamage":{"value":0},"range":null,"expend":null,"ammo":null,"reload":{"value":""},"grade":null,"runes":{"potency":1,"striking":1,"property":["flaming"]},"specific":null,"subitems":[],"bonusDamage":{"value":0},"property1":{"value":"","dice":null,"die":"","damageType":"","critDice":null,"critDie":"","critDamage":"","critDamageType":"","criticalConditionType":"","criticalConditionValue":null,"strikeConditionType":"","strikeConditionValue":null}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.equipment-srd.Item.grmaV4GdoGD7sKbn","duplicateSource":null,"exportSource":null}},{"_id":"udd3bomQcmG9AgIJ","name":"Telepathy 100 Feet","type":"action","img":"systems/pf2e/icons/actions/Passive.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>@Localize[PF2E.NPC.Abilities.Glossary.Telepathy]</p>"},"rules":[],"slug":"telepathy","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["aura","magical","mental"],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"interaction","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""},"weapon":{"value":""}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.bestiary-ability-glossary-srd.Item.kdhbPaBMK1d1fpbA","duplicateSource":null,"exportSource":null}}],"effects":[],"folder":null,"sort":0,"flags":{"pf2e":{"lootable":false},"core":{}},"system":{"attributes":{"hp":{"value":100,"temp":0,"max":100,"details":"(as Phantom Warrior)"},"ac":{"value":27,"details":"","base":27},"allSaves":{"value":""},"speed":{"value":25,"otherSpeeds":[],"details":""},"immunities":[{"type":"bleed"},{"type":"death-effects"},{"type":"disease"},{"type":"doomed"},{"type":"drained"},{"type":"fatigued"},{"type":"healing"},{"type":"nonlethal-attacks"},{"type":"paralyzed"},{"type":"poison"},{"type":"sickened"},{"type":"unconscious"}]},"initiative":{"statistic":"perception"},"details":{"languages":{"value":[],"details":"telepathy 100 feet; tongues"},"level":{"value":8},"blurb":"","publicNotes":"<p>A living blade is a sentient weapon driven to carry out some secret and often nefarious agenda. Its will to complete its mission is so strong that this powerful armament can actually manifest a phantom warrior to carry out its dark deeds. Otherwise, the weapon lives dormant, enticing an unsuspecting warrior to pick it up and receive its curse.</p>\n<p>The exact force that animates a living blade differs in every case, though often it is the spirit of a mortal whose life's mission was left unresolved. One popular story is of a master blacksmith who was slaughtered by her own blade at the hands of a traitorous customer; the blacksmith's spirit clung to the weapon, and in this new form she vowed to achieve revenge on her killer.</p>\n<h2>Other Living Blades</h2>\n<p>Living blades come in many varieties, not all of which are even blades. Generally, a living blade is a magic melee weapon whose level is equal to its creature level + 2. Its runes can be replaced, but any attempt to remove a rune without replacing it fails. The only way to permanently turn a living blade into a non-cursed weapon is by counteracting it with the <em>@Compendium[pf2e.spells-srd.ihbRf964JDXztcy3]{Disjunction}</em> spell.</p>\n<h2>Monster Part Subsystem</h2>\n<p><strong>Living Blade Creature 8 </strong></p>\n<p><strong>Monster Parts</strong> 64/140/250 gp</p>\n<p><strong>Eligible Refinements</strong> weapons (slashing), armor (heavy), perception item, skill items (Acrobatics, Athletics, Deception)</p>\n<p><strong>Eligible Imbued Properties</strong> bane, charisma, dexterity, energy resistant (negative, positive), evil, fire, mental, sensory (darkvision), spells (Occult: haste, soothe, tongues, true strike), strength, wild</p>","privateNotes":"","publication":{"title":"Battlezoo Bestiary","authors":"W. Brian Lane","license":"OGL","remaster":false},"creatureType":""},"resources":{},"_migration":{"version":0.932,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"abilities":{"str":{"mod":5},"dex":{"mod":6},"con":{"mod":2},"int":{"mod":0},"wis":{"mod":4},"cha":{"mod":5}},"perception":{"details":"","mod":18,"senses":[{"type":"darkvision"}],"vision":true},"saves":{"fortitude":{"value":12,"saveDetail":""},"reflex":{"value":18,"saveDetail":""},"will":{"value":16,"saveDetail":""}},"skills":{"acrobatics":{"base":18},"athletics":{"base":17},"deception":{"base":17}},"traits":{"value":["construct","evil","soulbound"],"rarity":"common","size":{"value":"med"}},"spellcasting":{"rituals":{"dc":27}}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"prototypeToken":{"bar1":{"attribute":"attributes.hp"},"displayName":20,"displayBars":20,"flags":{"pf2e":{"linkToActorSize":true,"autoscale":false}},"height":1,"width":1,"disposition":-1,"name":"Living Blade","actorLink":false,"lockRotation":false,"rotation":0,"alpha":1,"bar2":{"attribute":null},"randomImg":false,"light":{"alpha":0.25,"angle":360,"bright":0,"coloration":1,"dim":0,"luminosity":0.5,"saturation":0,"contrast":0,"shadows":0,"animation":{"speed":5,"intensity":5,"type":null,"reverse":false},"darkness":{"min":0,"max":1},"attenuation":0.5,"color":null,"negative":false,"priority":0},"texture":{"src":"modules/battlezoo-bestiary-pf2e/art/Tokens/living_blade.webp","scaleX":2,"scaleY":2,"tint":"#ffffff","anchorX":0.5,"anchorY":0.5,"fit":"contain","alphaThreshold":0.75},"sight":{"angle":360,"enabled":false,"range":0,"brightness":1,"visionMode":"basic","color":null,"attenuation":0.1,"saturation":0,"contrast":0},"detectionModes":{},"appendNumber":false,"prependAdjective":false,"occludable":{"radius":0},"ring":{"enabled":true,"colors":{"ring":null,"background":null},"effects":1,"