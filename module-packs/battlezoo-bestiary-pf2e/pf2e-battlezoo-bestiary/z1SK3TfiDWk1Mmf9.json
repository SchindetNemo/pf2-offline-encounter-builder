l,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"zmNrfKRysUN4M9B1","name":"Dagger","type":"melee","img":"systems/pf2e/icons/default-icons/melee.svg","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"value":"","gm":""},"rules":[],"slug":null,"traits":{"value":["agile","finesse","versatile-s"],"otherTags":[]},"damageRolls":{"9rwx1hviw57iiwaiol9e":{"damage":"1d6+7","damageType":"piercing","category":null}},"bonus":{"value":15},"attackEffects":{"value":[]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"_migration":{"version":0.932,"previous":{"schema":null,"foundry":"12.328","system":"6.1.0"}}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"5GlcaDxEA2i6sEW2","name":"Cloak","type":"melee","img":"systems/pf2e/icons/default-icons/melee.svg","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"value":"","gm":""},"rules":[],"slug":null,"traits":{"value":["nonlethal","reach-10"],"otherTags":[]},"damageRolls":{"f12h8b1e3stv29ln6uu5":{"damage":"2d6+7","damageType":"bludgeoning","category":null}},"bonus":{"value":15},"attackEffects":{"value":["grab"]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"_migration":{"version":0.932,"previous":{"schema":null,"foundry":"12.328","system":"6.1.0"}}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"KxPib8lOu6KyTjoF","name":"Cloak's Gaze","type":"action","img":"systems/pf2e/icons/actions/OneAction.webp","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"gm":"","value":"<p>The eyes stitched to the gouger's cloak fix their gaze on a creature within 30 feet. That creature must attempt a @Check[type:fortitude|dc:24|name:Cloak’s Gaze DC|traits:concentrate, occult, visual|showDC:gm]{Fortitude} saving throw. On a failed save, the creature becomes @Compendium[pf2e.conditionitems.TkIyaNPgTZFBCCuh]{Dazzled} for 1 minute; if the creature was already dazzled, it is @Compendium[pf2e.conditionitems.XgEqL1kFApUbl5Z2]{Blinded} for 1 minute instead.</p>\n<p>A creature @Compendium[pf2e.conditionitems.kWc1fhmv9LBiTuei]{Grabbed} by the gouger's cloak takes a -2 circumstance penalty to the save.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","occult","visual"],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":1},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"ngzEDPrpHULpwqYs","name":"Gouge Eyes","type":"action","img":"systems/pf2e/icons/actions/ThreeActions.webp","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"gm":"","value":"<p><strong>Requirements</strong> The target is @Compendium[pf2e.conditionitems.fBnFDH2MTzgFijKf]{Unconscious}, @Compendium[pf2e.conditionitems.eIcWbB5o3pP6OIMe]{Immobilized}, or @Compendium[pf2e.conditionitems.6uEgoh53GbXuHpTF]{Paralyzed} and the cloaked gouger is wielding a dagger;</p>\n<p><strong>Effect</strong> The cloaked gouger cuts out the target's eyes. The target must attempt a @Check[type:fortitude|dc:24|name:Gouge Eyes DC|showDC:gm]{Fortitude} save. On a failure, it is permanently @Compendium[pf2e.conditionitems.XgEqL1kFApUbl5Z2]{Blinded}.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":3},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"T9utUvjsgzDOAlM4","name":"Gouger Toxin","type":"action","img":"systems/pf2e/icons/actions/Passive.webp","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"gm":"","value":"<p><strong>Saving Throw</strong> @Check[type:fortitude|dc:20|name:|traits:|showDC:gm]{Fortitude};</p>\n\n<p><strong>Maximum Duration</strong> 6 rounds;</p>\n<p><strong>Stage 1</strong> [[/r 1d6 #poison]]{1d6 poison damage} (1 round);</p>\n<p><strong>Stage 2</strong> [[/r 1d6 #poison]]{1d6 poison damage} and @Compendium[pf2e.conditionitems.dfCMdR4wnpbYNTix]{Stunned 1} (1 round);</p>\n<p><strong>Stage 3</strong> [[/r 1d6 #poison]]{1d6 poison damage} and @Compendium[pf2e.conditionitems.6uEgoh53GbXuHpTF]{Paralyzed} (1 round)</p>\n"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["injury","poison"],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"offensive","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}}],"effects":[],"folder":null,"sort":0,"flags":{"pf2e":{"lootable":false},"core":{}},"system":{"attributes":{"hp":{"value":95,"temp":0,"max":95,"details":""},"ac":{"value":23,"details":"all-around vision","base":23},"allSaves":{"value":"-2 status vs. gaze attacks"},"speed":{"value":25,"otherSpeeds":[],"details":""},"weaknesses":[{"type":"cold-iron","value":5}]},"initiative":{"statistic":"perception"},"details":{"languages":{"value":["common","fey"],"details":""},"level":{"value":6},"blurb":"","publicNotes":"<p>Cloaked gougers are shadowy fey hunters who hunt down creatures and steal their precious eyes to add to their collection. A gouger wears its collection of stolen trophies on its person in the form of a macabre cloak made from its victims' flattened and stitched eyeballs. Since cloaked gougers have no eyes themselves-that part of their face is only featureless flesh-they rely on their cloaks to navigate the world and perform their foul deeds.</p>\n<p>Cloaked gougers travel far and wide looking for creatures with extraordinary eyes. Monsters with supernatural gazes, people who have seen incredible things, or beings with particularly beautiful eyes should fear the attention of a cloaked gouger. Once a gouger selects a target, it sets up an ambush and surprises its prey, paralyzing it with toxins so it can remove its prize. Gougers use alchemical elixirs to preserve the eyeballs of their victims and enhance the most desirable features of their organs. Though they rarely do so, cloaked gougers can reattach creatures' eyes as easily as they can remove them.</p>\n<p>Though undeniably wicked, gougers are said to be reasonable creatures, and on occasion, they can be convinced to heal their own victims or the victim of another gouger, but the price is always steep, and it is never guaranteed that a victim's new eyes will be the same as the ones that were stolen.</p>\n<h2>Gouger Cloak</h2>\n<p>A gouger cloak makes an impressive prize for any adventurer, but it is simply a spectacular cloak as its innate magic dies with the gouger. However, skilled crafters of magic items can tap into the cloak's inherent magic and turn a gouger cloak into the much-prized <em>@Compendium[battlezoo-bestiary-pf2e.pf2e-battlezoo-equipment.ykZotI8Zd9ntvEXY]{Cloak of Eyes}</em>.</p>\n<h2>Prized Eyes</h2>\n<p>Despite their vulnerability to gaze attacks, gougers prize the eyes of creatures such as basilisks above all others. A gouger that can claim such trophies earns incredible respect from other gougers. Even more valuable are the eyes of the medusa, a creature both feared and respected by cloaked gougers. Adventurers who can attain such eyes gain a powerful edge in bargaining with gougers.</p>\n<h2>Monster Part Subsystem</h2>\n<p><strong>Cloaked Gouger Creature 6 </strong></p>\n<p><strong>Monster Parts</strong> 30/65/125 gp</p>\n<p><strong>Eligible Refinements</strong> weapons (slashing), armor (light), perception item, skill items (Acrobatics, Athletics, Intimidation, Medicine, Occultism, Stealth)</p>\n<p><strong>Eligible Imbued Properties</strong> bane, constitution, energy resistant (positive), evil, intelligence, poison, strength, wild</p>","privateNotes":"","publication":{"title":"Battlezoo Bestiary","authors":"Chris Harrell","license":"OGL","remaster":false},"creatureType":""},"resources":{},"_migration":{"version":0.932,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"abilities":{"str":{"mod":5},"dex":{"mod":3},"con":{"mod":4},"int":{"mod":4},"wis":{"mod":2},"cha":{"mod":3}},"perception":{"details":"","mod":16,"senses":[{"type":"darkvision"},{"type":"lifesense","acuity":"imprecise","range":60}],"vision":true},"saves":{"fortitude":{"value":16,"saveDetail":""},"reflex":{"value":15,"saveDetail":""},"will":{"value":12,"saveDetail":""}},"skills":{"acrobatics":{"base":15},"athletics":{"base":15},"intimidation":{"base":13},"medicine":{"base":14},"occultism":{"base":14},"stealth":{"base":13}},"traits":{"value":["evil","fey"],"rarity":"common","size":{"value":"med"}},"customModifiers":{}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"prototypeToken":{"bar1":{"attribute":"attributes.hp"},"displayName":20,"displayBars":20,"flags":{"pf2e":{"linkToActorSize":true,"autoscale":false}},"height":1,"width":1,"disposition":-1,"name":"Cloaked Gouger","actorLink":false,"lockRotation":false,"rotation":0,"alpha":1,"bar2":{"attribute":null},"randomImg":false,"light":{"alpha":0.25,"angle":360,"bright":0,"coloration":1,"dim":0,"luminosity":0.5,"saturation":0,"contrast":0,"shadows":0,"animation":{"speed":5,"intensity":5,"type":null,"reverse":false},"darkness":{"min":0,"max":1},"attenuation":0.5,"color":null,"negative":false,"priority":0},"texture":{"src":"modules/battlezoo-bestiary-pf2e/art/Tokens/cloaked_gouger.webp","scaleX":2,"scaleY":2,"tint":"#ffffff","anchorX":0.5,"anchorY":0.5,"fit":"contain","alphaThreshold":0.75},"sight":{"angle":360,"enabled":false,"range":0,"brightness":1,"visionMode":"basic","color":null,"attenuation":0.1,"saturation":0,"contrast":0},"detectionModes":{},"appendNumber":false,"prependAdjective":false,"occludable":{"radius":0},"ring":{"enabled":true,"colors":{"ring":null,"background":null},"effects":1,"subject":{"scale":2,"texture":"modules/battlezoo-bestiary-pf2e/art/Subjects/cloaked_gouger.webp"}},"turnMarker":{"mode":1,"animation":null,"src":null,"disposition":false},"movementAction":null,"depth":1},"_stats":{"systemId":"pf2e","systemVersion":"6.1.0","coreVersion":"14.360","createdTime":1663517319106,"modifiedTime":1729381027814,"lastModifiedBy":"ZdvNMqfYMlbFrAL2","compendiumSource":"Compendium.battlezoo-bestiary-pf2e.pf2e-battlezoo-bestiary.Actor.z1SK3TfiDWk1Mmf9","duplicateSource":null,"exportSource":null}}