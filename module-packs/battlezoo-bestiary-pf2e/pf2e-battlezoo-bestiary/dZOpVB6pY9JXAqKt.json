value":"1 creature"},"range":{"value":"30 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"1 minute","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"fWSz8RB71JNM67JC","heightenedLevel":3},"counteraction":false,"heightening":{"levels":{"7":{"target":{"value":"6 creatures"}}},"type":"fixed"}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.o6YCGx4lycsYpww4","duplicateSource":null,"exportSource":null}},{"_id":"qX68srECHrCS39MY","name":"Slow","type":"spell","img":"systems/pf2e/icons/spells/slow.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>You dilate the flow of time around the target, slowing its actions.</p>\n<hr />\n<p><strong>Critical Success</strong> The target is unaffected.</p>\n<p><strong>Success</strong> The target is @Compendium[pf2e.conditionitems.xYTAsEpcJE1Ccni3]{Slowed 1} for 1 round.</p>\n<p><strong>Failure</strong> The target is @Compendium[pf2e.conditionitems.xYTAsEpcJE1Ccni3]{Slowed 1} for 1 minute.</p>\n<p><strong>Critical Failure</strong> The target is @Compendium[pf2e.conditionitems.xYTAsEpcJE1Ccni3]{Slowed 2} for 1 minute.</p>\n<hr />\n<p><strong>Heightened (6th)</strong> You can target up to 10 creatures.</p>"},"rules":[],"slug":"slow","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","manipulate"],"rarity":"common","traditions":["arcane","occult","primal"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":3},"requirements":"","target":{"value":"1 creature"},"range":{"value":"30 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"1 minute","sustained":false},"damage":{},"defense":{"passive":null,"save":{"statistic":"fortitude","basic":false}},"cost":{"value":""},"location":{"value":"fWSz8RB71JNM67JC","heightenedLevel":3},"counteraction":false,"heightening":{"levels":{"6":{"target":{"value":"10 creatures"}}},"type":"fixed"}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.WsUwpfmhKrKwoIe3","duplicateSource":null,"exportSource":null}}],"effects":[],"folder":null,"sort":0,"flags":{"pf2e":{"lootable":false},"core":{}},"system":{"attributes":{"hp":{"value":70,"temp":0,"max":70,"details":"force healing"},"ac":{"value":22,"details":"","base":22},"allSaves":{"value":""},"speed":{"value":40,"otherSpeeds":[],"details":"time step"},"immunities":[{"type":"bleed"},{"type":"disease"},{"type":"paralyzed"},{"type":"poison"},{"type":"sickened"},{"type":"sleep"},{"type":"slowed"},{"type":"unconscious"}]},"initiative":{"statistic":"perception"},"details":{"languages":{"value":["aklo"],"details":""},"level":{"value":5},"blurb":"","publicNotes":"<p>When something or someone moves from one point in time and space to another, such as through summoning or teleportation, the magical energy expended in the process isn't always transferred properly. Sometimes, an excess of energy is left in one reality and a void is left in the other. Such unbalanced energies can materialize as a temporal manifestation—a shadowy void being who defies the laws of time and space.</p>\n<p>Temporal manifestations appear as roughly humanoid-shaped voids filled with images of the night sky. Upon closer examination, one can see that the images are that of time moving in all directions at once: stars dying and being reborn, galaxies expanding and collapsing, universes forming from a singularity then dissipating into a cold, lifeless, dark ending. Those who get too close to a temporal manifestation can utterly lose themselves as they stare at such a pure expression of time.</p>\n<h2>Unknowable Plans</h2>\n<p>Temporal manifestations have their own inscrutable agendas<span style=\"color:#333333;font-family:Roboto, sans-serif;font-size:12px\">—</span>agendas that rarely bode well for mortals and other creatures from the Material Plane.</p>\n<h2>Monster Part Subsystem</h2>\n<p><strong>Temporal Manifestation Creature 5 </strong></p>\n<p><strong>Monster Parts</strong> 18/45/80 gp</p>\n<p><strong>Eligible Refinements</strong> armor (light), perception item, skill items (Acrobatics, Athletics, Occultism, Stealth)</p>\n<p><strong>Eligible Imbued Properties</strong> bane, dexterity, energy resistant (force, positive), evil, force, sensory (darkvision), spells (Occult: haste, slow), wild, wisdom</p>","privateNotes":"","publication":{"title":"Battlezoo Bestiary","authors":"Eric Sklavos","license":"OGL","remaster":false},"creatureType":""},"resources":{},"_migration":{"version":0.932,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"abilities":{"str":{"mod":3},"dex":{"mod":4},"con":{"mod":2},"int":{"mod":1},"wis":{"mod":5},"cha":{"mod":0}},"perception":{"details":"","mod":14,"senses":[{"type":"darkvision"}],"vision":true},"saves":{"fortitude":{"value":11,"saveDetail":""},"reflex":{"value":15,"saveDetail":""},"will":{"value":12,"saveDetail":""}},"skills":{"acrobatics":{"base":13},"athletics":{"base":12},"occultism":{"base":10},"stealth":{"base":13}},"traits":{"value":["aberration","evil","time"],"rarity":"rare","size":{"value":"med"}}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"prototypeToken":{"bar1":{"attribute":"attributes.hp"},"displayName":20,"displayBars":20,"flags":{"pf2e":{"linkToActorSize":true,"autoscale":true}},"height":1,"width":1,"disposition":-1,"name":"Temporal Manifestation","actorLink":false,"lockRotation":false,"rotation":0,"alpha":1,"bar2":{"attribute":null},"randomImg":false,"light":{"alpha":0.25,"angle":360,"bright":0,"coloration":1,"dim":0,"