p":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.bestiary-ability-glossary-srd.Item.qCCLZhnp2HhP3Ex6","duplicateSource":null,"exportSource":null}},{"_id":"8TqR6C4V4VPCCLQb","name":"Water Vulnerability","type":"action","img":"systems/pf2e/icons/actions/Passive.webp","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"gm":"","value":"<p>Water dilutes a yomhibdi's inky form and saps the monster of vitality. When the yomhibdi starts its turn in water or is doused with water (either through a spell or some other effect, such as pouring a bucket of water over it), it takes [[/r 2d6 #damage]]{2d6 damage}.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"interaction","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"yjAvoWa4PSFBMgrp","name":"Tendril","type":"melee","img":"systems/pf2e/icons/default-icons/melee.svg","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"value":"","gm":""},"rules":[],"slug":null,"traits":{"value":["agile","reach-10"],"otherTags":[]},"damageRolls":{"s6rwetqegy120p8ud82z":{"damage":"2d6+4","damageType":"bludgeoning","category":null}},"bonus":{"value":12},"attackEffects":{"value":[]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"_migration":{"version":0.932,"previous":{"schema":null,"foundry":"12.328","system":"6.1.0"}}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"1APac8APXDqshkCx","name":"Mind Probe","type":"spell","img":"systems/pf2e/icons/spells/mind-probe.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>You cast your thoughts through a creature's mind, sifting for information. You access the target's memories and knowledge unless it fends you off with a Will save.</p>\n<hr /><strong>Success</strong> The target is unaffected.\n<p><strong>Failure</strong> Each round of the spell's duration, you can Sustain the Spell to ask a different question and attempt to uncover the answer. For each question, the target can attempt a Deception check against your spell DC; if the target succeeds, you don't learn the answer, and on a critical success, the target gives you a false answer that you believe is truthful Once you've asked the target a given question, asking it again, even with a separate casting of mind probe, produces the same result.</p>\n<p><strong>Critical Failure</strong> As failure, and the target takes a -4 circumstance penalty to Deception checks against your questions.</p>"},"rules":[],"slug":"mind-probe","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","linguistic","manipulate","mental"],"rarity":"uncommon","traditions":["arcane","occult"]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"level":{"value":5},"requirements":"","target":{"value":"1 creature"},"range":{"value":"30 feet"},"area":null,"time":{"value":"1 minute"},"duration":{"value":"1 minute","sustained":true},"damage":{},"defense":{"passive":null,"save":{"statistic":"will","basic":false}},"cost":{"value":""},"location":{"value":"kXC90KjYTrsiXXXZ","heightenedLevel":5},"counteraction":false},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.9BnhadUO8FMLmeZ3","duplicateSource":null,"exportSource":null}},{"_id":"PqyMsWPkOQkFbvcT","name":"Dredge Sorrow","type":"action","img":"systems/pf2e/icons/actions/TwoActions.webp","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"gm":"","value":"<p>The yomhibdi plumbs the psyche of a creature within 30 feet and brings to the surface their feelings of self-doubt and unoriginality so that the yomhibdi can feast on these negative emotions. The target must attempt a @Check[type:will|dc:21|name:Dredge Sorrow DC|traits:emotion, healing, mental|showDC:gm]{Will} save.</p>\n\n<p>The yomhibdi can't Dredge Sorrow again for [[/br 1d4 #rounds]]{1d4 rounds}.</p>\n<hr />\n<p><strong>Critical Success</strong> The target is unaffected.</p>\n<p><strong>Success</strong> The target is @Compendium[pf2e.conditionitems.e1XGnhKNSQIm5IXg]{Stupefied 1} for 1 round.</p>\n<p><strong>Failure</strong> The target is @Compendium[pf2e.conditionitems.e1XGnhKNSQIm5IXg]{Stupefied 2} for 2 rounds, and the yomhibdi regains [[/br 14 #hit points]]{14 Hit Points}.</p>\n<p><strong>Critical Failure</strong> The target is @Compendium[pf2e.conditionitems.e1XGnhKNSQIm5IXg]{Stupefied 3} for 3 rounds, and the yomhibdi regains [[/br 28 #hit points]]{28 Hit Points}.</p>\n"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["emotion","healing","mental"],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":2},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"2KOHFYPv8rCLldWF","name":"Flick Ink","type":"action","img":"systems/pf2e/icons/actions/OneAction.webp","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"gm":"","value":"<p>The yomhibdi flicks a glob of ink at a single opponent within 5 feet. The target must attempt a @Check[type:reflex|dc:17|name:Flick Ink DC|traits:visual|showDC:gm]{Reflex} save.</p>\n<hr />\n<p><strong>Success</strong> The creature is unaffected.</p>\n<p><strong>Failure</strong> The creature is @Compendium[pf2e.conditionitems.XgEqL1kFApUbl5Z2]{Blinded}. The creature or an adjacent creature can spend 2 actions to wipe away the ink and remove the blinded condition.</p>\n<p><strong>Critical Failure</strong> As failure, but it takes 3 actions to wipe away the ink.</p>\n"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["visual"],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":1},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"kXC90KjYTrsiXXXZ","name":"Innate Divine Spells","type":"spellcastingEntry","img":"systems/pf2e/icons/default-icons/spellcastingEntry.svg","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"gm":"","value":""},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"ability":{"value":"cha"},"spelldc":{"value":11,"dc":19,"mod":0},"tradition":{"value":"divine"},"prepared":{"value":"innate","flexible":false},"showSlotlessLevels":{"value":false},"proficiency":{"value":0},"slots":{"slot0":{"prepared":[],"value":0,"max":0},"slot1":{"prepared":[],"value":0,"max":0},"slot2":{"prepared":[],"value":0,"max":0},"slot3":{"prepared":[],"value":0,"max":0},"slot4":{"prepared":[],"value":0,"max":0},"slot5":{"prepared":[],"value":0,"max":0},"slot6":{"prepared":[],"value":0,"max":0},"slot7":{"prepared":[],"value":0,"max":0},"slot8":{"prepared":[],"value":0,"max":0},"slot9":{"prepared":[],"value":0,"max":0},"slot10":{"prepared":[],"value":0,"max":0},"slot11":{"prepared":[],"value":0,"max":0}},"autoHeightenLevel":{"value":null},"showUnpreparedSpells":{"value":true},"displayLevels":{}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}}],"effects":[],"folder":null,"sort":0,"flags":{"pf2e":{"lootable":false},"core":{}},"system":{"attributes":{"hp":{"value":70,"temp":0,"max":70,"details":""},"ac":{"value":20,"details":"all-around vision","base":20},"allSaves":{"value":""},"speed":{"value":25,"otherSpeeds":[],"details":""},"immunities":[{"type":"blinded"},{"type":"critical-hits"},{"type":"precision"},{"type":"sleep"},{"type":"unconscious"}]},"initiative":{"statistic":"perception"},"details":{"languages":{"value":["aklo","common"],"details":""},"level":{"value":4},"blurb":"","publicNotes":"<p>Yomhibdis are information-devouring abominations that resemble floating humanoids made of ink-scrawled words, phrases, and symbols. They manifest on the Ethereal Plane from the wasted ink and squandered emotional energies of artists, poets, and writers who give up on works before they're finished. As soon as it manifests, a yomhibdi begins its never-ending search for the failed or self-sabotaging creatives on whom it feeds. Frustration, exhaustion, and despair are the yomhibdi's favorite dishes; once it has sapped a victim of these negative emotions, the yomhibdi consumes the creator whole.</p>\n<p>The words and sentences that compose a yomhibdi typically twist together into a roughly humanoid shape, since humanoids are the most common providers of the emotions that lead to a yomhibdi's creation. They typically stand about 5 feet tall but weigh less than 20 pounds, though they can reconfigure their bodies to a certain extent, lengthening their inky \"claws\" to strike at distant foes.</p>\n<p>Yomhibdis trapped on the Material Plane gravitate toward places of learning, art, and culture—anywhere that hacks and untalented creators might congregate. It is not unusual for a group of yomhibdis (called a story) to make their lair in the hidden nook of an old library or in the tunnels beneath great opera houses and theaters. There, they blend into the shadows and lie in ambush, ready to strike at any agonizing poets or playwrights who wander by lost in thought. As echoes of forgotten thoughts and stories, these creatures commonly steal works of writing from their victims, and their lairs might contain valuable books or even magic scrolls.</p>\n<h2>Creative Reliance</h2>\n<p>Yomhibdi exists solely to feed on the negative emotions of creative mortals. If it is unable to find a source of sustenance—such as in wilderness or hyper-pragmatic societies that don't foster creativity—a yomhibdi will gradually unspool and melt into a puddle of ink.</p>\n<h2>Monster Part Subsystem</h2>\n<p><strong>Yomhibdi Creature 4</strong></p>\n<p><strong>Monster Parts</strong> 12/27/50 gp</p>\n<p><strong>Eligible Refinements</strong> weapons (bludgeoning), perception item, skill items (Acrobatics, Athletics, Stealth)</p>\n<p><strong>Eligible Imbued Properties</strong> bane, chaotic, charisma, dexterity, energy resistant (positive), fortification, mental, sensory (darkvision), spells (Divine: mind probe), strength, wild</p>","privateNotes":"","publication":{"title":"Battlezoo Bestiary","authors":"Daniel Aznavorian","license":"OGL","remaster":false},"creatureType":""},"resources":{},"_migration":{"version":0.932,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"abilities":{"str":{"mod":4},"dex":{"mod":5},"con":{"mod":3},"int":{"mod":2},"wis":{"mod":1},"cha":{"mod":5}},"perception":{"details":"","mod":7,"senses":[{"type":"darkvision"}],"vision":true},"saves":{"fortitude":{"value":13,"saveDetail":""},"reflex":{"value":15,"saveDetail":""},"will":{"value":9,"saveDetail":""}},"skills":{"acrobatics":{"base":13},"athletics":{"base":12},"stealth":{"base":11}},"traits":{"value":["aberration","chaotic","ethereal"],"rarity":"common","size":{"value":"med"}}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"prototypeToken":{"bar1":{"attribute":"attributes.hp"},"displayName":20,"displayBars":20,"flags":{"pf2e":{"linkToActorSize":true,"autoscale":true}},"height":1,"width":1,"disposition":-1,"name":"Yomhibdi","actorLink":false,"lockRotation":false,"rotation":0,"alpha":1,"bar2":{"attribute":null},"randomImg":false,"light":{"alpha":0.25,"angle":360,"bright":0,"coloration":1,"dim":0,"luminosity":0.5,"saturation":0,"contrast":0,"shadows":0,"animation":{"speed":5,"intensity":5,"type":null,"reverse":false},"darkness":{"min":0,"max":1},"attenuation":0.5,"color":null,"negative":false,"priority":0},"texture":{"src":"modules/battlezoo-bestiary-pf2e/art/Tokens/yomhibdi.webp","scaleX":1,"scaleY":1,"tint":"#ffffff","anchorX":0.5,"anchorY":0.5,"fit":"contain","alphaThreshold":0.75},"sight":{"angle":360,"enabled":false,"range":0,"brightness":1,"visionMode":"basic","color":null,"attenuation":0.1,"saturation":0,"contrast":0},"detectionModes":{},"appendNumber":false,"prependAdjective":false,"occludable":{"radius":0},"ring":{"enabled":true,"colors":{"ring":null,"background":null},"effects":1,"subject":{"scale":1,"texture":"modules/battlezoo-bestiary-pf2e/art/Subjects/yomhibdi.webp"}},"turnMarker":{"mode":1,"animation":null,"src":null,"disposition":false},"movementAction":null,"depth":1},"_stats":{"systemId":"pf2e","systemVersion":"6.1.0","coreVersion":"14.360","createdTime":1663517316718,"modifiedTime":1729379232708,"lastModifiedBy":"ZdvNMqfYMlbFrAL2","compendiumSource":"Compendium.battlezoo-bestiary-pf2e.pf2e-battlezoo-bestiary.Actor.AXysDBHGcCKSvPbV","duplicateSource":null,"exportSource":null}}