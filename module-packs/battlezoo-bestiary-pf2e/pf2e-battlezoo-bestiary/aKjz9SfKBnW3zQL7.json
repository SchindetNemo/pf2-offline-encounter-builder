itionitems.xYTAsEpcJE1Ccni3]{Slowed 1}; on a critical failure, it is @Compendium[pf2e.conditionitems.xYTAsEpcJE1Ccni3]{Slowed 2}</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["incapacitation","manipulate","sonic"],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":1},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"WEtfHIwPFHSdOWDu","name":"Draconic Frenzy","type":"action","img":"systems/pf2e/icons/actions/TwoActions.webp","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"gm":"","value":"<p>The sapphire drake makes one fangs Strike and two tail Strikes in any order.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":2},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"dP8odpIlicoJybVN","name":"Embershard Breath","type":"action","img":"systems/pf2e/icons/actions/TwoActions.webp","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"gm":"","value":"<p>The sapphire drake exhales flaming blue crystals that deal [[/r {4d6[fire],4d6[piercing]}]]{4d6 fire and 4d6 piercing damage} in a @Template[type:cone|distance:30] (@Check[type:reflex|dc:24|name:Embershard Breath DC|traits:damaging-effect,arcane,earth,evocation,fire|showDC:gm]{basic Reflex} save).</p>\n<p>The area becomes difficult terrain; the first time a creature enters an affected square each round, that creature takes [[/r {1d6[fire],1d6[piercing]}]]{1d6 fire and 1d6 piercing damage} (@Check[type:reflex|dc:24|name:Difficult Terrain Damage DC|traits:damaging-effect,arcane,earth,evocation,fire|showDC:gm]{basic Reflex} save).</p>\n<p>The sapphire drake can't use Embershard Breath again for [[/br 1d6 #rounds]]{1d6 rounds}.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["arcane","earth","fire"],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":2},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"LRdbSQ9UC8se4Spc","name":"Speed Surge","type":"action","img":"systems/pf2e/icons/actions/OneAction.webp","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"gm":"","value":"<p>The sapphire drake moves up to twice its Speed. It can do this three times per day.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["move"],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":1},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}}],"effects":[],"folder":null,"sort":0,"flags":{"pf2e":{"lootable":false},"core":{}},"system":{"attributes":{"hp":{"value":120,"temp":0,"max":120,"details":""},"ac":{"value":24,"details":"","base":24},"allSaves":{"value":""},"speed":{"value":20,"otherSpeeds":[{"type":"climb","label":"Climb","value":25},{"type":"fly","label":"Fly","value":50}],"details":""},"immunities":[{"type":"paralyzed"},{"type":"unconscious"}],"resistances":[{"type":"fire","value":5},{"type":"piercing","value":5},{"type":"slashing","value":5}]},"initiative":{"statistic":"perception"},"details":{"languages":{"value":["draconic"],"details":""},"level":{"value":7},"blurb":"","publicNotes":"<p>Sapphire drakes stalk mineral-rich caverns and volcanic islands all over the world, appearing in roughly the same locales as their namesake gemstones. With beautiful crystalline scales, broad blue wings, and ferocious tempers, sapphire drakes strike a surprising balance between beauty and brutality.</p>\n<p>Even more so than most drakes, sapphires are extremely covetous of treasures such as gold, jewels, and pieces of art. Unfortunately for many would- be treasure hunters, sapphire drakes are also extremely good at hiding their wealth. These greedy dragons tend to quietly lair in remote places far from humanoid settlements, such as sea caves on distant islands, the lowest levels of gem-encrusted caverns, or the outer rims of scorching, sacrifice-laden volcanoes.</p>\n<p>Sapphire drakes are also prone to enslaving smaller creatures, which they accomplish by playing on humanoids' predictable tendency toward greed. To acquire such servants, a sapphire drake will simply grant a humanoid supplicant a grandiose title, some chosen trinkets from its hoard, and command this new minion to dominate its fellows. While sapphire drakes are not particularly intelligent creatures, they understand their own weaknesses and value the knowledge and loyalty of their humanoid prizes. Sapphire drakes strongly detest falsehoods or illusions, and quickly eradicate any underlings they suspect of treachery.</p>\n<h2>Drakes of Avarice</h2>\n<p>According to popular legends, sapphire drakes were originally created by greedy pirate-wizards who attempted to cross- breed jungle drakes and flame drakes. Their hope was to create a subservient species of drake to protect the pirates' treasure hoards and gem-filled mine shafts. The resulting sapphire drakes proved more than up to the task, quickly eradicating their former masters and claiming the bounty for themselves.</p>\n<h2>Monster Part Subsystem</h2>\n<p><strong>Sapphire Drake Creature 7 </strong></p>\n<p><strong>Monster Parts</strong> 45/100/180 gp</p>\n<p><strong>Eligible Refinements</strong> weapons (bludgeoning, piercing), armor (light, medium, heavy), shield, perception item, skill items (Acrobatics, Athletics, Intimidation, Stealth)</p>\n<p><strong>Eligible Imbued Properties</strong> bane, constitution, energy resistant (fire, positive), evil, fire, sensory (darkvision, scent), sonic, strength, sturdy, wild, winged</p>","privateNotes":"","publication":{"title":"Battlezoo Bestiary","authors":"Darran Caldemeyer","license":"OGL","remaster":false},"creatureType":""},"resources":{},"_migration":{"version":0.932,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"abilities":{"str":{"mod":6},"dex":{"mod":3},"con":{"mod":5},"int":{"mod":-1},"wis":{"mod":2},"cha":{"mod":2}},"perception":{"details":"","mod":15,"senses":[{"type":"darkvision"},{"type":"scent","acuity":"imprecise","range":30}],"vision":true},"saves":{"fortitude":{"value":18,"saveDetail":""},"reflex":{"value":15,"saveDetail":""},"will":{"value":11,"saveDetail":""}},"skills":{"acrobatics":{"base":14},"athletics":{"base":17},"intimidation":{"base":17},"stealth":{"base":12}},"traits":{"value":["dragon","earth","evil"],"rarity":"common","size":{"value":"lg"}}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"prototypeToken":{"bar1":{"attribute":"attributes.hp"},"displayName":20,"displayBars":20,"flags":{"pf2e":{"linkToActorSize":true,"autoscale":false}},"height":2,"width":2,"disposition":-1,"name":"Sapphire Drake","actorLink":false,"lockRotation":false,"rotation":0,"alpha":1,"bar2":{"attribute":null},"randomImg":false,"light":{"alpha":0.25,"angle":360,"bright":0,"coloration":1,"dim":0,"luminosity":0.5,"saturation":0,"contrast":0,"shadows":0,"animation":{"speed":5,"intensity":5,"type":null,"reverse":false},"darkness":{"min":0,"max":1},"color":null,"attenuation":0.5,"negative":false,"priority":0},"texture":{"src":"modules/battlezoo-bestiary-pf2e/art/Tokens/sapphire_drake.webp","tint":"#ffffff","scaleX":2,"scaleY":2,"anchorX":0.5,"anchorY":0.5,"fit":"contain","alphaThreshold":0.75},"sight":{"angle":360,"enabled":false,"range":0,"brightness":1,"visionMode":"basic","color":null,"attenuation":0.1,"saturation":0,"contrast":0},"detectionModes":{},"appendNumber":false,"prependAdjective":false,"occludable":{"radius":0},"ring":{"enabled":true,"colors":{"ring":null,"background":null},"effects":1,"subject":{"scale":2,"texture":"modules/battlezoo-bestiary-pf2e/art/Subjects/sapphire_drake.webp"}},"turnMarker":{"mode":1,"animation":null,"src":null,"disposition":false},"movementAction":null,"depth":2},"_stats":{"systemId":"pf2e","systemVersion":"6.1.0","coreVersion":"14.360","createdTime":1663517316900,"modifiedTime":1729380162907,"lastModifiedBy":"ZdvNMqfYMlbFrAL2","compendiumSource":"Compendium.battlezoo-bestiary-pf2e.pf2e-battlezoo-bestiary.Actor.aKjz9SfKBnW3zQL7","duplicateSource":null,"exportSource":null}}