{"prepared":[],"value":0,"max":0},"slot4":{"prepared":[],"value":0,"max":0},"slot5":{"prepared":[],"value":0,"max":0},"slot6":{"prepared":[],"value":0,"max":0},"slot7":{"prepared":[],"value":0,"max":0},"slot8":{"prepared":[],"value":0,"max":0},"slot9":{"prepared":[],"value":0,"max":0},"slot10":{"prepared":[],"value":0,"max":0},"slot11":{"prepared":[],"value":0,"max":0}},"autoHeightenLevel":{"value":null},"showUnpreparedSpells":{"value":true},"displayLevels":{}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"e2rOo0WKhZcjJlBT","name":"Dimension Door","type":"spell","img":"systems/pf2e/icons/spells/dimension-door.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>Opening a door that bypasses normal space, you instantly transport yourself and any items you're wearing and holding from your current space to a clear space within range you can see. If this would bring another creature with you-even if you're carrying it in an extradimensional container-the spell is lost.</p>\n<hr />\n<p><strong>Heightened (5th)</strong> The range increases to 1 mile. You don't need to be able to see your destination, as long as you have been there in the past and know its relative location and distance from you. You are temporarily immune for 1 hour.</p>"},"rules":[],"slug":"dimension-door","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","manipulate","teleportation"],"rarity":"common","traditions":["arcane","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":4},"requirements":"","target":{"value":""},"range":{"value":"120 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"VnFgf73KYzHHNLAV","heightenedLevel":4},"counteraction":false,"heightening":{"levels":{"5":{"range":{"value":"1 mile"}}},"type":"fixed"}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.VlNcjmYyu95vOUe8","duplicateSource":null,"exportSource":null}},{"_id":"D4C2BXsvyNbkWhH7","name":"Fangs","type":"melee","img":"systems/pf2e/icons/default-icons/melee.svg","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"value":"","gm":""},"rules":[],"slug":null,"traits":{"value":["magical"],"otherTags":[]},"damageRolls":{"bxtk0ngofu93i5cfoy7z":{"damage":"2d10+8","damageType":"piercing","category":null}},"bonus":{"value":18},"attackEffects":{"value":["grab"]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"_migration":{"version":0.932,"previous":{"schema":null,"foundry":"12.328","system":"6.1.0"}}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"MoN73qCKMblRCzzT","name":"Claw","type":"melee","img":"systems/pf2e/icons/default-icons/melee.svg","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"value":"","gm":""},"rules":[],"slug":null,"traits":{"value":["agile","magical"],"otherTags":[]},"damageRolls":{"um3zwjkg3pc5bvkq4bax":{"damage":"2d8+8","damageType":"slashing","category":null}},"bonus":{"value":18},"attackEffects":{"value":[]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"_migration":{"version":0.932,"previous":{"schema":null,"foundry":"12.328","system":"6.1.0"}}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"58SpRNd3qrXIqxRn","name":"Grab","type":"action","img":"systems/pf2e/icons/actions/OneAction.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p><strong>Requirements</strong> The monster's last action was a success with a Strike that lists Grab in its damage entry, or it has a creature grabbed using this action.</p>\n<p><strong>Effect</strong> The monster automatically Grabs the target until the end of the monster's next turn. The creature is @Compendium[pf2e.conditionitems.kWc1fhmv9LBiTuei]{Grabbed} by whichever body part the monster attacked with, and that body part can't be used to Strike creatures until the grab is ended. Using Grab extends the duration of the monster's Grab until the end of its next turn for all creatures grabbed by it. A grabbed creature can use the @Compendium[pf2e.actionspf2e.SkZAQRkLLkmBQNB9]{Escape} action to get out of the grab, and the Grab ends for a grabbed creatures if the monster moves away from it.</p>"},"rules":[],"slug":"grab","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":1},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""},"weapon":{"value":""}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.bestiary-ability-glossary-srd.Item.Tkd8sH4pwFIPzqTr","duplicateSource":null,"exportSource":null}}],"effects":[],"folder":null,"sort":0,"flags":{"pf2e":{"lootable":false},"core":{}},"system":{"attributes":{"hp":{"value":110,"temp":0,"max":110,"details":""},"ac":{"value":25,"details":"","base":25},"allSaves":{"value":""},"speed":{"value":40,"otherSpeeds":[],"details":""}},"initiative":{"statistic":"perception"},"details":{"languages":{"value":["aklo"],"details":""},"level":{"value":7},"blurb":"","publicNotes":"<p>Known for their supernatural grace, vicious brutality, and shimmering silver-blue fur, phase tigers are dangerous magical predators who stalk the boundaries between the Ethereal and Material Planes.</p>\n<p>Many regard phase tigers as myth rather than fact, which is just fine for the planes-hopping hunters who make their fortunes on the pelts of these incredible animals. For their part, phase tigers have their own natural enemies, or, at least, their own favored prey. Chief among phase tigers' ancestral foes are blink dogs, whom phase tigers disdain both for their inherent \"goodness\" (which the tigers regard as weakness disguised as chivalry) and for their tendency to help other creatures in need. A phase tiger is happy to track down and tear apart an entire pack of blink dogs in any place and at any time, if only for the sheer sport of it.</p>\n<h2>Phase Tiger Pelts</h2>\n<p>Only the wealthiest aristocrats and the most skilled hunters should even dream of getting their hands on a phase tiger pelt. Phase tigers are as rare in the wilds as they are formidable in combat, to say nothing of their reputations for wanton cruelty and vileness. Even in cities where fur-collecting is seen as gauche or morally reprehensible, an exception is made for the skins of irredeemably evil phase tigers.</p>\n<h2>Monster Part Subsystem</h2>\n<p><strong>Phase Tiger Creature 7 </strong></p>\n<p><strong>Monster Parts</strong> 45/100/180 gp</p>\n<p><strong>Eligible Refinements</strong> weapons (piercing, slashing), armor (light, medium), perception item, skill items (Acrobatics, Athletics, Stealth)</p>\n<p><strong>Eligible Imbued Properties</strong> bane, chaotic, dexterity, energy resistant (positive), evil, sensory (darkvision, scent), spells (Occult: dimension door), strength, wild</p>","privateNotes":"","publication":{"title":"Battlezoo Bestiary","authors":"Aoife Ester","license":"OGL","remaster":false},"creatureType":""},"resources":{},"_migration":{"version":0.932,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"abilities":{"str":{"mod":5},"dex":{"mod":6},"con":{"mod":4},"int":{"mod":0},"wis":{"mod":4},"cha":{"mod":3}},"perception":{"details":"","mod":17,"senses":[{"type":"darkvision"},{"type":"scent","acuity":"imprecise","range":60}],"vision":true},"saves":{"fortitude":{"value":13,"saveDetail":""},"reflex":{"value":19,"saveDetail":""},"will":{"value":13,"saveDetail":""}},"skills":{"athletics":{"base":18},"stealth":{"base":17},"acrobatics":{"base":17}},"traits":{"value":["beast","chaotic","evil"],"rarity":"uncommon","size":{"value":"lg"}}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"prototypeToken":{"bar1":{"attribute":"attributes.hp"},"displayName":20,"displayBars":20,"flags":{"pf2e":{"linkToActorSize":true,"autoscale":false}},"height":2,"width":2,"disposition":-1,"name":"Phase Tiger","actorLink":false,"lockRotation":false,"rotation":0,"alpha":1,"bar2":{"attribute":null},"randomImg":false,"light":{"alpha":0.25,"angle":360,"bright":0,"coloration":1,"dim":0,"luminosity":0.5,"saturation":0,"contrast":0,"shadows":0,"animation":{"speed":5,"intensity":5,"type":null,"reverse":false},"darkness":{"min":0,"max":1},"attenuation":0.5,"color":null,"negative":false,"priority":0},"texture":{"src":"modules/battlezoo-bestiary-pf2e/art/Tokens/phase_tiger.webp","scaleX":2,"scaleY":2,"tint":"#ffffff","anchorX":0.5,"anchorY":0.5,"fit":"contain","alphaThreshold":0.75},"sight":{"angle":360,"enabled":false,"range":0,"brightness":1,"visionMode":"basic","color":null,"attenuation":0.1,"saturation":0,"contrast":0},"detectionModes":{},"appendN