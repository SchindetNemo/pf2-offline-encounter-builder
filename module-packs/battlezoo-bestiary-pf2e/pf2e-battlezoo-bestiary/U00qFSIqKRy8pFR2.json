e":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"cubR2kctrEp6vIzN","name":"Bind Undead","type":"spell","img":"systems/pf2e/icons/spells/bind-undead.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>With a word of necromantic power, you seize control of the target. It gains the minion trait. If you or an ally uses any hostile actions against the target, the spell ends.</p>"},"rules":[],"slug":"bind-undead","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","manipulate"],"rarity":"common","traditions":["arcane","divine","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":3},"requirements":"","target":{"value":"1 mindless undead creature with a level no greater than bind undead's spell level"},"range":{"value":"30 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"1 day","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"OoKBLoew9YVU9kFQ","heightenedLevel":4},"counteraction":false},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.GUeRTriJkMlMlVrk","duplicateSource":null,"exportSource":null}},{"_id":"3RHI065Y2bhLJkG7","name":"Animate Dead","type":"spell","img":"systems/pf2e/icons/spells/animate-dead.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>Your magic dredges up a corpse or skeleton and fills it with necromantic life, and you force the dead to fight at your command. You summon a common creature that has the undead trait and whose level is -1; this creature gains the summoned trait. Heightening the spell increases the maximum level of creature you can summon.</p>\n<hr />\n<p><strong>Heightened (2nd)</strong> Level 1.</p>\n<p><strong>Heightened (3rd)</strong> Level 2.</p>\n<p><strong>Heightened (4th)</strong> Level 3.</p>\n<p><strong>Heightened (5th)</strong> Level 5.</p>\n<p><strong>Heightened (6th)</strong> Level 7.</p>\n<p><strong>Heightened (7th)</strong> Level 9.</p>\n<p><strong>Heightened (8th)</strong> Level 11.</p>\n<p><strong>Heightened (9th)</strong> Level 13.</p>\n<p><strong>Heightened (10th)</strong> Level 15.</p>"},"rules":[],"slug":"animate-dead","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","manipulate"],"rarity":"common","traditions":["arcane","divine","occult"]},"publication":{"title":"Pathfinder Advanced Player's Guide","authors":"","license":"OGL","remaster":false},"level":{"value":1},"requirements":"","target":{"value":""},"range":{"value":"30 feet"},"area":null,"time":{"value":"3"},"duration":{"value":"1 minute","sustained":true},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"OoKBLoew9YVU9kFQ","heightenedLevel":3,"uses":{"max":3,"value":3}},"counteraction":false},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.9WGeBwIIbbUuWKq0","duplicateSource":null,"exportSource":null}},{"_id":"oqtAzThNLUQPVtMD","name":"Circle of Protection (Good)","type":"spell","img":"systems/pf2e/icons/spells/circle-of-protection.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>You ward a creature and those nearby against a specified alignment. Choose chaotic, evil, good, or lawful; this spell gains the opposing trait. Creatures in the area gain a +1 status bonus to AC against attacks by creatures of the chosen alignment and to saves against effects from such creatures. This bonus increases to +3 against effects from such creatures that directly control the target and attacks made by summoned creatures of the chosen alignment. Summoned creatures of the chosen alignment can't willingly enter the area without succeeding at a Will save; repeated attempts use the first save result.</p>\n<hr />\n<p><strong>Heightened (4th)</strong> The duration increases to 1 hour.</p>"},"rules":[],"slug":"circle-of-protection","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","manipulate"],"rarity":"uncommon","traditions":["divine","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":3},"requirements":"","target":{"value":""},"range":{"value":"touch"},"area":{"value":10,"type":"emanation","details":"10-foot emanation centered on the touched creature"},"time":{"value":"3"},"duration":{"value":"1 minute","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"OoKBLoew9YVU9kFQ","heightenedLevel":3},"counteraction":false},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.mpGCMTldMVa0pWYs","duplicateSource":null,"exportSource":null}},{"_id":"6bgaiF8jXqVTt5Av","name":"Harm","type":"spell","img":"systems/pf2e/icons/spells/harm.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>You channel negative energy to harm the living or heal the undead. If the target is a living creature, you deal 1d8 negative damage to it, and it gets a basic Fortitude save. If the target is a willing undead creature, you restore that amount of Hit Points. The number of actions you spend when Casting this Spell determines its targets, range, area, and other parameters.</p>\n<p><span class=\"pf2-icon\">1</span> <strong>(somatic)</strong> The spell has a range of touch.</p>\n<p><span class=\"pf2-icon\">2</span> <strong>(verbal, somatic)</strong> The spell has a range of 30 feet. If you're healing an undead creature, increase the Hit Points restored by 8.</p>\n<p><span class=\"pf2-icon\">3</span> <strong>(material, verbal, somatic)</strong> You disperse negative energy in a 30-foot emanation. This targets all living and undead creatures in the area.</p>\n<hr />\n<p><strong>Heightened (+1)</strong> The amount of healing or damage increases by 1d8, and the extra healing for the 2-action version increases by 8.</p>"},"rules":[],"slug":"harm","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["manipulate","void"],"rarity":"common","traditions":["divine"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":1},"requirements":"","target":{"value":"1 living creature or 1 willing undead creature"},"range":{"value":"varies"},"area":{"value":30,"type":"emanation","details":"varies"},"time":{"value":"1 to 3"},"duration":{"value":"","sustained":false},"damage":{"0":{"applyMod":false,"formula":"1d8","type":"void","category":null,"materials":[],"kinds":["damage","healing"]}},"defense":{"passive":null,"save":{"statistic":"fortitude","basic":true}},"cost":{"value":""},"location":{"value":"OoKBLoew9YVU9kFQ","heightenedLevel":4,"uses":{"max":2,"value":2}},"counteraction":false,"heightening":{"damage":{"0":"1d8"},"interval":1,"type":"interval"},"overlays":{"4gyp3qlsv5ywdyjq":{"_id":"4gyp3qlsv5ywdyjq","name":"Harm (vs. Undead)","overlayType":"override","sort":3,"system":{"area":{"areaType":"","value":""},"damage":{"0":{"applyMod":true,"formula":"1d8+8","kinds":["healing"]}},"heightening":{"damage":{"0":"1d8+8"}},"range":{"value":"30 feet"},"target":{"value":"1 willing undead creature"},"time":{"value":"2"},"traits":{"value":["concentrate","manipulate","void"]},"defense":null}},"pq7cxntbz4s8g5ik":{"_id":"pq7cxntbz4s8g5ik","overlayType":"override","sort":1,"system":{"area":{"areaType":"","value":""},"range":{"value":"touch"},"time":{"value":"1"}}},"rvhoa43rqqqp8izn":{"_id":"rvhoa43rqqqp8izn","overlayType":"override","sort":4,"system":{"range":{"value":""},"target":{"value":"all living and undead creatures"},"time":{"value":"3"},"traits":{"value":["concentrate","manipulate","void"]}}},"z04svm1cvfcxtplb":{"_id":"z04svm1cvfcxtplb","name":"Harm (vs. Living)","overlayType":"override","sort":2,"system":{"area":{"areaType":"","value":""},"range":{"value":"30 feet"},"target":{"value":"1 living creature"},"time":{"value":"2"},"traits":{"value":["concentrate","manipulate","void"]},"damage":{"0":{"kinds":["damage"]}}}}}},"ownership":{"default":0,"qA45GVv5hySaf9b5":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.wdA52JJnsuQWeyqz","duplicateSource":null,"exportSource":null}}],"effects":[],"folder":null,"sort":0,"flags":{"pf2e":{"lootable":false},"core":{}},"system":{"attributes":{"hp":{"value":190,"temp":0,"max":190,"details":"negative healing"},"ac":{"value":26,"details":"","base":26},"allSaves":{"value":""},"speed":{"value":35,"otherSpeeds":[],"details":""},"immunities":[{"type":"death-effects"},{"type":"disease"},{"type":"mental"},{"type":"paralyzed"},{"type":"poison"},{"type":"unconscious"}],"weaknesses":[{"type":"vitality","value":10}]},"initiative":{"statistic":"perception"},"details":{"languages":{"value":["chthonian","common","necril"],"details":""},"level":{"value":8},"blurb":"","publicNotes":"<p>Slaughs are towering undead abominations who lead powerful armies of skeletons, ghouls, and other unliving horrors. Clad only in simple rags and wielding a fearsome skull-bedecked scythe, the slaugh strikes an imposing image whether at the forefront of a zombie militia or amid the center of a bloodthirsty vampire mob.</p>\n<p>A troop led by a slaugh is a troop to be feared. Although they are not necessarily tactical masterminds, slaughs can push their units to their physical limits using profane powers to inspire and intimidate in equal measure. That said, slaughs are never content to sit on the sidelines while their minions do the fun work of slaughtering enemies. Slaughs wade into the battlefield with glee, setting a prime example for their underlings in the ways of war and brutality.</p>\n<p>Slaughs arise not from a single restless soul but from many. In order to create a slaugh, a necromancer must collect a retinue of formidable souls, each from a different army, militia, or war party—only the strongest and most imposing warriors will do. Then, a single hulking corpse is used to bind these souls into one being. Each of the dozens of magical runes etched upon a slaugh's body represent a separate soul bound to the monster. A slaugh can tap into the power of its constituent souls to either release waves of potent necromantic energy or funnel incredible power into its devastating strikes.</p>\n<h2>Traitorous Commanders</h2>\n<p>Though the methods for creating slaughs are well known to lich kings and vampire overlords alike, few necromancers dare to raise such beings for their necrotic armies because slaughs have an outsized reputation for treachery and betrayal. Perhaps this trait shouldn't come as a surprise, considering the combative nature of the numerous souls that compose a slaugh. At any rate, the fact remains that even the most loyal-seeming slaugh can be trusted for only so long.</p>\n<h2>Monster Part Subsystem</h2>\n<p><strong>Slaugh Creature 8 </strong></p>\n<p><strong>Monster Parts</strong> 64/140/250 gp</p>\n<p><strong>Eligible Refinements</strong> weapons (bludgeoning), armor (medium, heavy), perception item, skill items (Athletics, Intimidation, Lore [Warfare], Religion)</p>\n<p><strong>Eligible Imbued Properties</strong> charisma, energy resistant (negative), evil, negative, sensory (darkvision), spells (Divine: animate dead, bind undead, harm,circle of protection), strength, wild, wisdom</p>","privateNotes":"","publication":{"title":"Battlezoo Bestiary","authors":"Jason Daugherty","license":"OGL","remaster":false},"creatureType":""},"resources":{},"_migration":{"version":0.932,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"abilities":{"str":{"mod":6},"dex":{"mod":1},"con":{"mod":0},"int":{"mod":2},"wis":{"mod":4},"cha":{"mod":6}},"perception":{"details":"","mod":17,"senses":[{"type":"darkvision"}],"vision":true},"saves":{"fortitude":{"value":16,"saveDetail":""},"reflex":{"value":11,"saveDetail":""},"will":{"value":19,"saveDetail":""}},"skills":{"athletics":{"base":20},"intimidation":{"base":18},"religion":{"base":14}},"traits":{"value":["evil","undead","unholy"],"rarity":"uncommon","size":{"value":"lg"}},"customModifiers":{}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"prototypeToken":{"bar1":{"attribute":"attributes.hp"},"displayName":20,"displayBars":20,"flags":{"pf2e":{"linkToActorSize":true,"autoscale":false}},"height":2,"width":2,"disposition":-1,"name":"Slaugh","actorLink":false,"lockRotation":false,"rotation":0,"alpha":1,"bar2":{"attribute":null},"randomImg":false,"light":{"alpha":0.25,"angle":360,"bright":0,"coloration":1,"dim":0,"luminosity":0.5,"saturation":0,"contrast":0,"shadows":0,"animation":{"speed":5,"intensity":5,"type":null,"reverse":false},"darkness":{"min":0,"max":1},"color":null,"attenuation":0.5,"negative":false,"priority":0},"texture":{"src":"modules/battlezoo-bestiary-pf2e/art/Tokens/slaugh.webp","tint":"#ffffff","scaleX":2,"scaleY":2,"anchorX":0.5,"anchorY":0.5,"fit":"contain","alphaThreshold":0.75},"sight":{"angle":360,"enabled":false,"range":0,"brightness":1,"visionMode":"basic",