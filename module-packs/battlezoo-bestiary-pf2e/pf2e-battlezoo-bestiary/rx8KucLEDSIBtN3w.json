dzGKt2ARwQJu","name":"Dominate","type":"spell","img":"systems/pf2e/icons/spells/dominate.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>You take command of the target, forcing it to obey your orders. If you issue an obviously self-destructive order, the target doesn't act until you issue a new order. The effect depends on its Will save.</p>\n<hr />\n<p><strong>Critical Success</strong> The target is unaffected.</p>\n<p><strong>Success</strong> The target is @Compendium[pf2e.conditionitems.dfCMdR4wnpbYNTix]{Stunned 1} as it fights off your commands.</p>\n<p><strong>Failure</strong> You control the target. It gains the @Compendium[pf2e.conditionitems.9qGBRpbX9NEwtAAr]{Controlled} condition, but it can attempt a Will save at the end of each of its turns. On a success, the spell ends.</p>\n<p><strong>Critical Failure</strong> As a failure, but the target receives a new save only if you give it a new order that is against its nature, such as killing its allies.</p>\n<hr />\n<p><strong>Heightened (10th)</strong> The duration is unlimited.</p>"},"rules":[],"slug":"dominate","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","incapacitation","manipulate","mental"],"rarity":"uncommon","traditions":["arcane","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":6},"requirements":"","target":{"value":"1 creature"},"range":{"value":"30 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"until the next time you make your daily preparations","sustained":false},"damage":{},"defense":{"passive":null,"save":{"statistic":"will","basic":false}},"cost":{"value":""},"location":{"value":"xxb0vyf8PG8B5Uvd","heightenedLevel":6},"counteraction":false},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.OsOhx3TGIZ7AhD0P","duplicateSource":null,"exportSource":null}},{"_id":"UFu9Zfupud9hKs07","name":"Dimension Door","type":"spell","img":"systems/pf2e/icons/spells/dimension-door.webp","effects":[],"folder":null,"sort":-100000,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>Opening a door that bypasses normal space, you instantly transport yourself and any items you're wearing and holding from your current space to a clear space within range you can see. If this would bring another creature with you-even if you're carrying it in an extradimensional container-the spell is lost.</p>\n<hr />\n<p><strong>Heightened (5th)</strong> The range increases to 1 mile. You don't need to be able to see your destination, as long as you have been there in the past and know its relative location and distance from you. You are temporarily immune for 1 hour.</p>"},"rules":[],"slug":"dimension-door","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","manipulate","teleportation"],"rarity":"common","traditions":["arcane","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":4},"requirements":"","target":{"value":""},"range":{"value":"120 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"xxb0vyf8PG8B5Uvd","heightenedLevel":5},"counteraction":false,"heightening":{"levels":{"5":{"range":{"value":"1 mile"}}},"type":"fixed"}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.VlNcjmYyu95vOUe8","duplicateSource":null,"exportSource":null}},{"_id":"henwgEDMiGaqWCPk","name":"Mind Probe (At Will)","type":"spell","img":"systems/pf2e/icons/spells/mind-probe.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>You cast your thoughts through a creature's mind, sifting for information. You access the target's memories and knowledge unless it fends you off with a Will save.</p>\n<hr /><strong>Success</strong> The target is unaffected.\n<p><strong>Failure</strong> Each round of the spell's duration, you can Sustain the Spell to ask a different question and attempt to uncover the answer. For each question, the target can attempt a Deception check against your spell DC; if the target succeeds, you don't learn the answer, and on a critical success, the target gives you a false answer that you believe is truthful Once you've asked the target a given question, asking it again, even with a separate casting of mind probe, produces the same result.</p>\n<p><strong>Critical Failure</strong> As failure, and the target takes a -4 circumstance penalty to Deception checks against your questions.</p>"},"rules":[],"slug":"mind-probe","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","linguistic","manipulate","mental"],"rarity":"uncommon","traditions":["arcane","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":5},"requirements":"","target":{"value":"1 creature"},"range":{"value":"30 feet"},"area":null,"time":{"value":"1 minute"},"duration":{"value":"1 minute","sustained":true},"damage":{},"defense":{"passive":null,"save":{"statistic":"will","basic":false}},"cost":{"value":""},"location":{"value":"xxb0vyf8PG8B5Uvd","heightenedLevel":5},"counteraction":false,"heightening":{"type":"interval","interval":1,"damage":{}}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.9BnhadUO8FMLmeZ3","duplicateSource":null,"exportSource":null}},{"_id":"tryw9QapKIi7SxJx","name":"Confusion","type":"spell","img":"systems/pf2e/icons/spells/confusion.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>You befuddle your target with strange impulses, causing it to act randomly. The effects are determined by the target's Will save. You can Dismiss the spell.</p>\n<hr />\n<p><strong>Critical Success</strong> The target is unaffected.</p>\n<p><strong>Success</strong> The target babbles incoherently and is @Compendium[pf2e.conditionitems.dfCMdR4wnpbYNTix]{Stunned 1}.</p>\n<p><strong>Failure</strong> The target is @Compendium[pf2e.conditionitems.yblD8fOR1J8rDwEQ]{Confused} for 1 minute. It can attempt a new save at the end of each of its turns to end the confusion.</p>\n<p><strong>Critical Failure</strong> The target is Confused for 1 minute, with no save to end early.</p>\n<hr />\n<p><strong>Heightened (8th)</strong> You can target up to 10 creatures.</p>"},"rules":[],"slug":"confusion","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","emotion","manipulate","mental"],"rarity":"common","traditions":["arcane","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":4},"requirements":"","target":{"value":"1 creature"},"range":{"value":"30 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"1 minute","sustained":false},"damage":{},"defense":{"passive":null,"save":{"statistic":"will","basic":false}},"cost":{"value":""},"location":{"value":"xxb0vyf8PG8B5Uvd","heightenedLevel":4},"counteraction":false,"heightening":{"levels":{"8":{"target":{"value":"10 creatures"}}},"type":"fixed"}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.LiGbewa9pO0yjbsY","duplicateSource":null,"exportSource":null}},{"_id":"AHowe1hTh0T45SDB","name":"Dimension Door (At Will)","type":"spell","img":"systems/pf2e/icons/spells/dimension-door.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>Opening a door that bypasses normal space, you instantly transport yourself and any items you're wearing and holding from your current space to a clear space within range you can see. If this would bring another creature with you-even if you're carrying it in an extradimensional container-the spell is lost.</p>\n<hr />\n<p><strong>Heightened (5th)</strong> The range increases to 1 mile. You don't need to be able to see your destination, as long as you have been there in the past and know its relative location and distance from you. You are temporarily immune for 1 hour.</p>"},"rules":[],"slug":"dimension-door","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","manipulate","teleportation"],"rarity":"common","traditions":["arcane","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":4},"requirements":"","target":{"value":""},"range":{"value":"120 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"xxb0vyf8PG8B5Uvd","heightenedLevel":4},"counteraction":false,"heightening":{"levels":{"5":{"range":{"value":"1 mile"}}},"type":"fixed"}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.VlNcjmYyu95vOUe8","duplicateSource":null,"exportSource":null}},{"_id":"1sPZziQxzEF6Z9yy","name":"Discern Lies","type":"spell","img":"systems/pf2e/icons/spells/discern-lies.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>Falsehoods ring in your ears like discordant notes. You gain a +4 status bonus to Perception checks when someone Lies.</p>"},"rules":[],"slug":"discern-lies","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","manipulate","mental","revelation"],"rarity":"uncommon","traditions":["arcane","divine","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":4},"requirements":"","target":{"value":""},"range":{"value":""},"area":null,"time":{"value":"2"},"duration":{"value":"10 minutes","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"xxb0vyf8PG8B5Uvd","heightenedLevel":4},"counteraction":false},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.uNsliWpl8Q1JdFcM","duplicateSource":null,"exportSource":null}},{"_id":"BgeilN922Pz8kbun","name":"Suggestion","type":"spell","img":"systems/pf2e/icons/spells/suggestion.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>Your honeyed words are difficult for creatures to resist. You suggest a course of action to the target, which must be phrased in such a way as to seem like a logical course of action to the target and can't be self-destructive or obviously against the target's self-interest. The target must attempt a Will save.</p>\n<hr /><strong>Critical Success</strong> The target is unaffected and knows you tried to control it.\n<p><strong>Success</strong> The target is unaffected and thinks you were talking to them normally, not casting a spell on them.</p>\n<p><strong>Failure</strong> The target immediately follows your suggestion. The spell has a duration of 1 minute, or until the target has completed a finite suggestion or the suggestion becomes self-destructive or has other obvious negative effects.</p>\n<p><strong>Critical Failure</strong> As failure, but the base duration is 1 hour.</p>\n<hr /><strong>Heightened (8th)</strong> You can target up to 10 creatures."},"rules":[],"slug":"suggestion","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","incapacitation","linguistic","manipulate","mental"],"rarity":"common","traditions":["arcane","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":4},"requirements":"","target":{"value":"1 creature"},"range":{"value":"30 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"varies","sustained":false},"damage":{},"defense":{"passive":null,"save":{"statistic":"will","basic":false}},"cost":{"value":""},"location":{"value":"xxb0vyf8PG8B5Uvd","heightenedLevel":4},"counteraction":false,"heightening":{"levels":{"8":{"target":{"value":"10 creatures"}}},"type":"fixed"}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.qwlh6aDgi86U3Q7H","duplicateSource":null,"exportSource":null}},{"_id":"tFR16vc7EZyKYn4f","name":"Crisis of Faith","type":"spell","img":"systems/pf2e/icons/spells/crisis-of-faith.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>You assault the target's faith, riddling the creature with doubt and mental turmoil that deal 6d6 mental damage, or 6d8 mental damage if it can cast divine spells. The effects are determined by its Will save.</p>\n<p>To many deities, casting this spell on a follower of your own deity without significant cause is anathema.</p>\n<hr />\n<p><strong>Critical Success</strong> The target is unaffected.</p>\n<p><strong>Success</strong> The target takes half damage.</p>\n<p><strong>Failure</strong> The target takes full damage; if the target can cast divine spells, it's @Compendium[pf2e.conditionitems.e1XGnhKNSQIm5IXg]{Stupefied 1} for 1 round.</p>\n<p><strong>Critical Failure</strong> The target takes double damage, is @Compendium[pf2e.conditionitems.e1XGnhKNSQIm5IXg]{Stupefied 1} for 1 round, and can't cast divine spells for 1 round.</p>\n<hr />\n<p><strong>Heightened (+1)</strong> The damage increases by 2d6 (or by 2d8 if the target is a divine spellcaster).</p>"},"rules":[],"slug":"crisis-of-faith","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","manipulate","mental"],"rarity":"common","traditions":["divine"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":3},"requirements":"","target":{"value":"1 creature"},"range":{"value":"30 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"","sustained":false},"damage":{"0":{"formula":"6d6","type":"mental","category":null,"materials":[],"kinds":["damage"]}},"defense":{"passive":null,"save":{"statistic":"will","basic":false}},"cost":{"value":""},"location":{"value":"xxb0vyf8PG8B5Uvd","heightenedLevel":3},"counteraction":false,"heightening":{"type":"interval","interval":1,"damage":{"0":"2d6"}}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.3x6eUCm17n6ROzUa","duplicateSource":null,"exportSource":null}},{"_id":"hEGbwm9XLn8ANMdv","name":"Mind Reading","type":"spell","img":"systems/pf2e/icons/spells/mind-reading.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>With a cursory mental touch, you attempt to read the target's mind. It must attempt a Will save. The target then becomes temporarily immune to your mind reading for 1 hour.</p>\n<hr /><strong>Critical Success</strong> The target perceives vague surface thoughts from you when you Cast the Spell.\n<p><strong>Success</strong> You find out whether the target's Intelligence modifier is higher than, equal to, or lower than yours.</p>\n<p><strong>Failure</strong> You perceive vague surface thoughts from the target when you Cast the Spell, and you find out whether its Intelligence modifier is higher than, equal to, or lower than yours.</p>\n<p><strong>Critical Failure</strong> As failure, and for the duration of the spell, you can Sustain the Spell to detect the target's surface thoughts again. The target doesn't receive any additional saves.</p>"},"rules":[],"slug":"mind-reading","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","detection","manipulate","mental"],"rarity":"uncommon","traditions":["arcane","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":3},"requirements":"","target":{"value":"1 creature"},"range":{"value":"30 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"1 round or sustained up to 1 minute","sustained":true},"damage":{},"defense":{"passive":null,"save":{"statistic":"will","basic":false}},"cost":{"value":""},"location":{"value":"xxb0vyf8PG8B5Uvd","heightenedLevel":3},"counteraction":false},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.KHnhPHL4x1AQHfbC","duplicateSource":null,"exportSource":null}},{"_id":"NBtGzKiYoekPckev","name":"Blur","type":"spell","img":"systems/pf2e/icons/spells/blur.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>The target's form appears blurry. It becomes @Compendium[pf2e.conditionitems.DmAIPqOBomZ7H95W]{Concealed}. As the nature of this effect still leaves the target's location obvious, the target can't use this concealment to Hide or Sneak.</p>"},"rules":[],"slug":"blur","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","illusion","manipulate","visual"],"rarity":"common","traditions":["arcane","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":2},"requirements":"","target":{"value":"1 creature"},"range":{"value":"touch"},"area":null,"time":{"value":"2"},"duration":{"value":"1 minute","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"xxb0vyf8PG8B5Uvd","heightenedLevel":2},"counteraction":false},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.3JG1t3T4mWn6vTke","duplicateSource":null,"exportSource":null}},{"_id":"UjXdk6z4Yys7ODjS","name":"Dispel Magic","type":"spell","img":"systems/pf2e/icons/spells/dispel-magic.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>You unravel the magic behind a spell or effect. Attempt a counteract check against the target. If you successfully counteract a magic item, the item becomes a mundane item of its type for 10 minutes. This doesn't change the item's non-magical properties. If the target is an artifact or similar item, you automatically fail.</p>"},"rules":[],"slug":"dispel-magic","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","manipulate"],"rarity":"common","traditions":["arcane","divine","occult","primal"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":2},"requirements":"","target":{"value":"1 spell effect or unattended magic item"},"range":{"value":"120 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"xxb0vyf8PG8B5Uvd","heightenedLevel":2},"counteraction":true},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.9HpwDN4MYQJnW0LG","duplicateSource":null,"exportSource":null}},{"_id":"JBRe2BhfZSbqDajv","name":"Bane","type":"spell","img":"systems/pf2e/icons/spells/bane.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>You fill the minds of your enemies with doubt.</p>\n<p>Enemies in the area must succeed at a Will save or take a -1 status penalty to attack rolls as long as they are in the area.</p>\n<p>Once per turn, starting the turn after you cast bane, you can use a single action, which has the concentrate trait, to increase the emanation's radius by 5 feet and force enemies in the area that weren't yet affected to attempt another saving throw.</p>\n<p>Bane can counteract bless.</p>\n<p>@Compendium[pf2e.spell-effects.UTLp7omqsiC36bso]{Spell Effect: Bane}</p>"},"rules":[],"slug":"bane","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","manipulate","mental"],"rarity":"common","traditions":["divine","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":1},"requirements":"","target":{"value":"enemies in the area"},"range":{"value":""},"area":{"value":5,"type":"emanation"},"time":{"value":"2"},"duration":{"value":"1 minute","sustained":false},"damage":{},"defense":{"passive":null,"save":{"statistic":"will","basic":false}},"cost":{"value":""},"location":{"value":"xxb0vyf8PG8B5Uvd","heightenedLevel":1},"counteraction":true},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.7ZinJNzxq0XF0oMx","duplicateSource":null,"exportSource":null}},{"_id":"1Z9IvDN5leHqs6jZ","name":"Command (At Will)","type":"spell","img":"systems/pf2e/icons/spells/command.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>You shout a command that's hard to ignore. You can command the target to approach you, run away (as if it had the @Compendium[pf2e.conditionitems.sDPxOjQ9kx2RZE8D]{Fleeing} condition), release what it's holding, drop @Compendium[pf2e.conditionitems.j91X7x0XSomq8d60]{Prone}, or stand in place. It can't Delay or take any reactions until it has obeyed your command. The effects depend on the target's Will save.</p>\n<hr /><strong>Success</strong> The creature is unaffected.\n<p><strong>Failure</strong> For the first action on its next turn, the creature must use a single action to do as you command.</p>\n<p><strong>Critical Failure</strong> The target must use all its actions on its next turn to obey your command.</p>\n<hr /><strong>Heightened (5th)</strong> You can target up to 10 creatures."},"rules":[],"slug":"command","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["auditory","concentrate","linguistic","manipulate","mental"],"rarity":"common","traditions":["arcane","divine","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":1},"requirements":"","target":{"value":"1 creature"},"range":{"value":"30 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"until the end of the target's next turn","sustained":false},"damage":{},"defense":{"passive":null,"save":{"statistic":"will","basic":false}},"cost":{"value":""},"location":{"value":"xxb0vyf8PG8B5Uvd","heightenedLevel":1},"counteraction":false,"heightening":{"levels":{"5":{"target":{"value":"10 creatures"}}},"type":"fixed"}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.aIHY2DArKFweIrpf","duplicateSource":null,"exportSource":null}},{"_id":"3MOeRHED8VxFLHfc","name":"Tongues (Constant)","type":"spell","img":"systems/pf2e/icons/spells/tongues.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>The target can understand all words regardless of language and also speak the languages of other creatures. When in a mixed group of creatures, each time the target speaks, it can choose a creature and speak in a language that creature understands, even if the target doesn't know what language that is.</p>\n<hr />\n<p><strong>Heightened (7th)</strong> The duration is 8 hours.</p>"},"rules":[],"slug":"tongues","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","manipulate"],"rarity":"uncommon","traditions":["arcane","divine","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":5},"requirements":"","target":{"value":"1 creature"},"range":{"value":"touch"},"area":null,"time":{"value":"2"},"duration":{"value":"1 hour","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"xxb0vyf8PG8B5Uvd","heightenedLevel":5},"counteraction":false,"heightening":{"type":"interval","interval":1,"damage":{}}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.SwUiVavHKMWG7t5K","duplicateSource":null,"exportSource":null}},{"_id":"2IrQtLPgSQcbqkTp","name":"Accursed Coronation","type":"action","img":"systems/pf2e/icons/actions/Passive.webp","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"gm":"","value":"<p>The coromn chooses a crown it can see of wearable condition and possesses it. While possessing a crown, the coromn is @Compendium[pf2e.conditionitems.zJxUflt9np0q4yML]{Invisible}, intangible, and resides within the material of the object itself. Any humanoid that wears or holds the crown hears the devil's telepathic whispers and suggestions. Upon first touching the crown, a creature must attempt a @Check[type:will|dc:24|name:Accursed Coronation DC|traits:divine, manipulate, transmutation|showDC:gm]{Will} save.</p>\n<hr />\n<p><strong>Critical Success</strong> The creature resists the crown's suggestions and realizes it is being influenced by the crown.</p>\n<p><strong>Success</strong> The creature resists the crown's suggestions, but it isn't aware that it is being influenced by the crown.</p>\n<p><strong>Failure</strong> The creature dons the crown, succumbs to its influence, and does as it says. Each subsequent day a creature is in contact with the possessed crown, the wearer must make another Will save; the save's DC increases by 1 for each consecutive day the creature has touched the crown (to a maximum DC 34 after 10 days).</p>\n<p>The coromn acts on its own initiative, giving orders and suggestions to the wearer of the crown as a free action. It cannot Strike while possessing a crown, but it can use its other spells and abilities. If the crown is destroyed, the coromn appears in the nearest empty space.</p>\n"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["divine","manipulate"],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"offensive","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"zffDOcrtRpaLjNEQ","name":"Delegate","type":"action","img":"systems/pf2e/icons/actions/ThreeActions.webp","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"gm":"","value":"<p>The crown devil commands minions to do its bidding. The crown devil targets up to two allies within 60 feet. The allies can immediately perform up to a total of 3 actions (either one ally gains 2 actions and the other gains 1, or one ally gains all 3 actions), even if they have already acted this turn. These actions must be either Strike or Stride.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["divine","linguistic"],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":3},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}}],"effects":[],"folder":null,"sort":0,"flags":{"pf2e":{"lootable":false},"core":{}},"system":{"attributes":{"hp":{"value":75,"temp":0,"max":75,"details":""},"ac":{"value":21,"details":"","base":21},"allSaves":{"value":"+1 status to all saves vs. magic"},"speed":{"value":25,"otherSpeeds":[],"details":""},"immunities":[{"type":"fire"}],"weaknesses":[{"type":"holy","value":5}],"resistances":[{"type":"physical","value":5,"exceptions":["silver"]},{"type":"poison","value":5}]},"initiative":{"statistic":"perception"},"details":{"languages":{"value":["common","diabolic","empyrean"],"details":"telepathy 100 feet, tongues"},"level":{"value":6},"blurb":"","publicNotes":"<p>Coromns, also known as crown devils, rarely busy themselves with the machinations of Hell. Instead, these duplicitous fiends spend the majority of their time spreading corruption and dissent in the lands of mortals. Though in their natural form they are not as physically imposing or intimidating as many of their infernal kin, coromns wield the power to destroy entire nations thanks to their silver tongues. Their true power is not physical, but the ability to manipulate the malleable minds and easily bent morals of their mortal targets.</p>\n<p>A coromn achieves its foul agenda by appearing as a beautiful crown, diadem, or other royal finery before an unsuspecting ruler. Upon donning the fiendish finery, this powerful sovereign-who may well have been a just and beneficent governer-becomes a puppet dictator subject to the crown devil's every whim. A crown devil's whispers can turn even the kindest of kings into hellish tyrants.</p>\n<p>Perched atop the head of a brainwashed king, empress, or warlord, the full extent of a coromn's depredations is limited only by its own ambitions and the potential power of its pawn's post. Under a crown devil's command, a ruler might alter the destiny of an entire dynasty, country, or continent.</p>\n<h2>Devil of Many Forms</h2>\n<p>Crown devils can inhabit virtually any type of headdress or formal headwear that denotes a status of royalty or authority. Some coromns have even been known to inhabit other royal garments such as royal rings, mantles, or scepters.</p>\n<h2>Monster Part Subsystem</h2>\n<p><strong>Coromn (Crown Devil) Creature 6 </strong></p>\n<p><strong>Monster Parts</strong> 30/65/125 gp</p>\n<p><strong>Eligible Refinements</strong> weapons (slashing), armor (light, medium), shield, perception item, skill items (Arcana, Deception, Diplomacy, Intimidation, Religion, Society)</p>\n<p><strong>Eligible Imbued Properties</strong> bane, charisma, dexterity, energy resistant (fire, positive), evil, lawful, mental, sensory (greater darkvision), spells (Divine: bane, blur, command, confusion, crisis of faith, dimension door, discern lies, dispel magic, dominate, mind probe, mind reading, suggestion, tongues), sturdy, wild, wisdom</p>","privateNotes":"","publication":{"title":"Battlezoo Bestiary","authors":"Adil Arif","license":"OGL","remaster":false},"creatureType":""},"resources":{},"_migration":{"version":0.932,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"abilities":{"str":{"mod":2},"dex":{"mod":4},"con":{"mod":2},"int":{"mod":3},"wis":{"mod":4},"cha":{"mod":5}},"perception":{"details":"","mod":17,"senses":[{"type":"greater-darkvision"}],"vision":true},"saves":{"fortitude":{"value":11,"saveDetail":""},"reflex":{"value":15,"saveDetail":""},"will":{"value":17,"saveDetail":""}},"skills":{"arcana":{"base":13},