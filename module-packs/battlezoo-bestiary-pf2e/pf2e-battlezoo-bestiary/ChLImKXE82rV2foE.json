EWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"C6x30fggn6c4aMNo","name":"Defensive Ball","type":"action","img":"systems/pf2e/icons/actions/Reaction.webp","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"gm":"","value":"<p><strong>Trigger</strong> The zuggle is hit with a melee or ranged attack;</p>\n<p><strong>Effect</strong> The zuggle curls into a defensive ball, granting it a +3 circumstance bonus to AC against the triggering attack. While in its defensive ball form, the zuggle's AC increases to 20, it can't perform melee Strikes, and it is @Compendium[pf2e.conditionitems.eIcWbB5o3pP6OIMe]{Immobilized} until it spends an action to roll out of its ball (this action has the manipulate trait).</p>"},"rules":[{"key":"FlatModifier","selector":"ac","value":3,"predicate":["defensiveBall"],"roll-options":["all"],"type":"circumstance"},{"key":"RollOption","domain":"all","option":"defensiveBall","toggleable":true,"value":false}],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["manipulate"],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"reaction"},"category":"defensive","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"Ay4t3tAustANOKZK","name":"Elemental Absorption","type":"action","img":"systems/pf2e/icons/actions/FreeAction.webp","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"gm":"","value":"<p>Ice zuggles feed on cold energy, but too much can cause them to explode.</p>\n<p><strong>Trigger</strong> The ice zuggle is hit by an effect that deals cold damage, but the damage hasn't yet been rolled;</p>\n<p><strong>Effect</strong> The ice zuggle absorbs the energy, regaining Hit Points equal to the cold damage that would have been dealt. If this heals the zuggle in excess of its maximum HP, it gains the excess amount as temporary HP. If this would give the zuggle more than 15 temporary HP, it immediately explodes, dealing [[/r 4d4[cold]]]{4d4 cold damage} in a @Template[type:burst|distance:10] (@Check[type:reflex|dc:18|name:Elemental Absorption DC|basic:true] save).</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"free"},"category":"defensive","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"Z7R6aM2U4YFQC8mX","name":"Horn","type":"melee","img":"systems/pf2e/icons/default-icons/melee.svg","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"value":"","gm":""},"rules":[],"slug":null,"traits":{"value":[],"otherTags":[]},"damageRolls":{"81ihnhhbywev0tsau9ub":{"damage":"1d4+1","damageType":"piercing","category":null}},"bonus":{"value":7},"attackEffects":{"value":[]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"_migration":{"version":0.932,"previous":{"schema":null,"foundry":"12.328","system":"6.1.0"}}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"hpiZXHCYGXj6Cyd2","name":"Zuggle Orb","type":"melee","img":"systems/pf2e/icons/default-icons/melee.svg","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"value":"","gm":""},"rules":[],"slug":null,"traits":{"value":["cold","primal","range-increment-20"],"otherTags":[]},"damageRolls":{"qbntwc78p1o0zwy9zcgg":{"damage":"1d8+3","damageType":"cold","category":null}},"bonus":{"value":9},"attackEffects":{"value":[]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"_migration":{"version":0.932,"previous":{"schema":null,"foundry":"12.328","system":"6.1.0"}}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"L6dVz33qaP1rC7rw","name":"Low-Light Vision","type":"action","img":"systems/pf2e/icons/actions/Passive.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>@Localize[PF2E.NPC.Abilities.Glossary.LowLightVision]</p>"},"rules":[],"slug":"low-light-vision","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"interaction","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""},"weapon":{"value":""}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.bestiary-ability-glossary-srd.Item.fFu2sZz4KB01fVRc","duplicateSource":null,"exportSource":null}}],"effects":[],"folder":null,"sort":0,"flags":{"pf2e":{"lootable":false},"core":{}},"system":{"attributes":{"hp":{"value":30,"temp":0,"max":30,"details":""},"ac":{"value":17,"details":"(20 in Defensive Ball)","base":17},"allSaves":{"value":""},"speed":{"value":20,"otherSpeeds":[{"type":"climb","label":"Climb","value":20}],"details":""},"immunities":[{"type":"bleed"},{"type":"cold"},{"type":"paralyzed"},{"type":"poison"},{"type":"sleep"}],"weaknesses":[{"type":"fire","value":5,"exceptions":[]}]},"initiative":{"statistic":"perception"},"details":{"languages":{"value":[],"details":""},"level":{"value":2},"blurb":"","publicNotes":"<p>These unassuming critters are a common sight on the elemental planes, where they crawl about in search of sustenance. Though their cute appearance is disarming and they are typically prey to the more powerful denizens of their home planes, zuggles still pose a threat to unwary or unprepared plane hoppers.</p>\n<p>Dozens of varieties of zuggle exist—from common rock and fire zuggles to more exotic types like sirocco, mud, and brine zuggles. Nearly all zuggles share the same basic form, which resembles a large caterpillar or wood weevil made of elemental matter. Each zuggle has a central fin along its backside that expands to detect and absorb ambient elemental auras. Other than its fin, the body of a zuggle can vary greatly depending on what type of elemental aura it has recently absorbed. A zuggle on the Plane of Water might have fins and gills, whereas a zuggle on the Plane of Earth might have a rocky carapace and claws. Elsewhere in the multiverse, zuggles can be found trying to feed off of any elemental auras that they can get. In places suffused with all kinds of elemental magic, a zuggle might have a truly bizarre anatomy and might have any number of unique abilities.</p>\n<p>While they aren't friendly by any means, zuggles are curious in a way that is often mistaken for an endearing disposition. It is not uncommon for a zuggle to follow around a spellcaster and sup up any spilled elemental byproducts from cast spells. A starving zuggle might display erratic behavior or aggression when it finally comes upon a source of elemental power. There have even been a few instances of a starving zuggle exploding after feasting too quickly on a potent elemental source.</p>\n<h2>Zuggle Orbs</h2>\n<p>Zuggles naturally produce fist-sized globules of element-infused protein, which they store in specialized pouches that run the length of their spine near their fin. A zuggle can launch these globules at predators for self-defense, but alchemists and others prize these \"zuggle orbs\" for their unique magical properties and take care to extract them without scaring or hurting the zuggle.</p>\n<h2>Monster Part Subsystem</h2>\n<p><strong>Ice Zuggle Creature 2 </strong></p>\n<p><strong>Monster Parts</strong> 5/12/22 gp</p>\n<p><strong>Eligible Refinements</strong> weapons (piercing), armor (light, medium), perception item, skill items (Athletics, Stealth, Survival)</p>\n<p><strong>Eligible Imbued Properties</strong> bane, chaotic, cold, constitution, dexterity, energy resistant (cold, positive), sensory (low-light vision), wild, wisdom</p>","privateNotes":"","publication":{"title":"Battlezoo Bestiary","authors":"Evan Commins","license":"OGL","remaster":false},"creatureType":""},"resources":{},"_migration":{"version":0.932,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"abilities":{"str":{"mod":1},"dex":{"mod":3},"con":{"mod":4},"int":{"mod":-4},"wis":{"mod":3},"cha":{"mod":0}},"perception":{"details":"element sense (imprecise) 120 feet","mod":10,"senses":[{"type":"low-light-vision"}],"vision":true},"saves":{"fortitude":{"value":10,"saveDetail":""},"reflex":{"value":7,"saveDetail":""},"will":{"value":5,"saveDetail":""}},"skills":{"athletics":{"base":5},"stealth":{"base":9},"survival":{"base":7}},"traits":{"value":["