EY8QB0aApWshFEE","name":"Sneak Attack","type":"action","img":"systems/pf2e/icons/actions/Passive.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>The solovei deals an additional [[/r 1d6[precision]]]{1d6 precision damage} to @Compendium[pf2e.conditionitems.AJh5ex99aV6VTggg]{Off-Guard} creatures.</p>\n<hr />\n<p>@Localize[PF2E.NPC.Abilities.Glossary.SneakAttack]</p>"},"rules":[{"category":"precision","diceNumber":1,"dieSize":"d6","key":"DamageDice","predicate":["target:condition:off-guard",{"or":["finesse","agile","ranged"]}],"selector":"strike-damage"},{"key":"RollOption","domain":"all","label":"PF2E.SpecificRule.TOTMToggle.OffGuard","option":"target:condition:off-guard","toggleable":"totm"}],"slug":"sneak-attack","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"offensive","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""},"weapon":{"value":""}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.bestiary-ability-glossary-srd.Item.AWvNPE4U0kEJSL1T","duplicateSource":null,"exportSource":null}},{"_id":"SspdKbrSWvxAwPYt","name":"Thundering Tremolo","type":"action","img":"systems/pf2e/icons/actions/TwoActions.webp","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"gm":"","value":"<p>The solovei lets loose a terrible screech and sends a powerful shockwave reverberating through the air, dealing [[/r 5d6[sonic]]] damage in a @Template[type:cone|distance:30]. Each creature in the area must attempt a @Check[type:fortitude|dc:25|name:Thundering Tremolo DC|traits:damaging-effect, auditory, sonic|showDC:gm]{Fortitude} save.</p>\n\n<p>The solovei can't use Thundering Tremolo again for [[/br 1d4 #rounds]]{1d4 rounds} or until it has successfully stolen an item worth at least 10 gp, whichever comes first.</p>\n<hr />\n<p><strong>Critical Success</strong> The creature takes no damage.</p>\n<p><strong>Success</strong> The creature takes half damage.</p>\n<p><strong>Failure</strong> The creature takes full damage and is @Compendium[pf2e.conditionitems.i3OJZU2nk64Df3xm]{Clumsy 1} and @Compendium[pf2e.conditionitems.9PR9y0bi4JPKnHPR]{Deafened} for 1 minute.</p>\n<p><strong>Critical Failure</strong> As failure, except the creature takes double damage and is also knocked @Compendium[pf2e.conditionitems.j91X7x0XSomq8d60]{Prone}.</p>\n"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["auditory","sonic"],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":2},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"IzNvON6nGsv8KAvc","name":"Withering Whistle","type":"action","img":"systems/pf2e/icons/actions/ThreeActions.webp","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"gm":"","value":"<p><strong>Requirements</strong> The solovei can use Thundering Tremolo;</p>\n\n<p><strong>Effect</strong> The solovei unleashes the full devastating power of its supernatural voice. The solovei uses Thundering Tremolo, which affects a @Template[type:burst|distance:20] instead of a cone. In addition, any vegetation in the area warps and withers, becoming difficult terrain. Any non-living organic matter in the area, such as food items, decomposes into rotting sludge.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["auditory","sonic"],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":3},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}}],"effects":[],"folder":null,"sort":0,"flags":{"pf2e":{"lootable":false},"core":{}},"system":{"attributes":{"hp":{"value":90,"temp":0,"max":90,"details":""},"ac":{"value":23,"details":"","base":23},"allSaves":{"value":""},"speed":{"value":35,"otherSpeeds":[{"type":"climb","label":"Climb","value":20}],"details":""},"immunities":[{"type":"sonic"}]},"initiative":{"statistic":"perception"},"details":{"languages":{"value":[],"details":""},"level":{"value":6},"blurb":"","publicNotes":"<p>Soloveis are bizarre, flightless scavenger birds with powerful legs and beaked humanoid heads. They are best known for their morbid fascination with valuables; like magpies, soloveis are drawn to shiny trinkets and intricate baubles, and so these birds frequently menace adventurers and other humanoids who cross through their territory. A solovei subdues its prey with its supernaturally shrill screeching, which stuns nearby creatures, allowing the solovei to tear its helpless victims apart before absconding with their jewelry and coins. In this way, the aftermath of a solovei attack often resembles a fatal highway robbery, causing no shortage of confusion and panic in nearby villages.</p>\n<p>Soloveis usually make their nests in the lower branches of large or intertwined trees, preferring to settle near roads where they can spot approaching prey while staying hidden. Their vestigial wings are all but useless, and so soloveis rely on their muscular legs and hand-like feet to scrabble up and down trees as needed.</p>\n<p>The vibrations induced by a solovei's warbling are so powerful that they disrupt organic matter. This includes the very trees that soloveis call home. Thus, savvy travelers might notice and avoid a solovei's nest if they're able to recognize ahead of time the distinct patches of warped and decaying vegetation in the tree canopy above.</p>\n<h2>Treasure Hoarders</h2>\n<p>Soloveis carry their stolen valuables back to their nests in order to decorate their lair and attract mates. Particularly successful soloveis can amass veritable hoards of looted trinkets, and these proud individuals often celebrate especially exciting additions to their collections with rapturous cries that can be heard from miles away.</p>\n<h2>Monster Part Subsystem</h2>\n<p><strong>Solovei Creature 6</strong></p>\n<p><strong>Monster Parts</strong> 30/65/125 gp</p>\n<p><strong>Eligible Refinements</strong> weapons (bludgeoning, piercing), armor (light, medium), skill items (Acrobatics, Athletics, Stealth, Thievery)</p>\n<p><strong>Eligible Imbued Properties</strong> bane, charisma, dexterity, energy resistant (positive, sonic), sensory (low-light vision), sonic, wild, wisdom</p>","privateNotes":"","publication":{"title":"Battlezoo Bestiary","authors":"Vadim Hesin","license":"OGL","remaster":false},"creatureType":""},"resources":{},"_migration":{"version":0.932,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"abilities":{"str":{"mod":3},"dex":{"mod":5},"con":{"mod":2},"int":{"mod":-4},"wis":{"mod":4},"cha":{"mod":5}},"perception":{"details":"","mod":14,"senses":[{"type":"low-light-vision"}],"vision":true},"saves":{"fortitude":{"value":10,"saveDetail":""},"reflex":{"value":17,"saveDetail":""},"will":{"value":14,"saveDetail":""}},"skills":{"acrobatics":{"base":15},"athletics":{"base":13},"stealth":{"base":15},"thievery":{"base":15}},"traits":{"value":["animal"],"rarity":"common","size":{"value":"med"}}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"prototypeToken":{"bar1":{"attribute":"attributes.hp"},"displayName":20,"displayBars":20,"flags":{"pf2e":{"linkToActorSize":true,"autoscale":true}},"height":1,"width":1,"disposition":-1,"name":"Solovei","actorLink":false,"lockRotation":false,"rotation":0,"alpha":1,"bar2":{"attribute":null},"randomImg":false,"light":{"alpha":0.25,"angle":360,"bright":0,"coloration":1,"dim":0,"luminosity":0.5,"saturation":0,"contrast":0,"shadows":0,"animation":{"speed":5,"intensity":5,"type":null,"reverse":false},"darkness":{"min":0,"max":1},"attenuation":0.5,"color":null,"negative":false,"priority":0},"texture":{"src":"modules/battlezoo-bestiary-pf2e/art/Tokens/solovei.webp","scaleX":1,"scaleY":1,"tint":"#ffffff","anchorX":0.5,"anchorY":0.5,"fit":"contain","alphaThreshold":0.75},"sight":{"angle":360,"enabled":false,"range":0,"brightness":1,"visionMode":"basic","color":null,"attenuation":0.1,"saturation":0,"contrast":0},"detectionModes":{},"appendNumber":false,"prependAdjective":false,"occludable":{"radius":0},"ring":{"enabled":true,"colors":{"ring":null,"background":null},"effects":1,"subject":{"scale":1,"texture":"modules/battlezoo-bestiary-pf2e/art/Subjects/solovei.webp"}},"turnMarker":{"mode":1,"animation":null,"src":null,"disposition":false},"movementAction":null,"depth":1},"_stats":{"systemId":"pf2e","systemVersion":"6.1.0","coreVersion":"14.360","createdTime":1663517319109,"modifiedTime":1729379236615,"lastModifiedBy":"ZdvNMqfYMlbFrAL2","compendiumSource":"Compendium.battlezoo-bestiary-pf2e.pf2e-battlezoo-bestiary.Actor.zIz1EqJmbV0Ugxdd","duplicateSource":null,"exportSource":null}}