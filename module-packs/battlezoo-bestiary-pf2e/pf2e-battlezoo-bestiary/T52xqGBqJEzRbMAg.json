assive":null,"save":{"statistic":"will","basic":false}},"cost":{"value":""},"location":{"value":"QFurqJkqQopsuLnP","heightenedLevel":4},"counteraction":false,"heightening":{"levels":{"8":{"target":{"value":"10 creatures"}}},"type":"fixed"}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.LiGbewa9pO0yjbsY","duplicateSource":null,"exportSource":null}},{"_id":"xembMc7XC8gSRvlt","name":"Blindness","type":"spell","img":"systems/pf2e/icons/spells/blindness.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>You blind the target. The effect is determined by the target's Fortitude save. The target then becomes temporarily immune for 1 minute.</p>\n<hr />\n<p><strong>Critical Success</strong> The target is unaffected.</p>\n<p><strong>Success</strong> The target is @Compendium[pf2e.conditionitems.XgEqL1kFApUbl5Z2]{Blinded} until its next turn begins.</p>\n<p><strong>Failure</strong> The target is Blinded for 1 minute.</p>\n<p><strong>Critical Failure</strong> The target is Blinded permanently.</p>"},"rules":[],"slug":"blindness","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","incapacitation","manipulate"],"rarity":"common","traditions":["arcane","divine","occult","primal"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":3},"requirements":"","target":{"value":"1 creature"},"range":{"value":"30 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"","sustained":false},"damage":{},"defense":{"passive":null,"save":{"statistic":"fortitude","basic":false}},"cost":{"value":""},"location":{"value":"QFurqJkqQopsuLnP","heightenedLevel":3},"counteraction":false},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.VosLNn2M8S7JH67D","duplicateSource":null,"exportSource":null}},{"_id":"U0stGRSTIEsBmTk3","name":"Blindness","type":"spell","img":"systems/pf2e/icons/spells/blindness.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>You blind the target. The effect is determined by the target's Fortitude save. The target then becomes temporarily immune for 1 minute.</p>\n<hr />\n<p><strong>Critical Success</strong> The target is unaffected.</p>\n<p><strong>Success</strong> The target is @Compendium[pf2e.conditionitems.XgEqL1kFApUbl5Z2]{Blinded} until its next turn begins.</p>\n<p><strong>Failure</strong> The target is Blinded for 1 minute.</p>\n<p><strong>Critical Failure</strong> The target is Blinded permanently.</p>"},"rules":[],"slug":"blindness","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","incapacitation","manipulate"],"rarity":"common","traditions":["arcane","divine","occult","primal"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":3},"requirements":"","target":{"value":"1 creature"},"range":{"value":"30 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"","sustained":false},"damage":{},"defense":{"passive":null,"save":{"statistic":"fortitude","basic":false}},"cost":{"value":""},"location":{"value":"QFurqJkqQopsuLnP","heightenedLevel":3},"counteraction":false},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.VosLNn2M8S7JH67D","duplicateSource":null,"exportSource":null}},{"_id":"uRTSAMGcAOZHkSZa","name":"Magic Missile","type":"spell","img":"systems/pf2e/icons/spells/magic-missile.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>You send a dart of force streaking toward a creature that you can see. It automatically hits and deals 1d4+1 force damage. For each additional action you use when Casting the Spell, increase the number of missiles you shoot by one, to a maximum of three missiles for 3 actions. You choose the target for each missile individually. If you shoot more than one missile at the same target, combine the damage before applying bonuses or penalties to damage, resistances, weaknesses, and so forth.</p>\n<hr />\n<p><strong>Heightened (+2)</strong> You shoot one additional missile with each action you spend.</p>"},"rules":[],"slug":"magic-missile","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","force","manipulate"],"rarity":"common","traditions":["arcane","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":1},"requirements":"","target":{"value":"1 creature"},"range":{"value":"120 feet"},"area":null,"time":{"value":"1 to 3"},"duration":{"value":"","sustained":false},"damage":{"0":{"formula":"1d4+1","type":"force","category":null,"materials":[],"kinds":["damage"]}},"defense":null,"cost":{"value":""},"location":{"value":"QFurqJkqQopsuLnP","heightenedLevel":3},"counteraction":false},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.gKKqvLohtrSJj3BM","duplicateSource":null,"exportSource":null}},{"_id":"3IWD9oCfDbX5MDK4","name":"Darkness","type":"spell","img":"systems/pf2e/icons/spells/darkness.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>You create a shroud of darkness that prevents light from penetrating or emanating within the area. Light does not enter the area and any non-magical light sources, such as a torch or lantern, do not emanate any light while inside the area, even if their light radius would extend beyond the darkness. This also suppresses magical light of your darkness spell's level or lower. Light can't pass through, so creatures in the area can't see outside. From outside, it appears as a globe of pure darkness.</p>\n<hr />\n<p><strong>Heightened (4th)</strong> Even creatures with darkvision (but not greater darkvision) can barely see through the darkness. They treat targets seen through the darkness as @Compendium[pf2e.conditionitems.DmAIPqOBomZ7H95W]{Concealed}.</p>"},"rules":[],"slug":"darkness","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","darkness","manipulate"],"rarity":"common","traditions":["arcane","divine","occult","primal"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":2},"requirements":"","target":{"value":""},"range":{"value":"120 feet"},"area":{"value":20,"type":"burst"},"time":{"value":"3"},"duration":{"value":"1 minute","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"QFurqJkqQopsuLnP","heightenedLevel":2},"counteraction":false},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.4GE2ZdODgIQtg51c","duplicateSource":null,"exportSource":null}},{"_id":"ULLNFCSRbKpbLgeb","name":"Darkness","type":"spell","img":"systems/pf2e/icons/spells/darkness.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>You create a shroud of darkness that prevents light from penetrating or emanating within the area. Light does not enter the area and any non-magical light sources, such as a torch or lantern, do not emanate any light while inside the area, even if their light radius would extend beyond the darkness. This also suppresses magical light of your darkness spell's level or lower. Light can't pass through, so creatures in the area can't see outside. From outside, it appears as a globe of pure darkness.</p>\n<hr />\n<p><strong>Heightened (4th)</strong> Even creatures with darkvision (but not greater darkvision) can barely see through the darkness. They treat targets seen through the darkness as @Compendium[pf2e.conditionitems.DmAIPqOBomZ7H95W]{Concealed}.</p>"},"rules":[],"slug":"darkness","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","darkness","manipulate"],"rarity":"common","traditions":["arcane","divine","occult","primal"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":2},"requirements":"","target":{"value":""},"range":{"value":"120 feet"},"area":{"value":20,"type":"burst"},"time":{"value":"3"},"duration":{"value":"1 minute","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"QFurqJkqQopsuLnP","heightenedLevel":2},"counteraction":false},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.4GE2ZdODgIQtg51c","duplicateSource":null,"exportSource":null}},{"_id":"xuHbu1PdEnyDMj8i","name":"Tongues (Constant)","type":"spell","img":"systems/pf2e/icons/spells/tongues.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>The target can understand all words regardless of language and also speak the languages of other creatures. When in a mixed group of creatures, each time the target speaks, it can choose a creature and speak in a language that creature understands, even if the target doesn't know what language that is.</p>\n<hr />\n<p><strong>Heightened (7th)</strong> The duration is 8 hours.</p>"},"rules":[],"slug":"tongues","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","manipulate"],"rarity":"uncommon","traditions":["arcane","divine","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":5},"requirements":"","target":{"value":"1 creature"},"range":{"value":"touch"},"area":null,"time":{"value":"2"},"duration":{"value":"1 hour","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"QFurqJkqQopsuLnP","heightenedLevel":5},"counteraction":false},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.SwUiVavHKMWG7t5K","duplicateSource":null,"exportSource":null}},{"_id":"IHL3bzc8K2LZDHZe","name":"Constant Spells","type":"action","img":"systems/pf2e/icons/actions/Passive.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>@Localize[PF2E.NPC.Abilities.Glossary.ConstantSpells]</p>"},"rules":[],"slug":"constant-spells","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"interaction","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""},"weapon":{"value":""}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.bestiary-ability-glossary-srd.Item.kakyXBG5WA8c6Zfd","duplicateSource":null,"exportSource":null}},{"_id":"gvbMvPRrlSNIVp4Y","name":"Change Shape","type":"action","img":"systems/pf2e/icons/actions/OneAction.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>The myzoform takes on the appearance of any Small or Medium humanoid. This doesn't change its Speed or attack and damage bonuses with its Strikes, but might change the damage type its Strikes deal (typically to bludgeoning).</p>\n<hr />\n<p>@Localize[PF2E.NPC.Abilities.Glossary.ChangeShape]</p>"},"rules":[],"slug":"change-shape","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","occult","polymorph"],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":1},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""},"weapon":{"value":""}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.bestiary-ability-glossary-srd.Item.eQM5hQ1W3d1uen97","duplicateSource":null,"exportSource":null}},{"_id":"bxUJ7qU9yl29HXKf","name":"Leech Mind","type":"action","img":"systems/pf2e/icons/actions/TwoActions.webp","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"gm":"","value":"<p><strong>Requirements</strong> The myzoform has a creature @Compendium[pf2e.conditionitems.kWc1fhmv9LBiTuei]{Grabbed};</p>\n<p><strong>Effect</strong> The myzoform latches its many lamprey mouths onto the grabbed creature, then feasts upon the victim's memories, dealing [[/r (4d4+10)[mental]]] damage. The target must attempt a @Check[type:will|dc:25|name:Leach Mind DC|traits:damaging-effect, mental, necromancy, occult|showDC:gm]{Will} save.</p>\n<hr />\n<p><strong>Critical Success</strong> The creature takes no damage and the grab ends.</p>\n<p><strong>Success</strong> The creature takes half damage.</p>\n<p><strong>Failure</strong> The creature takes full damage, is @Compendium[pf2e.conditionitems.e1XGnhKNSQIm5IXg]{Stupefied 1}, and permanently loses 1 minute's worth of memories, which are replaced with only an indistinct haze. The stupefied condition remains until the creature receives magical healing.</p>\n<p><strong>Critical Failure</strong> As failure, but the creature takes double damage, is @Compendium[pf2e.conditionitems.e1XGnhKNSQIm5IXg]{Stupefied 2}, and loses 5 minutes' worth of memories.</p>\n"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["mental","occult"],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":2},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"hnOTjY1e5zwDiA53","name":"Darkvision","type":"action","img":"systems/pf2e/icons/actions/Passive.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>@Localize[PF2E.NPC.Abilities.Glossary.Darkvision]</p>"},"rules":[],"slug":"darkvision","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"interaction","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""},"weapon":{"value":""}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.bestiary-ability-glossary-srd.Item.qCCLZhnp2HhP3Ex6","duplicateSource":null,"exportSource":null}},{"_id":"tBKcXBhVAwskLVn8","name":"Swarm Mind","type":"action","img":"systems/pf2e/icons/actions/Passive.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>@Localize[PF2E.NPC.Abilities.Glossary.SwarmMind]</p>"},"rules":[],"slug":"swarm-mind","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"defensive","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""},"weapon":{"value":""}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.bestiary-ability-glossary-srd.Item.baA0nSMhQyFyJIia","duplicateSource":null,"exportSource":null}}],"effects":[],"folder":null,"sort":0,"flags":{"pf2e":{"lootable":false},"core":{}},"system":{"attributes":{"hp":{"value":130,"temp":0,"max":130,"details":""},"ac":{"value":26,"details":"","base":26},"allSaves":{"value":""},"speed":{"value":25,"otherSpeeds":[],"details":""},"immunities":[{"type":"grabbed"},{"type":"prone"},{"type":"restrained"},{"type":"swarm-mind"}]},"initiative":{"statistic":"perception"},"details":{"languages":{"value":[],"details":"tongues"},"level":{"value":8},"blurb":"","publicNotes":"<p>A myzoform is an amalgam of magically modified lampreys fused together into a single humanoid shape. Its head is a writhing mass of lampreys which collectively act as the creature's eyes, ears, and mouths. Myzoforms come about when a mundane lamprey is accidentally exposed to strange and powerful magics—be it from the monstrous aboleths, wild sorcerers, or even natural sources. As a result of its exposure, the lamprey becomes pre-sapient, allowing it to feed on and digest creatures' memories as easily as a normal lamprey sucks blood.</p>\n<p>When such a pre-sapient lamprey attaches itself to another pre-sapient lamprey, the two create a kind of feedback loop as their minds interconnect and feed on and regurgitate one another's increasingly broken and bizarre memories. The lampreys then look for more lampreys to turn into their body, and the process snowballs until a myzoform is born.</p>\n<p>At this stage, a myzoform can survive on its own experiences and memories, but most myzoforms find themselves addicted to the \"fresh\" memories of other creatures. These thirsty creatures are often found haunting towns, cities, and other urban centers rich with potential prey on whose minds they can absorb. When a myzoform strikes from the shadows and latches onto the mind of an unfortunate local, they absorb everything—personality, memories, knowledge—and leave in their wake only an amnesiac.</p>\n<p>The most gluttonous and malicious myzoforms have fed on countless minds throughout their lives, and they might contain hundreds or even thousands of consumed personalities. As the number of minds inside them increases, only the most powerful myzoforms can stay in control; most eventually break down and self-destruct as their collective minds become a civil war of different fears, ideologies, and motivations</p>\n<h2>Crisis of Consciences</h2>\n<p>Although some myzoforms can be genuinely malicious, those are rare. Many myzoforms feel highly guilty over their nigh unstoppable impulse to feed on other sapient beings. Some rationalize their behavior by saying they can't control their impulses, while others might try to cure themselves of their \"curse\" and seek outside help to overcome their insatiable addiction.</p>\n<h2>Monster Part Subsystem</h2>\n<p><strong>Myzoform Creature 8 </strong></p>\n<p><strong>Monster Parts</strong> 64/140/250 gp</p>\n<p><strong>Eligible Refinements</strong> weapons (bludgeoning), armor (light), perception item, skill items (Arcana, Athletics, Deception, Occultism, Stealth)</p>\n<p><strong>Eligible Imbued Properties</strong> acid, bane, chaotic, constitution, energy resistant (positive), evil, force, intelligence, mental, sensory (darkvision), spells (Occult: acid arrow, blindness, confusion, darkness, magic missile, tongues), wild</p>","privateNotes":"","publication":{"title":"Battlezoo Bestiary","authors":"Bella Kelley","license":"OGL","remaster":false},"creatureType":""},"resources":{},"_migration":{"version":0.932,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"abilities":{"str":{"mod":3},"dex":{"mod":4},"con":{"mod":5},"int":{"mod":6},"wis":{"mod":2},"cha":{"mod":0}},"perception":{"details":"","mod":16,"senses":[{"type":"darkvision"}],"vision":true},"saves":{"fortitude":{"value":19,"saveDetail":""},"reflex":{"value":16,"saveDetail":""},"will":{"value":14,"saveDetail":""}},"skills":{"arcana":{"base":16},"deception":{"base":18},"occultism":{"base":18},"stealth":{"base":18},"athletics":{"base":17}},"traits":{"value":["aberration","amphibious","evil","swarm"],"rarity":"common","size":{"value":"lg"}}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"prototypeToken":{"bar1":{"attribute":"attributes.hp"},"displayName":20,"displayBars":20,"flags":{"pf2e":{"linkToActorSize":true,"autoscale":false}},"height":2,"width":2,"disposition":-1,"name":"Myzoform","actorLink":false,"lockRotation":false,"rotation":0,"alpha":1,"bar2":{"attribute":null},"randomImg":false,"light":{"alpha":0.25,"angle":360,"bright":0,"coloration":1,"dim":0,"luminosity":0.5,"saturation":0,"contrast":0,"shadows":0,"animation":{"speed":5,"intensity":5,"type":null,"reverse":false},"darkness":{"min":0,"max":1},"color":null,"attenuation":0.5,"negative":false,"priority":0},"texture":{"src":"modules/battlezoo-bestiary-pf2e/art/Tokens/myzoform.webp","tint":"#ffffff","scaleX":2,"scaleY":2,"anchorX":0.5,"anchorY":0.5,"fit":"contain","alphaThreshold":0.75},"sight":{"angle":360,"enabled":false,"range":0,"brightness":1,"visionMode":"basic","color":null,"attenuation":0.1,"saturation":0,"contrast":0},"detectionModes":{},"appendNumber":false,"prependAdjective":false,"occludable":{"radius":0},"ring":{"enabled":true,"colors":{"ring":null,"background":null},"effects":1,"subject":{"scale":2,"texture":"modules/battlezoo-bestiary-pf2e/art/Subjects/myzoform.webp"}},"turnMarker":{"mode":1,"animation":null,"src":null,"disposition":false},"movementAction":null,"depth":2},"_stats":{"systemId":"pf2e","systemVersion":"6.1.0","coreVersion":"14.360","createdTime":1663517316833,"modifiedTime":1729380276255,"lastModifiedBy":"ZdvNMqfYMlbFrAL2","compendiumSource":"Compendium.battlezoo.pf2e-battlezoo-bestiary.Actor.1GexAsGe5Y8XgXSZ","duplicateSource":null,"exportSource":null}}