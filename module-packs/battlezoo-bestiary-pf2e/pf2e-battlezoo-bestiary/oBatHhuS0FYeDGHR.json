By":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"Dg9lfDKEKCnEOSV1","name":"Silk-Tail Venom","type":"action","img":"systems/pf2e/icons/actions/Passive.webp","effects":[],"folder":null,"sort":-100000,"flags":{},"system":{"description":{"gm":"","value":"<p><strong>Saving Throw</strong> @Check[type:fortitude|dc:17|name:Silk-Tail Poison DC|traits:poison|showDC:gm]{Fortitude};</p>\n<hr />\n<p><strong>Maximum Duration</strong> 6 rounds;</p>\n<p><strong>Stage 1</strong> [[/r 1d6[poison]]] (1 round);</p>\n<p><strong>Stage 2</strong> [[/r 1d6[poison]]] and @Compendium[pf2e.conditionitems.AJh5ex99aV6VTggg]{Off-Guard} (1 round);</p>\n<p><strong>Stage 3</strong> [[/r 1d8[poison]]], off-guard, and @Compendium[pf2e.conditionitems.yblD8fOR1J8rDwEQ]{Confused} (1 round)</p>\n"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["poison"],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"offensive","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"v4CbUCqC8Qqnw0c3","name":"Dazzling Barbs","type":"action","img":"systems/pf2e/icons/actions/TwoActions.webp","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"gm":"","value":"<p>The silk-tailed beetle shakes its tail, reflecting the sunlight in a dazzling display of sparkles and color that affects the minds of creatures who see it. Creatures within 10 feet that can see the silk-tailed beetle must attempt a @Check[type:will|dc:19|name:Dazzling Barbs DC|traits:enchantment, mental, primal, visual|showDC:gm]{Will} save.</p>\n<hr />\n<p><strong>Success</strong> The creature is unaffected.</p>\n<p><strong>Failure</strong> The creature is @Compendium[pf2e.conditionitems.TkIyaNPgTZFBCCuh]{Dazzled} for 1 round.</p>\n<p><strong>Critical Failure</strong> The creature is dazzled for [[/br 1d4 #rounds]]{1d4 rounds}.</p>\n"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["mental","primal","visual"],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":2},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"NNi564qAsXvMyHGN","name":"Fling Barbs","type":"action","img":"systems/pf2e/icons/actions/TwoActions.webp","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"gm":"","value":"<p>The silk-tailed beetle flings the barbs on its tail in a @Template[type:cone|distance:15], dealing [[/r 1d6[piercing]]] damage to creatures in the area (@Check[type:reflex|dc:17|name:Fling Barbs DC|traits:damaging-effect|showDC:gm]{basic Reflex} save). A creature that rolls a failure on its saving throw gets a critical failure instead. A creature damaged by this attack is also exposed to silk-tailed venom.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":2},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}}],"effects":[],"folder":null,"sort":0,"flags":{"pf2e":{"lootable":false,"editNPC":{"value":false}},"core":{"sheetClass":""},"pf2e_updatednpcsheet":{"npcNotes":{"value":""}}},"system":{"attributes":{"hp":{"value":30,"temp":0,"max":30,"details":""},"ac":{"value":18,"details":"","base":18},"allSaves":{"value":""},"speed":{"value":35,"otherSpeeds":[],"details":""}},"initiative":{"statistic":"perception"},"details":{"languages":{"value":[],"details":""},"level":{"value":2},"blurb":"","publicNotes":"<p>Silk-tailed beetles are 3-foot-long insects that hail from the fey realm. They are named after their waxy, iridescent tails, which appear soft and silky but are in fact made up of millions of tiny, sharp, brittle barbs, each no wider than a strand of human hair. Each tail hair is coated in a dangerous venom that damages as well as bewilders foes.</p>\n<p>The distinctive markings on a silk-tailed beetle's shell further confound predators. To the uninitiated, the shell appears to be some kind of disturbing face, with the beetle's tail resembling a spiky tongue. But creatures who try to attack the silk-tailed beetle from behind find themselves with a mouthful of sticky, bitter-tasting fibers instead of a tasty treat. While the would-be predator reels from the venom, the beetle makes a quick getaway.</p>\n<p>In the realm of the fey, gremlins, brownies, and other miniature fey sometimes use silk-tailed beetles as mounts or beasts of burden. These beetles are surprisingly clever, making them easy to befriend or train for simple tasks but also prone to disobedience. While larger fey tend to keep silk-tailed beetles to milk their venom and farm their barbs, some train them as battle companions. When treated kindly and with respect, a silk-tailed beetle is a loyal ally who might even put its life on the line to protect its master.</p>\n<p>In the wild, silk-tailed beetles use their saw-like front limbs to chop off small branches to make tiny hovels for shelter. During mating season, males create elaborate hovels, using their barbs to create glittering masterpieces on the ground. Before they sleep or mate, they implant a few of the barbs from their tails into the ground to ward off predators.</p>\n<h2>Stolen Barbs</h2>\n<p>A silk-tailed beetle's venom remains viable for a few days after its barbs are removed. Clever animals such as tool-wielding primates, crows, and many of the cunning beasts of the fey realm sometimes form symbiotic relationships with silk-tailed beetles, stealing the barbs the beetles use to protect their dens and nests for their own purposes.</p>\n<h2>Monster Part Subsystem</h2>\n<p><strong>Silk-Tailed Beetle Creature 2 </strong></p>\n<p><strong>Monster Parts</strong> 5/12/22 gp</p>\n<p><strong>Eligible Refinements</strong> weapons (piercing, slashing), armor (light, medium), perception item, skill items (Acrobatics, Athletics, Deception, Survival)</p>\n<p><strong>Eligible Imbued Properties</strong> bane, charisma, constitution, dexterity, energy resistant (positive), mental, poison, sensory (darkvision, scent), strength, wild</p>","privateNotes":"","publication":{"title":"Battlezoo Bestiary","authors":"K.M. Kovalcik","license":"OGL","remaster":false},"creatureType":""},"resources":{},"_migration":{"version":0.932,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"abilities":{"str":{"mod":3},"dex":{"mod":4},"con":{"mod":3},"int":{"mod":-3},"wis":{"mod":1},"cha":{"mod":3}},"perception":{"details":"","mod":7,"senses":[{"type":"darkvision"},{"type":"scent","acuity":"imprecise","range":30}],"vision":true},"saves":{"fortitude":{"value":9,"saveDetail":"","base":9},"reflex":{"value":10,"saveDetail":"","base":10},"will":{"value":7,"saveDetail":"","base":7}},"skills":{"acrobatics":{"base":8},"athletics":{"base":9},"deception":{"base":9},"survival":{"base":7}},"traits":{"value":["beast","fey"],"rarity":"common","size":{"value":"sm"}}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"prototypeToken":{"bar1":{"attribute":"attributes.hp"},"displayName":20,"displayBars":20,"flags":{"pf2e":{"linkToActorSize":true,"autoscale":false}},"height":1,"width":1,"disposition":-1,"name":"Silk-Tailed Beetle","actorLink":false,"lockRotation":false,"rotation":0,"alpha":1,"bar2":{"attribute":null},"randomImg":false,"light":{"alpha":0.25,"angle":360,"bright":0,"coloration":1,"dim":0,"luminosity":0.5,"saturation":0,"contrast":0,"shadows":0,"animation":{"speed":5,"intensity":5,"type":null,"reverse":false},"darkness":{"min":0,"max":1},"attenuation":0.5,"color":null,"negative":false,"priority":0},"texture":{"src":"modules/battlezoo-bestiary-pf2e/art/Tokens/silk-tailed_beetle.webp","scaleX":1.6,"scaleY":1.6,"tint":"#ffffff","anchorX":0.5,"anchorY":0.5,"fit":"contain","alphaThreshold":0.75},"sight":{"angle":360,"enabled":false,"range":0,"brightness":1,"visionMode":"basic","color":null,"attenuation":0.1,"saturation":0,"contrast":0},"detectionModes":{},"appendNumber":false,"prependAdjective":false,"occludable":{"radius":0},"ring":{"enabled":true,"colors":{"ring":null,"background":null},"effects":1,"subject":{"scale":2,"texture":"modules/battlezoo-bestiary-pf2e/art/Subjects/silk-tailed_beetle.webp"}},"turnMarker":{"mode":1,"animation":null,"src":null,"disposition":false},"movementAction":null,"depth":1},"_stats":{"systemId":"pf2e","systemVersion":"6.1.0","coreVersion":"14.360","createdTime":1663517316976,"modifiedTime":1729382732001,"lastModifiedBy":"ZdvNMqfYMlbFrAL2","compendiumSource":"Compendium.battlezoo-bestiary-pf2e.pf2e-battlezoo-bestiary.Actor.oBatHhuS0FYeDGHR","duplicateSource":null,"exportSource":null}}