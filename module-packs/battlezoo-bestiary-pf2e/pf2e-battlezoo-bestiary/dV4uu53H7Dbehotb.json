ranged Strike with metal ammunition (including arrows and bolts) gains a +1 circumstance bonus on attack rolls against the ferropaceon and a -1 circumstance penalty on attack rolls against other creatures.</p>\n<hr />\n<p>@Compendium[battlezoo-bestiary-pf2e.pf2e-battlezoo-bestiary-effects.a2qTMWGyRq3sXL1B]{Effect: Aura of Magnetism}</p>"},"rules":[{"key":"RollOption","domain":"all","option":"self:ferropaceon"},{"effects":[{"affects":"all","events":["enter"],"includesSelf":false,"uuid":"Compendium.battlezoo-bestiary-pf2e.pf2e-battlezoo-bestiary-effects.Item.a2qTMWGyRq3sXL1B"}],"key":"Aura","radius":60,"traits":["primal"],"slug":"aura-of-magnetism"}],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["aura","primal"],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"defensive","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":"pf2e","systemVersion":"4.7.0","coreVersion":"14.360","createdTime":null,"modifiedTime":1675654986977,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"71ecZGz26SwYUkVK","name":"Metallic Carapace","type":"action","img":"systems/pf2e/icons/actions/Passive.webp","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"gm":"","value":"<p>The ferropaceon can protect itself by covering itself in magnetized metal objects, creating a metallic shell around its body. The ferropaceon can hold a maximum of 12 Bulk in this way; magnetized objects in excess of this limit simply fall to the ground beside the ferropaceon.</p>\n<p>The ferropaceon gains Hardness equal to the total Bulk of the magnetized objects. An adjacent creature can Interact to remove one of these objects with a successful @Check[type:athletics|dc:26|name:Remove Metallic Carapace DC|showDC:gm]{Athletics} check.</p>\n<p>Objects attached to the magnetic carapace are unattended for the purposes of spells and abilities, but they cannot be forcibly moved by the effects of a spell or ability.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"defensive","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"0EadGPMbWOJEYtFf","name":"Scissor Claw","type":"melee","img":"systems/pf2e/icons/default-icons/melee.svg","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"value":"","gm":""},"rules":[],"slug":null,"traits":{"value":["versatile-p"],"otherTags":[]},"damageRolls":{"rs7tja6tc3srra0sfvva":{"damage":"2d12+13","damageType":"slashing","category":null}},"bonus":{"value":23},"attackEffects":{"value":[]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"_migration":{"version":0.932,"previous":{"schema":null,"foundry":"12.328","system":"6.1.0"}}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"3UTW51ize4WAMaIN","name":"Earth Glide","type":"action","img":"systems/pf2e/icons/actions/Passive.webp","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"gm":"","value":"<p>The ferropaceon can Burrow through any earthen matter, including rock. When it does so, the ferropaceon moves at its full burrow Speed, leaving no tunnels or signs of its passing.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"offensive","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"AmIe9DqlKhVwGSeI","name":"Hyperpolarization","type":"action","img":"systems/pf2e/icons/actions/TwoActions.webp","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"gm":"","value":"<p>The ferropaceon temporarily intensifies its magnetic field, drawing in metal objects in a @Template[type:emanation|distance:60]. All unattended metal objects 1 Bulk or less in the area are immediately pulled toward the ferropaceon and added to its Metallic Carapace.</p>\n<p>The ferropaceon attempts to Disarm all creatures in the area wielding metal objects, adding the disarmed object to its Metallic Carapace on a critical success. Any creature in the area wearing metal armor or composed of metal must succeed at a @Check[type:fortitude|dc:28|name:Hyperpolarization DC|traits:evocation,primal|showDC:gm]{Fortitude} save or be pulled 10 feet towards the ferropaceon (15 feet on a critical failure).</p>\n<p>The ferropaceon can't use Hyperpolarization again for [[/br 1d4 #rounds]]{1d4 rounds}.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["primal"],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":2},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"4gFMj47kxhahANiF","name":"Repulsive Barrage","type":"action","img":"systems/pf2e/icons/actions/TwoActions.webp","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"gm":"","value":"<p><strong>Requirements</strong> The ferropaceon is holding at least 1 Bulk of metal items on its metallic carapace;</p>\n<p><strong>Effect</strong> The ferropaceon violently reverses its magnetic field, flinging everything stuck to its body outward in a @Template[type:emanation|distance:30]. Creatures in the area take [[/r 1d6[slashing]]] damage per 1 Bulk on the ferropaceon's metallic carapace (up to 12d6 for 12 Bulk; @Check[type:reflex|dc:29|name:Repulsive Barrage DC|traits:damaging-effect|showDC:gm]{basic Reflex} save).</p>\n<p>All the repulsed items drop to the ground 30 feet away from the ferropaceon.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["primal"],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":2},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}}],"effects":[],"folder":null,"sort":0,"flags":{"pf2e":{"lootable":false},"core":{}},"system":{"attributes":{"hp":{"value":185,"temp":0,"max":185,"details":"Hardness varies"},"ac":{"value":30,"details":"","base":30},"allSaves":{"value":""},"speed":{"value":25,"otherSpeeds":[{"type":"burrow","label":"Burrow","value":20}],"details":"earth glide"},"immunities":[{"type":"bleed"},{"type":"paralyzed"},{"type":"poison"},{"type":"sleep"}],"weaknesses":[{"type":"bludgeoning","value":10}]},"initiative":{"statistic":"perception"},"details":{"languages":{"value":["petran"],"details":""},"level":{"value":10},"blurb":"","publicNotes":"<p>Often likened to a hermit crab, the ferropaceon is a six-legged earth elemental with a naturally smooth magnetic shell upon which it single-mindedly hoards any magnetic materials it can find. Though they hail from the Elemental Plane of Earth and tend to emerge on the Material Plane within the cavernous depths of ore-rich mountains, ferropaceons inevitably wander toward humanoid lands in search of ever more and ever rarer metal objects. Junkyards, old battlefields, and the outskirts of highly industrial cities have all known a ferropaceon at one time or another.</p>\n<h2>Ferropaceon Weapons</h2>\n<p>Though not malicious, ferropaceons are highly territorial, viewing any object magnetically stuck to their body as rightly theirs. Most ferropaceons defend their treasures with scissor-like claws that can slice through flesh and bone with ease. The oldest ferropaceons can control their magnetic fields to such a degree that they can \"wield\" metallic weapons like swords and hammers, oscillating their magnetism so that the weapon hovers around them and strikes at their command.</p>\n<h2>Monster Part Subsystem</h2>\n<p><strong>Ferropaceon Creature 10 </strong></p>\n<p><strong>Monster Parts</strong> 125/275/500 gp</p>\n<p><strong>Eligible Refinements</strong> weapons (piercing, slashing), armor (heavy), perception item, skill items (Athletics)</p>\n<p><strong>Eligible Imbued Properties</strong> bane, constitution, energy resistant (positive), sensory (darkvision), strength, wild</p>","privateNotes":"","publication":{"title":"Battlezoo Bestiary","authors":"Aoife Ester","license":"OGL","remaster":false},"creatureType":""},"resources":{},"_migration":{"version":0.932,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"abilities":{"str":{"mod":7},"dex":{"mod":3},"con":{"mod":5},"int":{"mod":-2},"wis":{"mod":0},"cha":{"mod":-2}},"perception":{"details":"metal sense (imprecise) 60 feet","mod":18,"senses":[{"type":"darkvision"}],"vision":true},"saves":{"fortitude":{"value":23,"saveDetail":""},"reflex":{"value":15,"saveDetail":""},"will":{"value":16,"saveDetail":""}},"skills":{"athletics":{"base":23}},"traits":{"value":["earth","elemental"],"rarity":"uncommon","size":{"value":"lg"}},"customModifiers":{}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"prototypeToken":{"bar1":{"attribute":"attributes.hp"},"displayName":20,"displayBars":20,"flags":{"pf2e":{"linkToActorSize":true,"autoscale":false}},"height":2,"width":2,"disposition":-1,"name":"Ferropaceon","actorLink":false,"lockRotation":false,"rotation":0,"alpha":1,"bar2":{"attribute":null},"randomImg":false,"light":{"alpha":0.25,"angle":360,"bright":0,"coloration":1,"dim":0,"luminosity":0.5,"saturation":0,"contrast":0,"shadows":0,"animation":{"speed":5,"intensity":5,"type":null,"reverse":false},"darkness":{"min":0,"max":1},"color":null,"attenuation":0.5,"negative":false,"priority":0},"texture":{"src":"modules/battlezoo-bestiary-pf2e/art/Tokens/ferropaceon.webp","tint":"#ffffff","scaleX":2,"scaleY":2,"anchorX":0.5,"anchorY":0.5,"fit":"contain","alphaThreshold":0.75},"sight":{"angle":360,"enabled":false,"range":0,"brightness":1,"visionMode":"basic","color":null,"attenuation":0.1,"saturation":0,"contrast":0},"detectionModes":{},"appendNumber":false,"prependAdjective":false,"occludable":{"radius":0},"ring":{"enabled":true,"colors"