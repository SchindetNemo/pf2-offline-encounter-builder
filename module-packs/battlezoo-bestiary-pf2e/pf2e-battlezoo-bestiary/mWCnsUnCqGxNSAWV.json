slot8":{"prepared":[],"value":0,"max":0},"slot9":{"prepared":[],"value":0,"max":0},"slot10":{"prepared":[],"value":0,"max":0},"slot11":{"prepared":[],"value":0,"max":0}},"autoHeightenLevel":{"value":null},"showUnpreparedSpells":{"value":true},"displayLevels":{}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"XtbQtOsKMf4ftQSH","name":"Nightmare","type":"spell","img":"systems/pf2e/icons/spells/nightmare.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>You send disturbing nightmares to your target. The next time the target falls asleep, it must attempt a Will save. If you know the target only by name and have never met them, the target gets a +4 circumstance bonus to the Will save.</p>\n<hr />\n<p><strong>Critical Success</strong> The target suffers no adverse effects and is temporarily immune for 1 week.</p>\n<p><strong>Success</strong> The target experiences the nightmares but suffers no adverse effects other than unpleasant memories.</p>\n<p><strong>Failure</strong> The target experiences the nightmares and awakens @Compendium[pf2e.conditionitems.HL2l2VRSaQHu9lUw]{Fatigued}.</p>\n<p><strong>Critical Failure</strong> The target experiences the nightmares, awakens Fatigued, and is @Compendium[pf2e.conditionitems.4D2KBtexWXa6oUMR]{Drained 2} until it is no longer Fatigued.</p>"},"rules":[],"slug":"nightmare","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","illusion","manipulate","mental"],"rarity":"common","traditions":["arcane","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":4},"requirements":"","target":{"value":"1 creature you know by name"},"range":{"value":"planetary"},"area":null,"time":{"value":"10 minutes"},"duration":{"value":"1 day","sustained":false},"damage":{},"defense":{"passive":null,"save":{"statistic":"will","basic":false}},"cost":{"value":""},"location":{"value":"6tuNqK0aN8JTMDQc","heightenedLevel":6},"counteraction":false},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.Uqj344bezBq3ESdq","duplicateSource":null,"exportSource":null}},{"_id":"446O7GXUU4mz7VJW","name":"Nightmare","type":"spell","img":"systems/pf2e/icons/spells/nightmare.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>You send disturbing nightmares to your target. The next time the target falls asleep, it must attempt a Will save. If you know the target only by name and have never met them, the target gets a +4 circumstance bonus to the Will save.</p>\n<hr />\n<p><strong>Critical Success</strong> The target suffers no adverse effects and is temporarily immune for 1 week.</p>\n<p><strong>Success</strong> The target experiences the nightmares but suffers no adverse effects other than unpleasant memories.</p>\n<p><strong>Failure</strong> The target experiences the nightmares and awakens @Compendium[pf2e.conditionitems.HL2l2VRSaQHu9lUw]{Fatigued}.</p>\n<p><strong>Critical Failure</strong> The target experiences the nightmares, awakens Fatigued, and is @Compendium[pf2e.conditionitems.4D2KBtexWXa6oUMR]{Drained 2} until it is no longer Fatigued.</p>"},"rules":[],"slug":"nightmare","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","illusion","manipulate","mental"],"rarity":"common","traditions":["arcane","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":4},"requirements":"","target":{"value":"1 creature you know by name"},"range":{"value":"planetary"},"area":null,"time":{"value":"10 minutes"},"duration":{"value":"1 day","sustained":false},"damage":{},"defense":{"passive":null,"save":{"statistic":"will","basic":false}},"cost":{"value":""},"location":{"value":"6tuNqK0aN8JTMDQc","heightenedLevel":6},"counteraction":false},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.Uqj344bezBq3ESdq","duplicateSource":null,"exportSource":null}},{"_id":"cxG0WlVHtefbrAvq","name":"Paranoia","type":"spell","img":"systems/pf2e/icons/spells/paranoia.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>You cause the target to see all other creatures as dire threats. The target is stricken by intense paranoia toward all creatures around it and must attempt a Will save.</p>\n<hr /><strong>Critical Success</strong> The target is unaffected.\n<p><strong>Success</strong> The target believes everyone it sees is a potential threat. It becomes @Compendium[pf2e.conditionitems.I1ffBVISxLr2gC4u]{Unfriendly} to all creatures to which it wasn't already hostile, even those that were previously allies. It treats no one as an ally. The spell ends after 1 round.</p>\n<p><strong>Failure</strong> As success, but the effect lasts 1 minute.</p>\n<p><strong>Critical Failure</strong> As failure, except the target believes that everyone it sees is a mortal enemy. It uses its reactions and free actions against everyone, regardless of whether they were previously its allies, as determined by the GM. It otherwise acts as rationally as it normally does and likely prefers to attack creatures that are actively attacking or hindering it over those leaving it alone.</p>\n<hr /><strong>Heightened (6th)</strong> You can target up to 5 creatures."},"rules":[],"slug":"paranoia","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","illusion","manipulate","mental"],"rarity":"common","traditions":["occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":2},"requirements":"","target":{"value":"1 creature"},"range":{"value":"30 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"1 minute","sustained":false},"damage":{},"defense":{"passive":null,"save":{"statistic":"will","basic":false}},"cost":{"value":""},"location":{"value":"6tuNqK0aN8JTMDQc","heightenedLevel":6},"counteraction":false,"heightening":{"levels":{"6":{"target":{"value":"5 creatures"}}},"type":"fixed"}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.Mkbq9xlAUxHUHyR2","duplicateSource":null,"exportSource":null}},{"_id":"tEE17YbYPhzC5LLK","name":"Darkness (At Will)","type":"spell","img":"systems/pf2e/icons/spells/darkness.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>You create a shroud of darkness that prevents light from penetrating or emanating within the area. Light does not enter the area and any non-magical light sources, such as a torch or lantern, do not emanate any light while inside the area, even if their light radius would extend beyond the darkness. This also suppresses magical light of your darkness spell's level or lower. Light can't pass through, so creatures in the area can't see outside. From outside, it appears as a globe of pure darkness.</p>\n<hr />\n<p><strong>Heightened (4th)</strong> Even creatures with darkvision (but not greater darkvision) can barely see through the darkness. They treat targets seen through the darkness as @Compendium[pf2e.conditionitems.DmAIPqOBomZ7H95W]{Concealed}.</p>"},"rules":[],"slug":"darkness","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","darkness","manipulate"],"rarity":"common","traditions":["arcane","divine","occult","primal"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":2},"requirements":"","target":{"value":""},"range":{"value":"120 feet"},"area":{"value":20,"type":"burst"},"time":{"value":"3"},"duration":{"value":"1 minute","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"6tuNqK0aN8JTMDQc","heightenedLevel":4},"counteraction":false},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.4GE2ZdODgIQtg51c","duplicateSource":null,"exportSource":null}},{"_id":"ttWsSAWeFoqKZsNu","name":"Dimension Door","type":"spell","img":"systems/pf2e/icons/spells/dimension-door.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>Opening a door that bypasses normal space, you instantly transport yourself and any items you're wearing and holding from your current space to a clear space within range you can see. If this would bring another creature with you-even if you're carrying it in an extradimensional container-the spell is lost.</p>\n<hr />\n<p><strong>Heightened (5th)</strong> The range increases to 1 mile. You don't need to be able to see your destination, as long as you have been there in the past and know its relative location and distance from you. You are temporarily immune for 1 hour.</p>"},"rules":[],"slug":"dimension-door","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","manipulate","teleportation"],"rarity":"common","traditions":["arcane","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":4},"requirements":"","target":{"value":""},"range":{"value":"120 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"6tuNqK0aN8JTMDQc","heightenedLevel":4},"counteraction":false,"heightening":{"levels":{"5":{"range":{"value":"1 mile"}}},"type":"fixed"}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.VlNcjmYyu95vOUe8","duplicateSource":null,"exportSource":null}},{"_id":"zIDqG3vVHOR9AKGk","name":"Sleep","type":"spell","img":"systems/pf2e/icons/spells/sleep.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>Each creature in the area becomes drowsy and might fall asleep. A creature that falls @Compendium[pf2e.conditionitems.fBnFDH2MTzgFijKf]{Unconscious} from this spell doesn't fall @Compendium[pf2e.conditionitems.j91X7x0XSomq8d60]{Prone} or release what it's holding. This spell doesn't prevent creatures from waking up due to a successful Perception check, limiting its utility in combat.</p>\n<hr />\n<p><strong>Critical Success</strong> The creature is unaffected.</p>\n<p><strong>Success</strong> The creature takes a -1 status penalty to Perception checks for 1 round.</p>\n<p><strong>Failure</strong> The creature falls Unconscious. If it's still Unconscious after 1 minute, it wakes up automatically.</p>\n<p><strong>Critical Failure</strong> The creature falls Unconscious. If it's still Unconscious after 1 hour, it wakes up automatically.</p>\n<hr />\n<p><strong>Heightened (4th)</strong> The creatures fall Unconscious for 1 round on a failure or 1 minute on a critical failure. They fall Prone and release what they're holding, and they can't attempt Perception checks to wake up. When the duration ends, the creature is sleeping normally instead of automatically waking up.</p>"},"rules":[],"slug":"sleep","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","incapacitation","manipulate","mental","sleep"],"rarity":"common","traditions":["arcane","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":1},"requirements":"","target":{"value":""},"range":{"value":"30 feet"},"area":{"value":5,"type":"burst"},"time":{"value":"2"},"duration":{"value":"","sustained":false},"damage":{},"defense":{"passive":null,"save":{"statistic":"will","basic":false}},"cost":{"value":""},"location":{"value":"6tuNqK0aN8JTMDQc","heightenedLevel":4},"counteraction":false},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.o4lRVTwSxnOOn5vl","duplicateSource":null,"exportSource":null}},{"_id":"nacnXL7BuPNPzcMn","name":"Sleep","type":"spell","img":"systems/pf2e/icons/spells/sleep.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>Each creature in the area becomes drowsy and might fall asleep. A creature that falls @Compendium[pf2e.conditionitems.fBnFDH2MTzgFijKf]{Unconscious} from this spell doesn't fall @Compendium[pf2e.conditionitems.j91X7x0XSomq8d60]{Prone} or release what it's holding. This spell doesn't prevent creatures from waking up due to a successful Perception check, limiting its utility in combat.</p>\n<hr />\n<p><strong>Critical Success</strong> The creature is unaffected.</p>\n<p><strong>Success</strong> The creature takes a -1 status penalty to Perception checks for 1 round.</p>\n<p><strong>Failure</strong> The creature falls Unconscious. If it's still Unconscious after 1 minute, it wakes up automatically.</p>\n<p><strong>Critical Failure</strong> The creature falls Unconscious. If it's still Unconscious after 1 hour, it wakes up automatically.</p>\n<hr />\n<p><strong>Heightened (4th)</strong> The creatures fall Unconscious for 1 round on a failure or 1 minute on a critical failure. They fall Prone and release what they're holding, and they can't attempt Perception checks to wake up. When the duration ends, the creature is sleeping normally instead of automatically waking up.</p>"},"rules":[],"slug":"sleep","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","incapacitation","manipulate","mental","sleep"],"rarity":"common","traditions":["arcane","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":1},"requirements":"","target":{"value":""},"range":{"value":"30 feet"},"area":{"value":5,"type":"burst"},"time":{"value":"2"},"duration":{"value":"","sustained":false},"damage":{},"defense":{"passive":null,"save":{"statistic":"will","basic":false}},"cost":{"value":""},"location":{"value":"6tuNqK0aN8JTMDQc","heightenedLevel":4},"counteraction":false},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.o4lRVTwSxnOOn5vl","duplicateSource":null,"exportSource":null}},{"_id":"n3KyNsyLjWOEHqJN","name":"Silence","type":"spell","img":"systems/pf2e/icons/spells/silence.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>The target makes no sound, preventing creatures from noticing it using hearing or other senses alone. The target can't use sonic attacks, nor can it use actions with the auditory trait. This prevents it from casting spells that include verbal components.</p>\n<hr />\n<p><strong>Heightened (4th)</strong> The spell effect emanates from the touched creature, silencing all sound in or passing through a 10- foot radius and preventing any auditory and sonic effects in the affected area. While within the radius, creatures are subject to the same effects as the target. Depending upon the position of the effect, a creature might notice the lack of sound reaching it (blocking off the noise coming from a party, for example).</p>"},"rules":[],"slug":"silence","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["illusion","manipulate"],"rarity":"common","traditions":["divine","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":2},"requirements":"","target":{"value":"1 willing creature"},"range":{"value":"touch"},"area":null,"time":{"value":"2"},"duration":{"value":"1 minute","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"6tuNqK0aN8JTMDQc","heightenedLevel":2},"counteraction":false},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.gIdDLrbswTV3OBJy","duplicateSource":null,"exportSource":null}},{"_id":"tuxL8ctuP3LqIdub","name":"Ray of Enfeeblement","type":"spell","img":"systems/pf2e/icons/spells/ray-of-enfeeblement.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>A ray that saps a foe's strength flashes from your hand. Attempt a ranged spell attack against the target. If you succeed, that creature attempts a Fortitude save to determine the spell's effect. If your attack roll is a critical success, use the outcome for one degree of success worse than the result of its save.</p>\n<hr />\n<p><strong>Critical Success</strong> The target is unaffected.</p>\n<p><strong>Success</strong> The target becomes @Compendium[pf2e.conditionitems.MIRkyAjyBeXivMa7]{Enfeebled 1}.</p>\n<p><strong>Failure</strong> The target becomes @Compendium[pf2e.conditionitems.MIRkyAjyBeXivMa7]{Enfeebled 2}.</p>\n<p><strong>Critical Failure</strong> The target becomes @Compendium[pf2e.conditionitems.MIRkyAjyBeXivMa7]{Enfeebled 3}.</p>"},"rules":[],"slug":"ray-of-enfeeblement","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["attack","concentrate","manipulate"],"rarity":"common","traditions":["arcane","divine","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":1},"requirements":"","target":{"value":"1 creature"},"range":{"value":"30 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"1 minute","sustained":false},"damage":{},"defense":{"passive":null,"save":{"statistic":"fortitude","basic":false}},"cost":{"value":""},"location":{"value":"6tuNqK0aN8JTMDQc","heightenedLevel":1},"counteraction":false},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.J7Y7tl0bbdz7TcCc","duplicateSource":null,"exportSource":null}},{"_id":"ymXEiRPeTmkJEGHq","name":"Telekinetic Projectile","type":"spell","img":"systems/pf2e/icons/spells/telekinetic-projectile.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>You hurl a loose, unattended object that is within range and that has 1 Bulk or less at the target. Make a spell attack roll against the target. If you hit, you deal bludgeoning, piercing, or slashing damage-as appropriate for the object you hurled-equal to 1d6 plus your spellcasting ability modifier. No specific traits or magic properties of the hurled item affect the attack or the damage.</p>\n<hr />\n<p><strong>Critical Success</strong> You deal double damage.</p>\n<p><strong>Success</strong> You deal full damage.</p>\n<hr />\n<p><strong>Heightened (+1)</strong> The damage increases by 1d6.</p>"},"rules":[],"slug":"telekinetic-projectile","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["attack","cantrip","concentrate","manipulate"],"rarity":"common","traditions":["arcane","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":1},"requirements":"","target":{"value":"1 creature"},"range":{"value":"30 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"","sustained":false},"damage":{"0":{"applyMod":true,"formula":"1d6","type":"untyped","category":null,"materials":[],"kinds":["damage"]}},"defense":null,"cost":{"value":""},"location":{"value":"6tuNqK0aN8JTMDQc"},"counteraction":false,"heightening":{"type":"interval","interval":1,"damage":{"0":"1d6"}}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.60sgbuMWN0268dB7","duplicateSource":null,"exportSource":null}},{"_id":"JZrlKd9BSxgOaalg","name":"Open Dream Gate","type":"action","img":"systems/pf2e/icons/actions/ThreeActions.webp","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"gm":"","value":"<p>A jikou can traverse the Material Plane by using a sleeping creature as a gate to and from the Dimension of Dreams. The jikou tears open a dream gate in an adjacent @Compendium[pf2e.conditionitems.fBnFDH2MTzgFijKf]{Unconscious} creature, dealing [[/r (2d4 + 13)[slashing]]] damage and [[/r 2d4[bleed]]] damage to the creature. If this damage would cause the creature to wake up (typically because the creature is sleeping), it must succeed at a @Check[type:will|dc:32|name:Open Dream Gate DC|traits:damaging-effect, concentrate, conjuration, dream, primal|showDC:gm]{Will} save or remain asleep. As long as the creature is bleeding, it can attempt a new save each round at the beginning of its turn. Once a dream gate is open, it remains open for 10 minutes or until the creature's bleed damage ends.</p>\n<p>Any creature with the dream trait can enter or exit a dream gate to teleport across the Material Plane. To reemerge on the Material Plane, a jikou must tear open a dream gate while in the Dimension of Dreams, which it can do by targeting a sleeping creature's dreaming form. This has the same effect as opening a dream gate on the Material Plane, except the affected creature takes [[/r 2d4[persistent,mental]]] damage instead of bleed.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","primal"],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":3},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"pqzT6CqFou4wuLX6","name":"Razor Flurry","type":"action","img":"systems/pf2e/icons/actions/TwoActions.webp","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"gm":"","value":"<p>The jikou whips its razor in a wide, unpredictable pattern, making three melee razor Strikes against up to three creatures within range. Its multiple attack penalty doesn't increase until after it makes all three attacks.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":2},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"cA5j6sElToTVy8AT","name":"Sneak Attack","type":"action","img":"systems/pf2e/icons/actions/Passive.webp","effects":[],"folder":null,"sort":-100000,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>A jikou's Strikes deal an additional [[/r 2d6[precision]]]{2d6 precision damage} to @Compendium[pf2e.conditionitems.AJh5ex99aV6VTggg]{Off-Guard} creatures.</p>\n<hr />\n<p>@Localize[PF2E.NPC.Abilities.Glossary.SneakAttack]</p>"},"rules":[{"category":"precision","diceNumber":2,"dieSize":"d6","key":"DamageDice","predicate":["target:condition:off-guard",{"or":["finesse","agile","ranged"]}],"selector":"strike-damage"},{"key":"RollOption","domain":"all","label":"PF2E.SpecificRule.TOTMToggle.OffGuard","option":"target:condition:off-guard","toggleable":"totm"}],"slug":"sneak-attack","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"offensive","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""},"weapon":{"value":""}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.bestiary-ability-glossary-srd.Item.AWvNPE4U0kEJSL1T","duplicateSource":null,"exportSource":null}},{"_id":"RqOhH4dhiXF3TzZ6","name":"Razor","type":"weapon","img":"systems/pf2e/icons/equipment/weapons/dagger.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>This small, bladed weapon is held in one hand and used to stab a creature in close combat. It can also be thrown.</p>"},"rules":[],"slug":"dagger","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["agile","finesse","thrown-10","versatile-s"],"rarity":"common"},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":0},"quantity":1,"baseItem":"dagger","bulk":{"value":0.1},"hp":{"value":0,"max":0},"hardness":0,"price":{"value":{"sp":2}},"equipped":{"carryType":"held","invested":null,"handsHeld":1},"containerId":null,"size":"med","material":{"type":"cold-iron","grade":"standard"},"identification":{"status":"identified","unidentified":{"name":"Unusual Dagger","img":"systems/pf2e/icons/unidentified_item_icons/weapon.webp","data":{"description":{"value":""}}},"misidentified":{}},"usage":{"value":"held-in-one-hand"},"category":"simple","group":"knife","bonus":{"value":0},"damage":{"dice":1,"die":"d4","damageType":"piercing","persistent":null,"value":""},"splashDamage":{"value":0},"range":null,"expend":null,"ammo":null,"reload":{"value":"-"},"grade":null,"runes":{"potency":1,"striking":1,"property":["returning"]},"specific":null,"subitems":[],"bonusDamage":{"value":0},"property1":{"value":"","dice":null,"die":"","damageType":"","critDice":null,"critDie":"","critDamage":"","critDamageType":"","criticalConditionType":"","criticalConditionValue":null,"strikeConditionType":"","strikeConditionValue":null}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.equipment-srd.Item.rQWaJhI5Bko5x14Z","duplicateSource":null,"exportSource":null}},{"_id":"kyA7aBxVXnYMY5Ar","name":"At-Will Spells","type":"action","img":"systems/pf2e/icons/actions/Passive.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>@Localize[PF2E.NPC.Abilities.Glossary.AtWillSpells]</p>"},"rules":[],"slug":"at-will-spells","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"interaction","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""},"weapon":{"value":""}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.bestiary-ability-glossary-srd.Item.2YRDYVnC1eljaXKK","duplicateSource":null,"exportSource":null}}],"effects":[],"folder":null,"sort":0,"flags":{"pf2e":{"lootable":false},"core":{}},"system":{"attributes":{"hp":{"value":200,"temp":0,"max":200,"details":""},"ac":{"value":30,"details":"","base":30},"allSaves":{"value":""},"speed":{"value":0,"otherSpeeds":[{"type":"fly","label":"Fly","value":75}],"details":""},"immunities":[{"type":"disease"},{"type":"poison"},{"type":"precision"},{"type":"sleep"}],"weaknesses":[{"type":"cold-iron","value":10}],"resistances":[{"type":"all-damage","value":10,"exceptions":["cold-iron","force","ghost-touch"],"doubleVs":["non-magical"]}]},"initiative":{"statistic":"perception"},"details":{"languages":{"value":["aklo","common","fey"],"details":"(can’t speak any language); telepathy 100 feet"},"level":{"value":12},"blurb":"","publicNotes":"<p>Despite their wit and strength, ankous—the most notorious assassins among the fey—can occasionally still be duped or trapped by a devious master's contract. Unwilling to be held captive by threats or obligations, a snared ankou's subconscious mind seeks a solution from within. The jikou is the answer to this dilemma—a phantasmagoric manifestation of the ankou's twisted, murderous dreams of revenge.</p>\n<p>A jikou doesn't resemble much by itself—a tiny ball of shadows and flame that occasionally twists into the shape of a clawed fist. But every jikou carries with it a wicked razor of cold iron with which it enacts crimes and cruelty. The floating hand whips this razor about feverishly, its twists and turns becoming more erratic the closer a jikou gets to the blade's intended target.</p>\n<p>A jikou's first target is nearly always the treacherous master to whom its ankou progenitor is bound to serve. An ankou might not even realize it has manifested a jikou until after the floating blade completes its mad mission. Afterward, the ankou and jikou tend to work in tandem rather than take on any more contracts. Together, these nightmarish fey are far deadlier than the sum of their parts.</p>\n<h2>Dream Killers</h2>\n<p>Even when its ankou \"parent\" is bound by an iron-clad contract, a jikou can strike out and fulfill independent murderous schemes on behalf of its progenitor. A jikou travels across the Material Plane via the Dimension of Dreams, slashing portals through wandering dreamers like a phantasmal serial murderer.</p>\n<h2>Monster Part Subsystem</h2>\n<p><strong>Jikou Creature 12 </strong></p>\n<p><strong>Monster Parts</strong> 250/560/1,030 gp</p>\n<p><strong>Eligible Refinements</strong> weapons (slashing), perception item, skill items (Acrobatics, Deception, Intimidation, Stealth, Thievery)</p>\n<p><strong>Eligible Imbued Properties</strong> bane, charisma, dexterity, energy resistant (acid, cold, electricity, fire, negative, positive, sonic), fortification, lawful, mental, sensory (darkvision), spells (Primal: darkness, dimension door, nightmare, paranoia, ray of enfeeblement, silence, sleep, telekinetic projectile), wild, winged</p>","privateNotes":"","publication":{"title":"Battlezoo Bestiary","authors":"Derrick Ferry","license":"OGL","remaster":false},"creatureType":""},"resources":{},"_migration":{"version":0.932,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"abilities":{"str":{"mod":-5},"dex":{"mod":7},"con":{"mod":5},"int":{"mod":3},"wis":{"mod":4},"cha":{"mod":6}},"perception":{"details":"","mod":22,"senses":[{"type":"darkvision"},{"type":"lifesense","acuity":"precise","range":120}],"vision":true},"saves":{"fortitude":{"value":19,"saveDetail":""},"reflex":{"value":25,"saveDetail":""},"will":{"value":22,"saveDetail":""}},"skills":{"acrobatics":{"base":25},"deception":{"base":24},"intimidation":{"base":24},"stealth":{"base":25},"thievery":{"base":25}},"traits":{"value":["dream","fey","incorporeal","lawful"],"rarity":"uncommon","size":{"value":"tiny"}}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"prototypeToken":{"bar1":{"attribute":"attributes.hp"},"displayName":20,"displayBars":20,"flags":{"pf2e":{"linkToActorSize":true,"autoscale":true}},"height":0.5,"width":0.5,"disposition":-1,"name":"Jikou","actorLink":false,"lockRotation":false,"rotation":0,"alpha":1,"bar2":{"attribute":null},"randomImg":false,"light":{"alpha":0.25,"angle":360,"bright":0,"coloration":1,"dim":0,"luminosity":0.5,"saturation":0,"contrast":0,"shadows":0,"animation":{"speed":5,"intensity":5,"type":null,"reverse":false},"darkness":{"min":0,"max":1},"color":null,"attenuation":0.5,"negative":false,"priority":0},"texture":{"src":"modules/battlezoo-bestiary-pf2e/art/Tokens/jikou.webp","tint":"#ffffff","scaleX":1,"scaleY":1,"anchorX":0.5,"anchorY":0.5,"fit":"contain","alphaThreshold":0.75},"sight":{"angle":360,"enabled":false,"range":0,"brightness":1,"visionMode":"basic","color":null,"attenuation":0.1,"saturation":0,"contrast":0},"detectionModes":{},"appendNumber":false,"prependAdjective":false,"occludable":{"radius":0},"ring":{"enabled":true,"colors":{"ring":null,"background":null},"effects":1,"subject":{"scale":1,"texture":"modules/battlezoo-bestiary-pf2e/art/Subjects/jikou.webp"}},"turnMarker":{"mode":1,"animation":null,"src":null,"disposition":false},"movementAction":null,"depth":0.5},"_stats":{"systemId":"pf2e","systemVersion":"6.1.0","coreVersion":"14.360","createdTime":1663517316966,"modifiedTime":1729379235488,"lastModifiedBy":"ZdvNMqfYMlbFrAL2","compendiumSource":"Compendium.battlezoo-bestiary-pf2e.pf2e-battlezoo-bestiary.Actor.mWCnsUnCqGxNSAWV","duplicateSource":null,"exportSource":null}}