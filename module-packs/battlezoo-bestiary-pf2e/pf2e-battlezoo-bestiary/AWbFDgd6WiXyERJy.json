[/r 1d6[poison]]] damage, off-guard, and @Compendium[pf2e.conditionitems.fesd1n5eVhpCSS18]{Sickened 1} (1 round);</p>\n<p><strong>Stage 3</strong> [[/r 1d6[poison]]] damage, off-guard, and @Compendium[pf2e.conditionitems.fesd1n5eVhpCSS18]{Sickened 2} (1 round)</p>\n"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["divine","poison"],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"offensive","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"KamFosEv3QojnOGW","name":"Swarming Rags","type":"action","img":"systems/pf2e/icons/actions/OneAction.webp","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"gm":"","value":"<p>Each enemy in the dishrag dervish's space takes [[/r 1d8[bludgeoning]]] damage (@Check[type:reflex|dc:21|name:Swarming Rags DC|traits:damaging-effect,divine, evocation|showDC:gm]{basic Reflex} save) plus ectoplasmic dishwater.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["divine"],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":1},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"VmI2d6xsAAsgQhXp","name":"Greasy Spill","type":"action","img":"systems/pf2e/icons/actions/TwoActions.webp","effects":[],"folder":null,"sort":-50000,"flags":{},"system":{"description":{"gm":"","value":"<p>The dishrag dervish dumps grimy buckets and wrings out filthy sponges, creating a slippery puddle in a @Template[type:burst|distance:15] that lasts for 1 minute. Each creature standing in the area must succeed at a @Check[type:reflex|dc:20|name:Greasy Spill DC|showDC:gm]{Reflex} save or @Check[type:acrobatics|dc:20|name:|showDC:gm]{Acrobatics} check or fall @Compendium[pf2e.conditionitems.j91X7x0XSomq8d60]{Prone}. Creatures using an action to move into the affected area must attempt either a Reflex save or an Acrobatics check to Balance. A creature that Steps or Crawls doesn't have to attempt a check or save.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":2},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"Zm2NSH2tG0YL3mjt","name":"Swarm Mind","type":"action","img":"systems/pf2e/icons/actions/Passive.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>@Localize[PF2E.NPC.Abilities.Glossary.SwarmMind]</p>"},"rules":[],"slug":"swarm-mind","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"defensive","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""},"weapon":{"value":""}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.bestiary-ability-glossary-srd.Item.baA0nSMhQyFyJIia","duplicateSource":null,"exportSource":null}}],"effects":[],"folder":null,"sort":0,"flags":{"pf2e":{"lootable":false},"core":{}},"system":{"attributes":{"hp":{"value":35,"temp":0,"max":35,"details":"negative healing, rejuvenation"},"ac":{"value":19,"details":"","base":19},"allSaves":{"value":""},"speed":{"value":0,"otherSpeeds":[{"type":"fly","label":"Fly","value":25}],"details":""},"immunities":[{"type":"death-effects"},{"type":"disease"},{"type":"paralyzed"},{"type":"poison"},{"type":"precision"},{"type":"swarm-mind"},{"type":"unconscious"}],"weaknesses":[{"type":"area-damage","value":5},{"type":"splash-damage","value":5}],"resistances":[{"type":"all-damage","value":5,"exceptions":["force","ghost-touch","vitality"],"doubleVs":["non-magical"]},{"type":"bludgeoning","value":5},{"type":"piercing","value":5}]},"initiative":{"statistic":"perception"},"details":{"languages":{"value":["common"],"details":""},"level":{"value":4},"blurb":"","publicNotes":"<p>Clattering down stained hallways, sloshing across warped bars, and looming in dusty closets, the swarming spirits called dishrag dervishes haunt the ruins of pubs, bars, and other communal places of libationary indulgence.</p>\n<p>The hardest-working employees of public houses and taverns—waiters, servants, bar hands, and others at the bottom rungs of the business—typically sustain the most abuse and indignity from guests and employers alike. Tragically, when destruction visits the establishment in the form of riotous mobs or belligerent arsonists, these same workers are also among the most likely to perish in the attack. Perhaps it is no wonder, then, why sometimes in the aftermath of an attack these poor souls refuse to move onto the afterlife until the indignities they've suffered have been set right.</p>\n<p>To haunt the building that caused them so much agony in life, these vengeful souls manifest as grubby dishrags, splintered brooms, and buckets of scummy dishwater that clatter across the drinking hall and terrorize anyone who still dares patronize the sinful business. It isn't long before the haunted drinking establishment goes out of business completely; yet, still, a dishrag dervish will go on haunting the ruins of its former tormentors until the last drop of alcohol is scrubbed from the building's floorboards.</p>\n<h2>Tempestuous Teetotalers</h2>\n<p>In abandoned taverns, dishrag dervishes hide in plain sight as discarded cleaning supplies or common trash until their sordid domain is disturbed. These spirits particularly despise rowdy revelers, unrepentant litterers, and anyone who openly worships a god of debauchery or libations. In combat, a dishrag dervish will single-mindedly target such bacchants and braggadocios, ignoring all others until it has slaked its thirst for vengeance.</p>\n<h2>Sitebound Spirit</h2>\n<p>When a mass tragedy like a shipwreck or theatre fire claims the lives of sailors, performers, or other inhabitants whose identities were inextricably tied to the vessel or building in which they perished, the end result is often a malevolent spirit such as a wispy wayfarer. These ghostly beings cling to the Material Plane with a vengeance, assuming billowy shapes that reflect the trappings of their sacred place of work.</p>\n<h2>Monster Part Subsystem</h2>\n<p><strong>Dishrag Dervish Creature 4 </strong></p>\n<p><strong>Monster Parts</strong> 12/27/50 gp</p>\n<p><strong>Eligible Refinements</strong> weapons (bludgeoning), armor (light), perception item, skill items (Intimidation, Lore [Alcohol], Stealth)</p>\n<p><strong>Eligible Imbued Properties</strong> bane, chaotic, charisma, dexterity, energy resistant (acid, cold, electricity, fire, negative, sonic), evil, fortification, negative, poison, sensory (darkvision), wild, winged</p>","privateNotes":"","publication":{"title":"Battlezoo Bestiary","authors":"Alex G. Friedman","license":"OGL","remaster":false},"creatureType":""},"resources":{},"_migration":{"version":0.932,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"abilities":{"str":{"mod":-5},"dex":{"mod":5},"con":{"mod":0},"int":{"mod":1},"wis":{"mod":2},"cha":{"mod":4}},"perception":{"details":"","mod":10,"senses":[{"type":"darkvision"}],"vision":true},"saves":{"fortitude":{"value":12,"saveDetail":""},"reflex":{"value":14,"saveDetail":""},"will":{"value":8,"saveDetail":""}},"skills":{"intimidation":{"base":12},"stealth":{"base":13}},"traits":{"value":["chaotic","evil","incorporeal","spirit","swarm","undead","unholy"],"rarity":"common","size":{"value":"lg"}}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"prototypeToken":{"bar1":{"attribute":"attributes.hp"},"displayName":20,"displayBars":20,"flags":{"pf2e":{"linkToActorSize":true,"autoscale":true}},"height":2,"width":2,"disposition":-1,"name":"Dishrag Dervish","actorLink":false,"lockRotation":false,"rotation":0,"alpha":1,"bar2":{"attribute":null},"randomImg":false,"light":{"alpha":0.25,"angle":360,"bright":0,"coloration":1,"dim":0,"luminosity":0.5,"saturation":0,"contrast":0,"shadows":0,"animation":{"speed":5,"intensity":5,"type":null,"reverse":false},"darkness":{"min":0,"max":1},"color":null,"attenuation":0.5,"negative":false,"priority":0},"texture":{"src":"modules/battlezoo-bestiary-pf2e/art/Tokens/dishrag_dervish.webp","tint":"#ffffff","scaleX":1,"scaleY":1,"anchorX":0.5,"anchorY":0.5,"fit":"contain","alphaThreshold":0.75},"sight":{"angle":360,"enabled":false,"range":0,"brightness":1,"visionMode":"basic","color":n