{"_id":"rj1nC8Y1T1pVxY7N","name":"Galtzagorri Hunter","type":"npc","img":"modules/battlezoo-bestiary-pf2e/art/galtzagorri.webp","items":[{"_id":"GGzgMSO3uoe7j9mn","name":"Low-Light Vision","type":"action","img":"systems/pf2e/icons/actions/Passive.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>@Localize[PF2E.NPC.Abilities.Glossary.LowLightVision]</p>"},"rules":[],"slug":"low-light-vision","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"interaction","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""},"weapon":{"value":""}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.bestiary-ability-glossary-srd.Item.fFu2sZz4KB01fVRc","duplicateSource":null,"exportSource":null}},{"_id":"oKv8PnMR2pc5xmRb","name":"Craft Anything","type":"action","img":"systems/pf2e/icons/actions/Passive.webp","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"gm":"","value":"<p>The galtzagorri has the @Compendium[pf2e.feats-srd.xWY5omyIcILNR7y1]{Magical Crafting} and @Compendium[pf2e.feats-srd.is3Oz9wt11lNq62K]{Alchemical Crafting} feats.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["skill"],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"interaction","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"d