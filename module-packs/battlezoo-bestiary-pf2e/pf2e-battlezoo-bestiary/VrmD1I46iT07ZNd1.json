licateSource":null,"exportSource":null}},{"_id":"v0IFumqVvkfEn4n3","name":"Claw","type":"melee","img":"systems/pf2e/icons/default-icons/melee.svg","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"value":"","gm":""},"rules":[],"slug":null,"traits":{"value":[],"otherTags":[]},"damageRolls":{"x8fkzmabf0dkro27w4i4":{"damage":"1d6+4","damageType":"slashing","category":null}},"bonus":{"value":11},"attackEffects":{"value":[]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"_migration":{"version":0.932,"previous":{"schema":null,"foundry":"12.328","system":"6.1.0"}}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"XKCydSHvoGYze5Px","name":"Rock","type":"melee","img":"systems/pf2e/icons/default-icons/melee.svg","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"value":"","gm":""},"rules":[],"slug":null,"traits":{"value":["range-increment-60"],"otherTags":[]},"damageRolls":{"wuix8yit8dsigny5g5oo":{"damage":"1d8+4","damageType":"bludgeoning","category":null}},"bonus":{"value":10},"attackEffects":{"value":[]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"_migration":{"version":0.932,"previous":{"schema":null,"foundry":"12.328","system":"6.1.0"}}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"zJeYRKT2Kc2Bq6NC","name":"Drop Stalactites","type":"action","img":"systems/pf2e/icons/actions/TwoActions.webp","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"gm":"","value":"<p><strong>Requirements</strong> The shale spitter is underground;</p>\n<p><strong>Frequency</strong> once per hour;</p>\n\n<p><strong>Effect</strong> The shale spitter glows bright orange and emits a magical shockwave, causing spires of rock to fall from the ceiling in a @Template[type:burst|distance:20] centered on a point within 120 feet. Creatures in the area take [[/r 3d6[piercing]]] damage (@Check[type:reflex|dc:18|name:|traits:damaging-effect,conjuration,earth,primal|showDC:gm]{basic Reflex} save) and the area becomes difficult terrain.</p>\n<p>The shale spitter can't Drop Stalactites again for [[/br 1d4 #rounds]]{1d4 rounds}.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["earth","primal"],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":2},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"4sphRx94w4RCtJWN","name":"Spit Shale","type":"action","img":"systems/pf2e/icons/actions/TwoActions.webp","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"gm":"","value":"<p>The shale spitter violently regurgitates a hail of rock and dust in a @Template[type:cone|distance:15] that deals [[/r 2d6[piercing]]] damage (@Check[type:reflex|dc:18|name:Spit Shale DC|traits:damaging-effect,earth,evocation,primal|showDC:gm]{basic Reflex} save). Targets who critically fail their saving throw are also @Compendium[pf2e.conditionitems.TkIyaNPgTZFBCCuh]{Dazzled} for 1 round.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["earth","primal"],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":2},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}}],"effects":[],"folder":null,"sort":0,"flags":{"pf2e":{"lootable":false},"core":{}},"system":{"attributes":{"hp":{"value":30,"temp":0,"max":30,"details":""},"ac":{"value":18,"details":"20 while curled up","base":18},"allSaves":{"value":""},"speed":{"value":20,"otherSpeeds":[{"type":"burrow","label":"Burrow","value":30},{"type":"climb","label":"Climb","value":20}],"details":"rock stride"},"immunities":[{"type":"bleed"}],"resistances":[{"type":"piercing","value":3},{"type":"slashing","value":3}]},"initiative":{"statistic":"perception"},"details":{"languages":{"value":[],"details":""},"level":{"value":2},"blurb":"","publicNotes":"<p>Resembling not much more than a pile of overlapping pieces of slate rock at first glance, the stalwart shale spitter is a skittering isopod with a rocky carapace. It thrives in mountainous and underground areas, where it gathers minerals for sustenance and reproduces asexually.</p>\n<p>Similar to how common pearl oysters produce beautiful beads of polished nacre, shale spitters produce unique, iridescent tourmaline gemstones as a byproduct of their digestion process. These gems remain embedded in shale spitters' digestive tracts and help break down hard minerals, but people in fashionable social circles prize the tourmalines for jewelry and decoration. This makes the harvesting of shale spitter gems an emerging enterprise—albeit a dangerous one, since as of yet, no one has quite figured out how to tame these crafty critters.</p>\n<p>Shale spitters are notoriously territorial and typically congregate in small packs of three to five. Their social proclivities are hardly a result of a desire for companionship; shale spitters give their fellows a modest berth. Rather, these animals gather only to cast a wide defensive net in case intruders or predators threaten their feeding and breeding grounds.</p>\n<p>Adventurers or miners hunting shale spitters must first slay a shale spitter before cracking it open to retrieve the tourmaline inside, but subduing these isopods is no easy task. Shale spitters have developed senses for detecting the faintest vibrations in their rocky homes, as well as sharp claws and teeth for burrowing away from threats. From the safety of a nook or hole, shale spitters can discourage predators by spitting stones at deadly speed or, amazingly, tapping into some primal connection with caves in order to instantaneously conjure stalagmites or stalactites.</p>\n<h2>Primal Powers</h2>\n<p>The source of shale spitters' amazing ability to summon rocky protrusions from the stone around them has stumped researchers for centuries. Cave druids maintain that the unique gemstone inside a shale spitter is responsible for this power, but so far, all experiments to eke out the tourmaline's magic have failed.</p>\n<h2>Shale Spitter</h2>\n<p>Earthen isopods that subsist on crystals and stones in order to proliferate under mighty mountains, shale spitters run the gamut in terms of the challenges they pose to spelunking adventurers. The lowliest of shale spitter kind are little more than scuttling nuisances or, at worst, swarms of stony spawn. On the other end of the spectrum are behemoths that might be called mountains in themselves—looming terrors that dominate entire caverns and give form to whole underground ecosystems. All share one common characteristic that makes every shale spitter highly sought after by fortune-seeking monster hunters: Their crystalline waste matter is literally worth more than its weight in gold.</p>\n<h2>Monster Part Subsystem</h2>\n<p><strong>Shale Spitter Creature 2 </strong></p>\n<p><strong>Monster Parts</strong> 5/12/22 gp</p>\n<p><strong>Eligible Refinements</strong> weapons (bludgeoning, piercing, slashing), armor (heavy), shield, perception item, skill items (Athletics, Stealth)</p>\n<p><strong>Eligible Imbued Properties</strong> bane, constitution, energy resistant (positive), sensory (darkvision), strength, sturdy, wild</p>","privateNotes":"","publication":{"title":"Battlezoo Bestiary","authors":"Brant Vallier","license":"OGL","remaster":false},"creatureType":""},"resources":{},"_migration":{"version":0.932,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"abilities":{"str":{"mod":3},"dex":{"mod":2},"con":{"mod":4},"int":{"mod":-4},"wis":{"mod":2},"cha":{"mod":0}},"perception":{"details":"","mod":8,"senses":[{"type":"darkvision"},{"type":"tremorsense","acuity":"imprecise","range":60}],"vision":true},"saves":{"fortitude":{"value":11,"saveDetail":""},"reflex":{"value":8,"saveDetail":""},"will":{"value":6,"saveDetail":""}},"skills":{"athletics":{"base":7},"stealth":{"base":6,"special":[{"label":"in Caves","base":8,"predicate":["terrain:cave"]}]}},"traits":{"value":["animal","earth"],"rarity":"common","size":{"value":"med"}},"customModifiers":{}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"prototypeToken":{"bar1":{"attribute":"attributes.hp"},"displayName":20,"displayBars":20,"flags":{"pf2e":{"linkToActorSize":true,"autoscale":true}},"height":1,"width":1,"disposition":-1,"name":"Shale Spitter","actorLink":false,"lockRotation":false,"rotation":0,"alpha":1,"bar2":{"attribute":null},"randomImg":false,"light":{"alpha":0.25,"angle":360,"bright":0,"coloration":1,"dim":0,"luminosity":0.5,"saturation":0,"contrast":0,"shadows":0,"animation":{"speed":5,"intensity":5,"type":null,"reverse":false},"darkness":{"min":0,"max":1},"attenuation":0.5,"color":null,"negative":false,"priority":0},"texture":{"src":"modules/battl