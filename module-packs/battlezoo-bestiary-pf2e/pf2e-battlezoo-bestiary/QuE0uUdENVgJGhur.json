ong> The damage increases by 1d12.</p>"},"rules":[],"slug":"lightning-bolt","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","electricity","manipulate"],"rarity":"common","traditions":["arcane","primal"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":3},"requirements":"","target":{"value":""},"range":{"value":""},"area":{"value":120,"type":"line"},"time":{"value":"2"},"duration":{"value":"","sustained":false},"damage":{"0":{"applyMod":false,"formula":"4d12","type":"electricity","category":null,"materials":[],"kinds":["damage"]}},"defense":{"passive":null,"save":{"statistic":"reflex","basic":true}},"cost":{"value":""},"location":{"value":"QjOhe2HHtLt8lsOv","heightenedLevel":4},"counteraction":false,"heightening":{"type":"interval","interval":1,"damage":{"0":"1d12"}}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.9AAkVUCwF6WVNNY2","duplicateSource":null,"exportSource":null}},{"_id":"ryMg5yUyDVZS2Mts","name":"Private Sanctum","type":"spell","img":"systems/pf2e/icons/spells/private-sanctum.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>From outside, the area looks like a bank of impenetrable black fog. Sensory stimuli (such as sounds, smells, and light) don't pass from inside the area to outside the area. Scrying spells can't perceive any stimuli from the area, and mind-reading effects don't work in the area.</p>"},"rules":[],"slug":"private-sanctum","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","manipulate"],"rarity":"uncommon","traditions":["arcane","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":4},"requirements":"","target":{"value":""},"range":{"value":"touch"},"area":null,"time":{"value":"10 minutes"},"duration":{"value":"24 hours","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"QjOhe2HHtLt8lsOv","heightenedLevel":4},"counteraction":false},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.onjZCEHs3JJJRTD0","duplicateSource":null,"exportSource":null}},{"_id":"3TCqy9CRSEG0es97","name":"Shield Other (Constant) (On Prinicpal Only)","type":"spell","img":"systems/pf2e/icons/spells/shield-other.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>You forge a temporary link between the target's life essence and your own. The target takes half damage from all effects that deal Hit Point damage, and you take the remainder of the damage. When you take damage through this link, you don't apply any resistances, weaknesses, or other abilities you have to that damage; you simply take that amount of damage. The spell ends if the target is ever more than 30 feet away from you. If either you or the target is reduced to 0 Hit Points, any damage from this spell is resolved and then the spell ends.</p>"},"rules":[],"slug":"shield-other","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","manipulate"],"rarity":"common","traditions":["divine"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":2},"requirements":"","target":{"value":"1 creature"},"range":{"value":"30 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"10 minutes","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"QjOhe2HHtLt8lsOv","heightenedLevel":4},"counteraction":false,"heightening":{"type":"interval","interval":1,"damage":{}}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.d7Lwx6KAs47MtF0q","duplicateSource":null,"exportSource":null}},{"_id":"57px28ZkHvJrmuwH","name":"Infernal Pact","type":"spell","img":"systems/pf2e/icons/spells/infernal-pact.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>You make an appeal to a powerful devil, asking it to bind some of its subordinates to your service. If you succeed, the devil sends you its choice of one devil whose level is no more than double <em>infernal pact's</em> level, two devils whose levels are each at least 2 less than double the spell level, or three devils whose levels are each at least 3 less than double the spell level.</p>\n<hr />\n<p><strong>Critical Success</strong> The devils are sent to you and serve you for [[/r 1d4 #weeks]]{1d4 weeks}.</p>\n<p><strong>Success</strong> The devils are sent to you and serve you for [[/r 1d4 #days]]{1d4 days}.</p>\n<p><strong>Failure</strong> Your request is denied.</p>\n<p><strong>Critical Failure</strong> Not only is your request denied, but the powerful devil sends word of its displeasure to your master.</p>"},"rules":[],"slug":"infernal-pact","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[],"rarity":"uncommon","traditions":[]},"publication":{"title":"Pathfinder Bestiary","authors":"","license":"OGL","remaster":false},"level":{"value":1},"requirements":"","target":{"value":""},"range":{"value":""},"area":null,"time":{"value":"1 day"},"duration":{"value":"","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":null},"counteraction":false,"ritual":{"primary":{"check":"Religion (expert; you must be a devil)"},"secondary":{"checks":"","casters":0}}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.30BBep9U4BDV0EgQ","duplicateSource":null,"exportSource":null}},{"_id":"ehdkEB6TTaH1omIQ","name":"Change Shape","type":"action","img":"systems/pf2e/icons/actions/OneAction.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>When an excubitor is contracted to protect a principal, the contract specifies a specific alternate form for the chaperone devil. The excubitor can change shape to assume this specific shape, which is usually a Small or Medium humanoid. This doesn't alter any of the devil's statistics. If killed, the excubitor reverts to its true form.</p>\n<hr />\n<p>@Localize[PF2E.NPC.Abilities.Glossary.ChangeShape]</p>"},"rules":[],"slug":"change-shape","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","divine","polymorph"],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":1},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""},"weapon":{"value":""}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.bestiary-ability-glossary-srd.Item.eQM5hQ1W3d1uen97","duplicateSource":null,"exportSource":null}},{"_id":"Ynl2bJTFGfhbCNOH","name":"Regurgitate","type":"action","img":"systems/pf2e/icons/actions/TwoActions.webp","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"gm":"","value":"<p>The excubitor expels the contents of its stomach, including creatures Swallowed Whole.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":2},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"caAa6gmDgeXDafyr","name":"Swallow Evidence","type":"action","img":"systems/pf2e/icons/actions/OneAction.webp","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"gm":"","value":"<p>The excubitor grotesquely distends its jaws and, impossibly, swallows a creature as big as itself, transporting the swallowed creature into an extradimensional stomach.</p>\n<p>The excubitor @Compendium[pf2e.bestiary-ability-glossary-srd.uJSseLa57HZYSMUu]{Swallows Whole} a Medium or smaller creature ([[/r {4d6[poison],2d6[spirit]}]]{4d6 poison plus 2d6 spirit}, Rupture 15). The devil can forgo dealing this damage and can breathe in air so swallowed creatures don't suffocate. The excubitor's stomach can hold up to three Medium creatures.</p>\n<p>While the devil has any surviving creatures in its stomach it cannot use <em>@Compendium[pf2e.spells-srd.VlNcjmYyu95vOUe8]{Dimension Door}</em> effects.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["attack","unholy"],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":1},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}}],"effects":[],"folder":null,"sort":0,"flags":{"pf2e":{"lootable":false},"core":{}},"system":{"attributes":{"hp":{"value":135,"temp":0,"max":135,"details":""},"ac":{"value":27,"details":"","base":27},"allSaves":{"value":"+1 status to all saves vs. magic"},"speed":{"value":25,"otherSpeeds":[],"details":""},"immunities":[{"type":"fire"}],"weaknesses":[{"type":"holy","value":10}],"resistances":[{"type":"physical","value":10,"exceptions":["silver"]},{"type":"poison","value":10}]},"initiative":{"statistic":"perception"},"details":{"languages":{"value":["common","diabolic","draconic","empyrean"],"details":"telepathy 100 feet"},"level":{"value":8},"blurb":"","publicNotes":"<p>Devils have a reputation for being diabolical masterminds, but not all of them live up to that reputation. Excubitors, also known as chaperone devils, are forged from the souls of mortals who aided and abetted the evils of others rather than committing their own atrocities. In Hell, despite their formidable power, excubitors rank quite low in the diabolic hierarchy as they rarely achieve any triumphs which they can truly call their own.</p>\n<p>The reward for a devil who in life was \"just following orders\" is an eternity of following the orders of mortals. Chaperone devils specialize in protecting Hell's most important mortal assets-villains, criminal masterminds, and satanic warlords whose capacity for scheming overshadows their physical acumen. Excubitors are contracted to protect these important individuals from would-be law officers, knights, and other do-gooders. More than one would-be hero has nearly confronted a heinous villain only to first fall to that villain's \"secretary\"-a fiendish excubitor bodyguard, with fists like iron and an almost bottomless pit of a stomach.</p>\n<h2>Fiendish Partners</h2>\n<p>A phistophilus (also called a contract devil; see the Pathfinder Second Edition Bestiary) can assign an excubitor to protect a mortal as part of the contract signed by that mortal. Excubitors cannot create new contracts themselves. The mortal beneficiary of this contract is known as the \"principal.\"</p>\n<h2>Monster Part Subsystem</h2>\n<p><strong>Excubitor (Chaperone Devil) Creature 8 </strong></p>\n<p><strong>Monster Parts</strong> 64/140/250 gp</p>\n<p><strong>Eligible Refinements</strong> weapons (bludgeoning, piercing), armor (medium), shield, perception item, skill items (Athletics, Deception, Intimidation, Medicine, Religion, Society)</p>\n<p><strong>Eligible Imbued Properties</strong> bane, constitution, electricity, energy resistant (fire, positive), evil, fire, lawful, mental, poison, sensory (greater darkvision), spells (Divine: dimension door, dimension door, fireball, lightning bolt, private sanctum, shield other), strength, sturdy, wild</p>","privateNotes":"","publication":{"title":"Battlezoo Bestiary","authors":"Lau Bannenberg","license":"OGL","remaster":false},"creatureType":""},"resources":{},"_migration":{"version":0.932,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"abilities":{"str":{"mod":6},"dex":{"mod":4},"con":{"mod":5},"int":{"mod":0},"wis":{"mod":2},"cha":{"mod":3}},"perception":{"details":"","mod":18,"senses":[{"type":"greater-darkvision"}],"vision":true},"saves":{"fortitude":{"value":19,"saveDetail":""},"reflex":{"value":14,"saveDetail":""},"will":{"value":14,"saveDetail":""}},"skills":{"athletics":{"base":18},"deception":{"base":17},"intimidation":{"base":17},"medicine":{"base":14},"religion":{"base":16},"society":{"base":14}},"traits":{"value":["devil","evil","fiend","lawful","unholy"],"rarity":"common","size":{"value":"med"}},"spellcasting":{"rituals":{"dc":23}}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"prototypeToken":{"bar1":{"attribute":"attributes.hp"},"displayName":20,"displayBars":20,"flags":{"pf2e":{"linkToActorSize":true,"autoscale":true}},"height":1,"width":1,"disposition":-1,"name":"Excubitor","actorLink":false,"lockRotation":false,"rotation":0,"alpha":1,"bar2":{"attribute":null},"randomImg":false,"light":{"alpha":0.25,"angle":360,"bright":0,"coloration":1,"dim":0,"luminosity":0.5,"saturation":0,"contrast":0,"shadows":0,"animation":{"speed":5,"intensity":5,"type":null,"reverse":false},"darkness":{"min":0,"max":1},"attenuation":0.5,"color":null,"negative":false,"priority":0},"texture":{"src":"modules/battlezoo-bestiary-pf2e/art/Tokens/excubitor.webp","scaleX":1,"scaleY":1,"tint":"#ffffff","anchorX":0.5,"anchorY":0.5,"fit":"contain","alphaThreshold":0.75},"sight":{"angle":360,"enabled":false,"range":0,"brightness":1,"visionMode":"basic","color":null,"attenuation":0.1,"saturation":0,"contrast":0},"detectionModes":{},"appendNumber":false,"prependAdjective":false,"occludable":{"radius":0},"ring":{"enabled":true,"colors":{"ring":null,"background":null},"effects":1,"subject":{"scale":1,"texture":"modules/battlezoo-bestiary-pf2e/art/Subjects/excubitor.webp"}},"turnMarker":{"mode":1,"animation":null,"src":null,"disposition":false},"movementAction":null,"depth":1},"_stats":{"systemId":"pf2e","systemVersion":"6.1.0","coreVersion":"14.360","createdTime":1663517316816,"modifiedTime":1729381175130,"lastModifiedBy":"ZdvNMqfYMlbFrAL2","compendiumSource":"Compendium.battlezoo-bestiary-pf2e.pf2e-battlezoo-bestiary.Actor.QuE0uUdENVgJGhur","duplicateSource":null,"exportSource":{"worldId":"battlezoo","uuid":null,"coreVersion":"0.8.9","systemId":"pf2e","systemVersion":"2.14.4"}}}