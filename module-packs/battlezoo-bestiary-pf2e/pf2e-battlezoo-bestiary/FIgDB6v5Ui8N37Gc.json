lee.svg","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"value":"","gm":""},"rules":[],"slug":null,"traits":{"value":["magical","range-increment-120"],"otherTags":[]},"damageRolls":{"zik2h5ssn8f3p7w18gj0":{"damage":"3d6+14","damageType":"mental","category":null}},"bonus":{"value":26},"attackEffects":{"value":["temporal-trauma"]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"_migration":{"version":0.932,"previous":{"schema":null,"foundry":"12.328","system":"6.1.0"}}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"mLM0AYoYmDbs3C4A","name":"Arcane Innate Spells","type":"spellcastingEntry","img":"systems/pf2e/icons/default-icons/spellcastingEntry.svg","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"gm":"","value":""},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"ability":{"value":"wis"},"spelldc":{"value":23,"dc":31,"mod":0},"tradition":{"value":"arcane"},"prepared":{"value":"innate","flexible":false},"showSlotlessLevels":{"value":false},"proficiency":{"value":0},"slots":{"slot0":{"prepared":[],"value":0,"max":0},"slot1":{"prepared":[],"value":0,"max":0},"slot2":{"prepared":[],"value":0,"max":0},"slot3":{"prepared":[],"value":0,"max":0},"slot4":{"prepared":[],"value":0,"max":0},"slot5":{"prepared":[],"value":0,"max":0},"slot6":{"prepared":[],"value":0,"max":0},"slot7":{"prepared":[],"value":0,"max":0},"slot8":{"prepared":[],"value":0,"max":0},"slot9":{"prepared":[],"value":0,"max":0},"slot10":{"prepared":[],"value":0,"max":0},"slot11":{"prepared":[],"value":0,"max":0}},"autoHeightenLevel":{"value":null},"showUnpreparedSpells":{"value":true},"displayLevels":{}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"rLnKPuWumxuDWO7K","name":"Retrocognition","type":"spell","img":"systems/pf2e/icons/spells/retrocognition.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>Opening your mind to occult echoes, you gain impressions from past events that occurred in your current location. Retrocognition reveals psychic impressions from events that occurred over the course of the last day throughout the first minute of the duration, followed by impressions from the next day back the next minute, and so on. These echoes don't play out like a vision but instead reveal impressions of emotions and metaphors that provide cryptic clues and details of the past. If you witness a traumatic or turbulent event through an impression, the spell ends unless you succeed at a Will save with a DC of at least 30 and possibly as much as 50, depending on the severity of the event. The GM determines whether an event is traumatic and chooses the DC.</p>\n<hr />\n<p><strong>Heightened (8th)</strong> You gain impressions of events that occurred over the previous year for each minute you concentrate, instead of the previous day, though the details diminish, making it harder to distinguish impressions from all but the most major events.</p>\n<p><strong>Heightened (9th)</strong> You gain impressions of events that occurred over the previous century for each minute you concentrate, instead of the previous day, though the details diminish, making it almost impossible to distinguish impressions from all but the most major events.</p>"},"rules":[],"slug":"retrocognition","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","manipulate"],"rarity":"common","traditions":["occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":7},"requirements":"","target":{"value":""},"range":{"value":""},"area":null,"time":{"value":"1 minute"},"duration":{"value":"","sustained":true},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"mLM0AYoYmDbs3C4A","heightenedLevel":7},"counteraction":false},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.rsZ5c0AUyywe5yoK","duplicateSource":null,"exportSource":null}},{"_id":"YdXhwgaobuCiwVZz","name":"Vibrant Pattern","type":"spell","img":"systems/pf2e/icons/spells/vibrant-pattern.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>You create a pattern of lights that pulses with intensity. Creatures are @Compendium[pf2e.conditionitems.TkIyaNPgTZFBCCuh]{Dazzled} while inside the pattern. In addition, a creature must attempt a Will saving throw if it's inside the pattern when you cast it, enters the pattern, ends its turn within the pattern, or uses a Seek or Interact action on the pattern. A creature currently @Compendium[pf2e.conditionitems.XgEqL1kFApUbl5Z2]{Blinded} by the pattern doesn't need to attempt new saving throws.</p>\n<hr />\n<p><strong>Success</strong> The creature is unaffected.</p>\n<p><strong>Failure</strong> The creature is Blinded by the pattern. If it exits the pattern, it can attempt a new save to recover from the Blinded condition at the end of each of its turns, to a maximum duration of 1 minute.</p>\n<p><strong>Critical Failure</strong> The creature is Blinded for 1 minute.</p>"},"rules":[],"slug":"vibrant-pattern","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["illusion","incapacitation","manipulate","visual"],"rarity":"common","traditions":["arcane","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":6},"requirements":"","target":{"value":""},"range":{"value":"120 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"1 minute","sustained":true},"damage":{},"defense":{"passive":null,"save":{"statistic":"will","basic":false}},"cost":{"value":""},"location":{"value":"mLM0AYoYmDbs3C4A","heightenedLevel":6},"counteraction":false},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.RQjSQVZRG497cJhX","duplicateSource":null,"exportSource":null}},{"_id":"AuuQdIRwH0uWS8E0","name":"Locate","type":"spell","img":"systems/pf2e/icons/spells/locate.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>You learn the direction to the target (if you picked a specific object, such as \"my mother's sword\") or the nearest target (if you picked a type of object, such as \"swords\"). If the target is a specific object, you must have observed it directly with your own senses. If it's a type of object, you still need to have an accurate mental image of the type of object. If there's lead or running water between you and the target, this spell can't locate the object. This means you might find a type of object farther away if the nearest one is behind lead or running water.</p>\n<hr />\n<p><strong>Heightened (5th)</strong> You can target a specific creature or ancestry instead of an object, but you must have met or seen up close the creature or ancestry you want to target.</p>"},"rules":[],"slug":"locate","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","detection","manipulate"],"rarity":"uncommon","traditions":["arcane","divine","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":3},"requirements":"","target":{"value":"1 specific object or type of object"},"range":{"value":"500 feet"},"area":null,"time":{"value":"10 minutes"},"duration":{"value":"","sustained":true},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"mLM0AYoYmDbs3C4A","heightenedLevel":5},"counteraction":false,"heightening":{"levels":{"5":{"target":{"value":"1 specific object or type of object, or a specific creature or ancestry"}}},"type":"fixed"}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.LQzlKbYjZSMFQawP","duplicateSource":null,"exportSource":null}},{"_id":"cklxibmf58Rtbix4","name":"Prying Eye","type":"spell","img":"systems/pf2e/icons/spells/prying-eye.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>You create an @Compendium[pf2e.conditionitems.zJxUflt9np0q4yML]{Invisible}, floating eye, 1 inch in diameter, at a location you can see within 500 feet. It sees in all directions with your normal visual senses and continuously transmits what it sees to you. The first time you Sustain the Spell each round, you can either move the eye up to 30 feet, seeing only things in front of the eye, or move it up to 10 feet, seeing everything in all directions around it. There is no limit to how far from you the eye can move, but the spell ends immediately if you and the eye ever cease to be on the same plane of existence. You can attempt Seek actions through the eye if you want to attempt Perception checks with it. Any damage dealt to the eye destroys it and ends the spell.</p>"},"rules":[],"slug":"prying-eye","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","manipulate","scrying"],"rarity":"common","traditions":["arcane","divine","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":5},"requirements":"","target":{"value":""},"range":{"value":"see text"},"area":null,"time":{"value":"1 minute"},"duration":{"value":"","sustained":true},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"mLM0AYoYmDbs3C4A","heightenedLevel":5},"counteraction":false},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.Ek5XI0aEdZhBgm21","duplicateSource":null,"exportSource":null}},{"_id":"Gw2RuGc1NwGp5mvv","name":"True Seeing (Constant)","type":"spell","img":"systems/pf2e/icons/spells/true-seeing.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>You see things within 60 feet as they actually are. The GM rolls a secret counteract check against any illusion or transmutation in the area, but only for the purpose of determining whether you see through it (for instance, if the check succeeds against a polymorph spell, you can see the creature's true form, but you don't end the polymorph spell).</p>"},"rules":[],"slug":"true-seeing","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","manipulate","revelation"],"rarity":"common","traditions":["arcane","divine","occult","primal"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":6},"requirements":"","target":{"value":""},"range":{"value":""},"area":null,"time":{"value":"2"},"duration":{"value":"10 minutes","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"mLM0AYoYmDbs3C4A","heightenedLevel":6},"counteraction":true,"heightening":{"type":"interval","interval":1,"damage":{}}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.uqlxMQQeSGWEVjki","duplicateSource":null,"exportSource":null}},{"_id":"ePJv3AT8i77e3dJl","name":"Calamity Vent","type":"action","img":"systems/pf2e/icons/actions/TwoActions.webp","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"gm":"","value":"<p>The dredgenaut rapidly burns off some of the damning supernatural evidence stored in its body, then releases the fiery, time-infused energy from vents all over its body. Each creature in a @Template[type:burst|distance:30] takes [[/r {6d8[fire],6d8[mental]}]]{6d8 fire and 6d8 mental damage} (@Check[type:reflex|dc:34|name:Calamity Vent DC|traits:damaging-effect,arcane,evocation,fire,mental,time|showDC:gm]{basic Reflex} save).</p>\n<p>Affected creatures instantly age 1 year per 2 mental damage taken.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["arcane","fire","mental","time"],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":2},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"ph9SZ2GBphXekPUe","name":"Inexorable March","type":"action","img":"systems/pf2e/icons/actions/OneAction.webp","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"gm":"","value":"<p>The dredgenaut Strides up to its Speed, pushing back each creature whose space it moves into and damaging them if they try to stop its movement.</p>\n<p>A creature can attempt to bar the way by succeeding at a @Check[type:fortitude|dc:38|name:Inexorable March DC|traits:damaging-effect|showDC:gm]{Fortitude} save. On a critical success, the resisting creature takes no damage; otherwise, it is damaged as if hit by the dredgenaut's foot.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":1},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"HhKZcHg3rXpwDgls","name":"Swallow Whole","type":"action","img":"systems/pf2e/icons/actions/OneAction.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>Large, [[/r (3d8+8)[bludgeoning]]] damage, Rupture 25.</p>\n<p>The dredgenaut can use Swallow Whole on any creature @Compendium[pf2e.conditionitems.kWc1fhmv9LBiTuei]{Grabbed} in its claws.</p>\n<hr />\n<p>@Localize[PF2E.NPC.Abilities.Glossary.SwallowWhole]</p>"},"rules":[],"slug":"swallow-whole","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["attack"],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":1},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""},"weapon":{"value":""}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.bestiary-ability-glossary-srd.Item.uJSseLa57HZYSMUu","duplicateSource":null,"exportSource":null}},{"_id":"k3nfKdwQPWzoI28s","name":"Temporal Trauma","type":"action","img":"systems/pf2e/icons/actions/Passive.webp","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"gm":"","value":"<p>When condensed, burned as fuel, and vented, evidence collected by a dredgenaut washes over living creatures as a wave of psychic trauma and disruption to the flow of time itself.</p>\n<p>Any creature damaged by a dredgenaut's chrono beam Strike instantly ages 1 year per 2 mental damage taken (for example, a creature that takes 20 mental damage ages 10 years).</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["arcane","time"],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"offensive","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"rdDMe3TmPEkrcVl9","name":"Trample","type":"action","img":"systems/pf2e/icons/actions/ThreeActions.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>Large or smaller, foot, @Check[type:reflex|dc:36|name:Trample DC|traits:damaging-effect|showDC:gm]{basic Reflex}</p>\n<hr />\n<p>@Localize[PF2E.NPC.Abilities.Glossary.Trample]</p>"},"rules":[],"slug":"trample","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":3},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""},"weapon":{"value":""}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.bestiary-ability-glossary-srd.Item.UNah0bxXxkcZjxO3","duplicateSource":null,"exportSource":null}},{"_id":"M5VfxUz1OnflPPbI","name":"Improved Grab","type":"action","img":"systems/pf2e/icons/actions/FreeAction.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>@Localize[PF2E.NPC.Abilities.Glossary.ImprovedGrab]</p>"},"rules":[],"slug":"improved-grab","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"free"},"category":"offensive","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""},"weapon":{"value":""}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.bestiary-ability-glossary-srd.Item.i18TlebMzwONyPhI","duplicateSource":null,"exportSource":null}}],"effects":[],"folder":null,"sort":0,"flags":{"pf2e":{"lootable":false},"core":{}},"system":{"attributes":{"hp":{"value":230,"temp":0,"max":230,"details":""},"ac":{"value":35,"details":"","base":35},"allSaves":{"value":""},"speed":{"value":30,"otherSpeeds":[{"type":"burrow","label":"Burrow","value":45}],"details":""},"immunities":[{"type":"bleed"},{"type":"death-effects"},{"type":"disease"},{"type":"doomed"},{"type":"drained"},{"type":"fatigued"},{"type":"healing"},{"type":"mental"},{"type":"nonlethal-attacks"},{"type":"paralyzed"},{"type":"poison"},{"type":"sickened"},{"type":"unconscious"}],"resistances":[{"type":"physical","value":15,"exceptions":["adamantine"]}]},"initiative":{"statistic":"perception"},"details":{"languages":{"value":[],"details":""},"level":{"value":14},"blurb":"","publicNotes":"<p>The first dredgenaut was supposed to be the last. It was made, so the legend goes, by a desperate community whose corrupt leadership had long denied its people justice for some ancient crime. The scavengers of the community collected scrap metal and trinkets of better times, then fused everything to create a construct that would uncover ample evidence of the ancient crime and force the leaders to acknowledge their atrocities. Yet, the leaders managed to steal the dredgenaut and use the powerful construct to track down its creators. The screams of these talented inventors could be heard for miles around. And so it was that the secrets of creating dredgenauts were revealed to all.</p>\n<p>A dredgenaut is a powerful construct made of scrap metal and fueled by arcane toxic runoff. Powerful nations and private companies use dredgenauts to trawl for criminal evidence-either their enemies' or their own-in battlefields and ruined cities. To collect evidence, the dredgenaut picks up noteworthy items or creatures and drops them into the aperture on its face, \"swallowing\" them for later deposit. For reasons not entirely understood, dredgenauts are particularly prone to collecting supernatural or psychically resonant evidence that, when destroyed, can have dramatic aging effects on nearby living creatures.</p>\n<h2>Desperate Measures</h2>\n<p>Though its primary objective is to gather evidence, sometimes a dredgenaut must temporarily forego this mission in order to ensure its own safety. By reconfiguring various internal gears and tubes, the dredgenaut can funnel collected evidence from its storage compartments into its engine core, causing the engine to overheat as magic items, trapped spirits, and other occult phenomena break down in the construct's body. The dredgenaut can then release this excess energy either via a \"chrono beam\" from its face or by venting the energy from its body in a sudden burst.</p>\n<h2>Monster Part Subsystem</h2>\n<p><strong>Dredgenaut Creature 14 </strong></p>\n<p><strong>Monster Parts</strong> 560/1,250/2,300 gp</p>\n<p><strong>Eligible Refinements</strong> weapons (bludgeoning, slashing), armor (heavy), shield, perception item, skill items (Athletics)</p>\n<p><strong>Eligible Imbued Properties</strong> bane, constitution, energy resistant (negative, positive), fire, mental, sensory (greater darkvision, true seeing), spells (Arcane: locate, prying eye, retrocognition, true seeing, vibrant pattern), strength, sturdy, wild</p>","privateNotes":"","publication":{"title":"Battlezoo Bestiary","authors":"Rigby Bendele","license":"OGL","remaster":false},"creatureType":""},"resources":{},"_migration":{"version":0.932,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"abilities":{"str":{"mod":8},"dex":{"mod":4},"con":{"mod":6},"int":{"mod":-5},"wis":{"mod":0},"cha":{"mod":-1}},"perception":{"details":"","mod":24,"senses":[{"type":"greater-darkvision"},{"type":"truesight","acuity":"precise","range":60}],"vision":true},"saves":{"fortitude":{"value":28,"saveDetail":""},"reflex":{"value":22,"saveDetail":""},"will":{"value":18,"saveDetail":""}},"skills":{"athletics":{"base":30}},"traits":{"value":["construct","mindless"],"rarity":"uncommon","size":{"value":"huge"}}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"prototypeToken":{"bar1":{"attribute":"attributes.hp"},"displayName":20,"displayBars":20,"flags":{"pf2e":{"linkToActorSize":true,"autoscale":false}},"height":3,"width":3,"disposition":-1,"name":"Dredgenaut","actorLink":false,"lockRotation":false,"rotation":0,"alpha":1,"bar2":{"attribute":null},"randomImg":false,"light":{"alpha":0.25,"angle":360,"bright":0,"coloration":1,"dim":0,"luminosity":0.5,"saturation":0,"contrast":0,"shadows":0,"animation":{"speed":5,"intensity":5,"type":null,"reverse":false},"darkness":{"min":0,"max":1},"color":null,"attenuation":0.5,"negative":false,"priority":0},"texture":{"src":"modules/battlezoo-bestiary-pf2e/art/Tokens/dredgenaut.webp","tint":"#ffffff","scaleX":2,"scaleY":2,"anchorX":0.5,"anchorY":0.5,"fit":"contain","alphaThreshold":0.75},"sight":{"angle":360,"enabled":false,"range":0,"brightness":1,"visionMode":"basic","color":null,"attenuation":0.1,"saturation":0,"contrast":0},"detectionModes":{},"appendNumber":false,"prependAdjective":false,"occludable":{"radius":0},"ring":{"enabled":true,"colors":{"ring":null,"background":null},"effects":1,"subject":{"scale":2,"texture":"modules/battlezoo-bestiary-pf2e/art/Subjects/dredgenaut.webp"}},"turnMarker":{"mode":1,"animation":null,"src":null,"disposition":false},"movementAction":null,"depth":3},"_stats":{"systemId":"pf2e","systemVersion":"6.1.0","coreVersion":"14.360","createdTime":1663517316747,"modifiedTime":1729380754691,"lastModifiedBy":"ZdvNMqfYMlbFrAL2","compendiumSource":"Compendium.battlezoo-bestiary-pf2e.pf2e-battlezoo-bestiary.Actor.FIgDB6v5Ui8N37Gc","duplicateSource":null,"exportSource":null}}