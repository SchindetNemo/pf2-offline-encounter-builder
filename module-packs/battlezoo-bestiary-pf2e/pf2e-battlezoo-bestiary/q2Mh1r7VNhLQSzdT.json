id":"TKj5ulbdPBrFjhk2"},{"id":"EB81uAljQxXWX08i"},{"id":"tnxlI20KUNwsGso4"},{"id":"4lNA7nLZcO8mD9zO"},{"id":"GVOY4dqaClCKhDN6"},{"id":"ADwqItlSR59QsDRN"}],"value":0,"max":6},"slot1":{"prepared":[{"id":"usq66YnFtgXTtfnW"},{"id":"OMOusDoKLZb98q5O"},{"id":"OMOusDoKLZb98q5O"},{"id":"tS3dYnwazyQ8N9R0"},{"id":"H0EVfvMAFy5oYsNK"}],"value":0,"max":5},"slot2":{"prepared":[{"id":"Wa5isk91HfstaG3J"},{"id":"jBJxaO3WIPCXRyZz"},{"id":"tXItbrnr9tOk6mbX"},{"id":"tXItbrnr9tOk6mbX"}],"value":0,"max":4},"slot3":{"prepared":[{"id":"X7CvPX9AtS3Wetw1"},{"id":"usq66YnFtgXTtfnW"},{"id":"7yNNPEA7a4WKnUTn"}],"value":0,"max":3},"slot4":{"prepared":[],"value":0,"max":0},"slot5":{"prepared":[],"value":0,"max":0},"slot6":{"prepared":[],"value":0,"max":0},"slot7":{"prepared":[],"value":0,"max":0},"slot8":{"prepared":[],"value":0,"max":0},"slot9":{"prepared":[],"value":0,"max":0},"slot10":{"prepared":[],"value":0,"max":0},"slot11":{"prepared":[],"value":0,"max":0}},"autoHeightenLevel":{"value":null},"showUnpreparedSpells":{"value":false},"displayLevels":{}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"X7CvPX9AtS3Wetw1","name":"Glyph of Warding","type":"spell","img":"systems/pf2e/icons/spells/glyph-of-warding.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>You craft a trap by binding a hostile spell into a symbol. While Casting this Spell, you also Cast a Spell of a lower spell level to store in the glyph. The stored spell must take 3 actions or fewer to cast, have a hostile effect, and target one creature or have an area. You can set a password, a trigger, or both for the glyph. Any creature that moves, opens, or touches the target container or enters the target area that doesn't speak the password or that matches the trigger activates the glyph, releasing the harmful spell within.</p>\n<p>Once a spell is stored in the glyph, the glyph gains all the traits of that spell. If the stored spell targets one or more creatures, it targets the creature that set off the glyph. If it has an area, that area is centered on the creature that set off the glyph. Glyph of warding's duration ends when the glyph is triggered. The glyph counts as a magical trap, using your spell DC for both the Perception check to notice it and the Thievery check to disable it; both checks require the creature attempting them to be trained in order to succeed.</p>\n<p>You can Dismiss glyph of warding. The maximum number of glyphs of warding you can have active at a time is equal to your spellcasting ability modifier.</p>"},"rules":[],"slug":"glyph-of-warding","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","manipulate"],"rarity":"common","traditions":["arcane","divine","occult","primal"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":3},"requirements":"","target":{"value":"1 container or a 10-foot-by-10-foot area"},"range":{"value":"touch"},"area":null,"time":{"value":"10 minutes"},"duration":{"value":"unlimited","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"1iGNIp8JjnfsMVAY"},"counteraction":false},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.o0l57UfBm9ScEUMW","duplicateSource":null,"exportSource":null}},{"_id":"Wa5isk91HfstaG3J","name":"Comprehend Language","type":"spell","img":"systems/pf2e/icons/spells/comprehend-language.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>The target can understand the meaning of a single language it is hearing or reading when you cast the spell. This doesn't let it understand codes, language couched in metaphor, and the like (subject to GM discretion). If the target can hear multiple languages and knows that, it can choose which language to understand; otherwise, choose one of the languages randomly.</p>\n<hr />\n<p><strong>Heightened (3rd)</strong> The target can also speak the language.</p>\n<p><strong>Heightened (4th)</strong> You can target up to 10 creatures, and targets can also speak the language.</p>"},"rules":[],"slug":"comprehend-language","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","manipulate"],"rarity":"common","traditions":["arcane","divine","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":2},"requirements":"","target":{"value":"1 creature"},"range":{"value":"30 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"1 hour","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"1iGNIp8JjnfsMVAY"},"counteraction":false,"heightening":{"levels":{"4":{"target":{"value":"10 creatures"}}},"type":"fixed"}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.vTQvfYu2llKQedmY","duplicateSource":null,"exportSource":null}},{"_id":"usq66YnFtgXTtfnW","name":"Magic Missile","type":"spell","img":"systems/pf2e/icons/spells/magic-missile.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>You send a dart of force streaking toward a creature that you can see. It automatically hits and deals 1d4+1 force damage. For each additional action you use when Casting the Spell, increase the number of missiles you shoot by one, to a maximum of three missiles for 3 actions. You choose the target for each missile individually. If you shoot more than one missile at the same target, combine the damage before applying bonuses or penalties to damage, resistances, weaknesses, and so forth.</p>\n<hr />\n<p><strong>Heightened (+2)</strong> You shoot one additional missile with each action you spend.</p>"},"rules":[],"slug":"magic-missile","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","force","manipulate"],"rarity":"common","traditions":["arcane","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":1},"requirements":"","target":{"value":"1 creature"},"range":{"value":"120 feet"},"area":null,"time":{"value":"1 to 3"},"duration":{"value":"","sustained":false},"damage":{"0":{"formula":"1d4+1","type":"force","category":null,"materials":[],"kinds":["damage"]}},"defense":null,"cost":{"value":""},"location":{"value":"1iGNIp8JjnfsMVAY"},"counteraction":false},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.gKKqvLohtrSJj3BM","duplicateSource":null,"exportSource":null}},{"_id":"jBJxaO3WIPCXRyZz","name":"Dispel Magic","type":"spell","img":"systems/pf2e/icons/spells/dispel-magic.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>You unravel the magic behind a spell or effect. Attempt a counteract check against the target. If you successfully counteract a magic item, the item becomes a mundane item of its type for 10 minutes. This doesn't change the item's non-magical properties. If the target is an artifact or similar item, you automatically fail.</p>"},"rules":[],"slug":"dispel-magic","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","manipulate"],"rarity":"common","traditions":["arcane","divine","occult","primal"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":2},"requirements":"","target":{"value":"1 spell effect or unattended magic item"},"range":{"value":"120 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"1iGNIp8JjnfsMVAY"},"counteraction":true},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.9HpwDN4MYQJnW0LG","duplicateSource":null,"exportSource":null}},{"_id":"TKj5ulbdPBrFjhk2","name":"Mage Hand","type":"spell","img":"systems/pf2e/icons/spells/mage-hand.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>You create a single magical hand, either invisible or ghostlike, that grasps the target object and moves it slowly up to 20 feet. Because you're levitating the object, you can move it in any direction. When you Sustain the Spell, you can move the object an additional 20 feet. If the object is in the air when the spell ends, the object falls.</p>\n<hr />\n<p><strong>Heightened (3rd)</strong> You can target an unattended object with a Bulk of 1 or less.</p>\n<p><strong>Heightened (5th)</strong> The range increases to 60 feet, and you can target an unattended object with a Bulk of 1 or less.</p>\n<p><strong>Heightened (7th)</strong> The range increases to 60 feet, and you can target an unattended object with a Bulk of 2 or less.</p>"},"rules":[],"slug":"mage-hand","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["cantrip","concentrate","manipulate"],"rarity":"common","traditions":["arcane","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":1},"requirements":"","target":{"value":"1 unattended object of light Bulk or less"},"range":{"value":"30 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"","sustained":true},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"1iGNIp8JjnfsMVAY"},"counteraction":false,"heightening":{"levels":{"3":{"target":{"value":"1 unattended object with a Bulk of 1 or less"}},"5":{"range":{"value":"60 feet"}},"7":{"target":{"value":"1 unattended object with a Bulk of 2 or less"}}},"type":"fixed"}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.pwzdSlJgYqN7bs2w","duplicateSource":null,"exportSource":null}},{"_id":"OMOusDoKLZb98q5O","name":"Mending","type":"spell","img":"systems/pf2e/icons/spells/mending.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>You repair the target item. You restore 5 Hit Points per spell level to the target, potentially removing the @Compendium[pf2e.conditionitems.6dNUvdb1dhToNDj3]{Broken} condition if this repairs it past the item's Broken Threshold. You can't replace lost pieces or repair an object that's been completely destroyed.</p>\n<hr />\n<p><strong>Heightened (2nd)</strong> You can target a non-magical object of 1 Bulk or less.</p>\n<p><strong>Heightened (3rd)</strong> You can target a non-magical object of 2 Bulk or less, or a magical object of 1 Bulk or less.</p>"},"rules":[],"slug":"mending","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","manipulate"],"rarity":"common","traditions":["arcane","divine","occult","primal"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":1},"requirements":"","target":{"value":"non-magical object of light Bulk or less"},"range":{"value":"touch"},"area":null,"time":{"value":"10 minutes"},"duration":{"value":"","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"1iGNIp8JjnfsMVAY"},"counteraction":false,"heightening":{"levels":{"2":{"target":{"value":"non-magical object of 1 Bulk or less"}},"3":{"target":{"value":"non-magical object of 2 Bulk or less, or a magical object of 1 Bulk or less"}}},"type":"fixed"}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.dINQzhqGmIsqGMUY","duplicateSource":null,"exportSource":null}},{"_id":"EB81uAljQxXWX08i","name":"Message","type":"spell","img":"systems/pf2e/icons/spells/message.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>You mouth words quietly, but instead of coming out of your mouth, they're transferred directly to the ears of the target. While others can't hear your words any better than if you normally mouthed them, the target can hear your words as if they were standing next to you.</p>\n<p>The target can give a brief response as a reaction, or as a free action on their next turn if they wish, but they must be able to see you and be within range to do so. If they respond, their response is delivered directly to your ear, just like the original message.</p>\n<hr />\n<p><strong>Heightened (3rd)</strong> The spell's range increases to 500 feet.</p>"},"rules":[],"slug":"message","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["auditory","cantrip","concentrate","illusion","linguistic","mental"],"rarity":"common","traditions":["arcane","divine","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":1},"requirements":"","target":{"value":"1 creature"},"range":{"value":"120 feet"},"area":null,"time":{"value":"1"},"duration":{"value":"see below","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"1iGNIp8JjnfsMVAY"},"counteraction":false,"heightening":{"levels":{"3":{"range":{"value":"500 feet"}}},"type":"fixed"}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.vLzFcIaSXs7YTIqJ","duplicateSource":null,"exportSource":null}},{"_id":"tnxlI20KUNwsGso4","name":"Prestidigitation","type":"spell","img":"systems/pf2e/icons/spells/prestidigitation.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>The simplest magic does your bidding. You can perform simple magical effects for as long as you Sustain the Spell. Each time you Sustain the Spell, you can choose one of four options.</p>\n<ul>\n<li><strong>Cook</strong> Cool, warm, or flavor 1 pound of nonliving material.</li>\n<li><strong>Lift</strong> <strong>Slowly</strong> lift an unattended object of light Bulk or less 1 foot off the ground.</li>\n<li><strong>Make</strong> Create a temporary object of negligible Bulk, made of congealed magical substance. The object looks crude and artificial and is extremely fragile-it can't be used as a tool, weapon, or spell component.</li>\n<li><strong>Tidy</strong> Color, clean, or soil an object of light Bulk or less. You can affect an object of 1 Bulk with 10 rounds of concentration, and a larger object a 1 minute per Bulk.</li>\n</ul>\n<p>Prestidigitation can't deal damage or cause adverse conditions. Any actual change to an object (beyond what is noted above) persists only as long as you Sustain the Spell.</p>"},"rules":[],"slug":"prestidigitation","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["cantrip","concentrate","manipulate"],"rarity":"common","traditions":["arcane","divine","occult","primal"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":1},"requirements":"","target":{"value":"1 object (cook, lift, or tidy only)"},"range":{"value":"10 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"","sustained":true},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"1iGNIp8JjnfsMVAY"},"counteraction":false},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.Qw3fnUlaUbnn7ipC","duplicateSource":null,"exportSource":null}},{"_id":"tS3dYnwazyQ8N9R0","name":"Ray of Enfeeblement","type":"spell","img":"systems/pf2e/icons/spells/ray-of-enfeeblement.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>A ray that saps a foe's strength flashes from your hand. Attempt a ranged spell attack against the target. If you succeed, that creature attempts a Fortitude save to determine the spell's effect. If your attack roll is a critical success, use the outcome for one degree of success worse than the result of its save.</p>\n<hr />\n<p><strong>Critical Success</strong> The target is unaffected.</p>\n<p><strong>Success</strong> The target becomes @Compendium[pf2e.conditionitems.MIRkyAjyBeXivMa7]{Enfeebled 1}.</p>\n<p><strong>Failure</strong> The target becomes @Compendium[pf2e.conditionitems.MIRkyAjyBeXivMa7]{Enfeebled 2}.</p>\n<p><strong>Critical Failure</strong> The target becomes @Compendium[pf2e.conditionitems.MIRkyAjyBeXivMa7]{Enfeebled 3}.</p>"},"rules":[],"slug":"ray-of-enfeeblement","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["attack","concentrate","manipulate"],"rarity":"common","traditions":["arcane","divine","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":1},"requirements":"","target":{"value":"1 creature"},"range":{"value":"30 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"1 minute","sustained":false},"damage":{},"defense":{"passive":null,"save":{"statistic":"fortitude","basic":false}},"cost":{"value":""},"location":{"value":"1iGNIp8JjnfsMVAY"},"counteraction":false},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.J7Y7tl0bbdz7TcCc","duplicateSource":null,"exportSource":null}},{"_id":"4lNA7nLZcO8mD9zO","name":"Read Aura","type":"spell","img":"systems/pf2e/icons/spells/read-aura.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>You focus on the target object, opening your mind to perceive magical auras. When the casting is complete, you know whether that item is magical, and if it is, you learn the school of magic.</p>\n<p>If the object is illusory, you detect this only if the effect's level is lower than the level of your read aura spell.</p>\n<hr />\n<p><strong>Heightened (3rd)</strong> You can target up to 10 objects.</p>\n<p><strong>Heightened (6th)</strong> You can target any number of objects.</p>"},"rules":[],"slug":"read-aura","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["cantrip","concentrate","detection","manipulate"],"rarity":"common","traditions":["arcane","divine","occult","primal"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":1},"requirements":"","target":{"value":"1 object"},"range":{"value":"30 feet"},"area":null,"time":{"value":"1 Minute"},"duration":{"value":"","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"1iGNIp8JjnfsMVAY"},"counteraction":false,"heightening":{"levels":{"3":{"target":{"value":"10 objects"}},"6":{"target":{"value":"any number of objects"}}},"type":"fixed"}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.OhD2Z6rIGGD5ocZA","duplicateSource":null,"exportSource":null}},{"_id":"GVOY4dqaClCKhDN6","name":"Sigil","type":"spell","img":"systems/pf2e/icons/spells/sigil.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>You harmlessly place your unique magical sigil, which is about 1 square inch in size, on the targeted creature or object. The mark can be visible or invisible, and you can change it from one state to another by using an Interact action to touch the target. The mark can be scrubbed or scraped off with 5 minutes of work. If it's on a creature, it fades naturally over the course of a week. The time before the mark fades increases depending on your heightened level.</p>\n<hr />\n<p><strong>Heightened (3rd)</strong> The sigil instead fades after 1 month.</p>\n<p><strong>Heightened (5th)</strong> The sigil instead fades after 1 year.</p>\n<p><strong>Heightened (7th)</strong> The sigil never fades.</p>"},"rules":[],"slug":"sigil","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["cantrip"],"rarity":"common","traditions":["arcane","divine","occult","primal"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":1},"requirements":"","target":{"value":"1 creature or object"},"range":{"value":"touch"},"area":null,"time":{"value":"2"},"duration":{"value":"unlimited","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"1iGNIp8JjnfsMVAY"},"counteraction":false},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.AUctDF2fqPZN2w4W","duplicateSource":null,"exportSource":null}},{"_id":"H0EVfvMAFy5oYsNK","name":"Sleep","type":"spell","img":"systems/pf2e/icons/spells/sleep.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>Each creature in the area becomes drowsy and might fall asleep. A creature that falls @Compendium[pf2e.conditionitems.fBnFDH2MTzgFijKf]{Unconscious} from this spell doesn't fall @Compendium[pf2e.conditionitems.j91X7x0XSomq8d60]{Prone} or release what it's holding. This spell doesn't prevent creatures from waking up due to a successful Perception check, limiting its utility in combat.</p>\n<hr />\n<p><strong>Critical Success</strong> The creature is unaffected.</p>\n<p><strong>Success</strong> The creature takes a -1 status penalty to Perception checks for 1 round.</p>\n<p><strong>Failure</strong> The creature falls Unconscious. If it's still Unconscious after 1 minute, it wakes up automatically.</p>\n<p><strong>Critical Failure</strong> The creature falls Unconscious. If it's still Unconscious after 1 hour, it wakes up automatically.</p>\n<hr />\n<p><strong>Heightened (4th)</strong> The creatures fall Unconscious for 1 round on a failure or 1 minute on a critical failure. They fall Prone and release what they're holding, and they can't attempt Perception checks to wake up. When the duration ends, the creature is sleeping normally instead of automatically waking up.</p>"},"rules":[],"slug":"sleep","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","incapacitation","manipulate","mental","sleep"],"rarity":"common","traditions":["arcane","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":1},"requirements":"","target":{"value":""},"range":{"value":"30 feet"},"area":{"value":5,"type":"burst"},"time":{"value":"2"},"duration":{"value":"","sustained":false},"damage":{},"defense":{"passive":null,"save":{"statistic":"will","basic":false}},"cost":{"value":""},"location":{"value":"1iGNIp8JjnfsMVAY"},"counteraction":false},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.o4lRVTwSxnOOn5vl","duplicateSource":null,"exportSource":null}},{"_id":"7yNNPEA7a4WKnUTn","name":"Stinking Cloud","type":"spell","img":"systems/pf2e/icons/spells/stinking-cloud.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>You create a cloud of putrid mist in the area. The cloud functions as @Compendium[pf2e.spells-srd.9XHmC2JgTUIQ1CCm]{Obscuring Mist} except it sickens creatures that end their turns within the cloud. (The @Compendium[pf2e.conditionitems.DmAIPqOBomZ7H95W]{Concealed} condition is not a poison effect.)</p>\n<hr />\n<p><strong>Critical Success</strong> The creature is unaffected.</p>\n<p><strong>Success</strong> The creature is @Compendium[pf2e.conditionitems.fesd1n5eVhpCSS18]{Sickened 1}.</p>\n<p><strong>Failure</strong> The creature is @Compendium[pf2e.conditionitems.fesd1n5eVhpCSS18]{Sickened 1} and @Compendium[pf2e.conditionitems.xYTAsEpcJE1Ccni3]{Slowed 1} while in the cloud.</p>\n<p><strong>Critical Failure</strong> The creature is @Compendium[pf2e.conditionitems.fesd1n5eVhpCSS18]{Sickened 2} and @Compendium[pf2e.conditionitems.xYTAsEpcJE1Ccni3]{Slowed 1} until it leaves the cloud.</p>"},"rules":[],"slug":"stinking-cloud","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","manipulate","poison"],"rarity":"common","traditions":["arcane","primal"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":3},"requirements":"","target":{"value":""},"range":{"value":"120 feet"},"area":{"value":20,"type":"burst"},"time":{"value":"2"},"duration":{"value":"1 minute","sustained":false},"damage":{},"defense":{"passive":null,"save":{"statistic":"fortitude","basic":false}},"cost":{"value":""},"location":{"value":"1iGNIp8JjnfsMVAY"},"counteraction":false},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.GKpEcy9WId6NJvtx","duplicateSource":null,"exportSource":null}},{"_id":"tXItbrnr9tOk6mbX","name":"Telekinetic Maneuver","type":"spell","img":"systems/pf2e/icons/spells/telekinetic-maneuver.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>With a rush of telekinetic power, you move a foe or something they carry. You can attempt to Disarm, Shove, or Trip the target using a spell attack roll instead of an Athletics check.</p>"},"rules":[],"slug":"telekinetic-maneuver","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["attack","concentrate","force","manipulate"],"rarity":"common","traditions":["arcane","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":2},"requirements":"","target":{"value":"1 creature"},"range":{"value":"60 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"1iGNIp8JjnfsMVAY"},"counteraction":false},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.mrDi3v933gsmnw25","duplicateSource":null,"exportSource":null}},{"_id":"ADwqItlSR59QsDRN","name":"Telekinetic Projectile","type":"spell","img":"systems/pf2e/icons/spells/telekinetic-projectile.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>You hurl a loose, unattended object that is within range and that has 1 Bulk or less at the target. Make a spell attack roll against the target. If you hit, you deal bludgeoning, piercing, or slashing damage-as appropriate for the object you hurled-equal to 1d6 plus your spellcasting ability modifier. No specific traits or magic properties of the hurled item affect the attack or the damage.</p>\n<hr />\n<p><strong>Critical Success</strong> You deal double damage.</p>\n<p><strong>Success</strong> You deal full damage.</p>\n<hr />\n<p><strong>Heightened (+1)</strong> The damage increases by 1d6.</p>"},"rules":[],"slug":"telekinetic-projectile","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["attack","cantrip","concentrate","manipulate"],"rarity":"common","traditions":["arcane","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":1},"requirements":"","target":{"value":"1 creature"},"range":{"value":"30 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"","sustained":false},"damage":{"0":{"applyMod":true,"formula":"1d6","type":"untyped","category":null,"materials":[],"kinds":["damage"]}},"defense":null,"cost":{"value":""},"location":{"value":"1iGNIp8JjnfsMVAY"},"counteraction":false,"heightening":{"type":"interval","interval":1,"damage":{"0":"1d6"}}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.60sgbuMWN0268dB7","duplicateSource":null,"exportSource":null}},{"_id":"DzuPS1bYRbEaHFzh","name":"Ghostly Revisions","type":"action","img":"systems/pf2e/icons/actions/Passive.webp","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"gm":"","value":"<p>Any time a ghostwriter inhabits a spellbook with Inhabit Text, it automatically edits the text, making it difficult for the next reader to parse the words. The next time a spellcaster attempts to prepare spells from the spellbook, that spellcaster must attempt a @Check[type:arcana|dc:24|name:Ghostly Revisions DC|showDC:gm]{Arcana} check.</p>\n\n<p>Regardless of the result, the edits disappear afterward and don't affect subsequent preparations.</p>\n<hr />\n<p><strong>Critical Success</strong> The spellcaster deduces that the edits are, in fact, quite brilliant. The spellcaster can prepare one additional spell of the highest level for which they have spell slots. The GM determines this spell randomly.</p>\n<p><strong>Success</strong> The spellcaster is unaffected and can prepare spells normally.</p>\n<p><strong>Failure</strong> One random spell is made illegible in the spellbook. The spellcaster can't prepare that spell today.</p>\n<p><strong>Critical Failure</strong> As failure, but one random spell per spell level is made illegible.</p>\n"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"offensive","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"BtjQc7m9M8AZgCUa","name":"Inhabit Text","type":"action","img":"systems/pf2e/icons/actions/TwoActions.webp","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"gm":"","value":"<p>The ghostwriter possesses a book, scroll, roll of parchment, or similar-sized text within 20 feet. This has the same effect as the <em>@Compendium[pf2e.spells-srd.wU6hNzK8Yfqdmc8m]{Possession}</em> spell, except that the ghostwriter can target only works of text and the ghostwriter leaves no physical body behind while it possesses a text.</p>\n<p>If a creature is holding the text the ghostwriter is attempting to inhabit, that creature can attempt a @Check[type:will|dc:24|name:Inhabit Text DC|showDC:gm]{Will} save to prevent the possession. The possessed text has the same statistics and abilities as the ghostwriter. If the ghostwriter is destroyed while possessing a text, the text is destroyed as well.</p>\n<p>When the possession ends, the ghostwriter reappears in the text's square and cannot Inhabit Text again for [[/br 1d4 #rounds]]{1d4 rounds}.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":2},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"BEqJZ0gVpkpkBof8","name":"Quick Study","type":"action","img":"systems/pf2e/icons/actions/OneAction.webp","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"gm":"","value":"<p><strong>Requirements</strong> The ghostwriter is possessing a spellbook using Inhabit Text;</p>\n<p><strong>Effect</strong> The ghostwriter changes one of its arcane prepared spells to a spell of the same spell level contained within the spellbook.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":1},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}}],"effects":[],"folder":null,"sort":0,"flags":{"pf2e":{"lootable":false},"core":{}},"system":{"attributes":{"hp":{"value":70,"temp":0,"max":70,"details":"negative healing, rejuvenation"},"ac":{"value":23,"details":"","base":23},"allSaves":{"value":""},"speed":{"value":0,"otherSpeeds":[{"type":"fly","label":"Fly","value":25}],"details":""},"immunities":[{"type":"death-effects"},{"type":"disease"},{"type":"paralyzed"},{"type":"poison"},{"type":"precision"},{"type":"unconscious"}],"resistances":[{"type":"all-damage","value":5,"exceptions":["force","ghost-touch","vitality"],"doubleVs":["non-magical"]}]},"initiative":{"statistic":"perception"},"details":{"languages":{"value":["common"],"details":"any 4 other languages"},"level":{"value":6},"blurb":"","publicNotes":"<p>Ghostwriters are undead spirits that possess and revise texts in a misguided attempt to improve upon writings or to trick living spellcasters and researchers into unwittingly utilizing the spirit's work.</p>\n<p>A ghostwriter typically rises from the spirit of an avid scholar or arcanist who labored endlessly but fruitlessly on a long-winded historical treatise or arcane thesis. Risen as a ghostwriter, this unswerving intellectual aims its creative energies at the writings of the living. Ghostwriters typically hide within spellbooks, twisting words and tweaking language in ways that can cause a wizard's spells to flourish or fizzle.</p>\n<h2>Stubborn Ego</h2>\n<p>Ghostwriters are easily offended by critics or readers that seem ungrateful for the spirit's attempts to improve their spells and documents; flattery is a far more fruitful tack. Though difficult, if one can convince a ghostwriter that their work is finished, the spirit can finally drift to the afterlife.</p>\n<h2>Monster Part Subsystem</h2>\n<p><strong>Ghostwriter Creature 6 </strong></p>\n<p><strong>Monster Parts</strong> 30/65/125 gp</p>\n<p><strong>Eligible Refinements</strong> perception item, skill items (Arcana, Deception, Intimidation, Lore [Academia], Stealth)</p>\n<p><strong>Eligible Imbued Properties</strong> bane, chaotic, charisma, dexterity, energy resistant (acid, cold, electricity, fire, negative, sonic), evil, fortification, intelligence, negative, sensory (darkvision), wild, winged</p>","privateNotes":"","publication":{"title":"Battlezoo Bestiary","authors":"Garrick J. Williams","license":"OGL","remaster":false},"creatureType":""},"resources":{},"_migration":{"version":0.932,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"abilities":{"str":{"mod":-5},"dex":{"mod":4},"con":{"mod":0},"int":{"mod":5},"wis":{"mod":2},"cha":{"mod":4}},"perception":{"details":"","mod":14,"senses":[{"type":"darkvision"}],"vision":true},"saves":{"fortitude":{"value":12,"saveDetail":""},"reflex":{"value":16,"saveDetail":""},"will":{"value":14,"saveDetail":""}},"skills":{"arcana":{"base":15},"deception":{"base":14},"intimidation":{"base":14},"stealth":{"base":15}},"traits":{"value":["chaotic","evil","incorporeal","spirit","undead","unholy"],"rarity":"common","size":{"value":"med"}}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"prototypeToken":{"bar1":{"attribute":"attributes.hp"},"displayName":20,"displayBars":20,"flags":{"pf2e":{"linkToActorSize":true,"autoscale":true}},"height":1,"width":1,"disposition":-1,"name":"Ghostwriter","actorLink":false,"lockRotation":false,"rotation":0,"alpha":1,"bar2":{"attribute":null},"randomImg":false,"light":{"alpha":0.25,"angle":360,"bright":0,"coloration":1,"dim":0,"luminosity":0.5,"saturation":0,"contrast":0,"shadows":0,"animation":{"speed":5,"intensity":5,"type":null,"reverse":false},"darkness":{"min":0,"max":1},"attenuation":0.5,"color":null,"negative":false,"priority":0},"texture":{"src":"modules/battlezoo-bestiary-pf2e/art/Tokens/ghostwriter.webp","scaleX":1,"scaleY":1,"tint":"#ffffff","anchorX":0.5,"anchorY":0.5,"fit":"contain","alphaThreshold":0.75},"sight":{"angle":360,"enabled":false,"range":0,"brightness":1,"visionMode":"basic","color":null,"attenuation":0.1,"saturation":0,"contrast":0},"detectionModes":{},"appendNumber":false,"prependAdjective":false,"occludable":{"radius":0},"ring":{"enabled":true,"colors":{"ring":null,"background":null},"effects":1,"subject":{"scale":1,"texture":"modules/battlezoo-bestiary-pf2e/art/Subjects/ghostwriter.webp"}},"turnMarker":{"mode":1,"animation":null,"src":null,"disposition":false},"movementAction":null,"depth":1},"_stats":{"systemId":"pf2e","systemVersion":"6.1.0","coreVersion":"14.360","createdTime":1663517316982,"modifiedTime":1729379235683,"lastModifiedBy":"ZdvNMqfYMlbFrAL2","compendiumSource":"Compendium.battlezoo-bestiary-pf2e.pf2e-battlezoo-bestiary.Actor.q2Mh1r7VNhLQSzdT","duplicateSource":null,"exportSource":null}}