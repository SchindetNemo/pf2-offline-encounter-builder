ctions/OneAction.webp","effects":[],"folder":null,"sort":500000,"flags":{},"system":{"description":{"gm":"","value":"<p><strong>Frequency</strong> three times per round;</p>\n<p><strong>Requirements</strong> A willing or mindless Medium or larger undead creature is within 20 feet of the necroflesh monarch;</p>\n\n<p><strong>Effect</strong> The necroflesh monarch grabs the undead creature with a pseudopod and unceremoniously sucks it into its oozy body, causing the monarch to regain [[/r 30 #hit points]]{30 Hit Points}. The second and third time per round the monarch Consumes the Dead, it regains only [[/r 20 #hit points]]{20 Hit Points} and [[/r 10 #hit points]]{10 Hit Points}, respectively (for a maximum of 60 Hit Points regained in a single round).</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["arcane","healing","manipulate"],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":1},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"GIj0TmVB1RxmMwzI","name":"Death is Not the End","type":"action","img":"systems/pf2e/icons/actions/Passive.webp","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"gm":"","value":"<p>If a creature dies within 1 minute of being struck by the necroflesh monarch's black bile, the dying creature must attempt a @Check[type:will|dc:36|name:Death is Not the End DC|traits:arcane, necromancy|showDC:gm]{Will} save just before it dies. On a failed check, the creature's flesh rapidly liquifies with its final breath, and the corpse rises as a mindless skeleton controlled by the necroflesh monarch.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["arcane"],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"offensive","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"FjFeZBA4p1cBfEsw","name":"Greater Constrict","type":"action","img":"systems/pf2e/icons/actions/OneAction.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>[[/r (3d8 + 9)[bludgeoning]]] damage, @Check[type:fortitude|dc:36|name:Greater Constrict DC|traits:damaging-effect|showDC:gm]{basic fortitude} save</p>\n<hr />\n<p>@Localize[PF2E.NPC.Abilities.Glossary.GreaterConstrict]</p>"},"rules":[],"slug":"greater-constrict","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":1},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""},"weapon":{"value":""}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.bestiary-ability-glossary-srd.Item.OmV6E3aELvq9CkK1","duplicateSource":null,"exportSource":null}},{"_id":"FSka21Amo1sygNwB","name":"Swallow Whole","type":"action","img":"systems/pf2e/icons/actions/OneAction.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>Large, [[/r (3d8 + 9)[void]]] damage, Rupture 30</p>\n<hr />\n<p>@Localize[PF2E.NPC.Abilities.Glossary.SwallowWhole]</p>"},"rules":[],"slug":"swallow-whole","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["attack"],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":1},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""},"weapon":{"value":""}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.bestiary-ability-glossary-srd.Item.uJSseLa57HZYSMUu","duplicateSource":null,"exportSource":null}}],"effects":[],"folder":null,"sort":0,"flags":{"pf2e":{"lootable":false},"core":{}},"system":{"attributes":{"hp":{"value":350,"temp":0,"max":350,"details":"negative healing"},"ac":{"value":33,"details":"","base":33},"allSaves":{"value":""},"speed":{"value":25,"otherSpeeds":[],"details":""},"immunities":[{"type":"critical-hits"},{"type":"death-effects"},{"type":"disease"},{"type":"mental"},{"type":"paralyzed"},{"type":"poison"},{"type":"precision"},{"type":"unconscious"},{"type":"visual"}],"resistances":[{"type":"physical","value":15,"exceptions":["magical","slashing"]}]},"initiative":{"statistic":"perception"},"details":{"languages":{"value":[],"details":""},"level":{"value":15},"blurb":"","publicNotes":"<p>A monstrosity of liquified flesh and bone, the necroflesh monarch is an undead ooze made from the muscle, fat, and sinew of countless victims, all turned toward undeath and combined into one pulsing, hulking form.</p>\n<p>Necroflesh monarchs wander aimlessly between remote villages, across desolate deserts, and beneath venerable mountains, always on the hunt for more victims to add to their quivering, corpulent body. When a monarch swallows a living creature, the victim struggles for breath before eventually succumbing to the ooze's life-leaching internal acids. The flesh and bone of a slain victim melt and become subsumed into the monarch's corpulent, amorphous form. In this way, a necroflesh monarch grows in both size and power.</p>\n<p>Strangely, and perhaps thankfully, a necroflesh monarch makes no distinction between prey of high or low provenance. To these mindless meat-beings, the most regal queen is of equal value to the lowliest peasant.</p>\n<p>The signs of a necroflesh monarch attack are obvious to anyone who knows what to look for: crushed houses, steaming puddles of black bile, and not a single body in sight. This latter clue is perhaps the eeriest aspect of necroflesh monarchs. For all their brutish simplicity, these oozy behemoths know at least enough not waste a single morsel.</p>\n<h2>Army of Bones</h2>\n<p>Though mindless, the necroflesh monarch possesses a few clever, if rudimentary, survival instincts. For instance, to make sure it never goes without a meal, a monarch tends to keep a troop or even a small army of skeletal warriors by its side at all times. These mindless undead follow the same primeval protocols as the necroflesh monarch, plodding aimlessly along and swinging their limbs violently to attack.</p>\n<p>The skeletons that follow a necroflesh monarch might be any level, though all are mindless. Regardless of how strong its skeletal companions might be, a monarch doesn't rely on its bony minions for protection—rather, it keeps them as a mobile food source to tap into during lean times.</p>\n<h2>Monster Part Subsystem</h2>\n<p><strong>Necroflesh Monarch Creature 15 </strong></p>\n<p><strong>Monster Parts</strong> 810/1,850/3,400 gp</p>\n<p><strong>Eligible Refinements</strong> weapons (bludgeoning), armor (light), shield, perception item, skill items (Athletics)</p>\n<p><strong>Eligible Imbued Properties</strong> acid, bane, charisma, energy resistant (negative), evil, fortification, mental, negative, strength, sturdy, wild</p>","privateNotes":"","publication":{"title":"Battlezoo Bestiary","authors":"Benjamin Medrano","license":"OGL","remaster":false},"creatureType":""},"resources":{},"_migration":{"version":0.932,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"abilities":{"str":{"mod":9},"dex":{"mod":4},"con":{"mod":0},"int":{"mod":-5},"wis":{"mod":0},"cha":{"mod":7}},"perception":{"details":"","mod":20,"senses":[{"type":"motion-sense","acuity":"imprecise","range":120}],"vision":false},"saves":{"fortitude":{"value":21,"saveDetail":""},"reflex":{"value":25,"saveDetail":""},"will":{"value":21,"saveDetail":""}},"skills":{"athletics":{"base":30}},"traits":{"value":["evil","mindless","ooze","undead","unholy"],"rarity":"uncommon","size":{"value":"grg"}}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"prototypeToken":{"bar1":{"attribute":"attributes.hp"},"displayName":20,"displayBars":20,"flags":{"pf2e":{"linkToActorSize":true,"autoscale":true}},"height":4,"width":4,"disposition":-1,"name":"Necroflesh Monarch","actorLink":false,"lockRotation":false,"rotation":0,"alpha":1,"bar2":{"attribute":null},"randomImg":false,"light":{"alpha":0.25,"angle":360,"bright":0,"coloration":1,"dim":0,"luminosity":0.5,"saturation":0,"contrast":0,"shadows":0,"animation":{"speed":5,"intensity":5,"type":null,"reverse":false},"darkness":{"min":0,"max":1},"color":null,"attenuation":0.5,"negative":false,"priority":0},"texture":{"src":"modules/battlezoo-bestiary-pf2e/art/Tokens/necroflesh_monarch.webp","tint":"#ffffff","scaleX":1,"scaleY":1,"anchorX":0.5,"anchorY":0.5,"fit":"contain","alphaThreshold":0.75},"sight":{"angle":360,"enabled":false,"range":0,"brightness":1,"visionMode":"basic","color":null,"attenuation":0.1