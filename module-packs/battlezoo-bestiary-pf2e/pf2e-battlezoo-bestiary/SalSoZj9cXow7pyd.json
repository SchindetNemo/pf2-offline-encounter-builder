:"action","img":"systems/pf2e/icons/actions/Passive.webp","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"gm":"","value":"<p>A ruin bruiser's fist inflicts the destructive effects of unbridled entropy on any creature or thing it touches. The persistent chaotic damage dealt by the ruin bruiser's fist Strike affects objects as well as creatures. Each round, an affected object rolls a @Check[type:flat|dc:15|name:Decaying Fist Flat Check|traits:arcane, chaotic|showDC:owner]{Flat Check} to end the persistent damage.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["arcane"],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"offensive","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"3OUNKTZW7c0FRemi","name":"Darkvision","type":"action","img":"systems/pf2e/icons/actions/Passive.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>@Localize[PF2E.NPC.Abilities.Glossary.Darkvision]</p>"},"rules":[],"slug":"darkvision","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"interaction","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""},"weapon":{"value":""}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"syst