,"max":0},"slot5":{"prepared":[],"value":0,"max":0},"slot6":{"prepared":[],"value":0,"max":0},"slot7":{"prepared":[],"value":0,"max":0},"slot8":{"prepared":[],"value":3,"max":3},"slot9":{"prepared":[],"value":3,"max":3},"slot10":{"prepared":[],"value":1,"max":1},"slot11":{"prepared":[],"value":0,"max":0}},"autoHeightenLevel":{"value":null},"showUnpreparedSpells":{"value":true},"displayLevels":{}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"Xrud4NQXQutLRm2Y","name":"Alter Reality","type":"spell","img":"systems/pf2e/icons/spells/alter-reality.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>You use your occult lore and the power of your mind to manipulate the spiritual multiverse, resulting in any of the following effects:</p>\n<ul>\n<li>Duplicate any occult spell of 9th level or lower.</li>\n<li>Duplicate any non-occult spell of 7th level or lower.</li>\n<li>Produce any effect whose power is equivalent to any occult spell 9th level or lower, or non-occult spell 7th level or lower.</li>\n<li>Reverse certain effects that refer to the wish spell</li>\n</ul>\n<p>At the GM's discretion, you can try to produce greater effects, but this is dangerous and the spell may have only a partial effect.</p>"},"rules":[],"slug":"alter-reality","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","manipulate"],"rarity":"common","traditions":["occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":10},"requirements":"","target":{"value":""},"range":{"value":""},"area":null,"time":{"value":"3"},"duration":{"value":"","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"W1zJSOwBt4PNPNlF","heightenedLevel":10},"counteraction":false},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.h8zxY9hTeHtWsBVW","duplicateSource":null,"exportSource":null}},{"_id":"D5ncgQtAZJcrL4qN","name":"Eclipse Burst","type":"spell","img":"systems/pf2e/icons/spells/eclipse-burst.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>A globe of freezing darkness explodes in the area, dealing 8d10 cold damage to creatures in the area, plus 8d4 additional negative damage to living creatures. Each creature in the area must attempt a Reflex save. If the globe overlaps with an area of magical light or affects a creature affected by magical light, eclipse burst attempts to counteract the light effect.</p>\n<hr />\n<p><strong>Critical Success</strong> The creature is unaffected.</p>\n<p><strong>Success</strong> The creature takes half damage.</p>\n<p><strong>Failure</strong> The creature takes full damage.</p>\n<p><strong>Critical Failure</strong> The creature takes double damage and becomes @Compendium[pf2e.conditionitems.XgEqL1kFApUbl5Z2]{Blinded} by the darkness for an unlimited duration.</p>\n<hr />\n<p><strong>Heightened (+1)</strong> The cold damage increases by 1d10 and the negative damage against the living increases by 1d4.</p>"},"rules":[],"slug":"eclipse-burst","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["cold","concentrate","darkness","manipulate"],"rarity":"common","traditions":["arcane","divine","primal"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":7},"requirements":"","target":{"value":""},"range":{"value":"500 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"","sustained":false},"damage":{"0":{"formula":"8d10","type":"cold","category":null,"materials":[],"kinds":["damage"]}},"defense":{"passive":null,"save":{"statistic":"reflex","basic":false}},"cost":{"value":""},"location":{"value":"W1zJSOwBt4PNPNlF","heightenedLevel":9},"counteraction":false,"heightening":{"type":"interval","interval":1,"damage":{"0":"1d10"}}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.0jadeyQIItIuRgeH","duplicateSource":null,"exportSource":null}},{"_id":"adRTCwBoNvXsSYcF","name":"Paralyze","type":"spell","img":"systems/pf2e/icons/spells/paralyze.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>You block the target's motor impulses before they can leave its mind, threatening to freeze the target in place. The target must attempt a Will save.</p>\n<hr />\n<p><strong>Critical Success</strong> The target is unaffected.</p>\n<p><strong>Success</strong> The target is @Compendium[pf2e.conditionitems.dfCMdR4wnpbYNTix]{Stunned 1}.</p>\n<p><strong>Failure</strong> The target is @Compendium[pf2e.conditionitems.6uEgoh53GbXuHpTF]{Paralyzed} for 1 round.</p>\n<p><strong>Critical Failure</strong> The target is Paralyzed for 4 rounds. At the end of each of its turns, it can attempt a new Will save to reduce the remaining duration by 1 round, or end it entirely on a critical success.</p>\n<hr />\n<p><strong>Heightened (7th)</strong> You can target up to 10 creatures.</p>"},"rules":[],"slug":"paralyze","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","incapacitation","manipulate","mental"],"rarity":"common","traditions":["arcane","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":3},"requirements":"","target":{"value":"1 creature"},"range":{"value":"30 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"varies","sustained":false},"damage":{},"defense":{"passive":null,"save":{"statistic":"will","basic":false}},"cost":{"value":""},"location":{"value":"W1zJSOwBt4PNPNlF","heightenedLevel":9},"counteraction":false,"heightening":{"levels":{"7":{"target":{"value":"10 creatures"}}},"type":"fixed"}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.DCQHaLrYXMI37dvW","duplicateSource":null,"exportSource":null}},{"_id":"QxLIYSBWo06aHOSn","name":"Phantasmal Calamity","type":"spell","img":"systems/pf2e/icons/spells/phantasmal-calamity.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>A vision of apocalyptic destruction fills the mind of each creature in the area. The vision deals 11d6 mental damage (basic Will save). On a critical failure, the creature must also succeed at a Reflex save or believe it's trapped (stuck in a fissure, adrift at sea, or some other fate in keeping with its vision). If it fails the second save, it's also @Compendium[pf2e.conditionitems.dfCMdR4wnpbYNTix]{Stunned} for 1 minute. It can attempt a new Will save at the end of each of its turns, and on a success, it disbelieves the illusion and recovers from the Stunned condition.</p>\n<hr />\n<p><strong>Heightened (+1)</strong> The damage increases by 2d6.</p>"},"rules":[],"slug":"phantasmal-calamity","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","illusion","manipulate","mental"],"rarity":"common","traditions":["arcane","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":6},"requirements":"","target":{"value":""},"range":{"value":"500 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"","sustained":false},"damage":{"0":{"formula":"11d6","type":"mental","category":null,"materials":[],"kinds":["damage"]}},"defense":{"passive":null,"save":{"statistic":"will","basic":true}},"cost":{"value":""},"location":{"value":"W1zJSOwBt4PNPNlF","heightenedLevel":9},"counteraction":false,"heightening":{"type":"interval","interval":1,"damage":{"0":"2d6"}}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.0XP2XOxT9VSiXFDr","duplicateSource":null,"exportSource":null}},{"_id":"WhIWrGpFWfZoFecm","name":"Finger of Death","type":"spell","img":"systems/pf2e/icons/spells/finger-of-death.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>You point your finger toward the target and speak a word of slaying. You deal 70 negative damage to the target. If the damage from finger of death reduces the target to 0 Hit Points, the target dies instantly.</p>\n<hr />\n<p><strong>Heightened (+1)</strong> The damage increases by 10.</p>"},"rules":[],"slug":"finger-of-death","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","death","manipulate"],"rarity":"common","traditions":["divine","primal"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":7},"requirements":"","target":{"value":"1 living creature"},"range":{"value":"30 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"","sustained":false},"damage":{"0":{"applyMod":false,"formula":"70","type":"void","category":null,"materials":[],"kinds":["damage"]}},"defense":{"passive":null,"save":{"statistic":"fortitude","basic":true}},"cost":{"value":""},"location":{"value":"W1zJSOwBt4PNPNlF","heightenedLevel":8},"counteraction":false,"heightening":{"type":"interval","interval":1,"damage":{"0":"10"}}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.Z9OrRXKgAPv6Hn5l","duplicateSource":null,"exportSource":null}},{"_id":"xNPredEfqnCjuaX8","name":"Horrid Wilting","type":"spell","img":"systems/pf2e/icons/spells/horrid-wilting.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>You pull the moisture from the targets' bodies, dealing 10d10 negative damage. Creatures made of water (such as water elementals) and plant creatures use the outcome for one degree of success worse than the result of their saving throw. Creatures whose bodies contain no significant moisture (such as earth elementals) are immune to horrid wilting.</p>\n<hr />\n<p><strong>Heightened (+1)</strong> The damage increases by 1d10.</p>"},"rules":[],"slug":"horrid-wilting","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","manipulate"],"rarity":"common","traditions":["arcane","primal"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":8},"requirements":"","target":{"value":"any number of living creatures"},"range":{"value":"500 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"","sustained":false},"damage":{"0":{"formula":"10d10","type":"void","category":null,"materials":[],"kinds":["damage"]}},"defense":{"passive":null,"save":{"statistic":"fortitude","basic":true}},"cost":{"value":""},"location":{"value":"W1zJSOwBt4PNPNlF","heightenedLevel":8},"counteraction":false,"heightening":{"type":"interval","interval":1,"damage":{"0":"1d10"}}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.M0jQlpQYUr0pp2Sv","duplicateSource":null,"exportSource":null}},{"_id":"spnEQ20sXmadKLzA","name":"Spirit Song","type":"spell","img":"systems/pf2e/icons/spells/spirit-song.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>Your eldritch song sends pulsing waves of ethereal energy to attack creatures' spirits in the area, dealing 18d6 force damage. Because spirit song affects creatures' spirits, it can damage a target projecting its consciousness (such as via project image) or possessing another creature even if the target's body is elsewhere. The vibrating waves of spiritual song penetrate into, but not through, solid barriers, damaging incorporeal creatures hiding in solid objects in the area but not passing onward to damage creatures in other rooms. Possessed creatures aren't harmed by the song. The song doesn't harm creatures that have no spirit, such as constructs.</p>\n<hr />\n<p><strong>Heightened (+1)</strong> The damage increases by 2d6.</p>"},"rules":[],"slug":"spirit-song","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","force","manipulate"],"rarity":"common","traditions":["occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":8},"requirements":"","target":{"value":""},"range":{"value":""},"area":null,"time":{"value":"2"},"duration":{"value":"","sustained":false},"damage":{"0":{"formula":"18d6","type":"force","category":null,"materials":[],"kinds":["damage"]}},"defense":{"passive":null,"save":{"statistic":"fortitude","basic":true}},"cost":{"value":""},"location":{"value":"W1zJSOwBt4PNPNlF","heightenedLevel":8},"counteraction":false,"heightening":{"type":"interval","interval":1,"damage":{"0":"2d6"}}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.Ht35SDf9PDStJfoC","duplicateSource":null,"exportSource":null}},{"_id":"uqDD1Uailux7tSzX","name":"Locate (Constant) (Monkey's Paw Only)","type":"spell","img":"systems/pf2e/icons/spells/locate.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>You learn the direction to the target (if you picked a specific object, such as \"my mother's sword\") or the nearest target (if you picked a type of object, such as \"swords\"). If the target is a specific object, you must have observed it directly with your own senses. If it's a type of object, you still need to have an accurate mental image of the type of object. If there's lead or running water between you and the target, this spell can't locate the object. This means you might find a type of object farther away if the nearest one is behind lead or running water.</p>\n<hr />\n<p><strong>Heightened (5th)</strong> You can target a specific creature or ancestry instead of an object, but you must have met or seen up close the creature or ancestry you want to target.</p>"},"rules":[],"slug":"locate","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","detection","manipulate"],"rarity":"uncommon","traditions":["arcane","divine","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":3},"requirements":"","target":{"value":"1 specific object or type of object"},"range":{"value":"500 feet"},"area":null,"time":{"value":"10 minutes"},"duration":{"value":"","sustained":true},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"W1zJSOwBt4PNPNlF","heightenedLevel":8},"counteraction":false,"heightening":{"levels":{"5":{"target":{"value":"1 specific object or type of object, or a specific creature or ancestry"}}},"type":"fixed"}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.LQzlKbYjZSMFQawP","duplicateSource":null,"exportSource":null}},{"_id":"iKXvfxa5VzX3guev","name":"Constant Spells","type":"action","img":"systems/pf2e/icons/actions/Passive.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>@Localize[PF2E.NPC.Abilities.Glossary.ConstantSpells]</p>"},"rules":[],"slug":"constant-spells","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"interaction","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""},"weapon":{"value":""}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.bestiary-ability-glossary-srd.Item.kakyXBG5WA8c6Zfd","duplicateSource":null,"exportSource":null}},{"_id":"TTOgG8wTSGWH45mW","name":"Three Curses","type":"action","img":"systems/pf2e/icons/actions/TwoActions.webp","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"gm":"","value":"<p><strong>Frequency</strong> once per target per day;</p>\n<p><strong>Effect</strong> Semuvig curses a creature within 60 feet. The target must attempt a @Check[type:will|dc:46|name:Three Curses DC|traits:arcane,curse,necromancy|showDC:gm]{Will} save. On a failure, the target is cursed by one of the following effects (randomly selected); on a critical failure, two curses apply instead.</p>\n<hr />\n<ul>\n<li><strong><em>Doom</em></strong>: Increase the target's @Compendium[pf2e.conditionitems.3uh1r86TzbQvosxv]{Doomed} value by 1.</li>\n<li><strong><em>Backlash</em></strong>: For 1 minute, any weapon the target holds erupts into flames and acid, dealing [[/r {5d6[fire],5d6[acid]}]]{5d6 fire damage and 5d6 acid damage} (@Check[type:reflex|dc:46|name:Backlash Curse DC|traits:damaging-effect,arcane,curse,necromancy|showDC:gm]{basic Reflex} save) to the weapon and the target at the beginning of the target's turn.</li>\n<li><strong><em>Inversion</em></strong>: For 1 minute, the effects of healing and damaging spells are reversed when applied to the target. Spells that cause damage heal the target, and spells that restore Hit Points deal damage to the target. If the spell requires a saving throw, the target must roll that saving throw; the target does not get to roll a saving throw against spells that don't require a saving throw.</li>\n</ul>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["arcane","curse"],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":2},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"type":"action","img":"systems/pf2e/icons/actions/Passive.webp","name":"Paralyzing Touch","system":{"description":{"gm":"","value":"<p>A creature damaged by Semuvig's hand Strike must succeed at a @Check[type:fortitude|dc:46] save. The creature becomes @Compendium[pf2e.conditionitems.6uEgoh53GbXuHpTF]{Paralyzed} for 1 round on a failure. On a critical failure, the creature is paralyzed permanently, falls @Compendium[pf2e.conditionitems.j91X7x0XSomq8d60]{Prone}, and seems dead. A @Check[type:medicine|dc:40] check reveals the victim is alive.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["arcane","curse","incapacitation"]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"offensive","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"_id":"34z198yLisVyQtde","effects":[],"folder":null,"sort":0,"ownership":{"default":0,"W75cDAmGcgt3X6Rq":3},"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"4.7.2","coreVersion":"14.360","createdTime":1675904903031,"modifiedTime":1675904939600,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":null,"duplicateSource":null,"exportSource":null}}],"effects":[],"folder":null,"sort":0,"flags":{"pf2e":{"lootable":false},"core":{}},"system":{"attributes":{"hp":{"value":455,"temp":0,"max":455,"details":"negative healing. rejuvenation"},"ac":{"value":48,"details":"","base":48},"allSaves":{"value":"+1 status to all saves vs. positive"},"speed":{"value":50,"otherSpeeds":[],"details":""},"immunities":[{"type":"death-effects"},{"type":"disease"},{"type":"paralyzed"},{"type":"poison"},{"type":"unconscious"}],"resistances":[{"type":"physical","value":25,"exceptions":["magical","bludgeoning"]}]},"initiative":{"statistic":"perception"},"details":{"languages":{"value":["aklo","chthonian","diabolic","necril"],"details":""},"level":{"value":23},"blurb":"","publicNotes":"<p>Many have heard of the fabled <em>@Compendium[pf2e.equipment-srd.QWiXrqhSCkvdHbsi]{Monkey's Paw}</em>, an artifact capable of granting a mortal's greatest wishes but at equally great cost. Few, however, know of the cursed thing's origins. Those who have borne the paw and lived through the experience sometimes tell of a wicked wailing monkey pursuing them in their nightmares. With the body of a desiccated dead chimpanzee, an eerily human shriveled face, and a missing hand, this violent being is far from mere phantasmagoria. The legendary primate indeed walks the mortal world, not just in dreams. It calls itself Semuvig, though, in visions and legends, it is also known as the Yowling Simian, or \"the paw's monkey.\"</p>\n<p>It is unknown whether Semuvig's present state is the result of a cruel god's vindictive curse or whether the Yowling Simian chose this life for itself. Equally mysterious is the relationship between paw and owner: Perhaps the paw is a scout, though it is equally possible that the paw is fleeing Semuvig for its own reasons, possibly to prevent its master's ascent to even greater power. Whatever the true story, legends agree that the Yowling Simian must be kept away from its paw at all costs.</p>\n<h2>Semuvig's Paw</h2>\n<p>Semuvig yearns for its missing hand and possesses a modicum of power over it while in its vicinity. When Semuvig is within 120 feet of the <em>monkey's paw</em>, it can make a wish on behalf of the paw's wielder.</p>\n<h2>Monster Part Subsystem</h2>\n<p><strong>Semuvig, The Paw’s Monkey Creature 23 </strong></p>\n<p><strong>Monster Parts</strong> 20,000/48,000/90,000 gp</p>\n<p><strong>Eligible Refinements</strong> weapons (piercing, slashing), armor (light, medium), shield, perception item, skill items (Acrobatics, Arcana, Athletics, Deception, Intimidation, Occultism, Stealth, Survival)</p>\n<p><strong>Eligible Imbued Properties</strong> acid, chaotic, dexterity, energy resistant (negative), evil, fire, mental, negative, sensory (darkvision), spells (Arcane: alter reality, eclipse burst, finger of death, horrid wilting, locate, paralyze, phantasmal calamity, spirit song), sturdy, wild, wisdom</p>","privateNotes":"","publication":{"title":"Battlezoo Bestiary","authors":"W. Brian Lane","license":"OGL","remaster":false},"creatureType":""},"resources":{},"_migration":{"version":0.932,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"abilities":{"str":{"mod":9},"dex":{"mod":11},"con":{"mod":8},"int":{"mod":6},"wis":{"mod":10},"cha":{"mod":9}},"perception":{"details":"","mod":41,"senses":[{"type":"darkvision"}],"vision":true},"saves":{"fortitude":{"value":35,"saveDetail":""},"reflex":{"value":42,"saveDetail":""},"will":{"value":41,"saveDetail":""}},"skills":{"acrobatics":{"base":44},"arcana":{"base":39},"athletics":{"base":38},"deception":{"base":40},"intimidation":{"base":40,"special":[{"label":"against any creature holding the monkey’s paw","base":44,"predicate":["monkeys-paw"]}]},"occultism":{"base":39},"stealth":{"base":42},"survival":{"base":39}},"traits":{"value":["chaotic","evil","undead","unholy"],"rarity":"unique","size":{"value":"sm"}},"customModifiers":{}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"prototypeToken":{"bar1":{"attribute":"attributes.hp"},"displayName":20,"displayBars":20,"flags":{"pf2e":{"linkToActorSize":true,"autoscale":true}},"height":1,"width":1,"disposition":-1,"name":"Semuvig","actorLink":false,"lockRotation":false,"rotation":0,"alpha":1,"bar2":{"attribute":null},"randomImg":false,"light":{"alpha":0.25,"angle":360,"bright":0,"coloration":1,"dim":0,"luminosity":0.5,"saturation":0,"contrast":0,"shadows":0,"animation":{"speed":5,"intensity":5,"type":null,"reverse":false},"darkness":{"min":0,"max":1},"color":null,"attenuation":0.5,"negative":false,"priority":0},"texture":{"src":"modules/battlezoo-bestiary-pf2e/art/Tokens/semuvig.webp","tint":"#ffff