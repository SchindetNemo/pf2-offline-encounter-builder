ared":[],"value":0,"max":0},"slot2":{"prepared":[],"value":1,"max":1},"slot3":{"prepared":[],"value":0,"max":0},"slot4":{"prepared":[],"value":1,"max":1},"slot5":{"prepared":[],"value":0,"max":0},"slot6":{"prepared":[],"value":0,"max":0},"slot7":{"prepared":[],"value":0,"max":0},"slot8":{"prepared":[],"value":0,"max":0},"slot9":{"prepared":[],"value":0,"max":0},"slot10":{"prepared":[],"value":0,"max":0},"slot11":{"prepared":[],"value":0,"max":0}},"autoHeightenLevel":{"value":null},"showUnpreparedSpells":{"value":true},"displayLevels":{}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"ZCAb37F6bWjQM31E","name":"Hallucinatory Terrain","type":"spell","img":"systems/pf2e/icons/spells/hallucinatory-terrain.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>You create an illusion that causes natural terrain to look, sound, feel, and smell like a different kind of terrain. This doesn't disguise any structures or creatures in the area. Any creature that touches the illusion or uses the Seek action to examine it can attempt to disbelieve your illusion.</p>\n<hr />\n<p><strong>Heightened (5th)</strong> Your image can also disguise structures or create illusory structures (but still doesn't disguise creatures).</p>"},"rules":[],"slug":"hallucinatory-terrain","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","illusion","manipulate"],"rarity":"uncommon","traditions":["arcane","occult","primal"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":4},"requirements":"","target":{"value":""},"range":{"value":"500 feet"},"area":null,"time":{"value":"10 minutes"},"duration":{"value":"until the next time you make your daily preparations","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"R4r8DsxN8aRo5MT3","heightenedLevel":4},"counteraction":false},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.HBJPsonQnWcC3qdX","duplicateSource":null,"exportSource":null}},{"_id":"t53b0NFO0NFyLVoS","name":"Obscuring Mist","type":"spell","img":"systems/pf2e/icons/spells/obscuring-mist.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>You call forth a cloud of mist. All creatures within the mist become @Compendium[pf2e.conditionitems.DmAIPqOBomZ7H95W]{Concealed}, and all creatures outside the mist become Concealed to creatures within it. You can Dismiss the cloud.</p>"},"rules":[],"slug":"obscuring-mist","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","manipulate","water"],"rarity":"common","traditions":["arcane","primal"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":2},"requirements":"","target":{"value":""},"range":{"value":"120 feet"},"area":{"value":20,"type":"burst"},"time":{"value":"3"},"duration":{"value":"1 minute","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"R4r8DsxN8aRo5MT3","heightenedLevel":2},"counteraction":false},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.9XHmC2JgTUIQ1CCm","duplicateSource":null,"exportSource":null}}],"effects":[],"folder":null,"sort":0,"flags":{"pf2e":{"lootable":false},"core":{}},"system":{"attributes":{"hp":{"value":150,"temp":0,"max":150,"details":"negative healing"},"ac":{"value":25,"details":"","base":25},"allSaves":{"value":""},"speed":{"value":20,"otherSpeeds":[{"type":"swim","label":"Swim","value":20}],"details":"swamp dweller"},"immunities":[{"type":"death-effects"},{"type":"disease"},{"type":"paralyzed"},{"type":"poison"},{"type":"unconscious"}],"weaknesses":[{"type":"fire","value":10},{"type":"vitality","value":10}],"resistances":[{"type":"cold","value":10},{"type":"physical","value":10}]},"initiative":{"statistic":"perception"},"details":{"languages":{"value":["common"],"details":""},"level":{"value":7},"blurb":"","publicNotes":"<p>A veenlijk comes into being when a humanoid is strangled to death and its corpse is disposed of in a swamp. The victim's spirit, which is too anguished to move on, and its body, preserved by the swamp's acids, harden into an undead creature whose sole motive is to haunt its sodden domain.</p>\n<p>Some veenlijken are the result of murder or foul play, while others rise in the wake of sacrificial rites to swamp-dwelling gods and other occult powers. When the veenlijk rises, it may at first seek to avenge its death, hunting down anyone it deems complicit in its terrible fate. Dim-witted by death, however, most veenlijken end up indiscriminately targeting anyone who happens to cross their path. Particularly old or cunning veenlijken purposefully set up environmental traps, using magic to conceal quicksand and other hazards that might aid in their ambushes.</p>\n<p>The most sinister veenlijken truly embrace their undeath, believing themselves destined to be the unholy protectors of their boggy demesnes. Such a veenlijk might lead its own elaborate rituals centered on human sacrifice—unholy rites modeled after its own undead genesis.</p>\n<h2>Druids and Veenlijken</h2>\n<p>Certain bog-dwelling druids reverentially tell stories of \"primordial veenlijken,\" whom they regard as supernatural manifestations of the cycle of life and death in a swamp. The most ardent devotees of such radical beliefs dwell on the outskirts of veenlijken hunting grounds, luring travelers and adventurers into the swamp and personally abetting the primordial veenlijk's wicked ceremonies.</p>\n<h2>Monster Part Subsystem</h2>\n<p><strong>Veenlijk Creature 7 </strong></p>\n<p><strong>Monster Parts</strong> 45/100/180 gp</p>\n<p><strong>Eligible Refinements</strong> weapons (bludgeoning), armor (light, medium), shield, perception item, skill items (Athletics, Nature, Religion, Stealth)</p>\n<p><strong>Eligible Imbued Properties</strong> constitution, energy resistant (cold, negative), evil, fire, negative, sensory (darkvision), spells (Primal: hallucinatory terrain, obscuring mist), strength, sturdy, wild, wisdom</p>","privateNotes":"","publication":{"title":"Battlezoo Bestiary","authors":"Lau Bannenberg","license":"OGL","remaster":false},"creatureType":""},"resources":{},"_migration":{"version":0.932,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"abilities":{"str":{"mod":6},"dex":{"mod":1},"con":{"mod":4},"int":{"mod":2},"wis":{"mod":4},"cha":{"mod":2}},"perception":{"details":"breathsense (precise) 30 feet","mod":17,"senses":[{"type":"darkvision"}],"vision":true},"saves":{"fortitude":{"value":17,"saveDetail":""},"reflex":{"value":12,"saveDetail":""},"will":{"value":15,"saveDetail":""}},"skills":{"athletics":{"base":17},"nature":{"base":15},"religion":{"base":17},"stealth":{"base":12,"special":[{"label":"in Swamps","base":18,"predicate":["terrain:swamp"]}]}},"traits":{"value":["amphibious","evil","undead","unholy"],"rarity":"common","size":{"value":"med"}}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"prototypeToken":{"bar1":{"attribute":"attributes.hp"},"displayName":20,"displayBars":20,"flags":{"pf2e":{"linkToActorSize":true,"autoscale":false}},"height":1,"width":1,"disposition":-1,"name":"Veenlijk","actorLink":false,