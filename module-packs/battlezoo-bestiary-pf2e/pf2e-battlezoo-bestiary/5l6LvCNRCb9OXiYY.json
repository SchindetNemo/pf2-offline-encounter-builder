ditionitems.i3OJZU2nk64Df3xm]{Clumsy 1} for 1 round.</p>\n<p><strong>Critical Failure</strong> As failure, but the creature is @Compendium[pf2e.conditionitems.i3OJZU2nk64Df3xm]{Clumsy 2} for [[/r 1d4 #rounds]]{1d4 rounds}.</p>\n"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"offensive","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"TkX6rita9AkUo8tt","name":"Scent (Imprecise) 60 Feet","type":"action","img":"systems/pf2e/icons/actions/Passive.webp","effects":[],"folder":null,"sort":400000,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>@Localize[PF2E.NPC.Abilities.Glossary.Scent]</p>"},"rules":[],"slug":"scent","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"interaction","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""},"weapon":{"value":""}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.bestiary-ability-glossary-srd.Item.rqfnQ5VHT5hxm25r","duplicateSource":null,"exportSource":null}},{"_id":"Wo3zcU74c25JJG57","name":"Jaws","type":"melee","img":"sys