vh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"u3lfbNVA4iUtHUh2","name":"Blink","type":"spell","img":"systems/pf2e/icons/spells/blink.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>You blink quickly between the Material Plane and the Ethereal Plane. You gain resistance 5 to all damage (except force). You can Sustain the Spell to vanish and reappear 10 feet away in a random direction determined by the GM; the movement doesn't trigger reactions. At the end of your turn, you vanish and reappear as above.</p>\n<hr />\n<p><strong>Heightened (+2)</strong> The resistance increases by 3.</p>"},"rules":[],"slug":"blink","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","manipulate","teleportation"],"rarity":"common","traditions":["arcane","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":4},"requirements":"","target":{"value":""},"range":{"value":""},"area":null,"time":{"value":"2"},"duration":{"value":"1 minute","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"LMNsFpMLFEVKCAFJ","heightenedLevel":4},"counteraction":false},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.zR67Rt3UMHKC5evy","duplicateSource":null,"exportSource":null}},{"_id":"cB6KK3UHd8USlsqh","name":"Blink Breath","type":"action","img":"systems/pf2e/icons/actions/TwoActions.webp","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"gm":"","value":"<p>The warp wyrm spits a glob of ethereal ectoplasm to a range of 50 feet that explodes in a @Template[type:burst|distance:15]. Creatures within the burst take [[/r 7d6[force]]]{7d6 force damage} (@Check[type:reflex|dc:25|name:Blink Breath DC|traits:damaging-effect,arcane,conjuration,teleportation|showDC:gm]{basic Reflex} save). A creature that fails its save is coated in the wyrm's ectoplasm, which causes the creature to potentially \"blink\" back to the area: At the beginning of its turn, an affected creature must succeed at a @Check[type:will|dc:25|name:Blink Breath DC|traits:arcane,conjuration,teleportation|showDC:gm]{Will} save or be instantly teleported back to the spot where it was originally hit with Blink Breath.</p>\n<p>The creature remains coated in ectoplasm for 6 rounds, until it removes the ectoplasm by spending two actions (which have the Interact trait), or until the warp wyrm uses Blink Breath again, whichever comes first.</p>\n<p>The warp wyrm can't use Blink Breath again for [[/br 1d6 #rounds]]{1d6 rounds}.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["arcane","teleportation"],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":2},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"MoLzphOQLLqwOoKv","name":"Blinking Slice","type":"action","img":"systems/pf2e/icons/actions/TwoActions.webp","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"gm":"","value":"<p>The warp wyrm disappears into the Ethereal Plane, Strides, then reappears on this plane. If it ends this action adjacent to a creature, the warp wyrm can make a jaws Strike against that creature. On a hit, it deals an extra [[/r 2d6[precision]]]{2d6 precision damage}.</p>"},"rules":[{"key":"RollOption","label":"Use Blinking Slice","domain":"all","option":"blinkingSlice","toggleable":true,"value":false},{"key":"DamageDice","selector":"jaws-damage","diceNumber":2,"dieSize":"d6","damageCategory":"precision","predicate":["blinkingSlice"]}],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["arcane","teleportation"],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":2},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"B6Q73EewBSXHFfRD","name":"Draconic Frenzy","type":"action","img":"systems/pf2e/icons/actions/TwoActions.webp","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"gm":"","value":"<p>The warp wyrm makes two claw and one jaws Strike in any order.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":2},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"DQTY0morSH5wpTNK","name":"Warp Lash","type":"action","img":"systems/pf2e/icons/actions/OneAction.webp","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"gm":"","value":"<p><strong>Requirements</strong> The warp wyrm's last action was a successful tail Strike;</p>\n<p><strong>Effect</strong> The warp wyrm knocks the target through a dimensional portal. The target must succeed at a @Check[type:fortitude|dc:26|name:Warp Lash DC|traits:arcane, conjuration, teleportation|showDC:gm]{Fortitude} save or disappear onto the Ethereal Plane before reappearing on this plane in a space [[/br 1d4*5 #feet]]{1d4x5} feet away from its starting point. (Roll a d8 to determine which direction the target is knocked.)</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["arcane","teleportation"],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":1},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}}],"effects":[],"folder":null,"sort":0,"flags":{"pf2e":{"lootable":false},"core":{}},"system":{"attributes":{"hp":{"value":140,"temp":0,"max":140,"details":""},"ac":{"value":26,"details":"","base":26},"allSaves":{"value":""},"speed":{"value":25,"otherSpeeds":[{"type":"fly","label":"Fly","value":40}],"details":""},"immunities":[{"type":"paralyzed"},{"type":"sleep"}]},"initiative":{"statistic":"perception"},"details":{"languages":{"value":["draconic"],"details":""},"level":{"value":8},"blurb":"","publicNotes":"<p>Warp wyrms are small drakes capable of rapidly teleporting between the Ethereal and Material Planes, upon both of which they wreak incredible amounts of damage wherever they go. Whereas most drakes are at least prone to stay near their natural environs, warp wyrms know no such boundaries, making them a deadly menace in lands far and wide.</p>\n<p>Whereas most drake collectives are known as rampages, a gang of warp wyrms is called a chaos, and rightly so, for few groups of monsters exhibit as much wanton mayhem and destructive curiosity as these cruel dragons. Even when a warp wyrm lacks prey with which to play, it will undoubtedly stick its nose in all manner of nooks and crannies, uncovering things that should remain hidden, releasing things that should be contained, and breaking things that are impossible to fix.</p>\n<h2>Sadistic Predators</h2>\n<p>Warp wyrms are smaller than most drakes, but no less vicious. Like cats or sadists, warp wyrms delight in playing with their victims before making the killing blow. Nothing gets a warp wyrm howling with laughter quite like leaping out of the Ethereal Plane to scare a victim or knocking prey through a dimensional portal toward its terrible demise.</p>\n<h2>Monster Part Subsystem</h2>\n<p><strong>Warp Wyrm Creature 8 </strong></p>\n<p><strong>Monster Parts</strong> 64/140/250 gp</p>\n<p><strong>Eligible Refinements</strong> weapons (bludgeoning, piercing, slashing), armor (light, medium, heavy), perception item, skill items (Acrobatics, Athletics, Stealth)</p>\n<p><strong>Eligible Imbued Properties</strong> bane, chaotic, constitution, dexterity, energy resistant (positive), evil, force, sensory (darkvision, scent), spells (Arcane: blink), wild, winged</p>","privateNotes":"","publication":{"title":"Battlezoo Bestiary","authors":"Scott Janke","license":"OGL","remaster":false},"creatureType":""},"resources":{},"_migration":{"version":0.932,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"abilities":{"str":{"mod":4},"dex":{"mod":6},"con":{"mod":5},"int":{"mod":-3},"wis":{"mod":2},"cha":{"mod":3}},"perception":{"details":"","mod":16,"senses":[{"type":"darkvision"},{"type":"scent","acuity":"imprecise","range":30}],"vision":true},"saves":{"fortitude":{"value":15,"saveDetail":""},"reflex":{"value":20,"saveDetail":""},"will":{"value":12,"saveDetail":""}},"skills":{"acrobatics":{"base":18},"athletics":{"base":16},"stealth":{"base":18}},"traits":{"value":["chaotic","dragon","ethereal","evil"],"rarity":"common","size":{"value":"med"}}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"prototypeToken":{"bar1":{"attribute":"attributes.hp"},"displayName":20,"displayBars":20,"flags":{"pf2e":{"linkToActorSize":true,"autoscale":false}},"height":1,"width":1,"disposition":-1,"name":"Warp Wyrm","actorLink":false,"lockRotation":false,"rotation":0,"alpha":1,"bar2":{"attribute":null},"randomImg":false,"light":{"alpha":0.25,"angle":360,"bright":0,"coloration":1,"dim":0,"luminosity":0.5,"saturation":0,"contrast":0,"shadows":0,"animation":{"speed":5,"intensity":5,"type":null,"reverse":false},"darkness":{"min":0,"max":1},"attenuation":0.5,"color":null,"negative":false,"priority":0},"texture":{"src":"modules/battlezoo-bestiary-pf2e/art/Tokens/Warp_Wyrm.webp","scaleX":2,"scaleY":2,"tint":"#ffffff","anchorX":0.5,"anchorY":0.5,"fit":"contain","alphaThreshold":0.75},"sight":{"angle":360,"enabled":false,"range":0,"brightness":1,"visionMode":"basic","color":null,"attenuation":0.1,"saturation":0,"contrast":0},"detectionModes":{},"appendNumber":false,"prependAdjective":false,"occludable":{"radius":0},"ring":{"enabled":true,"colors":{"ring":null,"background":null},"effects":1,"subject":{"scale":2,"texture":"modules/battlezoo-bestiary-pf2e/art/Subjects/Warp_Wyrm.webp"}},"turnMarker":{"mode":1,"animation":null,"src":null,"disposition":false},"movementAction":null,"depth":1},"_stats":{"systemId":"pf2e","systemVersion":"6.1.0","coreVersion":"14.360","createdTime":1663517316799,"modi