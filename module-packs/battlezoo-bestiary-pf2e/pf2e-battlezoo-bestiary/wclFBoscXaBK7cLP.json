s page to create a powerful bomb. The living proof throws a bomb that deals [[/r 2d6[piercing]]] damage and 1 piercing splash damage. Each damaged creature must succeed at a @Check[type:reflex|dc:14|name:Entangling Math Bomb DC|traits:alchemical, bomb, manipulate, splash|showDC:gm]{Reflex} save or become @Compendium[pf2e.conditionitems.e1XGnhKNSQIm5IXg]{Stupefied 1} for 1 minute (@Compendium[pf2e.conditionitems.e1XGnhKNSQIm5IXg]{Stupefied 2} on a critical failure).</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["splash"],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":2},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"UMUZPXnEIJEMJbfm","name":"Arcane Innate Spells","type":"spellcastingEntry","img":"systems/pf2e/icons/default-icons/spellcastingEntry.svg","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"gm":"","value":""},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"ability":{"value":"cha"},"spelldc":{"value":6,"dc":14,"mod":0},"tradition":{"value":"arcane"},"prepared":{"value":"innate","flexible":false},"showSlotlessLevels":{"value":false},"proficiency":{"value":0},"slots":{"slot0":{"prepared":[],"value":0,"max":0},"slot1":{"prepared":[],"value":0,"max":0},"slot2":{"prepared":[],"value":0,"max":0},"slot3":{"prepared":[],"value":0,"max":0},"slot4":{"prepared":[],"value":0,"max":0},"slot5":{"prepared":[],"value":0,"max":0},"slot6":{"prepared":[],"value":0,"max":0},"slot7":{"prepared":[],"value":0,"max":0},"slot8":{"prepared":[],"value":0,"max":0},"slot9":{"prepared":[],"value":0,"max":0},"slot10":{"prepared":[],"value":0,"max":0},"slot11":{"prepared":[],"value":0,"max":0}},"autoHeightenLevel":{"value":null},"showUnpreparedSpells":{"value":true},"displayLevels":{}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"Xm4BFfwACWyuL352","name":"Magic Missile","type":"spell","img":"systems/pf2e/icons/spells/magic-missile.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>You send a dart of force streaking toward a creature that you can see. It automatically hits and deals 1d4+1 force damage. For each additional action you use when Casting the Spell, increase the number of missiles you shoot by one, to a maximum of three missiles for 3 actions. You choose the target for each missile individually. If you shoot more than one missile at the same target, combine the damage before applying bonuses or penalties to damage, resistances, weaknesses, and so forth.</p>\n<hr />\n<p><strong>Heightened (+2)</strong> You shoot one additional missile with each action you spend.</p>"},"rules":[],"slug":"magic-missile","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","force","manipulate"],"rarity":"common","traditions":["arcane","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":1},"requirements":"","target":{"value":"1 creature"},"range":{"value":"120 feet"},"area":null,"time":{"value":"1 to 3"},"duration":{"value":"","sustained":false},"damage":{"0":{"formula":"1d4+1","type":"force","category":null,"materials":[],"kinds":["damage"]}},"defense":null,"cost":{"value":""},"location":{"value":"UMUZPXnEIJEMJbfm","heightenedLevel":1},"counteraction":false},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.gKKqvLohtrSJj3BM","duplicateSource":null,"exportSource":null}},{"_id":"iflCJyhskf2Dzu97","name":"Magic Missile","type":"spell","img":"systems/pf2e/icons/spells/magic-missile.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>You send a dart of force streaking toward a creature that you can see. It automatically hits and deals 1d4+1 force damage. For each additional action you use when Casting the Spell, increase the number of missiles you shoot by one, to a maximum of three missiles for 3 actions. You choose the target for each missile individually. If you shoot more than one missile at the same target, combine the damage before applying bonuses or penalties to damage, resistances, weaknesses, and so forth.</p>\n<hr />\n<p><strong>Heightened (+2)</strong> You shoot one additional missile with each action you spend.</p>"},"rules":[],"slug":"magic-missile","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","force","manipulate"],"rarity":"common","traditions":["arcane","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":1},"requirements":"","target":{"value":"1 creature"},"range":{"value":"120 feet"},"area":null,"time":{"value":"1 to 3"},"duration":{"value":"","sustained":false},"damage":{"0":{"formula":"1d4+1","type":"force","category":null,"materials":[],"kinds":["damage"]}},"defense":null,"cost":{"value":""},"location":{"value":"UMUZPXnEIJEMJbfm","heightenedLevel":1},"counteraction":false},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.gKKqvLohtrSJj3BM","duplicateSource":null,"exportSource":null}},{"_id":"OxWO0saN26IC2QYo","name":"Read Aura","type":"spell","img":"systems/pf2e/icons/spells/read-aura.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>You focus on the target object, opening your mind to perceive magical auras. When the casting is complete, you know whether that item is magical, and if it is, you learn the school of magic.</p>\n<p>If the object is illusory, you detect this only if the effect's level is lower than the level of your read aura spell.</p>\n<hr />\n<p><strong>Heightened (3rd)</strong> You can target up to 10 objects.</p>\n<p><strong>Heightened (6th)</strong> You can target any number of objects.</p>"},"rules":[],"slug":"read-aura","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["cantrip","concentrate","detection","manipulate"],"rarity":"common","traditions":["arcane","divine","occult","primal"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":1},"requirements":"","target":{"value":"1 object"},"range":{"value":"30 feet"},"area":null,"time":{"value":"1 Minute"},"duration":{"value":"","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"UMUZPXnEIJEMJbfm"},"counteraction":false,"heightening":{"levels":{"3":{"target":{"value":"10 objects"}},"6":{"target":{"value":"any number of objects"}}},"type":"fixed"}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.OhD2Z6rIGGD5ocZA","duplicateSource":null,"exportSource":null}},{"_id":"jC5IvuYK3vtFoTCC","name":"Sigil","type":"spell","img":"systems/pf2e/icons/spells/sigil.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>You harmlessly place your unique magical sigil, which is about 1 square inch in size, on the targeted creature or object. The mark can be visible or invisible, and you can change it from one state to another by using an Interact action to touch the target. The mark can be scrubbed or scraped off with 5 minutes of work. If it's on a creature, it fades naturally over the course of a week. The time before the mark fades increases depending on your heightened level.</p>\n<hr />\n<p><strong>Heightened (3rd)</strong> The sigil instead fades after 1 month.</p>\n<p><strong>Heightened (5th)</strong> The sigil instead fades after 1 year.</p>\n<p><strong>Heightened (7th)</strong> The sigil never fades.</p>"},"rules":[],"slug":"sigil","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["cantrip"],"rarity":"common","traditions":["arcane","divine","occult","primal"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":1},"requirements":"","target":{"value":"1 creature or object"},"range":{"value":"touch"},"area":null,"time":{"value":"2"},"duration":{"value":"unlimited","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"UMUZPXnEIJEMJbfm"},"counteraction":false},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.AUctDF2fqPZN2w4W","duplicateSource":null,"exportSource":null}}],"effects":[],"folder":null,"sort":0,"flags":{"pf2e":{"lootable":false},"core":{}},"system":{"attributes":{"hp":{"value":20,"temp":0,"max":20,"details":""},"ac":{"value":14,"details":"","base":14},"allSaves":{"value":""},"speed":{"value":15,"otherSpeeds":[{"type":"fly","label":"Fly","value":15}],"details":""},"immunities":[{"type":"bleed"},{"type":"death-effects"},{"type":"disease"},{"type":"doomed"},{"type":"drained"},{"type":"fatigued"},{"type":"healing"},{"type":"nonlethal-attacks"},{"type":"paralyzed"},{"type":"poison"},{"type":"sickened"},{"type":"unconscious"}],"weaknesses":[{"type":"fire","value":3},{"type":"slashing","value":3}]},"initiative":{"statistic":"perception"},"details":{"languages":{"value":["common"],"details":"(can't speak any language)"},"level":{"value":1},"blurb":"","publicNotes":"<p>Alchemists have been known to spend countless hours and days working on new formulae in order to expand their repertoire of elixirs and explore the frontiers of alchemical knowledge. Under certain conditions, this devotion to the study of math, science, and transmutation can take on a life all its own. When a potentially powerful recipe or formula is left on the crafting table half- finished, it can manifest the will to pick up where its creator left off. Overnight, the composition feverishly works itself into completion and beyond, forming an incomprehensible proof that has a mind of its own. Alchemists have come to lovingly call these mathematically animated pages living proofs.</p>\n<p>Physically, living proofs are usually composed of nothing more than parchment and ink. They mobilize by folding and re-folding themselves like origami. Though this talent allows living proofs to take on just about any shape, they tend to choose forms that resemble miniature versions of their creators or, rarely, some other creature important to the proof. For example, a living proof written in snake's blood might take the guise of a papery serpent. Similarly, a living proof whose first sight upon animating is that of a caged specimen such as a chimera or owlbear might model itself after such a monster.</p>\n<p>Although most living proofs dedicate themselves to one particular area of study, the occasional specimen might become a polymath if they were designed by a particularly genius alchemist. If abandoned or forgotten, a living proof may wander from its laboratory to seek a new master to inspire and aid, though they are otherwise loyal assistants. Sometimes this loyalty goes a bit too far—more than one alchemist apprentice has wound up injured after dawdling in their master's lab after hours and stumbling upon a seemingly mundane sheet of parchment come to life.</p>\n<h2>Unusual Materials</h2>\n<p>Living proofs made of unusual materials—such as vellum, stone tablets, or even chalkboards—are not unknown. Such specimens typically have different resistances and weaknesses depending on the material they are made of.</p>\n<h2>Monster Part Subsystem</h2>\n<p><strong>Living Proof Creature 1 </strong></p>\n<p><strong>Monster Parts</strong> 3.5/7/13 gp</p>\n<p><strong>Eligible Refinements</strong> weapons (piercing, slashing), armor (light), perception item, skill items (Acrobatics, Arcana, Crafting)</p>\n<p><strong>Eligible Imbued Properties</strong> bane, dexterity, energy resistant (negative, positive), force, intelligence, sensory (darkvision), spells (Arcane: magic missile, read aura, sigil), wild, winged</p>","privateNotes":"","publication":{"title":"Battlezoo Bestiary","authors":"Douglas Edwards","license":"OGL","remaster":false},"creatureType":""},"resources":{},"_migration":{"version":0.932,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"abilities":{"str":{"mod":-4},"dex":{"mod":4},"con":{"mod":0},"int":{"mod":5},"wis":{"mod":1},"cha":{"mod":-5}},"perception":{"details":"","mod":7,"senses":[{"type":"darkvision"}],"vision":true},"saves":{"fortitude":{"value":4,"saveDetail":""},"reflex":{"value":10,"saveDetail":""},"will":{"value":6,"saveDetail":""}},"skills":{"acrobatics":{"base":6},"arcana":{"base":6},"crafting":{"base":6,"special":[{"label":"to Identify Alchemy and Craft alchemical items","base":8,"predicate":["alchemy"]}]}},"traits":{"value":["construct","minion"],"rarity":"common","size":{"value":"tiny"}},"customModifiers":{}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"prototypeToken":{"bar1":{"attribute":"attributes.hp"},"displayName":20,"displayBars":20,"flags":{"pf2e":{"linkToActorSize":true,"autoscale":false}},"height":0.5,"width":0.5,"disposition":-1,"name":"Living Proof","actorLink":false,"lockRotation":false,"rotation":0,"alpha":1,"bar2":{"attribute":null},"randomImg":false,"light":{"alpha":0.25,"angle":360,"bright":0,"coloration":1,"dim":0,"luminosity":0.5,"saturation":0,"contrast":0,"shadows":0,"animation":{"speed":5,"intensity":5,"type":null,"reverse":false},"darkness":{"min":0,"max":1},"attenuation":0.5,"color":null,"negative":false,"priority":0},"texture":{"src":"modules/battlezoo-bestiary-pf2e/art/Tokens/living_proof.webp","scaleX":2,"scaleY":2,"tint":"#ffffff","anchorX":0.5,"anchorY":0.5,"fit":"contain","alphaThreshold":0.75},"sight":{"angle":360,"enabled":false,"range":0,"brightness":1,"visionMode":"basic","color":null,"attenuation":0.1,"saturation":0,"contrast":0},"detectionModes":{},"appendNumber":false,"prependAdjective":false,"occludable":{"radius":0},"ring":{"enabled":true,"colors":{"ring":null,"background":null},"effects":1,"subject":{"scale":2,"texture":"modules/battlezoo-bestiary-pf2e/art/Subjects/living_proof.webp"}},"turnMarker":{"mode":1,"animation":null,"src":null,"disposition":false},"movementAction":null,"depth":0.5},"_stats":{"systemId":"pf2e","systemVersion":"6.1.0","coreVersion":"14.360","createdTime":1663517319090,"modifiedTime":1729380397429,"lastModifiedBy":"ZdvNMqfYMlbFrAL2","compendiumSource":"Compendium.battlezoo-bestiary-pf2e.