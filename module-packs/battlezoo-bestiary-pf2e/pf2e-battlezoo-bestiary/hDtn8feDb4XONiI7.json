e":null,"duplicateSource":null,"exportSource":null}},{"_id":"0i4RJwKPubiJfi91","name":"Throw Rock","type":"action","img":"systems/pf2e/icons/actions/OneAction.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>@Localize[PF2E.NPC.Abilities.Glossary.ThrowRock]</p>"},"rules":[],"slug":"throw-rock","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":1},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""},"weapon":{"value":""}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.bestiary-ability-glossary-srd.Item.a0tx6exmB9v9CUsj","duplicateSource":null,"exportSource":null}},{"_id":"dTDXVA7sLJ4hWqNW","name":"Innate Occult Spells","type":"spellcastingEntry","img":"systems/pf2e/icons/default-icons/spellcastingEntry.svg","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"gm":"","value":""},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"ability":{"value":"cha"},"spelldc":{"value":17,"dc":25,"mod":0},"tradition":{"value":"occult"},"prepared":{"value":"innate","flexible":false},"showSlotlessLevels":{"value":false},"proficiency":{"value":0},"slots":{"slot0":{"prepared":[],"value":0,"max":0},"slot1":{"prepared":[],"value":0,"max":0},"slot2":{"prepared":[],"value":0,"max":0},"slot3":{"prepared":[],"value":0,"max":0},"slot4":{"prepared":[],"value":0,"max":0},"slot5":{"prepared":[],"value":0,"max":0},"slot6":{"prepared":[],"value":0,"max":0},"slot7":{"prepared":[],"value":0,"max":0},"slot8":{"prepared":[],"value":0,"max":0},"slot9":{"prepared":[],"value":0,"max":0},"slot10":{"prepared":[],"value":0,"max":0},"slot11":{"prepared":[],"value":0,"max":0}},"autoHeightenLevel":{"value":null},"showUnpreparedSpells":{"value":true},"displayLevels":{}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"ksrigmxMOdwetIZa","name":"Talking Corpse","type":"spell","img":"systems/pf2e/icons/spells/talking-corpse.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>You grant the target corpse a semblance of life, which it uses to speak the answers to three questions posed to it. This spell calls on the physical body's latent memories rather than summoning back the deceased's spirit, so the corpse must be mostly intact for the spell to function. The more damage the corpse has taken, the more inaccurate or patchwork its answers are, and it must have a throat and mouth to speak at all. If anyone has previously cast this spell on the corpse in the last week, the spell automatically fails. The corpse can attempt a Will save to resist answering the questions using the statistics of the original creature at its time of death, with the following effects.</p>\n<hr /><strong>Critical Success</strong> The target can lie or refuse to answer your questions, and the target's spirit haunts you for 24 hours, bothering you and causing you to be unable to gain any rest for that time.\n<p><strong>Success</strong> The target can provide false information or refuse to answer your questions.</p>\n<p><strong>Failure</strong> The target must answer truthfully, but its answers can be brief, cryptic, and repetitive. It can still mislead you or attempt to stall so that the spell's duration runs out before you can ask all your questions.</p>\n<p><strong>Critical Failure</strong> As failure, but the target's answers are more direct and less repetitive, though still cryptic. It takes a -2 status penalty to Deception checks to deceive or mislead you.</p>"},"rules":[],"slug":"talking-corpse","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","manipulate"],"rarity":"uncommon","traditions":["divine","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":4},"requirements":"","target":{"value":"1 corpse"},"range":{"value":"touch"},"area":null,"time":{"value":"10 minutes"},"duration":{"value":"10 minutes","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"dTDXVA7sLJ4hWqNW","heightenedLevel":4},"counteraction":false},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.FM3SmEW8N1FCRjqt","duplicateSource":null,"exportSource":null}},{"_id":"wQQSCxKC6whGbiLA","name":"Locate","type":"spell","img":"systems/pf2e/icons/spells/locate.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>You learn the direction to the target (if you picked a specific object, such as \"my mother's sword\") or the nearest target (if you picked a type of object, such as \"swords\"). If the target is a specific object, you must have observed it directly with your own senses. If it's a type of object, you still need to have an accurate mental image of the type of object. If there's lead or running water between you and the target, this spell can't locate the object. This means you might find a type of object farther away if the nearest one is behind lead or running water.</p>\n<hr />\n<p><strong>Heightened (5th)</strong> You can target a specific creature or ancestry instead of an object, but you must have met or seen up close the creature or ancestry you want to target.</p>"},"rules":[],"slug":"locate","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","detection","manipulate"],"rarity":"uncommon","traditions":["arcane","divine","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":3},"requirements":"","target":{"value":"1 specific object or type of object"},"range":{"value":"500 feet"},"area":null,"time":{"value":"10 minutes"},"duration":{"value":"","sustained":true},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"dTDXVA7sLJ4hWqNW","heightenedLevel":3},"counteraction":false,"heightening":{"levels":{"5":{"target":{"value":"1 specific object or type of object, or a specific creature or ancestry"}}},"type":"fixed"}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.LQzlKbYjZSMFQawP","duplicateSource":null,"exportSource":null}},{"_id":"1ao0F9fRkeprnfFB","name":"Death Knell","type":"spell","img":"systems/pf2e/icons/spells/death-knell.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>You snuff the life out of a creature on the brink of death. The target must attempt a Will save. If this kills it, you gain 10 temporary HP and a +1 status bonus to attack and damage rolls for 10 minutes.</p>\n<hr /><strong>Critical Success</strong> The target is unaffected.\n<p><strong>Success</strong> The target's @Compendium[pf2e.conditionitems.yZRUzMqrMmfLu0V1]{Dying} value increases by 1.</p>\n<p><strong>Failure</strong> The target dies.</p>"},"rules":[],"slug":"death-knell","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","death","manipulate"],"rarity":"common","traditions":["divine","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":2},"requirements":"","target":{"value":"1 living creature that has 0 HP"},"range":{"value":"touch"},"area":null,"time":{"value":"2"},"duration":{"value":"","sustained":false},"damage":{},"defense":{"passive":null,"save":{"statistic":"will","basic":false}},"cost":{"value":""},"location":{"value":"dTDXVA7sLJ4hWqNW","heightenedLevel":2},"counteraction":false},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.dLdRqT6UxTKlsPgp","duplicateSource":null,"exportSource":null}},{"_id":"qxEY16ahOPmLAzHD","name":"Clairvoyance (On Keepsake Item Only)","type":"spell","img":"systems/pf2e/icons/spells/clairvoyance.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>You create an @Compendium[pf2e.conditionitems.zJxUflt9np0q4yML]{Invisible} floating eye at a location within range (even if it's outside your line of sight or line of effect). The eye can't move, but you can see in all directions from that point as if using your normal visual senses.</p>"},"rules":[],"slug":"clairvoyance","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","manipulate","scrying"],"rarity":"common","traditions":["arcane","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors