ity":"common","traditions":["occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":1},"requirements":"","target":{"value":"1 creature"},"range":{"value":"30 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"1 minute","sustained":false},"damage":{"0":{"formula":"2d4","type":"mental","category":null,"materials":[],"kinds":["damage"]}},"defense":{"passive":null,"save":{"statistic":"will","basic":false}},"cost":{"value":""},"location":{"value":"sw10OvltdffCS0Ty","heightenedLevel":2},"counteraction":false,"heightening":{"type":"interval","interval":1,"damage":{"0":"2d4"}}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.R8bqnYiThB6MYTxD","duplicateSource":null,"exportSource":null}},{"_id":"1AeP16HQ2P3roJVb","name":"Phantom Pain","type":"spell","img":"systems/pf2e/icons/spells/phantom-pain.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>Illusory pain wracks the target, dealing 2d4 mental damage and [[/r 1d4[persistent,mental]]] damage. The target must attempt a Will save.</p>\n<hr />\n<p><strong>Critical Success</strong> The target is unaffected.</p>\n<p><strong>Success</strong> The target takes full initial damage but no @Compendium[pf2e.conditionitems.lDVqvLKA6eF3Df60]{Persistent Mental Damage}, and the spell ends immediately.</p>\n<p><strong>Failure</strong> The target takes full initial and Persistent Damage, and the target is @Compendium[pf2e.conditionitems.fesd1n5eVhpCSS18]{Sickened 1}. If the target recovers from being Sickened, the Persistent Damage ends and the spell ends.</p>\n<p><strong>Critical Failure</strong> As failure, but the target is @Compendium[pf2e.conditionitems.fesd1n5eVhpCSS18]{Sickened 2}.</p>\n<hr />\n<p><strong>Heightened (+1)</strong> The damage increases by 2d4 and the Persistent Damage by 1d4.</p>"},"rules":[],"slug":"phantom-pain","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","illusion","manipulate","mental","nonlethal"],"rarity":"common","traditions":["occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":1},"requirements":"","target":{"value":"1 creature"},"range":{"value":"30 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"1 minute","sustained":false},"damage":{"0":{"formula":"2d4","type":"mental","category":null,"materials":[],"kinds":["damage"]}},"defense":{"passive":null,"save":{"statistic":"will","basic":false}},"cost":{"value":""},"location":{"value":"sw10OvltdffCS0Ty","heightenedLevel":2},"counteraction":false,"heightening":{"type":"interval","interval":1,"damage":{"0":"2d4"}}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.R8bqnYiThB6MYTxD","duplicateSource":null,"exportSource":null}},{"_id":"jIEsZNNbyVfK0RBP","name":"Command (At Will)","type":"spell","img":"systems/pf2e/icons/spells/command.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>You shout a command that's hard to ignore. You can command the target to approach you, run away (as if it had the @Compendium[pf2e.conditionitems.sDPxOjQ9kx2RZE8D]{Fleeing} condition), release what it's holding, drop @Compendium[pf2e.conditionitems.j91X7x0XSomq8d60]{Prone}, or stand in place. It can't Delay or take any reactions until it has obeyed your command. The effects depend on the target's Will save.</p>\n<hr /><strong>Success</strong> The creature is unaffected.\n<p><strong>Failure</strong> For the first action on its next turn, the creature must use a single action to do as you command.</p>\n<p><strong>Critical Failure</strong> The target must use all its actions on its next turn to obey your command.</p>\n<hr /><strong>Heightened (5th)</strong> You can target up to 10 creatures."},"rules":[],"slug":"command","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["auditory","concentrate","linguistic","manipulate","mental"],"rarity":"common","traditions":["arcane","divine","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":1},"requirements":"","target":{"value":"1 creature"},"range":{"value":"30 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"until the end of the target's next turn","sustained":false},"damage":{},"defense":{"passive":null,"save":{"statistic":"will","basic":false}},"cost":{"value":""},"location":{"value":"sw10OvltdffCS0Ty","heightenedLevel":1},"counteraction":false,"heightening":{"levels":{"5":{"target":{"value":"10 creatures"}}},"type":"fixed"}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.aIHY2DArKFweIrpf","duplicateSource":null,"exportSource":null}},{"_id":"3UkrPBUai9OX8KYg","name":"At-Will Spells","type":"action","img":"systems/pf2e/icons/actions/Passive.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>@Localize[PF2E.NPC.Abilities.Glossary.AtWillSpells]</p>"},"rules":[],"slug":"at-will-spells","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"interaction","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""},"weapon":{"value":""}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.bestiary-ability-glossary-srd.Item.2YRDYVnC1eljaXKK","duplicateSource":null,"exportSource":null}},{"_id":"Z0qhCLA6WB9uYJl3","name":"Killer's Possession","type":"action","img":"systems/pf2e/icons/actions/TwoActions.webp","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"gm":"","value":"<p>The killing intent attempts to possess an adjacent frightened or @Compendium[pf2e.conditionitems.fBnFDH2MTzgFijKf]{Unconscious} corporeal creature. This has the same effect as the <em>@Compendium[pf2e.spells-srd.wU6hNzK8Yfqdmc8m]{Possession}</em> spell (@Check[type:will|dc:21|name:Killer's Possession DC|traits:occult,incapacitation,mental,necromancy,possession|showDC:gm]{Will}), except since the killing intent doesn't have a physical body, it is unaffected by that restriction of the spell.</p>\n<p>The possessed creature automatically gains a number of temporary Hit Points equal to half the killing intent's remaining HP. Once the possession ends, the target loses the temporary Hit Points, becomes @Compendium[pf2e.conditionitems.3uh1r86TzbQvosxv]{Doomed 1}, and is immune to this ability for 24 hours.</p>\n<p>The killing intent's bloodlust allows its corporeal vessel to exceed its normal bodily limits. A creature possessed by the killing intent deals [[/r {4}]]{4 additional damage} on its melee Strikes, takes a -2 penalty to AC, and gains the @Compendium[pf2e.conditionitems.nlCjDvLMf2EkV2dl]{Quickened} condition; it can use the extra action each round only for Strike and Stride actions.</p>\n<p>@Compendium[battlezoo-bestiary-pf2e.pf2e-battlezoo-bestiary-effects.7nv45Y1wagTct7SI]{Effect: Killer's Possession}</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":2},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"Bq6fyymRTbsmImyM","name":"Nauseating Pressure","type":"action","img":"systems/pf2e/icons/actions/FreeAction.webp","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"gm":"","value":"<p><strong>Frequency</strong> once per round;</p>\n<p><strong>Trigger</strong> The killing intent ends its movement adjacent to a creature;</p>\n<hr />\n<p><strong>Effect</strong> The killing intent focuses its pressure on a creature. The creature must roll a @Check[type:fortitude|dc:21|name:Nauseating Pressure|showDC:gm]{Fortitude} save. On a failure, the creature is @Compendium[pf2e.conditionitems.fesd1n5eVhpCSS18]{Sickened 1}.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"free"},"category":"offensive","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"BBDzfGGqexQnZgYs","name":"Darkvision","type":"action","img":"systems/pf2e/icons/actions/Passive.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>@Localize[PF2E.NPC.Abilities.Glossary.Darkvision]</p>"},"rules":[],"slug":"darkvision","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"interaction","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""},"weapon":{"value":""}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.bestiary-ability-glossary-srd.Item.qCCLZhnp2HhP3Ex6","duplicateSource":null,"exportSource":null}},{"_id":"XO6bjEGROF5AyWLW","name":"Telepathy 100 feet","type":"action","img":"systems/pf2e/icons/actions/Passive.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>@Localize[PF2E.NPC.Abilities.Glossary.Telepathy]</p>"},"rules":[],"slug":"telepathy","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["aura","magical","mental"],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"interaction","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""},"weapon":{"value":""}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.bestiary-ability-glossary-srd.Item.kdhbPaBMK1d1fpbA","duplicateSource":null,"exportSource":null}}],"effects":[],"folder":null,"sort":0,"flags":{"pf2e":{"lootable":false},"core":{}},"system":{"attributes":{"hp":{"value":45,"temp":0,"max":45,"details":""},"ac":{"value":18,"details":"","base":18},"allSaves":{"value":""},"speed":{"value":0,"otherSpeeds":[{"type":"fly","label":"Fly","value":25}],"details":""},"immunities":[{"type":"disease"},{"type":"fear-effects"},{"type":"poison"},{"type":"precision"},{"type":"unconscious"}],"resistances":[{"type":"all-damage","value":5,"exceptions":["force","ghost-touch","mental"],"doubleVs":["non-magical"]}]},"initiative":{"statistic":"perception"},"details":{"languages":{"value":["aklo","common"],"details":"telepathy 100 feet"},"level":{"value":4},"blurb":"","publicNotes":"<p>The mysterious entities called killing intents manifest on the Ethereal Plane when an especially violent mortal perishes on that plane and leaves a significant psychic impression on the planar landscape. A killing intent's presence is more often felt than perceived by sight or sound; witnesses report sudden drops in temperature, constant strong winds, and the extinguishment of lights. More terrifying, though, are counter-reports which suggest that these phenomena occur solely within the mind of a killing intent's victim.</p>\n<p>Killing intents are attracted to fear, but they feed on pure bloodlust. When a killing intent locates a suitably strong host, it possesses the corporeal creature's body and goes on a murderous rampage to sate its hunger. Once its possession has run its course, or it runs out of victims to kill, a killing intent vacates its host and leaves the confused creature to deal with the bloody aftermath.</p>\n<h2>The Pattern</h2>\n<p>Some fringe scholars theorize that killing intents are connected to \"the pattern\"—a mystical force that supposedly drives mortals to become \"pattern killers.\" Such scholars do not claim that the killing intents are behind this mysterious force, but rather that these spirits are living stains left on the Ethereal Plane by the psyches of mortals affected by the pattern.</p>\n<h2>Monster Part Subsystem</h2>\n<p><strong>Killing Intent Creature 4 </strong></p>\n<p><strong>Monster Parts</strong> 12/27/50 gp</p>\n<p><strong>Eligible Refinements</strong> perception item, skill items (Intimidation, Stealth)</p>\n<p><strong>Eligible Imbued Properties</strong> bane, chaotic, charisma, dexterity, energy resistant (acid, cold, electricity, fire, negative, positive, sonic), evil, force, fortification, mental, sensory (darkvision), spells (Occult: command, phantom pain), wild, winged, wisdom</p>","privateNotes":"","publication":{"title":"Battlezoo Bestiary","authors":"Jesse Lehto","license":"OGL","remaster":false},"creatureType":""},"resources":{},"_migration":{"version":0.932,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"abilities":{"str":{"mod":-5},"dex":{"mod":3},"con":{"mod":0},"int":{"mod":-2},"wis":{"mod":3},"cha":{"mod":5}},"perception":{"details":"fearsense (imprecise) 60 feet","mod":11,"senses":[{"type":"darkvision"}],"vision":true},"saves":{"fortitude":{"value":8,"saveDetail":""},"reflex":{"value":11,"saveDetail":""},"will":{"value":13,"saveDetail":""}},"skills":{"intimidation":{"base":13},"stealth":{"base":11}},"traits":{"value":["chaotic","ethereal","evil","incorporeal","spirit"],"rarity":"uncommon","size":{"value":"med"}}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"prototypeToken":{"bar1":{"attribute":"attributes.hp"},"displayName":20,"displayBars":20,"flags":{"pf2e":{"linkToActorSize":true,"autoscale":true}},"height":1,"width":1,"disposition":-1,"name":"Killing Intent","actorLink":false,"lockRotation":false,"rotation":0,"alpha":1,"bar2":{"attribute":null},"randomImg":false,"light":{"alpha":0.25,"angle":360,"bright":0,"coloration":1,"dim":0,"luminosity":0.5,"saturation":0,"contrast":0,"shadows":0,"animation":{"speed":5,"intensity":5,"type":null