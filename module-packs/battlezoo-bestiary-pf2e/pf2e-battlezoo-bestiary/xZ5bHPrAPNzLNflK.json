"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"T17FnKmXNTzhtE2F","name":"Lithe","type":"action","img":"systems/pf2e/icons/actions/Passive.webp","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"gm":"","value":"<p>The afneith can fit through tight spaces as if it were a Small creature. While @Compendium[pf2e.actionspf2e.kMcV8e5EZUxa6evt]{Squeezing}, it can move at its full Speed.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"offensive","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"iMDosjpGAu2sNirE","name":"Pounce","type":"action","img":"systems/pf2e/icons/actions/OneAction.webp","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"gm":"","value":"<p>The afneith Strides and makes a Strike at the end of that movement. If the afneith began this action @Compendium[pf2e.conditionitems.iU0fEDdBp3rXpTMC]{Hidden}, it remains hidden until after this ability's Strike.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":1},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"07EIul0q4BhipCry","name":"Sneak Attack","type":"action","img":"systems/pf2e/icons/actions/Passive.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>The afneith deals [[/r 1d6[precision]]]{1d6 extra precision damage} to @Compendium[pf2e.conditionitems.AJh5ex99aV6VTggg]{Off-Guard} creatures.</p>\n<hr />\n<p>@Localize[PF2E.NPC.Abilities.Glossary.SneakAttack]</p>"},"rules":[{"category":"precision","diceNumber":1,"dieSize":"d6","key":"DamageDice","predicate":["target:condition:off-guard",{"or":["finesse","agile","ranged"]}],"selector":"strike-damage"},{"key":"RollOption","domain":"all","label":"PF2E.SpecificRule.TOTMToggle.OffGuard","option":"target:condition:off-guard","toggleable":"totm"}],"slug":"sneak-attack","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"offensive","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""},"weapon":{"value":""}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.bestiary-ability-glossary-srd.Item.AWvNPE4U0kEJSL1T","duplicateSource":null,"exportSource":null}},{"_id":"QsBQq6bo948IYt8p","name":"Improved Grab","type":"action","img":"systems/pf2e/icons/actions/FreeAction.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>@Localize[PF2E.NPC.Abilities.Glossary.ImprovedGrab]</p>"},"rules":[],"slug":"improved-grab","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"free"},"category":"offensive","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""},"weapon":{"value":""}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.bestiary-ability-glossary-srd.Item.i18TlebMzwONyPhI","duplicateSource":null,"exportSource":null}}],"effects":[],"folder":null,"sort":0,"flags":{"pf2e":{"lootable":false},"core":{}},"system":{"attributes":{"hp":{"value":140,"temp":0,"max":140,"details":""},"ac":{"value":26,"details":"","base":26},"allSaves":{"value":""},"speed":{"value":40,"otherSpeeds":[{"type":"climb","label":"Climb","value":40}],"details":""}},"initiative":{"statistic":"perception"},"details":{"languages":{"value":["common"],"details":"can't speak any language"},"level":{"value":8},"blurb":"","publicNotes":"<p>Afneiths are nocturnal eight-legged felines native to arid southern deserts. Their large bodies strike a distinctive silhouette on moonlit nights: serrated claws, wide jaws, and oversized ears combine to form the image of a natural-born killer. Though these powerful predators were not born-they were made.</p>\n<p>The first afneith was created by a cabal of desert-dwelling druids who served a cat-adoring pharaoh. When the pharaoh died, her will stipulated that her tomb not be guarded by constructs or soldiers but by a feline beast of her own peculiar specifications. The druids worked tirelessly to create such a beast, enlisting royal clerics and wizards to aid their quest. In the end, they created a beast so fearsome that they were only too glad to lock it away in their pharaoh's tomb. As a safeguard in case the beast should escape, the spellcasters ensured that the afneith had an easily exploitable weakness to the belladonna herb-a weakness that they tried to keep secret but which has inevitably become common knowledge to sarcophagus-robbing treasure hunters.</p>\n<p>Afneiths physically differ from their typical cat relatives in several ways. Their massive pointed ears act like funnels for sound, allowing them to pinpoint even the stealthiest tomb robbers. With their flexible skeletal structure and slack flesh, afneiths have little trouble slinking through tight corridors and alcoves to reposition and get the edge in an encounter. Finally, they possess an advanced intellect that allows them to override some of their feline instincts and invent complex strategies.</p>\n<h2>\"Domesticated\" Afneiths</h2>\n<p>Afneiths have long spread beyond the pharaonic mausoleums in which they were initially confined. Desert travelers who overcome their initial fright might hope to befriend the wandering beast; afneiths are supposedly loyal friends once their trust is earned with food and affection. Skeptics claim that afneiths nearly always appear aloof to others' needs and seem primarily motivated by food and play. Conversely, afneith supporters point out that many humanoids are motivated by these same things.</p>\n<h2>Monster Part Subsystem</h2>\n<p><strong>Afneith Creature 8 </strong></p>\n<p><strong>Monster Parts</strong> 64/140/250 gp</p>\n<p><strong>Eligible Refinements</strong> weapons (piercing, slashing), armor (light, medium), perception item, skill items (Acrobatics, Athletics, Intimidation, Society, Stealth, Survival)</p>\n<p><strong>Eligible Imbued Properties</strong> bane, charisma, dexterity, energy resistant (positive), sensory (darkvision, scent), wild</p>","privateNotes":"","publication":{"title":"Battlezoo Bestiary","authors":"Andrew P. Sturtevant","license":"OGL","remaster":false},"creatureType":""},"resources":{},"_migration":{"version":0.932,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"abilities":{"str":{"mod":4},"dex":{"mod":6},"con":{"mod":4},"int":{"mod":-2},"wis":{"mod":3},"cha":{"mod":5}},"perception":{"details":"","mod":17,"senses":[{"type":"darkvision"},{"type":"echolocation","acuity":"precise","range":60},{"type":"scent","acuity":"imprecise","range":30}],"vision":true},"saves":{"fortitude":{"value":16,"saveDetail":""},"reflex":{"value":20,"saveDetail":""},"will":{"value":13,"saveDetail":""}},"skills":{"acrobatics":{"base":18},"athletics":{"base":16},"intimidation":{"base":17},"society":{"base":10},"stealth":{"base":18},"survival":{"base":15}},"traits":{"value":["beast"],"rarity":"common","size":{"value":"lg"}}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"prototypeToken":{"bar1":{"attribute":"attributes.hp"},"displayName":20,"displayBars":20,"flags":{"pf2e":{"linkToActorSize":true,"autoscale":false}},"height":2,"width":2,"disposition":-1,"name":"Afneith","actorLink":false,"lockRotation":false,"rotation":0,"alpha":1,"bar2":{"attribute":null},"randomImg":false,"light":{"alpha":0.25,"angle":360,"bright":0,"coloration":1,"dim":0,"luminosity":0.5,"saturation":0,"contrast":0,"shadows":0,"animation":{"speed":5,"intensity":5,"type":null,"reverse":false},"darkness":{"min":0,"max":1},"color":null,"attenuation":0.5,"negative":false,"priority":0},"texture":{"src":"modules/battlezoo-bestiary-pf2e/art/Tokens/afneith.webp","tint":"#ffffff","scaleX":2,"scaleY":2,"anchorX":0.5,"anchorY":0.5,"fit":"contain","alphaThreshold":0.75},"sight":{"angle":360,"enabled":false,"range":0,"brightness":1,"visionMode":"basic","color":null,"attenuation":0.1,"saturation":0,"contrast":0},"detectionModes":{},"appendNumber":false,"prependAdjective":false,"occludable":{"radius":0},"ring":{"enabled":true,"colors":{"ring":null,"background":null},"effects":1,"subjec