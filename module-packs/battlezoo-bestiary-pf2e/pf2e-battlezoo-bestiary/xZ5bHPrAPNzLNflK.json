ot be distracted again by belladonna for 1 hour.</p>\n<p><strong>Success</strong> As critical success, but the afneith can make a Fortitude saving throw against the belladonna. The afneith takes a -5 penalty to its save.</p>\n<p><strong>Failure</strong> The afneith is unimpressed and does not react.</p>\n<p><strong>Critical Failure</strong> The afneith can spend a reaction to make a jaws Strike against the creature.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"defensive","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":"pf2e","systemVersion":"4.9.3","coreVersion":"14.360","createdTime":null,"modifiedTime":1679091334050,"lastModifiedBy":"W75cDAmGcgt3X6Rq","compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"eK8RsdNqge2VdlTK","name":"Jaws","type":"melee","img":"systems/pf2e/icons/default-icons/melee.svg","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"gm":"","value":""},"rules":[],"slug":null,"traits":{"value":[],"otherTags":[]},"damageRolls":{"oz6wpdojmbl4frlz4wv2":{"damage":"2d10+10","damageType":"piercing","category":null}},"bonus":{"value":18},"attackEffects":{"value":[]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"_migration":{"version":0.932,"previous":{"schema":null,"foundry":"12.328","system":"6.1.0"}}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"jl3LXQaF0FTY6Ypu","name":"Claw","type":"melee","im