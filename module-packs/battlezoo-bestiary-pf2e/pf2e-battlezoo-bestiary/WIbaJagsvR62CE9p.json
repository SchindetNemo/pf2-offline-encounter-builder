":0},"slot10":{"prepared":[],"value":0,"max":0},"slot11":{"prepared":[],"value":0,"max":0}},"autoHeightenLevel":{"value":null},"showUnpreparedSpells":{"value":true},"displayLevels":{}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"3IEyZYOhTzUkVdxn","name":"Entangle (At Will)","type":"spell","img":"systems/pf2e/icons/spells/entangle.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>Plants in the area entangle creatures. The area counts as difficult terrain. Each round that a creature starts its turn in the area, it must attempt a Reflex save. On a failure, it takes a -10-foot circumstance penalty to its Speeds until it leaves the area, and on a critical failure, it is also @Compendium[pf2e.conditionitems.eIcWbB5o3pP6OIMe]{Immobilized} for 1 round. Creatures can attempt to Escape at entangle's DC to remove these effects.</p>"},"rules":[],"slug":"entangle","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","manipulate","plant"],"rarity":"common","traditions":["primal"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":2},"requirements":"","target":{"value":""},"range":{"value":"120 feet"},"area":{"value":20,"type":"burst","details":"all squares in a 20-foot-radius burst that contain plants"},"time":{"value":"2"},"duration":{"value":"1 minute","sustained":false},"damage":{},"defense":{"passive":null,"save":{"statistic":"reflex","basic":false}},"cost":{"value":""},"location":{"value":"zeMRBZOfI2Q1Asze","heightenedLevel":2},"counteraction":false},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":nu