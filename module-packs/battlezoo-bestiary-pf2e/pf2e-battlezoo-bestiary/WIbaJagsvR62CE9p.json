d.Item.zlnXpME1T2uvn8Lr","duplicateSource":null,"exportSource":null}},{"_id":"3ccF7kdYtqm7F8Bk","name":"Constant Spells","type":"action","img":"systems/pf2e/icons/actions/Passive.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>@Localize[PF2E.NPC.Abilities.Glossary.ConstantSpells]</p>"},"rules":[],"slug":"constant-spells","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"interaction","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""},"weapon":{"value":""}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.bestiary-ability-glossary-srd.Item.kakyXBG5WA8c6Zfd","duplicateSource":null,"exportSource":null}},{"_id":"xJGrxfa1MIqPVcCa","name":"At-Will Spells","type":"action","img":"systems/pf2e/icons/actions/Passive.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>@Localize[PF2E.NPC.Abilities.Glossary.AtWillSpells]</p>"},"rules":[],"slug":"at-will-spells","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"interaction","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""},"weapon":{"value":""}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.bestiary-ability-glossary-srd.Item.2YRDYVnC1eljaXKK","duplicateSource":null,"exportSource":null}},{"_id":"fGokaQfJjEjvRbM7","name":"Drain Fluids","type":"action","img":"systems/pf2e/icons/actions/OneAction.webp","effects":[],"folder":null,"sort":100000,"flags":{},"system":{"description":{"gm":"","value":"<p><strong>Frequency</strong> once per round;</p>\n<p><strong>Requirements</strong> The thorn crawler has one or more creatures swallowed whole;</p>\n\n<p><strong>Effect</strong> The thorn crawler uses its sharp, hollow roots to suck vital fluids from swallowed creatures' bodies. Each swallowed creature must make a @Check[type:fortitude|dc:29|name:Drain Fluids DC|traits:necromancy, primal|showDC:gm]{Fortitude} save.</p>\n<hr />\n<p><strong>Success</strong> The creature is unaffected.</p>\n<p><strong>Failure</strong> The creature is @Compendium[pf2e.conditionitems.4D2KBtexWXa6oUMR]{Drained 1} and the thorn crawler regains 15 HP.</p>\n<p><strong>Critical Failure</strong> The creature is @Compendium[pf2e.conditionitems.4D2KBtexWXa6oUMR]{Drained 2} and the thorn crawler regains 30 HP.</p>\n"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["primal"],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":1},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"CJKe38htuGe9FvZX","name":"Swallow Whole","type":"action","img":"systems/pf2e/icons/actions/OneAction.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>Large, [[/r (2d8 + 13)[piercing]]] damage, Rupture 30. A thorn crawler can have up to two Medium creatures swallowed at a time.</p>\n<hr />\n<p>@Localize[PF2E.NPC.Abilities.Glossary.SwallowWhole]</p>"},"rules":[],"slug":"swallow-whole","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["attack"],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":1},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""},"weapon":{"value":""}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.bestiary-ability-glossary-srd.Item.uJSseLa57HZYSMUu","duplicateSource":null,"exportSource":null}},{"_id":"ACb6tftq5WpboDjW","name":"Woodland Stride","type":"action","img":"systems/pf2e/icons/actions/Passive.webp","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"gm":"","value":"<p>The thorn crawler ignores difficult terrain and greater difficult terrain from nonmagical foliage.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"offensive","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"6BoXIeIGB0SObZuh","name":"Thorn Burst","type":"action","img":"systems/pf2e/icons/actions/TwoActions.webp","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"gm":"","value":"<p>The thorn crawler thrusts its branches into the ground and up through the surrounding plants, causing sharp thorns to explode from every direction. Other creatures in a @Template[type:emanation|distance:10] take [[/r 11d6[piercing]]] damage (@Check[type:reflex|dc:29|name:Thorn Burst DC|traits:damaging-effect,evocation,primal|showDC:gm]{basic Reflex} save).</p>\n<p>The thorn crawler can't use Thorn Burst again for [[/br 1d4 #rounds]]{1d4 rounds}.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["primal"],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":2},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}}],"effects":[],"folder":null,"sort":0,"flags":{"pf2e":{"lootable":false},"core":{}},"system":{"attributes":{"hp":{"value":215,"temp":0,"max":215,"details":""},"ac":{"value":29,"details":"","base":29},"allSaves":{"value":""},"speed":{"value":30,"otherSpeeds":[{"type":"climb","label":"Climb","value":15}],"details":"woodland stride"},"weaknesses":[{"type":"fire","value":10}]},"initiative":{"statistic":"perception"},"details":{"languages":{"value":[],"details":""},"level":{"value":10},"blurb":"","publicNotes":"<p>Thorn crawlers resemble massive centipedes made entirely of twisted roots, branches, vines, and undergrowth, with every inch of the monstrosity's body covered in razor-sharp thorns. These carnivorous plant creatures roam only the world's most primeval forests, using their ability to scent blood from a mile away to track down and consume injured prey. Despite their massive size, thorn crawlers are adept at navigating dense forests; they easily squeeze under tree roots and scurry through weed-choked gulches, even climbing into the forest canopy to better survey the ground and get the drop on unsuspecting prey.</p>\n<p>Like many carnivorous plants, thorn crawlers feed on bodily fluids, leeching blood and humors into their root systems. A thorn crawler's digestive organs, such as they are, are located along the inner diameter of a hollow cavity in the monster's body. Thorn crawlers tuck captured forest critters and unwary travelers in this cavity, piercing its prey with sharp roots and swiftly draining the creature of vital fluids. Days later, a thorn crawler unceremoniously expels the victim's desiccated husk onto the forest floor.</p>\n<p>A newly introduced thorn crawler can challenge a forest's apex predators and decimate the local ecosystem if left unchecked. Rulers of nations whose forests are beleaguered by thorn crawlers sometimes arrange for formal hunts of the creatures. Because the peasantry would turn such a hunt into little more than a slash and burn of the entire forest, rulers prefer to send adventurers who have a lighter touch to hunt down and eliminate the pesky plants.</p>\n<h2>Variant Thorn Crawlers</h2>\n<p>Their ability to traverse a wide variety of terrain means that thorn crawlers can be found in forests throughout the world. Those in temperate forests typically become dormant during the winter, slumbering in thicketed ravines; those in tropical climates, however, are active year-round. Some species develop a natural paralytic poison that afflicts anyone on the wrong end of their thorns, while others have been afflicted by powerful consumed magic items or artifacts which have unlocked theretofore unknown primal powers.</p>\n<h2>Monster Part Subsystem</h2>\n<p><strong>Thorn Crawler Creature 10 </strong></p>\n<p><strong>Monster Parts</strong> 125/275/500 gp</p>\n<p><strong>Eligible Refinements</strong> weapons (piercing, slashing), armor (light, medium), perception item, skill items (Acrobatics, Athletics, Stealth)</p>\n<p><strong>Eligible Imbued Properties</strong> bane, constitution, dexterity, energy resistant (positive), spells (Primal: entangle, pass without trace), strength, wild</p>","privateNotes":"","publication":{"title":"Battlezoo Bestiary","authors":"Daniel Aznavorian","license":"OGL","remaster":false},"creatureType":""},"resources":{},"_migration":{"version":0.932,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"abilities":{"str":{"mod":7},"dex":{"mod":5},"con":{"mod":7},"int":{"mod":-4},"wis":{"mod":3},"cha":{"mod":-4}},"perception":{"details":"blood scent, blood scent","mod":19,"senses":[{"type":"tremorsense","acuity":"imprecise","range":120}],"vision":true},"saves":{"fortitude":{"value":21,"saveDetail":""},"reflex":{"value":19,"saveDetail":""},"will":{"value":15,"saveDetail":""}},"skills":{"acrobatics":{"base":19},"athletics":{"base":21},"stealth":{"base":19,"special":[{"label":"in Forests","base":23,"predicate":["terrain:forest"]}]}},"traits":{"value":["plant"],"rarity":"common","size":{"value":"huge"}}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"prototypeToken":{"bar1":{"attribute":"attributes.hp"},"displayName":20,"displayBars":20,"flags":{"pf2e":{"linkToActorSize":true,"autoscale":true}},"height":3,"width":3,"disposition":-1,"name":"Thorn Crawler","actorLink":false,"lockRotation":false,"rotation":0,"alpha":1,"bar2":{"attribute":null},"randomImg":false,"light":{"alpha":0.25,"angle":360,"bright":0,"coloration":1,"dim":0,"luminosity":0.5,"saturation":0,"contrast":0,"shadows":0,"animation":{"speed":5,"intensity":5,"type":null,"reverse":false},"darkness":{"min":0,"max":1},"color":null,"attenuation":0.5,"negative":false,"priority":0},"texture":{"src":"modules/battlezoo-bestiary-pf2e/art/Tokens/thorn_crawler.webp","tint":"#ffffff","scaleX":1,"scaleY":1,"anchorX":0.5,"anchorY":0.5,"fit":"contain","alphaThreshold":0.75},"sight":{"angle":360,"enabled":false,"range":0,"brightness":1,"visionMode":"basic","color":null,"attenuation":0.1,"saturation":0,"contrast":0},"detectionModes":{},"appendNumber":false,"prependAdjective":false,"occludable":{"radius":0},"ring":{"enabled":true,"colors":{"ring":null,"background":null},"effects":1,"subject":{"scale":1,"texture":"modules/battlezoo-bestiary-pf2e/art/Subjects/thorn_crawler.webp"}},"turnMarker":{"mode":1,"animation":null,"src":null,"disposition":false},"movementAction":null,"depth":3},"_stats":{"systemId":"pf2e","systemVersion":"6.1.0","coreVersion":"14.360","createdTime":1663517316857,"modifiedTime":1729379234151,"lastModifiedBy":"ZdvNMqfYMlbFrAL2","compendiumSource":"Compendium.battlezoo-bestiary-pf2e.pf2e-battlezoo-bestiary.Actor.WIbaJagsvR62CE9p","duplicateSource":null,"exportSource":null}}