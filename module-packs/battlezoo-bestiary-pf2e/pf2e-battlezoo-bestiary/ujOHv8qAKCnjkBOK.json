":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["mental"],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"reaction"},"category":"defensive","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"lNoXNV2kt6e3RSQq","name":"Selfish Protection","type":"action","img":"systems/pf2e/icons/actions/Reaction.webp","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"gm":"","value":"<p><strong>Trigger</strong> An enemy damages the milopoxy's ward. Both the enemy and ward must be within 15 feet of the milopoxy;</p>\n<hr />\n<p><strong>Effect</strong> The milopoxy Strides to a space adjacent to its ward to shield them. The ward gains resistance 10 to the triggering damage. All damage prevented this way is dealt to the milopoxy instead. The milopoxy can use Bask In Glory as part of this reaction.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"reaction"},"category":"defensive","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"WSGFmKoeSAzE0vBF","name":"Bastard Sword","type":"melee","img":"systems/pf2e/icons/default-icons/melee.svg","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"value":"","gm":""},"rules":[],"slug":null,"traits":{"value":["magical","two-hand-d12"],"otherTags":[]},"damageRolls":{"tko896ej2j07bbqqeilz":{"damage":"2d8+9","damageType":"slashing","category":null}},"bonus":{"value":19},"attackEffects":{"value":[]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"_migration":{"version":0.932,"previous":{"schema":null,"foundry":"12.328","system":"6.1.0"}}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"8Hk3XjKSGR1tnsh1","name":"Composite Longbow","type":"melee","img":"systems/pf2e/icons/default-icons/melee.svg","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"value":"","gm":""},"rules":[],"slug":null,"traits":{"value":["deadly-d10","propulsive","range-increment-100","reload-0","volley-30"],"otherTags":[]},"damageRolls":{"l5u290335zwztjdaefpq":{"damage":"1d8+2","damageType":"piercing","category":null}},"bonus":{"value":18},"attackEffects":{"value":[]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"_migration":{"version":0.932,"previous":{"schema":null,"foundry":"12.328","system":"6.1.0"}}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"iqlh8kIHkrOSO8VQ","name":"Bask in Glory","type":"action","img":"systems/pf2e/icons/actions/OneAction.webp","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"gm":"","value":"<p>Requirement The milopoxy can be seen by its ward or at least one non-hostile creature;</p>\n\n<p><strong>Effect</strong> The milopoxy shows off its imagined heroism, magically compelling witnesses to cheer. It rolls a Diplomacy check against the Will DC of its ward and all non-hostile creatures within 60 feet. As long as one creature cheers, the milopoxy gains a +1 status bonus to attack rolls, damage rolls, and saves against fear effects.</p>\n\n<p>Regardless of its save result, each creature is immune to Bask In Glory for 24 hours.</p>\n<hr />\n<p><strong>Critical Success</strong> The creature uses all its actions to cheer for the milopoxy. It does so for up to 1 minute or until the milopoxy doesn't Bask In Glory at least once on a subsequent round, whichever comes first. If the creature or one of its allies is attacked, it can make a @Check[type:will|dc:26|name:Bask in Glory DC|traits:emotion,enchantment,incapacitation,mental,primal,visual|showDC:gm]{Will} save to end the effect.</p>\n<p><strong>Success</strong> As critical success, but the duration is until the end of the creature's next turn.</p>\n<p><strong>Failure</strong> The creature is unaffected.</p>\n"},"rules":[{"key":"RollOption","label":"A witness is cheering (Bask in Glory)","domain":"all","option":"baskInGlory","toggleable":true,"value":false},{"key":"FlatModifier","selector":"saving-throw","value":1,"type":"status","predicate":["baskInGlory","fear"]},{"key":"FlatModifier","selector":"attack","value":1,"type":"status","predicate":["baskInGlory"]},{"key":"FlatModifier","selector":"strike-damage","value":1,"type":"status","predicate":["baskInGlory"]}],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["emotion","incapacitation","mental","primal","visual"],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":1},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"rPTHFGDmkVKUnt36","name":"Proclaim Ward","type":"action","img":"systems/pf2e/icons/actions/OneAction.webp","effects":[],"folder":null,"sort":100000,"flags":{},"system":{"description":{"gm":"","value":"<p>The milopoxy loudly designates as its ward a single creature that it can see and hear or that it is Tracking. It gains a +2 circumstance bonus to Perception checks when it Seeks its ward and a +2 circumstance bonus to Survival checks when it Tracks its ward. It also gains a +2 circumstance bonus to Athletics, Diplomacy, and Intimidation checks it makes while protecting its ward. The milopoxy can have only one ward designated at a time, and a creature can be designated the ward of only one milopoxy.</p>"},"rules":[{"key":"FlatModifier","selector":"survival","value":2,"type":"circumstance","predicate":["action:track","target:ward"]},{"key":"FlatModifier","selector":"perception","value":2,"type":"circumstance","predicate":["action:seek","target:ward"]},{"key":"FlatModifier","selector":"athletics","value":2,"type":"circumstance","predicate":["protectWard"]},{"key":"FlatModifier","selector":"diplomacy","value":2,"type":"circumstance","predicate":["protectWard"]},{"key":"FlatModifier","selector":"intimidation","value":2,"type":"circumstance","predicate":["protectWard"]}],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":1},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}}],"effects":[],"folder":null,"sort":0,"flags":{"pf2e":{"lootable":false},"core":{}},"system":{"attributes":{"hp":{"value":130,"temp":0,"max":130,"details":""},"ac":{"value":27,"details":"","base":27},"allSaves":{"value":""},"speed":{"value":20,"otherSpeeds":[],"details":""},"weaknesses":[{"type":"cold-iron","value":10}]},"initiative":{"statistic":"perception"},"details":{"languages":{"value":["common","fey"],"details":""},"level":{"value":8},"blurb":"","publicNotes":"<p>Obsessed with grandiose tales of chivalry and stories of great heroes who protect the weak, milopoxies are lithe humanoid fey who wander the world imitating these legends between fits of delusion and whimsy. Unfortunately for others, milopoxies don't truly understand the concepts of empathy or selflessness. Far from really aiding anyone, these selfish cavaliers—which are also known poetically as \"misguided protectors\"—tend to expend all their energy boasting about imagined heroic deeds and imploring evildoers to beware of their righteous blades. Yet, in spite of a milopoxy's obliviousness, this over-the-top distraction technique occasionally works.</p>\n<h2>Oblivious Guardian</h2>\n<p>More often than not, a milopoxy's ward ends up dead from exhaustion or neglect since milopoxies have no need for food or water and believe that everlasting glory is more than enough sustenance to live on. Particularly aloof milopoxies might continue carrying a dead protégé for years, only disposing of the corpse after stumbling upon a more prestigious creature to \"protect.\"</p>\n<h2>Monster Part Subsystem</h2>\n<p><strong>Milopoxy Creature 8 </strong></p>\n<p><strong>Monster Parts</strong> 64/140/250 gp</p>\n<p><strong>Eligible Refinements</strong> armor (light, medium), skill items (Acrobatics, Athletics, Diplomacy, Intimidation, Lore [Chivalry])</p>\n<p><strong>Eligible Imbued Properties</strong> bane, chaotic, charisma, dexterity, energy resistant (positive), mental, sensory (low-light vision), strength, wild</p>","privateNotes":"","publication":{"title":"Battlezoo Bestiary","authors":"Francois Potvin Naud","license":"OGL","remaster":false},"creatureType":""},"resources":{},"_migration":{"version":0.932,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"abilities":{"str":{"mod":5},"dex":{"mod":6},"con":{"mod":3},"int":{"mod":2},"wis":{"mod":0},"cha":{"mod":6}},"perception":{"details":"","mod":14,"senses":[{"type":"low-light-vision"}],"vision":true},"saves":{"fortitude":{"value":17,"saveDetail":""},"reflex":{"value":20,"saveDetail":""},"will":{"value":12,"saveDetail":""}},"skills":{"acrobatics":{"base":18},"athletics":{"base":17},"diplomacy":{"base":18},"intimidation":{"base":18,"special":[{"label":"to Demoralize","base":20,"predicate":["action:demoralize"]}]}},"traits":{"value":["chaotic","fey"],"rarity":"uncommon","size":{"value":"med"}}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"prototypeToken":{"bar1":{"attribute":"attributes.hp"},"displayName":20,"displayBars":20,"flags":{"pf2e":{"linkToActorSize":true,"autoscale":false}},"height":1,"width":1,"disposition":-1,"name":"Milopoxy","actorLink":false,"lockRotation":false,"rotation":0,"alpha":1,"bar2":{"attribute":null},"randomImg":false,"light":{"alpha":0.25,"angle":360,"bright":0,"coloration":1,"dim":0,"luminosity":0.5,"saturation":0,"contrast":0,"shadows":0,"animation":{"speed":5,"intensity":5,"type":null,"reverse":false},"darkness":{"min":0,"max":1},"attenuation":0.5,"color":null,"negative":false,"priority":0},"texture":{"src":"modules/battlezoo-bestiary-pf2e/art/Tokens/milopoxy.webp","scaleX":2,"scaleY":2,"tint":"#ffffff","anchorX":0.5,"anchorY":0.5,"fit":"contain","alphaThreshold":0.75},"sight":{"angle":360,"enabled":false,"range":0,"brightness":1,"visionMode":"basic","color":null,"attenuation":0.1,"saturation":0,"contrast":0},"detectionModes":{},"appendNumber":false,"prependAdjectiv