{"_id":"ga6jCZzeR6rr7iMn","name":"Scroll Mold","type":"npc","img":"modules/battlezoo-bestiary-pf2e/art/scroll_mold.webp","items":[{"_id":"O50wetp5r61gwDqd","name":"Camouflage","type":"action","img":"systems/pf2e/icons/actions/Passive.webp","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"gm":"","value":"<p>The scroll mold can change its coloration to match its surroundings. It doesn't need cover to attempt to @Compendium[pf2e.actionspf2e.XMcnh4cSI32tljXa]{Hide} with a Stealth check.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"interaction","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"bp7EMR5OyYv7bzV5","name":"Motion Sense 30 feet","type":"action","img":"systems/pf2e/icons/actions/Passive.webp","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"gm":"","value":"<p>Scroll molds can sense nearby creatures through vibration and air or water movement.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"interaction","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"FIoUUSoMwBmGvHPi","name":"Arcane Innate Spells","type":"spellcastingEntry","img":"systems/pf2e/icons/default-icons/spellcastingEntry.svg","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"gm":"","value":""},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"ability":{"value":"wis"},"spelldc":{"value":8,"dc":16,"mod":0},"tradition":{"value":"arcane"},"prepared":{"value":"innate","flexible":false},"showSlotlessLevels":{"value":true},"proficiency":{"value":0},"slots":{"slot0":{"prepared":[],"value":0,"max":0},"slot1":{"prepared":[],"value":0,"max":0},"slot2":{"prepared":[],"value":0,"max":0},"slot3":{"prepared":[],"value":0,"max":0},"slot4":{"prepared":[],"value":0,"max":0},"slot5":{"prepared":[],"value":0,"max":0},"slot6":{"prepared":[],"value":0,"max":0},"slot7":{"prepared":[],"value":0,"max":0},"slot8":{"prepared":[],"value":0,"max":0},"slot9":{"prepared":[],"value":0,"max":0},"slot10":{"prepared":[],"value":0,"max":0},"slot11":{"prepared":[],"value":0,"max":0}},"autoHeightenLevel":{"value":null},"showUnpreparedSpells":{"value":true},"displayLevels":{}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"v7okoiou7ucimiqE","name":"Burning Hands","type":"spell","img":"systems/pf2e/icons/spells/burning-hands.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>Gouts of flame rush from your hands. You deal 2d6 fire damage to creatures in the area.</p>\n<hr />\n<p><strong>Heightened (+1)</strong> The damage increases by 2d6.</p>"},"rules":[],"slug":"burning-hands","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["fire"],"rarity":"common","traditions":["arcane","primal"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":1},"requirements":"","target":{"value":""},"range":{"value":""},"area":{"value":15,"type":"cone"},"time":{"value":"3"},"duration":{"value":"","sustained":false},"damage":{"0":{"applyMod":false,"formula":"2d6","type":"fire","category":null,"materials":[],"kinds":["damage"]}},"defense":{"passive":null,"save":{"statistic":"reflex","basic":true}},"cost":{"value":""},"location":{"value":"FIoUUSoMwBmGvHPi","heightenedLevel":1},"counteraction":false,"heightening":{"type":"interval","interval":1,"damage":{"0":"2d6"}}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.y6rAdMK6EFlV6U0t","duplicateSource":null,"exportSource":null}},{"_id":"BmUp6VGPP3kiSEQN","name":"Color Spray","type":"spell","img":"systems/pf2e/icons/spells/color-spray.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>Swirling colors affect viewers based on their Will saves.</p>\n<hr />\n<p><strong>Critical Success</strong> The creature is unaffected.</p>\n<p><strong>Success</strong> The creature is @Compendium[pf2e.conditionitems.TkIyaNPgTZFBCCuh]{Dazzled} for 1 round.</p>\n<p><strong>Failure</strong> The creature is @Compendium[pf2e.conditionitems.dfCMdR4wnpbYNTix]{Stunned 1}, @Compendium[pf2e.conditionitems.XgEqL1kFApUbl5Z2]{Blinded} for 1 round, and Dazzled for 1 minute.</p>\n<p><strong>Critical Failure</strong> The creature is Stunned for 1 round and Blinded for 1 minute.</p>"},"rules":[],"slug":"color-spray","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["illusion","incapacitation","visual"],"rarity":"common","traditions":["arcane","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":1},"requirements":"","target":{"value":""},"range":{"value":""},"area":{"value":15,"type":"cone"},"time":{"value":"3"},"duration":{"value":"1 or more rounds (see below)","sustained":false},"damage":{},"defense":{"passive":null,"save":{"statistic":"will","basic":false}},"cost":{"value":""},"location":{"value":"FIoUUSoMwBmGvHPi","heightenedLevel":1},"counteraction":false},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.UKsIOWmMx4hSpafl","duplicateSource":null,"exportSource":null}},{"_id":"SeMECz4hOpDis9Ve","name":"Illusory Object (See Nascent Mind)","type":"spell","img":"systems/pf2e/icons/spells/illusory-object.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>You create an illusory visual image of a stationary object. The entire image must fit within the spell's area. The object appears to animate naturally, but it doesn't make sounds or generate smells. For example, water would appear to pour down an illusory waterfall, but it would be silent.</p>\n<p>Any creature that touches the image or uses the Seek action to examine it can attempt to disbelieve your illusion.</p>\n<hr />\n<p><strong>Heightened (2nd)</strong> Your image makes appropriate sounds, generates normal smells, and feels right to the touch. The spell gains the auditory trait. The duration increases to 1 hour.</p>\n<p><strong>Heightened (5th)</strong> As the 2nd-level version, but the duration is unlimited.</p>"},"rules":[],"slug":"illusory-object","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["illusion","visual"],"rarity":"common","traditions":["arcane","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":1},"requirements":"","target":{"value":""},"range":{"value":"500 feet"},"area":{"value":20,"type":"burst"},"time":{"value":"3"},"duration":{"value":"10 minutes","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"FIoUUSoMwBmGvHPi","heightenedLevel":1},"counteraction":false,"heightening":{"type":"interval","interval":1,"damage":{}}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.2oH5IufzdESuYxat","duplicateSource":null,"exportSource":null}},{"_id":"ngoBltkHQADWGdlg","name":"Longstrider","type":"spell","img":"systems/pf2e/icons/spells/longstrider.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>You lengthen your stride beyond what should be possible. You gain a +10-foot status bonus to your Speed.</p>\n<p>@Compendium[pf2e.spell-effects.PQHP7Oph3BQX1GhF]{Spell Effect: Longstrider}</p>\n<hr />\n<p><strong>Heightened (2nd)</strong> The duration increases to 8 hours.</p>"},"rules":[],"slug":"longstrider","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[],"rarity":"common","traditions":["arcane","primal"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":1},"requirements":"","target":{"value":""},"range":{"value":""},"area":null,"time":{"value":"3"},"duration":{"value":"1 hour","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"FIoUUSoMwBmGvHPi","heightenedLevel":1},"counteraction":false},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.KcLVELhCUcKXxiKE","duplicateSource":null,"exportSource":null}},{"_id":"TI7g28joSOrkwXWL","name":"Sleep","type":"spell","img":"systems/pf2e/icons/spells/sleep.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>Each creature in the area becomes drowsy and might fall asleep. A creature that falls @Compendium[pf2e.conditionitems.fBnFDH2MTzgFijKf]{Unconscious} from this spell doesn't fall @Compendium[pf2e.conditionitems.j91X7x0XSomq8d60]{Prone} or release what it's holding. This spell doesn't prevent creatures from waking up due to a successful Perception check, limiting its utility in combat.</p>\n<hr />\n<p><strong>Critical Success</strong> The creature is unaffected.</p>\n<p><strong>Success</strong> The creature takes a -1 status penalty to Perception checks for 1 round.</p>\n<p><strong>Failure</strong> The creature falls Unconscious. If it's still Unconscious after 1 minute, it wakes up automatically.</p>\n<p><strong>Critical Failure</strong> The creature falls Unconscious. If it's still Unconscious after 1 hour, it wakes up automatically.</p>\n<hr />\n<p><strong>Heightened (4th)</strong> The creatures fall Unconscious for 1 round on a failure or 1 minute on a critical failure. They fall Prone and release what they're holding, and they can't attempt Perception checks to wake up. When the duration ends, the creature is sleeping normally instead of automatically waking up.</p>"},"rules":[],"slug":"sleep","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["incapacitation","mental","sleep"],"rarity":"common","traditions":["arcane","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":1},"requirements":"","target":{"value":""},"range":{"value":"30 feet"},"area":{"value":5,"type":"burst"},"time":{"value":"3"},"duration":{"value":"","sustained":false},"damage":{},"defense":{"passive":null,"save":{"statistic":"will","basic":false}},"cost":{"value":""},"location":{"value":"FIoUUSoMwBmGvHPi","heightenedLevel":1},"counteraction":false},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.o4lRVTwSxnOOn5vl","duplicateSource":null,"exportSource":null}},{"_id":"a3BEwnPjQdiZTwGr","name":"Chill Touch","type":"spell","img":"systems/pf2e/icons/spells/chill-touch.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>Siphoning negative energy into yourself, your hand radiates a pale darkness. Your touch weakens the living and disorients undead, possibly even causing them to flee. The effect depends on whether the target is living or undead.</p>\n<ul>\n<li><strong>Living Creature</strong> The spell deals negative damage equal to 1d4 plus your spellcasting modifier. The target attempts a basic Fortitude save, but is also @Compendium[pf2e.conditionitems.MIRkyAjyBeXivMa7]{Enfeebled 1} for 1 round on a critical failure.</li>\n<li><strong>Undead Creature</strong> The target is @Compendium[pf2e.conditionitems.AJh5ex99aV6VTggg]{Off-Guard} for 1 round on a failed Fortitude save. On a critical failure, the target is also @Compendium[pf2e.conditionitems.sDPxOjQ9kx2RZE8D]{Fleeing} for 1 round unless it succeeds at a Will save.</li>\n</ul>\n<hr />\n<p><strong>Heightened (+1)</strong> The negative damage to living creatures increases by 1d4.</p>"},"rules":[],"slug":"chill-touch","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["cantrip"],"rarity":"common","traditions":["arcane","divine","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":1},"requirements":"","target":{"value":"1 living or undead creature"},"range":{"value":"touch"},"area":null,"time":{"value":"3"},"duration":{"value":"","sustained":false},"damage":{"0":{"applyMod":true,"formula":"1d4","type":"void","category":null,"materials":[],"kinds":["damage"]}},"defense":{"passive":null,"save":{"statistic":"fortitude","basic":true}},"cost":{"value":""},"location":{"value":"FIoUUSoMwBmGvHPi"},"counteraction":false,"heightening":{"type":"interval","interval":1,"damage":{"0":"1d4"}}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.mAMEt4FFbdqoRnkN","duplicateSource":null,"exportSource":null}},{"_id":"d69r7CgccT9a61g9","name":"Detect Magic","type":"spell","img":"systems/pf2e/icons/spells/detect-magic.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>You send out a pulse that registers the presence of magic. You receive no information beyond the presence or absence of magic. You can choose to ignore magic you're fully aware of, such as the magic items and ongoing spells of you and your allies.</p>\n<p>You detect illusion magic only if that magic's effect has a lower level than the level of your detect magic spell. However, items that have an illusion aura but aren't deceptive in appearance (such as an invisibility potion) typically are detected normally.</p>\n<p><strong>Heightened (3rd)</strong> You learn the school of magic for the highest-level effect within range that the spell detects. If multiple effects are equally strong, the GM determines which you learn.</p>\n<p><strong>Heightened (4th)</strong> As 3rd level, but you also pinpoint the source of the highest-level magic. Like for an imprecise sense, you don't learn the exact location, but can narrow down the source to within a 5-foot cube (or the nearest if larger than that).</p>"},"rules":[],"slug":"detect-magic","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["cantrip","detection"],"rarity":"common","traditions":["arcane","divine","occult","primal"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":1},"requirements":"","target":{"value":""},"range":{"value":""},"area":{"value":30,"type":"emanation"},"time":{"value":"3"},"duration":{"value":"","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"FIoUUSoMwBmGvHPi"},"counteraction":false},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.gpzpAAAJ1Lza2JVl","duplicateSource":null,"exportSource":null}},{"_id":"hFqdcYvW8saUCnju","name":"Electric Arc","type":"spell","img":"systems/pf2e/icons/spells/electric-arc.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>An arc of lightning leaps from one target to another. You deal electricity damage equal to 1d4 plus your spellcasting ability modifier.</p>\n<hr />\n<p><strong>Heightened (+1)</strong> The damage increases by 1d4.</p>"},"rules":[],"slug":"electric-arc","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["cantrip","electricity"],"rarity":"common","traditions":["arcane","primal"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":1},"requirements":"","target":{"value":"1 or 2 creatures"},"range":{"value":"30 feet"},"area":null,"time":{"value":"3"},"duration":{"value":"","sustained":false},"damage":{"0":{"applyMod":true,"formula":"1d4","type":"electricity","category":null,"materials":[],"kinds":["damage"]}},"defense":{"passive":null,"save":{"statistic":"reflex","basic":true}},"cost":{"value":""},"location":{"value":"FIoUUSoMwBmGvHPi"},"counteraction":false,"heightening":{"type":"interval","interval":1,"damage":{"0":"1d4"}}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.kBhaPuzLUSwS6vVf","duplicateSource":null,"exportSource":null}},{"_id":"yoZnVBXVZH8b3Q1l","name":"Ghost Sound (See Nascent Mind)","type":"spell","img":"systems/pf2e/icons/spells/ghost-sound.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>You create an auditory illusion of simple sounds that has a maximum volume equal to four normal humans shouting. The sounds emanate from a square you designate within range. You can't create intelligible words or other intricate sounds (such as music).</p>\n<hr />\n<p><strong>Heightened (3rd)</strong> The range increases to 60 feet.</p>\n<p><strong>Heightened (5th)</strong> The range increases to 120 feet.</p>"},"rules":[],"slug":"ghost-sound","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["auditory","cantrip","illusion"],"rarity":"common","traditions":["arcane","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":1},"requirements":"","target":{"value":""},"range":{"value":"30 feet"},"area":null,"time":{"value":"3"},"duration":{"value":"","sustained":true},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"FIoUUSoMwBmGvHPi"},"counteraction":false,"heightening":{"levels":{"3":{"range":{"value":"60 feet"}},"5":{"range":{"value":"120 feet"}}},"type":"fixed"}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.atlgGNI1E1Ox3O3a","duplicateSource":null,"exportSource":null}},{"_id":"gr6odujhomLnqYN7","name":"Nascent Mind","type":"action","img":"systems/pf2e/icons/actions/Passive.webp","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"gm":"","value":"<p>The mind of a scroll mold is barely conscious and has difficulty imagining things it has not already perceived. As it has no sense of sight, visual illusions (such as those created by <em>@Compendium[pf2e.spells-srd.2oH5IufzdESuYxat]{Illusory Object}</em>) tend to appear as shifting, shapeless blobs. Auditory illusions (such as those created by <em>@Compendium[pf2e.spells-srd.atlgGNI1E1Ox3O3a]{Ghost Sound}</em>) tend to be distorted reflections of sounds the scroll mold has recently heard.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"offensive","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"EY2HLKSqaGijS1qR","name":"Subtle Caster","type":"action","img":"systems/pf2e/icons/actions/Passive.webp","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"gm":"","value":"<p>When using an innate spell, the scroll mold must expend 1 more action than that spell would usually require. However, it does not need to use somatic or verbal components, and the spell does not create obvious sensory manifestations that would make spellcasting obvious to those nearby.</p>\n<p>This ability obscures only the spell's casting, not its effects, so an observer would still see a gout of flame or an arc of lightning emitting from the scroll mold.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"offensive","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}}],"effects":[],"folder":null,"sort":0,"flags":{"pf2e":{"lootable":false},"core":{}},"system":{"attributes":{"hp":{"value":16,"temp":0,"max":16,"details":""},"ac":{"value":12,"details":"","base":12},"allSaves":{"value":""},"speed":{"value":0,"otherSpeeds":[],"details":""},"immunities":[{"type":"critical-hits"},{"type":"precision"},{"type":"unconscious"},{"type":"visual"}]},"initiative":{"statistic":"perception"},"details":{"languages":{"value":[],"details":""},"level":{"value":0},"blurb":"","publicNotes":"<p>Many students of the arcane have muttered to themselves about a case of scrolls \"wandering off on its own.\" Most of the time, they've simply misplaced the item. But now and again, when the conditions are right, their absurd ramblings are more right than they realize.</p>\n<p>Scroll molds are colonies of color-shifting mold that have permeated and incorporated a decaying wooden scroll case into their masses, the scrolls within rendered slimy and blank. They are typically the result of magic scrolls left abandoned for too long in some musty basement or dank cavern. After extended exposure to the magic contained within the scroll case, a patch of otherwise ordinary mold develops strange new abilities—and the beginnings of consciousness.</p>\n<p>Scroll molds can barely move. Instead, they rely on their spells, camouflage, and distractions to stay safe. They generally hide in out-of-the-way spaces, preferably damp and dark nooks and crannies, tuning their color to blend in with their surroundings. If they sense approaching creatures, they instinctively create illusions to distract other creatures from their location. If still approached, a scroll mold will often try to put interlopers to sleep before casting <em>@Compendium[pf2e.spells-srd.KcLVELhCUcKXxiKE]{Longstrider}</em> to slither away to a new hiding place. As a last resort, the scroll mold can use its few offensive spells, although doing so makes it obvious it is not merely a decaying scroll case to be left alone to decompose.</p>\n<h2>Hungry for Knowledge</h2>\n<p>Scroll molds have a particular taste for magic items. If a scroll mold senses magic and there is no one around, it might make its way over to the source and attempt to consume the item to incorporate it into itself. Utilizing this process, it can learn spells or develop powerful new abilities.</p>\n<h2>Monster Part Subsystem</h2>\n<p><strong>Scroll Mold Creature 0 </strong></p>\n<p><strong>Monster Parts</strong> 2.25/5/9 gp</p>\n<p><strong>Eligible Refinements</strong> perception item, skill items (Deception, Stealth)</p>\n<p><strong>Eligible Imbued Properties</strong> bane, charisma, constitution, electricity, energy resistant (positive), fire, fortification, mental, negative, spells (Arcane: burning hands, chill touch, color spray, detect magic, electric arc, ghost sound, illusory object, longstrider, sleep), wild, wisdom</p>","privateNotes":"","publication":{"title":"Battlezoo Bestiary","authors":"Robert Garland","license":"OGL","remaster":false},"creatureType":""},"resources":{},"_migration":{"version":0.932,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"abilities":{"str":{"mod":-5},"dex":{"mod":-5},"con":{"mod":2},"int":{"mod":-4},"wis":{"mod":3},"cha":{"mod":2}},"perception":{"details":"","mod":6,"senses":[{"type":"motion-sense","acuity":"imprecise","range":30}],"vision":false},"saves":{"fortitude":{"value":6,"saveDetail":""},"reflex":{"value":0,"saveDetail":""},"will":{"value":9,"saveDetail":""}},"skills":{"deception":{"base":6},"stealth":{"base":8}},"traits":{"value":["fungus"],"rarity":"common","size":{"value":"tiny"}}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"prototypeToken":{"bar1":{"attribute":"attributes.hp"},"displayName":20,"displayBars":20,"flags":{"pf2e":{"linkToActorSize":true,"autoscale":true}},"height":0.5,"width":0.5,"disposition":-1,"name":"Scroll Mold","actorLink":false,"lockRotation":false,"rotation":0,"alpha":1,"bar2":{"attribute":null},"randomImg":false,"light":{"alpha":0.25,"angle":360,"bright":0,"coloration":1,"dim":0,"luminosity":0.5,"saturation":0,"contrast":0,"shadows":0,"animation":{"speed":5,"intensity":5,"type":null,"reverse":false},"darkness":{"min":0,"max":1},"color":null,"attenuation":0.5,"negative":false,"priority":0},"texture":{"src":"modules/battlezoo-bestiary-pf2e/art/Tokens/scroll_mold.webp","tint":"#ffffff","scaleX":1,"scaleY":1,"anchorX":0.5,"anchorY":0.5,"fit":"contain","alphaThreshold":0.75},"sight":{"angle":360,"enabled":false,"range":0,"brightness":1,"visionMode":"basic","color":null,"attenuation":0.