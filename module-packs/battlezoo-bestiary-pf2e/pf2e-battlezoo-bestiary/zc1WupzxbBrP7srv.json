e","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""},"weapon":{"value":""}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.bestiary-ability-glossary-srd.Item.etMnv73EIdEZrYYu","duplicateSource":null,"exportSource":null}},{"_id":"aohh1QanPUkkmd5m","name":"Impart Anguish","type":"action","img":"systems/pf2e/icons/actions/TwoActions.webp","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"gm":"","value":"<p>The dryad husk twists its face into a visage of utter agony, sharing its anguish with those who gaze upon it. Creatures in a @Template[type:cone|distance:15] take [[/r 3d6[mental]]] damage (@Check[type:will|dc:19|name:Impart Anguish DC|traits:damaging-effect, mental, primal, visual|showDC:gm]{basic Will} save). On a critically failed save, the creature is also @Compendium[pf2e.conditionitems.e1XGnhKNSQIm5IXg]{Stupefied 1} for 1 round.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["mental","primal","visual"],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":2},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"ogxf9RhxMMtg910b","name":"Draining Impact","type":"action","img":"systems/pf2e/icons/actions/Passive.webp","effects":[],"folder":null,"sort":-50000,"flags":{},"system":{"description":{"gm":"","value":"<p>When the dryad husk hits a creature with its blighted branch, the creature must make a @Check[type:fortitude|dc:20|name:Draining Impact DC|traits:primal|showDC:gm]{Fortitude} save. Whatever the result, the creature is immune to the same dryad husk's draining impact for 24 hours.</p>\n<hr />\n<p><strong>Success</strong> The creature is unaffected.</p>\n<p><strong>Failure</strong> The creature is @Compendium[pf2e.conditionitems.4D2KBtexWXa6oUMR]{Drained 1}</p>\n<p><strong>Critical Failure</strong> The creature is @Compendium[pf2e.conditionitems.4D2KBtexWXa6oUMR]{Drained 2}.</p>\n"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["primal"],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"offensive","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"SB16paJRM6RSkuKx","name":"Blighted Branch","type":"melee","img":"systems/pf2e/icons/default-icons/melee.svg","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"value":"","gm":""},"rules":[],"slug":null,"traits":{"value":["finesse","magical","reach-10"],"otherTags":[]},"damageRolls":{"bxy9b22al4fodw2n8yq4":{"damage":"1d10+7","damageType":"bludgeoning","category":null}},"bonus":{"value":11},"attackEffects":{"value":["draining-impact"]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"_migration":{"version":0.932,"previous":{"schema":null,"foundry":"12.328","system":"6.1.0"}}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","c