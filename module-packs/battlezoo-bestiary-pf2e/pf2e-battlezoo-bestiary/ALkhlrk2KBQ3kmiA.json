e":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"BQlIYo6mMVXgUHpE","name":"Negative Healing","type":"action","img":"systems/pf2e/icons/actions/Passive.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>@Localize[PF2E.NPC.Abilities.Glossary.NegativeHealing]</p>"},"rules":[{"key":"ActiveEffectLike","mode":"override","path":"system.attributes.hp.negativeHealing","value":true}],"slug":"negative-healing","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"defensive","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""},"weapon":{"value":""}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.bestiary-ability-glossary-srd.Item.TTCw5NusiSSkJU1x","duplicateSource":null,"exportSource":null}},{"_id":"Wew0ScvL80QzEH1m","name":"Rejuvenation","type":"action","img":"systems/pf2e/icons/actions/Passive.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>When an unarmored is destroyed, it re-forms after [[/r 2d4 #days]]{2d4 days} at the site to which it is bound, fully healed. An unarmored is permanently and instantly destroyed only if earnestly gifted a suit of armor worth at least 1,400 gp. The gifted suit of armor disappears along with the departing spirit.</p>"},"rules":[],"slug":"ghost-rejuvenation","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["divine"],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"defensive","actions":{"value":null},"deathNote":false,"requirements":{"value":"Pathfinder Bestiary"},"trigger":{"value":""},"weapon":{"value":""}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.bestiary-family-ability-glossary.Item.unR8VVR4yyRnsmnB","duplicateSource":null,"exportSource":null}},{"_id":"VMREp0QhCVpB0xHl","name":"Deny Shield","type":"action","img":"systems/pf2e/icons/actions/Reaction.webp","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"gm":"","value":"<p><strong>Trigger</strong> A creature within 30 feet of the unarmored that it can see uses the Shield Block reaction;</p>\n<hr />\n<p><strong>Effect</strong> The unarmored wills the triggering creature's shield to momentarily dematerialize, allowing all incoming damage that triggered the Shield Block to bypass the Shield Block.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["divine","teleportation"],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"reaction"},"category":"defensive","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"hleCFq25QtLtFwnr","name":"Spectral Hand","type":"melee","img":"systems/pf2e/icons/default-icons/melee.svg","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"value":"","gm":""},"rules":[],"slug":null,"traits":{"value":["agile","finesse","magical"],"otherTags":[]},"damageRolls":{"w5swuw3aiAEVJWyY":{"damage":"3d6+15","damageType":"void"}},"bonus":{"value":25},"attackEffects":{"value":[]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"_migration":{"version":0.932,"previous":{"schema":null,"foundry":"12.328","system":"6.1.0"}}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":"pf2e","systemVersion":"6.1.0","coreVersion":"14.360","createdTime":null,"modifiedTime":1721532808927,"lastModifiedBy":"l2rbNx2a8f5ocpeL","compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"Vk2U3gSBODvOipdm","name":"Transport Armor","type":"action","img":"systems/pf2e/icons/actions/TwoActions.webp","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"gm":"","value":"<p>Pointing a finger and issuing a silent scream, the unarmored targets a creature wearing armor within 30 feet. The unarmored attempts to sever the target's connection to its armor and whisk the armor to the Ethereal Plane. The target must attempt a @Check[type:will|dc:31|name:Transport Armor DC|traits:conjuration, divine, teleportation|showDC:gm]{Will} save.</p>\n<hr />\n<p><strong>Success</strong> The creature is unaffected.</p>\n<p><strong>Failure</strong> The creature's bond to its armor isn't strong enough to withstand the unarmored's meddling. The creature's armor turns ghostly and translucent as it is transported to the Ethereal Plane. The armor is instantly unequipped and becomes invisible and untouchable to creatures on the Material Plane. After 1 round, the armor rematerializes in the nearest empty space to where it was last worn.</p>\n<p><strong>Critical Failure</strong> As failure, but the armor remains on the Ethereal Plane for 1 minute. The armor rematerializes on the Material Plane in a random direction within 100 feet of where it was last worn.</p>\n"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["divine","teleportation"],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":2},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}}],"effects":[],"folder":null,"sort":0,"flags":{"pf2e":{"lootable":false},"core":{}},"system":{"attributes":{"hp":{"value":190,"temp":0,"max":190,"details":"negative healing, rejuvenation"},"ac":{"value":30,"details":"","base":30},"allSaves":{"value":""},"speed":{"value":0,"otherSpeeds":[{"type":"fly","label":"Fly","value":60}],"details":""},"immunities":[{"type":"death-effects"},{"type":"disease"},{"type":"paralyzed"},{"type":"poison"},{"type":"precision"},{"type":"unconscious"}],"weaknesses":[{"type":"vitality","value":10}],"resistances":[{"type":"all-damage","value":10,"exceptions":["force","ghost-touch","vitality"],"doubleVs":["non-magical"]}]},"initiative":{"statistic":"perception"},"details":{"languages":{"value":["common"],"details":""},"level":{"value":12},"blurb":"","publicNotes":"<p>Few things frustrate adventurers more than when essential gear goes missing, and this is doubly true for warriors and their precious armor. When a fighter spends their final moments lamenting their fate—believing they would have survived if only they had been wearing better armor—the individual's anger, despair, and obsession can cause their spirit to rise as an unarmored.</p>\n<p>Anchored to the location of their demise and unable to move on from their grim fate, unarmored desire only two things: to acquire the perfect suit of armor and to inflict their tragedy upon others. They bear great hatred for anyone wearing particularly spectacular gear. To ensure such well-equipped individuals suffer the same loss as it, an unarmored spirits away its victim's armor to the Ethereal Plane before mercilessly striking down the suddenly unprotected warrior.</p>\n<h2>Ethereal Extraction</h2>\n<p>Adventurers who know that they might run up against an unarmored do well to prepare an ethereal jaunt spell or other means of quickly going back and forth between the Material and Ethereal Planes. Doing so allows victims of the unarmored's armor-teleporting powers to quickly retrieve their equipment. Such preparations can dramatically stymie<span style=\"color:#333333;font-family:Roboto, sans-serif;font-size:12px\">—</span>and enrage<span style=\"color:#333333;font-family:Roboto, sans-serif;font-size:12px\">—</span>an unarmored.</p>\n<h2>Monster Part Subsystem</h2>\n<p><strong>Unarmored Creature 12 </strong></p>\n<p><strong>Monster Parts</strong> 250/560/1,030 gp</p>\n<p><strong>Eligible Refinements</strong> perception item, skill items (Intimidation, Stealth)</p>\n<p><strong>Eligible Imbued Properties</strong> bane, chaotic, charisma, dexterity, energy resistant (acid, cold, electricity, fire, negative, sonic), evil, fortification, negative, sensory (darkvision), wild, winged</p>","privateNotes":"","publication":{"title":"Battlezoo Bestiary","authors":"Ryan Griggs","license":"OGL","remaster":false},"creatureType":""},"resources":{},"_migration":{"version":0.932,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"abilities":{"str":{"mod":-5},"dex":{"mod":6},"con":{"mod":0},"int":{"mod":0},"wis":{"mod":5},"cha":{"mod":7}},"perception":{"details":"armorsense (imprecise) 60 feet","mod":23,"senses":[{"type":"darkvision"}],"vision":true},"saves":{"fortitude":{"value":18,"saveDetail":""},"reflex":{"value":26,"saveDetail":""},"will":{"value":23,"saveDetail":""}},"skills":{"intimidation":{"base":25},"stealth":{"base":24}},"traits":{"value":["chaotic","evil","incorporeal","spirit","undead","unholy"],"rarity":"common","size":{"value":"med"}}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"prototypeToken":{"bar1":{"attribute":"attributes.hp"},"displayName":20,"displayBars":20,"flags":{"pf2e":{"linkToActorSize":true,"autoscale":false}},"height":1,"width":1,"disposition":-1,"name":"Unarmored","actorLink":false,"lockRotation":false,"rotation":0,"alpha":1,"bar2":{"attribute":null},"randomImg":false,"light":{"alpha":0.25,"angle":360,"bright":0,"coloration":1,"dim":0,"luminosity":0.5,"saturation":0,"contrast":0,"shadows":0,"animation":{"speed":5,"intensity":5,"type":null,"reverse":false},"darkness":{"min":0,"max":1},"attenuation":0.5,"color":null,"negative":false,"priority":0},"texture":{"src":"modules/battlezoo-bestiary-pf2e/art/Tokens/unarmored.webp","scaleX":2,"scaleY":2,"tint":"#ffffff","anchorX":0.5,"anchorY":0.5,"fit":"contain","alphaThreshold":0.75},"sight":{"angle":360,"enabled":false,"range":0,"brightness":1,"visionMode":"basic","color":null,"attenuation":0.1,"saturation":0,"contrast":0},"detectionModes":{},"appendNumber":false,"prependAdjective":false,"occludable":{"radius":0},"ring":{"enabled":true,"colors":{"ring":null,"background":null},"effects":1,"subject":{"scale":2,"texture":"modules/battlezoo-bestiary-pf2e/art/Subjects/unarmored.webp"}},"turnMarker":{"mode":1,"animation":null,"src":null,"disposition":false},"movementAction":null,"depth":1},"_stats":{"systemId":"pf2e","systemVersion":"6.1.0","coreVersion":"14.360","createdTime":1663517316713,"modifiedTime":1729379963428,"lastModifiedBy":"ZdvNMqfYMlbFrAL2","compendiumSource":"Compendium.battlezoo-bestiary-pf2e.pf2e-battlezoo-bestiary.Actor.ALkhlrk2KBQ3kmiA","duplicateSource":null,"exportSource":null}}