x":1},"slot5":{"prepared":[],"value":0,"max":0},"slot6":{"prepared":[],"value":0,"max":0},"slot7":{"prepared":[],"value":0,"max":0},"slot8":{"prepared":[],"value":0,"max":0},"slot9":{"prepared":[],"value":0,"max":0},"slot10":{"prepared":[],"value":0,"max":0},"slot11":{"prepared":[],"value":0,"max":0}},"autoHeightenLevel":{"value":null},"showUnpreparedSpells":{"value":true},"displayLevels":{}},"ownership":{"default":0,"gCWCgNsZrx3xvkIE":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"PRqJwqkHyaulGp6x","name":"Burning Hands (At Will)","type":"spell","img":"systems/pf2e/icons/spells/burning-hands.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>Gouts of flame rush from your hands. You deal 2d6 fire damage to creatures in the area.</p>\n<hr />\n<p><strong>Heightened (+1)</strong> The damage increases by 2d6.</p>"},"rules":[],"slug":"burning-hands","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","fire","manipulate"],"rarity":"common","traditions":["arcane","primal"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":1},"requirements":"","target":{"value":""},"range":{"value":""},"area":{"value":15,"type":"cone"},"time":{"value":"2"},"duration":{"value":"","sustained":false},"damage":{"0":{"applyMod":false,"formula":"2d6","type":"fire","category":null,"materials":[],"kinds":["damage"]}},"defense":{"passive":null,"save":{"statistic":"reflex","basic":true}},"cost":{"value":""},"location":{"value":"6nu1LPIRbGDYpnIy","heightenedLevel":1},"counteraction":false,"heightening":{"type":"interval","interval":1,"damage":{"0":"2d6"}}},"ownership":{"default":0,"gCWCgNsZrx3xvkIE":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.y6rAdMK6EFlV6U0t","duplicateSource":null,"exportSource":null}},{"_id":"30etbKhf87EPHEiI","name":"Produce Flame","type":"spell","img":"systems/pf2e/icons/spells/produce-flame.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>A small ball of flame appears in the palm of your hand, and you lash out with it either in melee or at range. Make a spell attack roll against your target's AC. This is normally a ranged attack, but you can also make a melee attack against a creature in your unarmed reach.</p>\n<p>On a success, you deal 1d4 fire damage plus your spellcasting ability modifier. On a critical success, the target takes double damage and [[/r 1d4[persistent,fire]]] damage.</p>\n<hr />\n<p><strong>Heightened (+1)</strong> Increase the damage by 1d4 and the @Compendium[pf2e.conditionitems.lDVqvLKA6eF3Df60]{Persistent Damage} on a critical hit by 1d4.</p>"},"rules":[],"slug":"produce-flame","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["attack","cantrip","concentrate","fire","manipulate"],"rarity":"common","traditions":["arcane","primal"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":1},"requirements":"","target":{"value":"1 creature"},"range":{"value":"30 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"","sustained":false},"damage":{"0":{"applyMod":true,"formula":"1d4","type":"fire","category":null,"materials":[],"kinds":["damage"]}},"defense":null,"cost":{"value":""},"location":{"value":"6nu1LPIRbGDYpnIy"},"counteraction":false,"heightening":{"type":"interval","interval":1,"damage":{"0":"1d4"}}},"ownership":{"default":0,"gCWCgNsZrx3xvkIE":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.O9w7r4BKgPogYDDe","duplicateSource":null,"exportSource":null}},{"_id":"UnI00laKEEeIwXbS","name":"Speak with Plants (Constant) (Pyrophytic Plants Only)","type":"spell","img":"systems/pf2e/icons/spells/speak-with-plants.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>You can ask questions of and receive answers from plants, but the spell doesn't make them more friendly or intelligent than normal. Most normal plants have a distinctive view of the world around them, so they don't recognize details about creatures or know anything about the world beyond their immediate vicinity. Cunning plant monsters are likely to be terse and evasive, while less intelligent ones often make inane comments.</p>"},"rules":[],"slug":"speak-with-plants","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","manipulate","plant"],"rarity":"common","traditions":["primal"]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"level":{"value":4},"requirements":"","target":{"value":""},"range":{"value":""},"area":null,"time":{"value":"2"},"duration":{"value":"10 minutes","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"6nu1LPIRbGDYpnIy","heightenedLevel":4},"counteraction":false},"ownership":{"default":0,"A7Cmsw43rnggTkpf":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.qvwIwJ9QBihy8R0t","duplicateSource":null,"exportSource":null}},{"_id":"Mk5ESrpLmQpqyf0A","name":"Change Shape","type":"action","img":"systems/pf2e/icons/actions/OneAction.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>The wildfire leshy transforms into a Small pyrophytic plant. This ability otherwise uses the effects of <em>@Compendium[pf2e.spells-srd.dileJ0Yxqg76LMvu]{Tree Shape}</em>.</p>\n<hr />\n<p>@Localize[PF2E.NPC.Abilities.Glossary.ChangeShape]</p>"},"rules":[],"slug":"change-shape","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","polymorph","primal"],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":1},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""},"weapon":{"value":""}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.bestiary-ability-glossary-srd.Item.eQM5hQ1W3d1uen97","duplicateSource":null,"exportSource":null}}],"effects":[],"folder":null,"sort":0,"flags":{"pf2e":{"lootable":false},"core":{}},"system":{"attributes":{"hp":{"value":40,"temp":0,"max":40,"details":""},"ac":{"value":16,"details":"","base":16},"allSaves":{"value":""},"speed":{"value":25,"otherSpeeds":[],"details":""},"resistances":[{"type":"fire","value":5,"exceptions":[],"doubleVs":[]}]},"initiative":{"statistic":"perception"},"details":{"languages":{"value":["common","wildsong","fey"],"details":"speak with plants (pyrophytic plants only)"},"level":{"value":2},"blurb":"","publicNotes":"<p>Wildfire leshies arise from the charred remains of plants destroyed by wildfires, and they are perhaps as often misunderstood as their terrifying—but wholly natural—conflagratory namesakes. Like wildfires themselves, wildfire leshies are part of the miraculous and mysterious cycle of life, death, and rebirth.</p>\n<p>Similar to other leshies, wildfire leshies typically arise when a druid infuses a body of vegetation with a nature spirit, but spontaneously manifested wildfire leshies are far from unknown. Their small, stocky bodies are formed of tightly packed charred wood and twigs, and their sunken eyes and mouth resemble smoldering embers. Druids mesmerized by the power and beauty of fire find a good ally indeed in the form of a wildfire leshy, whose gentle heat can keep their friend warm at night and whose gravelly voice is not dissimilar to the sound of crackling firewood.</p>\n<p>Wildfire leshies have an intuitive understanding of the natural balance in highly flammable natural areas such as forests and plains. Although wildfires are anathema to many animals and plants, certain kinds of life—including wildfire leshies themselves—rely on the natural cycle of fire, decay, and regrowth in order to flourish. Wildfire leshies use their preternatural knowledge of this cycle both to fight premature wildfires and to spark the first flames in areas overdue for a fiery cleansing. Whenever possible, wildfire leshies recruit the aid of other wild creatures, including other types of leshies, to usher vulnerable creatures toward a safe refuge before starting their inferno. Since they require little air to breathe and can see through even the thickest smoke with ease, wildfire leshies are also excellent at rescuing creatures caught in a wildfire before it's too late.</p>\n<h2>Born of Fire</h2>\n<p>Wildfire leshies aren't the only such plant creatures to emerge from the ashes of a wildfire. Certain varieties of fungus leshies, for instance, can manifest only in the aftermath of a forest inferno, much like morel mushrooms.</p>\n<h2>Monster Part Subsystem</h2>\n<p><strong>Wildfire Leshy Creature 2</strong></p>\n<p><strong>Monster Parts</strong> 5/12/22 gp</p>\n<p><strong>Eligible Refinements</strong> weapons (bludgeoning), armor (light), perception item, skill items (Athletics, Nature, Survival)</p>\n<p><strong>Eligible Imbued Properties</strong> bane, chaotic, constitution, energy resistant (fire, positive), fire, good, sensory (low-light vision), spells (Primal: burning hands, produce flame, speak with plants), wild, wisdom</p>","privateNotes":"","publication":{"title":"Battlezoo Bestiary","authors":"David Walker","license":"OGL","remaster":false},"creatureType":""},"resources":{},"_migration":{"version":0.932,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"abilities":{"str":{"mod":2},"dex":{"mod":1},"con":{"mod":4},"int":{"mod":-2},"wis":{"mod":3},"cha":{"mod":0}},"perception":{"details":"smoke vision","mod":9,"senses":[{"type":"low-light-vision"}],"vision":true},"saves":{"fortitude":{"value":12,"saveDetail":""},"reflex":{"value":5,"saveDetail":""},"will":{"value":7,"saveDetail":""}},"skills":{"athletics":{"base":8},"nature":{"base":7},"survival":{"base":7}},"traits":{"value":["chaotic","good","leshy","plant"],"rarity":"common","size":{"value":"sm"}},"customModifiers":{}},"ownership":{"default":0,"A7Cmsw43rnggTkpf":3},"prototypeToken":{"bar1":{"attribute":"attributes.hp"},"displayName":20,"displayBars":20,"flags":{"pf2e":{"linkToActorSize":true,"autoscale":false}},"height":1,"width":1,"disposition":-1,"name":"Wildfire Leshy","actorLink":false,"lockRotation":false,"rotation":0,"alpha":1,"bar2":{"attribute":null},"randomImg":false,"light":{"alpha":0.25,"angle":360,"bright":0,"coloration":1,"dim":0,"luminosity":0.5,"saturation":0,"contrast":0,"shadows":0,"animation":{"speed":5,"intensity":5,"type":null,"reverse":false},"darkness":{"min":0,"max":1},"color":null,"attenuation":0.5,"negative":false,"priority":0},"texture":{"src":"modules/battlezoo-bestiary-pf2e/art/Tokens/wildfire_leshy.webp","tint":"#ffffff","scaleX":1.6,"scaleY":1.6,"anchorX":0.5,"anchorY":0.5,"fit":"contain","alphaThreshold":0.75},"sight":{"angle":360,"enabled":false,"range":0,"brightness":1,"visionMode":"basic","color":null,"attenuation":0.1,"saturation":0,"contrast":0},"detectionModes":{},"appendNumber":false,"prependAdjective":false,"occludable":{"radius":0},"ring":{"enabled":true,"colors":{"ring":null,"background":null},"effects":1,"subject":{"scale":2,"texture":"modules/battlezoo-bestiary-pf2e/art/Subjects/wildfire_leshy.webp"}},"turnMarker":{"mode":1,"animation":null,"src":null,"disposition":false},"movementAction":null,"depth":1},"_stats":{"systemId":"pf2e","systemVersion":"6.1.0","coreVersion":"14.360","createdTime":1663517316829,"modifiedTime":1729382840547,"lastModifiedBy":"ZdvNMqfYMlbFrAL2","compendiumSource":"Actor.e99sjzpw8J3of99V","duplicateSource":null,"exportSource":{"worldId":"data-entry","uuid":null,"coreVersion":"0.8.9","systemId":"pf2e","systemVersion":"2.13.5"}}}