:"common","traditions":["arcane","occult"]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"level":{"value":5},"requirements":"","target":{"value":"1 unattended object of up to 80 Bulk with no dimension longer than 20 feet"},"range":{"value":"120 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"1 minute","sustained":true},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"yhTzgskEh84upZ8w","heightenedLevel":5},"counteraction":false},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.tpLTLbJUrYcMWGld","duplicateSource":null,"exportSource":null}},{"_id":"M26ZZhLkqPFQTbNZ","name":"Dispel Magic","type":"spell","img":"systems/pf2e/icons/spells/dispel-magic.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>You unravel the magic behind a spell or effect. Attempt a counteract check against the target. If you successfully counteract a magic item, the item becomes a mundane item of its type for 10 minutes. This doesn't change the item's non-magical properties. If the target is an artifact or similar item, you automatically fail.</p>"},"rules":[],"slug":"dispel-magic","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","manipulate"],"rarity":"common","traditions":["arcane","divine","occult","primal"]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"level":{"value":2},"requirements":"","target":{"value":"1 spell effect or unattended magic item"},"range":{"value":"120 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"yhTzgskEh84upZ8w","heightenedLevel":4},"cou