FmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.DCQHaLrYXMI37dvW","duplicateSource":null,"exportSource":null}},{"_id":"6d4vCOgFDN8uTf1y","name":"Ray of Enfeeblement","type":"spell","img":"systems/pf2e/icons/spells/ray-of-enfeeblement.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>A ray that saps a foe's strength flashes from your hand. Attempt a ranged spell attack against the target. If you succeed, that creature attempts a Fortitude save to determine the spell's effect. If your attack roll is a critical success, use the outcome for one degree of success worse than the result of its save.</p>\n<hr />\n<p><strong>Critical Success</strong> The target is unaffected.</p>\n<p><strong>Success</strong> The target becomes @Compendium[pf2e.conditionitems.MIRkyAjyBeXivMa7]{Enfeebled 1}.</p>\n<p><strong>Failure</strong> The target becomes @Compendium[pf2e.conditionitems.MIRkyAjyBeXivMa7]{Enfeebled 2}.</p>\n<p><strong>Critical Failure</strong> The target becomes @Compendium[pf2e.conditionitems.MIRkyAjyBeXivMa7]{Enfeebled 3}.</p>"},"rules":[],"slug":"ray-of-enfeeblement","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["attack","concentrate","manipulate"],"rarity":"common","traditions":["arcane","divine","occult"]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"level":{"value":1},"requirements":"","target":{"value":"1 creature"},"range":{"value":"30 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"1 minute","sustained":false},"damage":{},"defense":{"passive":null,"save":{"statistic":"fortitude","basic":false}},"cost":{"value":""},"location":{"value":"yhTzgskEh84upZ8w","heightenedLevel":4},"counteraction":false},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.J7Y7tl0bbdz7TcCc","duplicateSource":null,"exportSource":null}},{"_id":"DjsOQcUw6u29JwVE","name":"Invisibility (At Will) (Self Only)","type":"spell","img":"systems/pf2e/icons/spells/invisibility.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>Cloaked in illusion, the target becomes @Compendium[pf2e.conditionitems.zJxUflt9np0q4yML]{Invisible}. This makes it @Compendium[pf2e.conditionitems.VRSef5y1LmL2Hkjf]{Undetected} to all creatures, though the creatures can attempt to find the target, making it @Compendium[pf2e.conditionitems.iU0fEDdBp3rXpTMC]{Hidden} to them instead. If the target uses a hostile action, the spell ends after that hostile action is completed.</p>\n<hr />\n<p><strong>Heightened (4th)</strong> The spell lasts 1 minute, but it doesn't end if the target uses a hostile action.</p>"},"rules":[],"slug":"invisibility","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["illusion","manipulate"],"rarity":"common","traditions":["arcane","occult"]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"level":{"value":2},"requirements":"","target":{"value":"self"},"range":{"value":"self"},"area":null,"time":{"value":"2"},"duration":{"value":"10 minutes","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"yhTzgskEh84upZ8w","heightenedLevel":2},"counteraction":false},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.XXqE1eY3w3z6xJCB","duplicateSource":null,"exportSource":null}},{"_id":"g1O3e89ay0AV3X51","name":"True Seeing (Constant)","type":"spell","img":"systems/pf2e/icons/spells/true-seeing.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>You see things within 60 feet as they actually are. The GM rolls a secret counteract check against any illusion or transmutation in the area, but only for the purpose of determining whether you see through it (for instance, if the check succeeds against a polymorph spell, you can see the creature's true form, but you don't end the polymorph spell).</p>"},"rules":[],"slug":"true-seeing","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","manipulate","revelation"],"rarity":"common","traditions":["arcane","divine","occult","primal"]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"level":{"value":6},"requirements":"","target":{"value":""},"range":{"value":""},"area":null,"time":{"value":"2"},"duration":{"value":"10 minutes","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"yhTzgskEh84upZ8w","heightenedLevel":6},"counteraction":true},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.uqlxMQQeSGWEVjki","duplicateSource":null,"exportSource":null}},{"_id":"hiHWyC828jwsIxRD","name":"Geas","type":"spell","img":"systems/pf2e/icons/spells/geas.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>You enforce a magic rule on a willing target, forcing it to either perform or refrain from carrying out a certain act. A <em>geas</em> to perform an act is usually conditional, such as, \"Always offer hospitality to strangers seeking a place to stay.\" An unconditional <em>geas</em> to perform a certain act doesn't require the target to perform that act exclusively, though it must prioritize the task above all leisurely pursuits. The most common <em>geas</em> to refrain from carrying out an act is a specification to avoid violating a contract. In those cases, the secondary caster usually takes charge of making sure the wording of the contract is attuned correctly with the ritual's magic. Because the target is willing, <em>geas</em> can have a duration that lasts for as long as the target agrees to. If the target is unable to fulfill the <em>geas</em>, it becomes @Compendium[pf2e.conditionitems.fesd1n5eVhpCSS18]{Sickened 1}, and the sickened condition increases by 1 for each consecutive day it is prevented from following the <em>geas</em>, to a maximum of sickened 4. The sickened condition ends immediately when it follows the <em>geas</em> again; it can't remove the sickened condition in any other way. Only powerful magic such as a @Compendium[pf2e.spells-srd.6dDtGIUerazSHIOu]{Wish} spell can remove the effects of <em>geas</em> from a willing target.</p>\n<hr />\n<p><strong>Critical Success</strong> The <em>geas</em> succeeds, and the target receives a +1 status bonus to skill checks that directly uphold the <em>geas</em> (at the GM's discretion).</p>\n<p><strong>Success</strong> The <em>geas</em> succeeds.</p>\n<p><strong>Failure</strong> The <em>geas</em> fails.</p>\n<p><strong>Critical Failure</strong> The <em>geas</em> fails, and you are instead affected by the <em>geas</em> you were attempting to place on the target. You are considered an unwilling target, so the <em>geas</em> can be counteracted with a @Compendium[pf2e.spells-srd.OyFCwQuw8XRazsNr]{Remove Curse} spell.</p>\n<hr />\n<p><strong>Heightened (5th)</strong> You can use <em>geas</em> on an unwilling creature; it can attempt a Will save to negate the effect. If the target fails this Will save, the <em>geas</em> lasts up to 1 week. A <em>remove curse</em> spell can counteract a <em>geas</em> on an unwilling creature, in addition to powerful magic such as a <em>wish</em> spell. A clever unwilling creature can subvert the <em>geas</em> by contriving situations that prevent it from complying, but in that case it becomes @Compendium[pf2e.conditionitems.fesd1n5eVhpCSS18]{Sickened} (as described above).</p>\n<p><strong>Heightened (7th)</strong> As 5th level, but the <em>geas</em> lasts for up to 1 year on an unwilling creature.</p>\n<p><strong>Heightened (9th)</strong> As 5th level, but the <em>geas</em> lasts for a duration you choose (even unlimited) on an unwilling creature.</p>"},"rules":[],"slug":"geas","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["curse","mental"],"rarity":"uncommon","traditions":[]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"level":{"value":3},"requirements":"","target":{"value":"1 creature of a level no greater than double the geas ritual's level"},"range":{"value":"10 feet"},"area":null,"time":{"value":"1 day"},"duration":{"value":"see text","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":null},"counteraction":false,"ritual":{"primary":{"check":"Arcana (expert), Occultism (expert), or Religion (expert)"},"secondary":{"checks":"Society or Legal Lore","casters":1}}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.Q690d3mw3TUrKX7E","duplicateSource":null,"exportSource":null}}],"effects":[],"folder":null,"sort":0,"flags":{"pf2e":{"lootable":false},"core":{}},"system":{"attributes":{"hp":{"value":175,"temp":0,"max":175,"details":"regeneration 10 (deactivated by chaotic)"},"ac":{"value":30,"details":"","base":30},"allSaves":{"value":"+1 status to all saves vs. magic"},"speed":{"value":0,"otherSpeeds":[{"type":"fly","label":"Fly","value":60}],"details":""},"immunities":[{"type":"death-effects"},{"type":"disease"},{"type":"emotion"},{"type":"poison"},{"type":"unconscious"}],"weaknesses":[]},"initiative":{"statistic":"perception"},"details":{"languages":{"value":["diabolic","empyrean","utopian"],"details":"truespeech"},"level":{"value":10},"blurb":"","publicNotes":"<p>As far as an arcarayut is concerned, what goes up must also come down. Charged with protecting and enforcing the laws of gravity, arcarayuts are the bane of those who depend too much on magical flight, levitation, or even just magical protections from long falls. Thankfully for most abjurers and transmuters, arcarayuts focus their efforts only on the multiverse's most flagrant or powerful abusers of such gravity-defying powers, such as proteans who warp the laws of gravity across an entire plane or arcanists who levitate entire nations.</p>\n<p>An aracarayut looks like a fist-sized filigreed diamond. Two marbles-one jet black, one bone white-float around the diamond and are vital to the creature's gravitational balance. While ruthless in punishing those that defy gravity magically, arcarayuts are fascinated by creatures that can glide and fly through physical means. When not pursuing quarry, they can often be found watching birds and other winged creatures soar for hours on end.</p>\n<p>Arcarayuts are more inclined to pursue knowledge than most inevitables. They engage in numerous practical experiments and mundane studies regarding the effects of gravity on items of various sizes, shapes, and materials. Because they are constantly coming up with new experiments, most arcarayuts keep a wide variety of trinkets and baubles in their small gravity fields. An arcarayut has enough control over its gravitational field that it can use items in its debris field as weapons at close range and strike targets farther away with pulses of concentrated gravity</p>\n<h2>Valuable Inevitable</h2>\n<p>When an arcarayut is destroyed, its diamond center turns gray and dull and falls lifelessly to the ground. This crystal can be dissolved in protean blood to create [[/r 1d6 #doses]]{1d6 doses} of @Compendium[pf2e.equipment-srd.Ru4xaA4kjdZ4IFS5]{Oil of Weightlessness (Greater)} or a single dose of @Compendium[pf2e.equipment-srd.IZRfgOYlZ3HRBkYX]{Oil of Repulsion}. This fact, in addition to the countless treasures that often float around arcarayuts, makes these inevitables valuable targets for plane-hopping treasure hunters.</p>\n<h2>Monster Part Subsystem</h2>\n<p><strong>Arcarayut Creature 10 </strong></p>\n<p><strong>Monster Parts</strong> 125/275/500 gp</p>\n<p><strong>Eligible Refinements</strong> weapons (bludgeoning), armor (heavy), perception item, skill items (Acrobatics, Arcana, Athletics, Lore [Utopia], Religion, Stealth)</p>\n<p><strong>Eligible Imbued Properties</strong> bane, dexterity, energy resistant (positive), force, intelligence, lawful, mental, sensory (darkvision, true seeing), spells (Divine: dispel magic, freedom of movement, invisibility, paralyze, ray of enfeeblement, telekinetic haul, true seeing), wild, winged</p>","privateNotes":"","publication":{"title":"Battlezoo Bestiary","authors":"James Abendroth","license":"OGL","remaster":false},"creatureType":""},"resources":{},"_migration":{"version":0.932,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"abilities":{"str":{"mod":5},"dex":{"mod":7},"con":{"mod":4},"int":{"mod":6},"wis":{"mod":4},"cha":{"mod":2}},"perception":{"details":"","mod":20,"senses":[{"type":"darkvision"},{"type":"truesight","acuity":"precise","range":60}],"vision":true},"saves":{"fortitude":{"value":18,"saveDetail":""},"reflex":{"value":23,"saveDetail":""},"will":{"value":18,"saveDetail":""}},"skills":{"acrobatics":{"base":23},"arcana":{"base":22},"athletics":{"base":19},"religion":{"base":20},"stealth":{"base":21}},"traits":{"value":["aeon","inevitable","lawful","monitor"],"rarity":"common","size":{"value":"sm"}},"spellcasting":{"rituals":{"dc":29}}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"prototypeToken":{"bar1":{"attribute":"attributes.hp"},"displayName":20,"displayBars":20,"flags":{"pf2e":{"linkToActorSize":true,"autoscale":true}},"height":1,"width":1,"disposition":-1,"name":"Arcarayut","actorLink":false,"lockRotation":false,"rotation":0,"alpha":1,"bar2":{"attribute":null},"randomImg":false,"light":{"alpha":0.25,"angle":360,"bright":0,"coloration":1,"dim":0,"luminosity":0.5,"saturation":0,"contrast":0,"shadows":0,"animation":{"speed":5,"intensity":5,"type":null,"reverse":false},"darkness":{"min":0,"max":1},"attenuation":0.5,"color":null,"negative":false,"priority":0},"texture":{"src":"modules/battlezoo-bestiary-pf2e/art/Tokens/arcarayut.webp","scaleX":0.8,"scaleY":0.8,"tint":"#ffffff","anchorX":0.5,"anchorY":0.5,"fit":"contain","alphaThreshold":0.75},"sight":{"angle":360,"enabled":false,"range":0,"brightness":1,"visionMode":"basic","color":null,"attenuation":0.1,"saturation":0,"contrast":0},"detectionModes":{},"appendNumber":false,"prependAdjective":false,"occludable":{"radius":0},"ring":{"enabled":true,"colors":{"ring":null,"background":null},"effects":1,"subject":{"scale":1,"texture":"modules/battlezoo-bestiary-pf2e/art/Subjects/arcarayut.webp"}},"turnMarker":{"mode":1,"animation":null,"src":null,"disposition":false},"movementAction":null,"depth":1},"_stats":{"systemId":"pf2e","systemVersion":"6.1.0","coreVersion":"14.360","createdTime":1663517319080,"modifiedTime":1729379236335,"lastModifiedBy":"ZdvNMqfYMlbFrAL2","compendiumSource":"Compendium.battlezoo-bestiary-pf2e.pf2e-battlezoo-bestiary.Actor.vG6eBnj7RiFSMTkl","duplicateSource":null,"exportSource":null}}