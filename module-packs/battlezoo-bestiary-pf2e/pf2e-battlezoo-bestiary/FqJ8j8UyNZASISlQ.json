,"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"VTsuwTl2LnEn3TOY","name":"Claw","type":"melee","img":"systems/pf2e/icons/default-icons/melee.svg","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"value":"","gm":""},"rules":[],"slug":null,"traits":{"value":["agile","reach-10"],"otherTags":[]},"damageRolls":{"n8g408d5vgjp78ppiy0v":{"damage":"2d6+6","damageType":"slashing","category":null}},"bonus":{"value":15},"attackEffects":{"value":["sanguinary-disease"]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"_migration":{"version":0.932,"previous":{"schema":null,"foundry":"12.328","system":"6.1.0"}}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"KoG80986uRQfgecF","name":"Diseased Wake","type":"action","img":"systems/pf2e/icons/actions/TwoActions.webp","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"gm":"","value":"<p>The fungal raptor flies up to its fly Speed, spreading its wings and coating the area up to 15 feet below with deadly spores. The spores last for 1 minute. Creatures other than the fungal raptor looking through the spores take a -2 circumstance penalty to visual Perception checks.</p>\n<p>Any creature that starts its turn in the area of the spores or moves through a spore-ridden space must save against the raptor's sanguinary disease.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["disease","move"],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"defensive","actions":{"value":2},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"Yr1Z3czCUuNnXGvw","name":"Sanguinary Disease","type":"action","img":"systems/pf2e/icons/actions/Passive.webp","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"gm":"","value":"<p>Bloodless creatures are immune. The sickened condition does not improve on its own until the disease is cured.</p>\n<p><strong>Saving Throw</strong> @Check[type:fortitude|dc:24|name:Sanguinary Disease DC|traits:disease|showDC:gm]{Fortitude};</p>\n\n<p><strong>Stage 1</strong> @Compendium[pf2e.conditionitems.fesd1n5eVhpCSS18]{Sickened 1} (1 hour);</p>\n<p><strong>Stage 2</strong> sickened 1 and @Compendium[pf2e.conditionitems.4D2KBtexWXa6oUMR]{Drained 1} ([[/br 1d4 #hours]]{1d4 hours});</p>\n<p><strong>Stage 3</strong> sickened 1 and @Compendium[pf2e.conditionitems.4D2KBtexWXa6oUMR]{Drained 2} ([[/br 2d4 #hours]]{2d4 hours});</p>\n<p><strong>Stage 4</strong> @Compendium[pf2e.conditionitems.fBnFDH2MTzgFijKf]{Unconscious} (1 day);</p>\n<p><strong>Stage 5</strong> dead</p>\n"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["disease"],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"offensive","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"Nq9RS0MEC5KBFuPR","name":"Sneak Attack","type":"action","img":"systems/pf2e/icons/actions/Passive.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>The fungal raptor deals [[/r 1d6[precision]]]{1d6 extra precision damage} to @Compendium[pf2e.conditionitems.AJh5ex99aV6VTggg]{Off-Guard} creatures.</p>\n<hr />\n<p>@Localize[PF2E.NPC.Abilities.Glossary.SneakAttack]</p>"},"rules":[{"category":"precision","diceNumber":1,"dieSize":"d6","key":"DamageDice","predicate":["target:condition:off-guard",{"or":["finesse","agile","ranged"]}],"selector":"strike-damage"},{"key":"RollOption","domain":"all","label":"PF2E.SpecificRule.TOTMToggle.OffGuard","option":"target:condition:off-guard","toggleable":"totm"}],"slug":"sneak-attack","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"offensive","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""},"weapon":{"value":""}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.bestiary-ability-glossary-srd.Item.AWvNPE4U0kEJSL1T","duplicateSource":null,"exportSource":null}}],"effects":[],"folder":null,"sort":0,"flags":{"pf2e":{"lootable":false},"core":{}},"system":{"attributes":{"hp":{"value":120,"temp":0,"max":120,"details":""},"ac":{"value":24,"details":"","base":24},"allSaves":{"value":""},"speed":{"value":15,"otherSpeeds":[{"type":"fly","label":"Fly","value":40}],"details":""},"immunities":[{"type":"disease"}]},"initiative":{"statistic":"perception"},"details":{"languages":{"value":[],"details":""},"level":{"value":6},"blurb":"","publicNotes":"<p>To the untrained eye, a fungal raptor initially appears to be a disease-ridden avian skeleton. In fact, however, this unsightly creature is a naturally occurring airborne fungus that grows in the shape of a bird of prey.</p>\n<p>Somehow, fungal raptors have gained enough intelligence to imitate the forms of their namesake flying predators. Packs of fungal raptors hunt dark forests and damp swamps, using their diseased wings to drive prey deeper into their territory by creating a maze of pestilence. Once a target is thoroughly disoriented and lost, the fungal raptors ambush their prey, infect their victim with a unique blood-devouring disease, and then retreat into the trees where they wait for their helpless victims to succumb to exsanguination. Like true carrion feeders, fungal raptors never eat live prey, but even more importantly, fresh blood itself is harmful to fungal raptors-a fact desperate defenders might try to use to their advantage.</p>\n<p>Like most fungi, fungal raptors blossom and grow in dank, dimly lit areas such as dungeons, grottos, and ruins, making them a common threat to spelunkers and treasure-hunting adventurers. In addition, territorial druids sometimes purposefully cultivate fungal raptors to protect their primal demesnes.</p>\n<h2>Spore Carriers</h2>\n<p>The first fungal raptors were created by a vampiric druid obsessed with the cycle of rot, decay, and rebirth (particularly the rot and decay parts). Since then, fungal raptors have spread throughout the known world utilizing sporal reproduction. Many woods- traipsing adventurers have unknowingly been sprinkled with the spores of a fungal raptor hiding in the trees above, only to carry the raptor's progeny far and wide.</p>\n<h2>Monster Part Subsystem</h2>\n<p><strong>Fungal Raptor Creature 6 </strong></p>\n<p><strong>Monster Parts</strong> 30/65/125 gp</p>\n<p><strong>Eligible Refinements</strong> weapons (piercing, slashing), armor (light), perception item, skill items (Acrobatics, Athletics, Stealth)</p>\n<p><strong>Eligible Imbued Properties</strong> bane, constitution, dexterity, energy resistant (positive), sensory (darkvision, scent), wild, winge</p>","privateNotes":"","publication":{"title":"Battlezoo Bestiary","authors":"Chris Harrell","license":"OGL","remaster":false},"creatureType":""},"resources":{},"_migration":{"version":0.932,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"abilities":{"str":{"mod":3},"dex":{"mod":6},"con":{"mod":4},"int":{"mod":-4},"wis":{"mod":2},"cha":{"mod":0}},"perception":{"details":"","mod":16,"senses":[{"type":"darkvision"},{"type":"scent","acuity":"imprecise","range":60}],"vision":true},"saves":{"fortitude":{"value":16,"saveDetail":""},"reflex":{"value":16,"saveDetail":""},"will":{"value":12,"saveDetail":""}},"skills":{"acrobatics":{"base":14},"athletics":{"base":13},"stealth":{"base":14,"special":[{"label":"in forests and swamps","base":20,"predicate":[{"or":["terrain:forest","terrain:swamp"]}]}]}},"traits":{"value":["fungus"],"rarity":"uncommon","size":{"value":"med"}},"customModifiers":{}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"prototypeToken":{"bar1":{"attribute":"attributes.hp"},"displayName":20,"displayBars":20,"flags":{"pf2e":{"linkToActorSize":true,"autoscale":false}},"height":1,"width":1,"disposition":-1,"name":"Fungal Raptor","actorLink":false,"lockRotation":false,"rotation":0,"alpha":1,"bar2":{"attribute":null},"randomImg":false,"light":{"alpha":0.25,"angle":360,"bright":0,"coloration":1,"dim":0,"luminosity":0.5,"saturation":0,"contrast":0,"shadows":0,"animation":{"speed":5,"intensity":5,"type":null,"reverse":false},"darkness":{"min":0,"max":1},"attenuation":0.5,"color":null,"negative":false,"priority":0},"texture":{"src":"modules/battlezoo-bestiary-pf2e/art/Tokens/fungal_raptor.webp","scaleX":2,"scaleY":2,"tint":"#ffffff","anchorX":0.5,"anchorY":0.5,"fit":"contain","a