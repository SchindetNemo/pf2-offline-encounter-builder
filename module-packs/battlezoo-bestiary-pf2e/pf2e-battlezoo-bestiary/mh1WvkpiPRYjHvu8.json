gEntry.svg","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"gm":"","value":""},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"ability":{"value":"cha"},"spelldc":{"value":16,"dc":24,"mod":0},"tradition":{"value":"divine"},"prepared":{"value":"innate","flexible":false},"showSlotlessLevels":{"value":false},"proficiency":{"value":0},"slots":{"slot0":{"prepared":[],"value":0,"max":0},"slot1":{"prepared":[],"value":0,"max":0},"slot2":{"prepared":[],"value":0,"max":0},"slot3":{"prepared":[],"value":0,"max":0},"slot4":{"prepared":[],"value":0,"max":0},"slot5":{"prepared":[],"value":0,"max":0},"slot6":{"prepared":[],"value":0,"max":0},"slot7":{"prepared":[],"value":0,"max":0},"slot8":{"prepared":[],"value":0,"max":0},"slot9":{"prepared":[],"value":0,"max":0},"slot10":{"prepared":[],"value":0,"max":0},"slot11":{"prepared":[],"value":0,"max":0}},"autoHeightenLevel":{"value":null},"showUnpreparedSpells":{"value":true},"displayLevels":{}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"rKAArLE4Nxf5ioZJ","name":"Dimension Door (At Will)","type":"spell","img":"systems/pf2e/icons/spells/dimension-door.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>Opening a door that bypasses normal space, you instantly transport yourself and any items you're wearing and holding from your current space to a clear space within range you can see. If this would bring another creature with you-even if you're carrying it in an extradimensional container-the spell is lost.</p>\n<hr />\n<p><strong>Heightened (5th)</strong> The range increases to 1 mile. You don't need to be able to see your destination, as long as you have been there in the past and know its relative location and distance from you. You are temporarily immune for 1 hour.</p>"},"rules":[],"slug":"dimension-door","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","manipulate","teleportation"],"rarity":"common","traditions":["arcane","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":4},"requirements":"","target":{"value":""},"range":{"value":"120 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"Lhbub6FQ2RAcalVB","heightenedLevel":4},"counteraction":false,"heightening":{"levels":{"5":{"range":{"value":"1 mile"}}},"type":"fixed"}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.VlNcjmYyu95vOUe8","duplicateSource":null,"exportSource":null}},{"_id":"EDsVjQlHSwMR7KfX","name":"Silence","type":"spell","img":"systems/pf2e/icons/spells/silence.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>The target makes no sound, preventing creatures from noticing it using hearing or other senses alone. The target can't use sonic attacks, nor can it use actions with the auditory trait. This prevents it from casting spells that include verbal components.</p>\n<hr />\n<p><strong>Heightened (4th)</strong> The spell effect emanates from the touched creature, silencing all sound in or passing through a 10- foot radius and preventing any auditory and sonic effects in the affected area. While within the radius, creatures are subject to the same effects as the target. Depending upon the position of the effect, a creature might notice the lack of sound reaching it (blocking off the noise coming from a party, for example).</p>"},"rules":[],"slug":"silence","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["illusion","manipulate"],"rarity":"common","traditions":["divine","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":2},"requirements":"","target":{"value":"1 willing creature"},"range":{"value":"touch"},"area":null,"time":{"value":"2"},"duration":{"value":"1 minute","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"Lhbub6FQ2RAcalVB","heightenedLevel":4},"counteraction":false},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.gIdDLrbswTV3OBJy","duplicateSource":null,"exportSource":null}},{"_id":"GztSCnDOSQe8YllJ","name":"Detect Alignment (At Will) (Good Only)","type":"spell","img":"systems/pf2e/icons/spells/detect-alignment.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>Your eyes glow as you sense aligned auras. Choose chaotic, evil, good, or lawful. You detect auras of that alignment. You receive no information beyond presence or absence. You can choose not to detect creatures or effects you're aware have that alignment.</p>\n<p>Only creatures of 6th level or higher-unless divine spellcasters, undead, or beings from the Outer Sphere-have alignment auras.</p>\n<hr />\n<p><strong>Heightened (2nd)</strong> You learn each aura's location and strength.</p>"},"rules":[],"slug":"detect-alignment","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","detection","manipulate"],"rarity":"uncommon","traditions":["divine","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":1},"requirements":"","target":{"value":""},"range":{"value":""},"area":{"value":30,"type":"emanation"},"time":{"value":"2"},"duration":{"value":"","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"Lhbub6FQ2RAcalVB","heightenedLevel":1},"counteraction":false},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.QnTtGCAvdWRU4spv","duplicateSource":null,"exportSource":null}},{"_id":"jerUYCyfFA6oc2Z6","name":"Silence (Constant) (Self)","type":"spell","img":"systems/pf2e/icons/spells/silence.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>The target makes no sound, preventing creatures from noticing it using hearing or other senses alone. The target can't use sonic attacks, nor can it use actions with the auditory trait. This prevents it from casting spells that include verbal components.</p>\n<hr />\n<p><strong>Heightened (4th)</strong> The spell effect emanates from the touched creature, silencing all sound in or passing through a 10- foot radius and preventing any auditory and sonic effects in the affected area. While within the radius, creatures are subject to the same effects as the target. Depending upon the position of the effect, a creature might notice the lack of sound reaching it (blocking off the noise coming from a party, for example).</p>"},"rules":[],"slug":"silence","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["illusion","manipulate"],"rarity":"common","traditions":["divine","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":2},"requirements":"","target":{"value":"1 willing creature"},"range":{"value":"touch"},"area":null,"time":{"value":"2"},"duration":{"value":"1 minute","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"Lhbub6FQ2RAcalVB","heightenedLevel":2},"counteraction":false},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.gIdDLrbswTV3OBJy","duplicateSource":null,"exportSource":null}},{"_id":"4EEKxRdl0ESKEMCu","name":"Constant Spells","type":"action","img":"systems/pf2e/icons/actions/Passive.webp","effects":[],"folder":null,"sort":475000,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>@Localize[PF2E.NPC.Abilities.Glossary.ConstantSpells]</p>"},"rules":[],"slug":"constant-spells","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"interaction","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""},"weapon":{"value":""}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.bestiary-ability-glossary-srd.Item.kakyXBG5WA8c6Zfd","duplicateSource":null,"exportSource":null}},{"_id":"LTuCG3lgDdV4XrPV","name":"At-Will Spells","type":"action","img":"systems/pf2e/icons/actions/Passive.webp","effects":[],"folder":null,"sort":500000,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>@Localize[PF2E.NPC.Abilities.Glossary.AtWillSpells]</p>"},"rules":[],"slug":"at-will-spells","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":[],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"interaction","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""},"weapon":{"value":""}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.bestiary-ability-glossary-srd.Item.2YRDYVnC1eljaXKK","duplicateSource":null,"exportSource":null}},{"_id":"NRGGDhtXgK0n5EFf","name":"Telepathy 100 feet","type":"action","img":"systems/pf2e/icons/actions/Passive.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>@Localize[PF2E.NPC.Abilities.Glossary.Telepathy]</p>"},"rules":[],"slug":"telepathy","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["aura","magical","mental"],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"interaction","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""},"weapon":{"value":""}},"ownership":{"default":0,"ldigRFmLUDwvP1vo":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.bestiary-ability-glossary-srd.Item.kdhbPaBMK1d1fpbA","duplicateSource":null,"exportSource":null}}],"effects":[],"folder":null,"sort":0,"flags":{"pf2e":{"lootable":false},"core":{}},"system":{"attributes":{"hp":{"value":130,"temp":0,"max":130,"details":""},"ac":{"value":26,"details":"","base":26},"allSaves":{"value":""},"speed":{"value":0,"otherSpeeds":[{"type":"fly","label":"Fly","value":40}],"details":""},"immunities":[{"type":"death-effects"},{"type":"disease"},{"type":"poison"},{"type":"precision"}],"weaknesses":[{"type":"holy","value":10}],"resistances":[{"type":"all-damage","value":10,"exceptions":["force","ghost-touch"],"doubleVs":["non-magical"]}]},"initiative":{"statistic":"perception"},"details":{"languages":{"value":["daemonic"],"details":"can't speak any language, telepathy 100 feet"},"level":{"value":8},"blurb":"","publicNotes":"<p>These daemons embody death at the merciless hands of the laws of nature—the inexorable march of entropy itself. Senidaemons are horrifying to look upon, their insubstantial bodies as devoid of light and color as the deepest spaces between stars.</p>\n<p>Senidaemons lack strong emotion or wit or even most trappings of individuality. Rather, their lives are as hollow as their forms, their alien minds unconcerned with hope, meaning, or even survival. Senidaemons exist to destroy, and if one believes a course of action leading to its death would lead toward a faster extinction of the universe than would its survival, it will go unfalteringly to its demise.</p>\n<h2>Senidaemon tactics</h2>\n<p>Senidaemons are masters of stealth, bodiless, and shrouded in perpetual silence. They care nothing for spectacle or creativity, and their methods of destruction are brutally direct: They bide their time in hiding, and when the opportunity presents itself, they absorb energy and transform it into its most disorderly form—heat—upon which they use their blazing hands to wreak further injury and devastation.</p>\n<h2>Monster Part Subsystem</h2>\n<p><strong>Senidaemon (Entropy Daemon) Creature 8 </strong></p>\n<p><strong>Monster Parts</strong> 64/140/250 gp</p>\n<p><strong>Eligible Refinements</strong> perception item, skill items (Stealth)</p>\n<p><strong>Eligible Imbued Properties</strong> bane, charisma, dexterity, energy resistant (acid, cold, electricity, fire, negative, positive, sonic), evil, fire, fortification, mental, negative, sensory (darkvision), spells (Divine: detect alignment, dimension door, silence), wild, winged, wisdom</p>","privateNotes":"","publication":{"title":"Battlezoo Bestiary","authors":"Clara Barrs","license":"OGL","remaster":false},"creatureType":""},"resources":{},"_migration":{"version":0.932,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"abilities":{"str":{"mod":-5},"dex":{"mod":6},"con":{"mod":3},"int":{"mod":2},"wis":{"mod":4},"cha":{"mod":4}},"perception":{"details":"","mod":16,"senses":[{"type":"darkvision"},{"type":"lifesense","acuity":"precise","range":30}],"vision":true},"saves":{"fortitude":{"value":13,"saveDetail":""},"reflex":{"value":20,"saveDetail":""},"will":{"value":16,"saveDetail":""}},"skills":{"stealth":{"base":20}},"traits":{"value":["demon","evil","fiend","incorporeal","unholy"],"rarity":"common","size":{"value":"med"}},"customModifiers":{}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"prototypeToken":{"bar1":{"attribute":"attributes.hp"},"displayName":20,"displayBars":20,"flags":{"pf2e":{"linkToActorSize":true,"autoscale":false}},"height":1,"width":1,"disposition":-1,"name":"Senidaemon","actorLink":false,"lockRotation":false,"rotation":0,"alpha":1,"bar2":{"attribute":null},"randomImg":false,"light":{"alpha":0.25,"angle":360,"bright":0,"coloration":1,"dim":0,"luminosity":0.5,"saturation":0,"contrast":0,"shadows":0,"animation":{"speed":5,"intensity":5,"type":null,"reverse":false},"darkness":{"min":0,"max":1},"attenuation":0.5,"color":null,"negative":false,"priority":0},"texture":{"src":"modules/battlezoo-bestiary-pf2e/art/Tokens/senidaemon.webp","scaleX":2,"scaleY":2,"tint":"#ffffff","anchorX":0.5,"anchorY":0.5,"fit":"contain","alphaThreshold":0.75},"sight":{"angle":360,"enabled":fals