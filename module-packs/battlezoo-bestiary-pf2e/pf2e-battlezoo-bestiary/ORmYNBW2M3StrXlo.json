light"]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"_migration":{"version":0.932,"previous":{"schema":null,"foundry":"12.328","system":"6.1.0"}}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"DPSPf5Vr8c0IP5wj","name":"Breath Weapon","type":"action","img":"systems/pf2e/icons/actions/TwoActions.webp","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"gm":"","value":"<p>The shadowless house drake breathes a cloud of dark vapor in a @Template[type:cone|distance:10] that deals [[/r 5d6[void]]] damage (@Check[type:reflex|dc:21|name:Breath Weapon DC|traits:damaging-effect, arcane, evocation, negative|showDC:gm]{basic Reflex} save). A creature that fails or critically fails the save is exposed to cosmic blight.</p>\n<p>The shadowless drake can't use Breath Weapon again for [[/br 1d4 #rounds]]{1d4 rounds}.</p>"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["arcane"],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"action"},"category":"offensive","actions":{"value":2},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"4SiB1F2Oo1GhHPky","name":"Cosmic Blight","type":"action","img":"systems/pf2e/icons/actions/Passive.webp","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"gm":"","value":"<p><strong>Saving Throw</strong> @Check[type:fortitude|dc:19|name:Cosmic Blight DC|traits:disease|showDC:gm]{Fortitude};</p>\n<hr />\n<p><strong>Stage 1</strong> carrier with no ill effect (1 week);</p>\n<p><strong>Stage 2</strong> [[/r 1d6[mental]]] damage, [[/r 2d6[void]]] damage and @Compendium[pf2e.conditionitems.e1XGnhKNSQIm5IXg]{Stupefied 1} (1 day);</p>\n<p><strong>Stage 3</strong> [[/r 2d6[mental]]] damage, [[/r 4d6[void]]] damage and @Compendium[pf2e.conditionitems.e1XGnhKNSQIm5IXg]{Stupefied 2} (1 day);</p>\n<p><strong>Stage 4</strong> @Compendium[pf2e.conditionitems.fBnFDH2MTzgFijKf]{Unconscious} and gains no benefit from healing magic (1 day);</p>\n<p><strong>Stage 5</strong> dead</p>\n"},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["disease"],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"actionType":{"value":"passive"},"category":"offensive","actions":{"value":null},"deathNote":false,"requirements":{"value":""},"trigger":{"value":""}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"n4HmjovJ54htAFpr","name":"Occult Innate Spells","type":"spellcastingEntry","img":"systems/pf2e/icons/default-icons/spellcastingEntry.svg","effects":[],"folder":null,"sort":0,"flags":{},"system":{"description":{"gm":"","value":""},"rules":[],"slug":null,"_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"ability":{"value":"cha"},"spelldc":{"value":11,"dc":21,"mod":0},"tradition":{"value":"occult"},"prepared":{"value":"innate","flexible":false},"showSlotlessLevels":{"value":false},"proficiency":{"value":0},"slots":{"slot0":{"prepared":[],"value":0,"max":0},"slot1":{"prepared":[],"value":2,"max":2},"slot2":{"prepared":[],"value":1,"max":1},"slot3":{"prepared":[],"value":0,"max":0},"slot4":{"prepared":[],"value":0,"max":0},"slot5":{"prepared":[],"value":0,"max":0},"slot6":{"prepared":[],"value":0,"max":0},"slot7":{"prepared":[],"value":0,"max":0},"slot8":{"prepared":[],"value":0,"max":0},"slot9":{"prepared":[],"value":0,"max":0},"slot10":{"prepared":[],"value":0,"max":0},"slot11":{"prepared":[],"value":0,"max":0}},"autoHeightenLevel":{"value":null},"showUnpreparedSpells":{"value":true},"displayLevels":{}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"sw56LBMjprO4qA3I","name":"Darkness","type":"spell","img":"systems/pf2e/icons/spells/darkness.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>You create a shroud of darkness that prevents light from penetrating or emanating within the area. Light does not enter the area and any non-magical light sources, such as a torch or lantern, do not emanate any light while inside the area, even if their light radius would extend beyond the darkness. This also suppresses magical light of your darkness spell's level or lower. Light can't pass through, so creatures in the area can't see outside. From outside, it appears as a globe of pure darkness.</p>\n<hr />\n<p><strong>Heightened (4th)</strong> Even creatures with darkvision (but not greater darkvision) can barely see through the darkness. They treat targets seen through the darkness as @Compendium[pf2e.conditionitems.DmAIPqOBomZ7H95W]{Concealed}.</p>"},"rules":[],"slug":"darkness","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","darkness","manipulate"],"rarity":"common","traditions":["arcane","divine","occult","primal"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":2},"requirements":"","target":{"value":""},"range":{"value":"120 feet"},"area":{"value":20,"type":"burst"},"time":{"value":"3"},"duration":{"value":"1 minute","sustained":false},"damage":{},"defense":null,"cost":{"value":""},"location":{"value":"n4HmjovJ54htAFpr","heightenedLevel":2},"counteraction":false},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.4GE2ZdODgIQtg51c","duplicateSource":null,"exportSource":null}},{"_id":"X4gLAarmxCC3lnrW","name":"Charm","type":"spell","img":"systems/pf2e/icons/spells/charm.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>To the target, your words are honey and your visage seems bathed in a dreamy haze. It must attempt a Will save, with a +4 circumstance bonus if you or your allies recently threatened it or used hostile actions against it.</p>\n<p>You can Dismiss the spell. If you use hostile actions against the target, the spell ends. When the spell ends, the target doesn't necessarily realize it was charmed unless its friendship with you or the actions you convinced it to take clash with its expectations, meaning you could potentially convince the target to continue being your friend via mundane means.</p>\n<hr />\n<p><strong>Critical Success</strong> The target is unaffected and aware you tried to charm it.</p>\n<p><strong>Success</strong> The target is unaffected but thinks your spell was something harmless instead of charm, unless it identifies the spell.</p>\n<p><strong>Failure</strong> The target's attitude becomes @Compendium[pf2e.conditionitems.v66R7FdOf11l94im]{Friendly} toward you. If it was Friendly, it becomes @Compendium[pf2e.conditionitems.v44P3WUcU1j0115l]{Helpful}. It can't use hostile actions against you.</p>\n<p><strong>Critical Failure</strong> The target's attitude becomes Helpful toward you, and it can't use hostile actions against you.</p>\n<hr />\n<p><strong>Heightened (4th)</strong> The duration lasts until the next time you make your daily preparations.</p>\n<p><strong>Heightened (8th)</strong> The duration lasts until the next time you make your daily preparations, and you can target up to 10 creatures.</p>"},"rules":[],"slug":"charm","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","emotion","incapacitation","manipulate","mental"],"rarity":"common","traditions":["arcane","occult","primal"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":1},"requirements":"","target":{"value":"1 creature"},"range":{"value":"30 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"1 hour","sustained":false},"damage":{},"defense":{"passive":null,"save":{"statistic":"will","basic":false}},"cost":{"value":""},"location":{"value":"n4HmjovJ54htAFpr","heightenedLevel":1},"counteraction":false,"heightening":{"levels":{"8":{"target":{"value":"10 creatures"}}},"type":"fixed"}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.vLA0q0WOK2YPuJs6","duplicateSource":null,"exportSource":null}},{"_id":"XZZL0sNWud4pRQhN","name":"Fear","type":"spell","img":"systems/pf2e/icons/spells/fear.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>You plant fear in the target; it must attempt a Will save.</p>\n<hr />\n<p><strong>Critical Success</strong> The target is unaffected.</p>\n<p><strong>Success</strong> The target is @Compendium[pf2e.conditionitems.TBSHQspnbcqxsmjL]{Frightened 1}.</p>\n<p><strong>Failure</strong> The target is @Compendium[pf2e.conditionitems.TBSHQspnbcqxsmjL]{Frightened 2}.</p>\n<p><strong>Critical Failure</strong> The target is @Compendium[pf2e.conditionitems.TBSHQspnbcqxsmjL]{Frightened 3} and @Compendium[pf2e.conditionitems.sDPxOjQ9kx2RZE8D]{Fleeing} for 1 round.</p>\n<hr />\n<p><strong>Heightened (3rd)</strong> You can target up to five creatures.</p>"},"rules":[],"slug":"fear","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["concentrate","emotion","fear","manipulate","mental"],"rarity":"common","traditions":["arcane","divine","occult","primal"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":1},"requirements":"","target":{"value":"1 creature"},"range":{"value":"30 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"varies","sustained":false},"damage":{},"defense":{"passive":null,"save":{"statistic":"will","basic":false}},"cost":{"value":""},"location":{"value":"n4HmjovJ54htAFpr","heightenedLevel":1},"counteraction":false,"heightening":{"levels":{"3":{"target":{"value":"5 creatures"}}},"type":"fixed"}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.4koZzrnMXhhosn0D","duplicateSource":null,"exportSource":null}},{"_id":"JERG30TD7y9AnxQ7","name":"Daze","type":"spell","img":"systems/pf2e/icons/spells/daze.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>You cloud the target's mind and daze it with a mental jolt. The jolt deals mental damage equal to your spellcasting ability modifier; the target must attempt a basic Will save. If the target critically fails the save, it is also @Compendium[pf2e.conditionitems.dfCMdR4wnpbYNTix]{Stunned 1}.</p>\n<hr />\n<p><strong>Heightened (+2)</strong> The damage increases by 1d6.</p>"},"rules":[],"slug":"daze","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["cantrip","concentrate","manipulate","mental","nonlethal"],"rarity":"common","traditions":["arcane","divine","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":1},"requirements":"","target":{"value":"1 creature"},"range":{"value":"60 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"1 round","sustained":false},"damage":{"0":{"applyMod":true,"formula":"0","type":"mental","category":null,"materials":[],"kinds":["damage"]}},"defense":{"passive":null,"save":{"statistic":"will","basic":true}},"cost":{"value":""},"location":{"value":"n4HmjovJ54htAFpr"},"counteraction":false,"heightening":{"type":"interval","interval":2,"damage":{"0":"1d6"}}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.4gBIw4IDrSfFHik4","duplicateSource":null,"exportSource":null}},{"_id":"fyrTkjVp25f4LbrH","name":"Telekinetic Projectile","type":"spell","img":"systems/pf2e/icons/spells/telekinetic-projectile.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>You hurl a loose, unattended object that is within range and that has 1 Bulk or less at the target. Make a spell attack roll against the target. If you hit, you deal bludgeoning, piercing, or slashing damage-as appropriate for the object you hurled-equal to 1d6 plus your spellcasting ability modifier. No specific traits or magic properties of the hurled item affect the attack or the damage.</p>\n<hr />\n<p><strong>Critical Success</strong> You deal double damage.</p>\n<p><strong>Success</strong> You deal full damage.</p>\n<hr />\n<p><strong>Heightened (+1)</strong> The damage increases by 1d6.</p>"},"rules":[],"slug":"telekinetic-projectile","_migration":{"version":0.932,"lastMigration":null,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"traits":{"otherTags":[],"value":["attack","cantrip","concentrate","manipulate"],"rarity":"common","traditions":["arcane","occult"]},"publication":{"title":"Pathfinder Core Rulebook","authors":"","license":"OGL","remaster":false},"level":{"value":1},"requirements":"","target":{"value":"1 creature"},"range":{"value":"30 feet"},"area":null,"time":{"value":"2"},"duration":{"value":"","sustained":false},"damage":{"0":{"applyMod":true,"formula":"1d6","type":"untyped","category":null,"materials":[],"kinds":["damage"]}},"defense":null,"cost":{"value":""},"location":{"value":"n4HmjovJ54htAFpr"},"counteraction":false,"heightening":{"type":"interval","interval":1,"damage":{"0":"1d6"}}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":"14.360","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Compendium.pf2e.spells-srd.Item.60sgbuMWN0268dB7","duplicateSource":null,"exportSource":null}}],"effects":[],"folder":null,"sort":0,"flags":{"pf2e":{"lootable":false},"core":{}},"system":{"attributes":{"hp":{"value":60,"temp":0,"max":60,"details":""},"ac":{"value":20,"details":"","base":20},"allSaves":{"value":""},"speed":{"value":15,"otherSpeeds":[{"type":"fly","label":"Fly","value":50}],"details":""},"immunities":[{"type":"paralyzed"},{"type":"unconscious"}]},"initiative":{"statistic":"perception"},"details":{"languages":{"value":["aklo","common","draconic"],"details":""},"level":{"value":4},"blurb":"","publicNotes":"<p>Terrestrial societies have made a number of ill-fated journeys to the stars. Humanoids often take companions on such trips, and diminutive house drakes—the favored pets of the rich and powerful in certain metropolises—are no exception. Yet, as evidenced by the corrupt and malignant beings that often return from extraplanetary expeditions, perhaps it is better for some beings to simply stay home.</p>\n<p>While many who return from the void are changed, it seems that house drakes are especially prone to such changes—and rarely for the better. Twisted by great evil beings residing in the farthest corners of space, these drakes continue their former activities of collecting hoards, terrorizing imps, and consorting with students of arcane academies, but with little of the carefree joy they may have once exhibited. All their capricious fervor is replaced with conniving, ruthless malice. Furthermore, these warped individuals bear none of the friendly nature that house drakes are known for and tend to spend much of their time brooding over stolen treasures.</p>\n<p>The transformed house drake's appearance is what gives these creatures their moniker; their formerly lustrous and healthy violet scales change to a matte, bruised purple-black that scatters no light. Even the drake itself seems to cast no shadow, or its shadow is otherwise hazy and indistinct even in the hardest light. A shadowless house drake's tail also bears signs of the malformation, seemingly broken and rendered lifeless.</p>\n<h2>Worlds of Potential</h2>\n<p>Like typical @Compendium[pf2e.pathfinder-bestiary-3.ldzHiLhLAHhwpVJe]{House Drakes}, shadowless house drakes are almost exclusively found in certain cosmopolitan cities. Unlike their mundane brethren, however, these shadowy dragons are not bound to just one planet. Indeed, their bizarre interactions with the greater cosmos has planted descendants of the original shadowless house drakes on every celestial body in the solar system.</p>\n<h2>Monster Part Subsystem</h2>\n<p><strong>Shadowless House Drake Creature 4 </strong></p>\n<p><strong>Monster Parts</strong> 12/27/50 gp</p>\n<p><strong>Eligible Refinements</strong> weapons (piercing), armor (light, medium, heavy), perception item, skill items (Acrobatics, Arcana, Stealth, Thievery)</p>\n<p><strong>Eligible Imbued Properties</strong> bane, charisma, dexterity, energy resistant (positive), evil, intelligence, mental, negative, sensory (darkvision), spells (Occult: charm, darkness, daze, fear, telekinetic projectile), wild, winged</p>","privateNotes":"","publication":{"title":"Battlezoo Bestiary","authors":"Elizabeth Heyeck","license":"OGL","remaster":false},"creatureType":""},"resources":{},"_migration":{"version":0.932,"previous":{"schema":0.819,"foundry":"12.328","system":"6.1.0"}},"abilities":{"str":{"mod":2},"dex":{"mod":4},"con":{"mod":3},"int":{"mod":5},"wis":{"mod":3},"cha":{"mod":4}},"perception":{"details":"","mod":11,"senses":[{"type":"darkvision"}],"vision":true},"saves":{"fortitude":{"value":11,"saveDetail":""},"reflex":{"value":14,"saveDetail":""},"will":{"value":11,"saveDetail":""}},"skills":{"acrobatics":{"base":12},"arcana":{"base":13},"stealth":{"base":12},"thievery":{"base":12}},"traits":{"value":["aberration","dragon","evil"],"rarity":"rare","size":{"value":"sm"}},"customModifiers":{}},"ownership":{"default":0,"bWA8khYkEWvh0G5V":3},"prototypeToken":{"bar1":{"attribute":"attributes.hp"},"displayName":20,"displayBars":20,"flags":{"pf2e":{"linkToActorSize":true,"autoscale":false}},"height":1,"width":1,"disposition":-1,"name":"Shadowless House Drake","actorLink":false,"lockRotation":false,"rotation":0,"alpha":1,"bar2":{"attribute":null},"randomImg":false,"light":{"alpha":0.25,"angle":360,"bright":0,"coloration":1,"dim":0,"luminosity":0.5,"saturation":0,"contrast":0,"shadows":0,"animation":{"speed":5,"intensity":5,"type":null,"reverse":false},"darkness":{"min":0,"max":1},"attenuation":0.5,"color":null,"negative":false,"priority":0},"texture":{"src":"modules/battlezoo-bestiary-pf2e/art/Tokens/shadowless_house_drake.webp","scaleX":2.4,"scaleY":2.4,"tint":"#ffffff","anchorX":0.5,"anchorY":0.5,"fit":"contain","alphaThreshold":0.75},"sight":{"angle":360,"enabled":false,"range":0,"brightness":1,"visionMode":"basic","color":null,"attenuation":0.1,"saturation":0,"contrast":0},"detectionModes":{},"appendNumber":false,"prependAdjective":false,"occludable":{"radius":0},"ring":{"enabled":true,"colors":{"ring":null,"background":null},"effects":1,"subject":{"scale":3,"texture":"modules/battlezoo-bestiary-pf2e/art/Subjects/shadowless_house_drake.webp"}},"turnMarker":{"mode":1,"animation":null,"src":null,"disposition":false},"movementAction":null,"depth":1},"_stats":{"systemId":"pf2e","systemVersion":"6.1.0","coreVersion":"14.360","createdTime":1663517316792,"modifiedTime":1729380137496,"lastModifiedBy":"ZdvNMqfYMlbFrAL2","compendiumSource":"Compendium.battlezoo-bestiary-pf2e.pf2e-battlezoo-bestiary.Actor.ORmYNBW2M3StrXlo","duplicateSource":null,"exportSource":null}}